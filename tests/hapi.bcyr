# hapi benchmarks — the in-process hot paths of a `sync`.
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.
#
# The whole-process `sync` harness, cold and warm over 100 packages, is in
# docs/benchmarks.md; these time the pieces it spends in, with no
# filesystem: parsing a manifest, its sha1c: hash, a target's lexical
# normalization, and the search a warm run makes of the trail for each row
# (F-079). Through 1.7.0 this tier timed a no-op (2026-10-29 audit,
# finding 165).

include "src/manifest.cyr"
include "src/audit.cyr"
include "src/cmd/link.cyr"

fn _hbn_cat(a, b): i64 {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

fn main(): i64 {
    alloc_init();
    # A 100-row manifest.
    var text = "[package]\nname = \"bench\"\nversion = \"1.0.0\"\n";
    var i = 0;
    while (i < 100) {
        var n = hapi_itoa(i);
        text = _hbn_cat(text, _hbn_cat(_hbn_cat("\n[[link]]\nsource = \"file", n), "\"\n"));
        text = _hbn_cat(text, _hbn_cat(_hbn_cat("target = \".config/bench/file", n), "\"\n"));
        i = i + 1;
    }
    var tl = strlen(text);

    var b1 = bench_new("parse a 100-row manifest");
    bench_batch_start(b1);
    i = 0;
    while (i < 200) { hapi_mf_parse_header_r(text, tl); i = i + 1; }
    bench_batch_stop(b1, 200);
    bench_report(b1);

    var t, m = hapi_mf_parse_header_r(text, tl);
    var b2 = bench_new("sha1c: hash of a 100-row manifest");
    bench_batch_start(b2);
    i = 0;
    while (i < 200) { audit_manifest_hash_of(m); i = i + 1; }
    bench_batch_stop(b2, 200);
    bench_report(b2);

    var b3 = bench_new("lexical normalize a target");
    bench_batch_start(b3);
    i = 0;
    while (i < 10000) { fsl_lexical_normalize("/home/u/./.config//nvim/../nvim/lua/init.lua"); i = i + 1; }
    bench_batch_stop(b3, 10000);
    bench_report(b3);

    # A 150 KB trail, the harness's size, and a row recorded near its start:
    # the backward search's worst case.
    var line = _hbn_cat(_hbn_cat("{\"ts\":\"2026-10-29T00:00:00Z\",\"op\":\"link\",\"pkg\":\"pkg042\",",
      "\"pkg_version\":\"1.0.0\",\"source\":\"file1\","),
      "\"target\":\".pkg042-file1\",\"abs_target\":\"/home/u/.pkg042-file1\"}\n");
    var ll = strlen(line);
    var trail = alloc(ll * 1000 + 1);
    i = 0;
    while (i < 1000) { memcpy(trail + i * ll, line, ll); i = i + 1; }
    var first = "\"abs_target\":\"/home/u/.pkg000-file0\"";
    memcpy(trail + ll - strlen(first) - 2, first, strlen(first));
    var b4 = bench_new("trail search for a row's record (150 KB)");
    bench_batch_start(b4);
    i = 0;
    while (i < 200) { _hlnk_last_at(trail, ll * 1000, first); i = i + 1; }
    bench_batch_stop(b4, 200);
    bench_report(b4);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
