    var t, v = cap_check_root_r("/etc/myproject");
    assert_eq(is_err_result(t), 1, "denied when no allowlist + outside home");
    assert_eq(v, HapiCapDenied, "code is HapiCapDenied");
    cap_set_home(0);
    return 0;
}

