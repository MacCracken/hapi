fn test_fsl_within_basics() {
    test_group("cap: path-within prefix matcher");

    # Exact match.
    assert_eq(_fsl_within("/etc/myproject", "/etc/myproject"), 1, "exact match");

    # Subdir match.
    assert_eq(_fsl_within("/etc/myproject/sub", "/etc/myproject"), 1, "subdir match");

    # Multi-level subdir.
    assert_eq(_fsl_within("/etc/myproject/a/b/c", "/etc/myproject"), 1, "deep subdir match");

    # Prefix-byte-collision but different path component — must not match.
    assert_eq(_fsl_within("/etc/myprojectextra", "/etc/myproject"), 0,
      "byte-prefix collision rejected (boundary on /)");

    # Trailing slash on prefix is tolerated.
    assert_eq(_fsl_within("/etc/myproject/foo", "/etc/myproject/"), 1,
      "trailing slash on prefix tolerated");

    # Parent path, not within child prefix.
    assert_eq(_fsl_within("/etc", "/etc/myproject"), 0, "parent != within child");

    # Empty prefix never matches.
    assert_eq(_fsl_within("/etc", ""), 0, "empty prefix rejected");
    return 0;
}

