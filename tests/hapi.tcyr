    assert_eq(is_ok(t), 1, "inside-home path allowed without allowlist entry");
    cap_set_home(0);
    return 0;
}

fn test_cap_check_allows_listed_root() {
    test_group("cap: allows path matching HAPI_ALLOWED_ROOTS");

    cap_set_home("/home/macro");
    cap_set_allowlist("/etc/myproject:/srv/app");
    var t, v = cap_check_root_r("/etc/myproject");
    assert_eq(is_ok(t), 1, "exact-match allowlist entry passes");

    var r2_t, r2_v = cap_check_root_r("/srv/app/sub/path");
    assert_eq(is_ok(r2_t), 1, "subdir of allowlist entry passes");

    var r3_t, r3_v = cap_check_root_r("/etc/myprojectextra");
    assert_eq(is_err_result(r3_t), 1, "byte-prefix collision still denied");

    var r4_t, r4_v = cap_check_root_r("/tmp/random");
    assert_eq(is_err_result(r4_t), 1, "non-listed path denied");

    cap_set_home(0);
    cap_set_allowlist(0);
    return 0;
}

