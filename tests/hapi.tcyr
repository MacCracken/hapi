# ============================================================
# M7 — security hardening repairs (v0.9.0 audit pass)
# ============================================================

fn test_lexical_normalize_dotdot_collapses() {
    test_group("audit-repair: lexical normalize collapses ..");

    # /home/user/../etc/secret — `..` pops "user", leaving
    # [home, etc, secret]. The bypass demo it defeats:
    # this path is no longer byte-prefix-matchable to /home/user,
    # so cap_check_root_r denies it (see test below).
    var a = fsl_lexical_normalize("/home/user/../etc/secret");
    assert_eq(memeq(a, "/home/etc/secret", 16), 1, ".. pops one component");
    assert_eq(strlen(a), 16, "no trailing junk");

    var b = fsl_lexical_normalize("/a/b/c/../../d");
    assert_eq(memeq(b, "/a/d", 4), 1, "successive .. pops two");
    assert_eq(strlen(b), 4, "no trailing junk");

    var c = fsl_lexical_normalize("/a/./b/./");
    assert_eq(memeq(c, "/a/b", 4), 1, ". segments dropped");
    assert_eq(strlen(c), 4, "no trailing junk");

    var d = fsl_lexical_normalize("/..");
    assert_eq(memeq(d, "/", 1), 1, ".. at root stays at root");
    assert_eq(strlen(d), 1, "root is one byte");

    var e = fsl_lexical_normalize("/");
    assert_eq(memeq(e, "/", 1), 1, "root canonicalizes to root");
    assert_eq(strlen(e), 1, "root is one byte");

    return 0;
}

fn test_cap_check_rejects_dotdot_escape() {
    test_group("audit-repair: cap check rejects .. that escapes $HOME");

    cap_set_home("/home/user");
    cap_set_allowlist("");

    # The bypass case: /home/user/../etc looks like it starts
    # with /home/user but actually resolves to /etc.
    var t, v = cap_check_root_r("/home/user/../etc");
    assert_eq(is_err_result(t), 1, "escape via .. is denied");

    # Legitimate under-$HOME path still allowed.
    var r2_t, r2_v = cap_check_root_r("/home/user/dotfiles");
    assert_eq(is_ok(r2_t), 1, "honest subpath still allowed");

    # And $HOME itself.
    var r3_t, r3_v = cap_check_root_r("/home/user");
    assert_eq(is_ok(r3_t), 1, "$HOME itself still allowed");

    cap_set_home(0);
    cap_set_allowlist(0);
    return 0;
}

fn test_cap_check_normalizes_allowlist_entries() {
    test_group("audit-repair: allowlist entries lex-normalized too");

    cap_set_home("/dev/null");   # force allowlist path
    cap_set_allowlist("/etc/myproject/../escape:/srv/legit");

    # The malformed entry must not gate access to /escape via
    # byte-prefix match — the entry normalizes to /escape, so
    # paths under /escape pass, but /etc/myproject paths do NOT.
    var r1_t, r1_v = cap_check_root_r("/etc/myproject/anything");
    assert_eq(is_err_result(r1_t), 1, "malformed allowlist entry no longer gates /etc/myproject");

    var r2_t, r2_v = cap_check_root_r("/srv/legit/sub");
    assert_eq(is_ok(r2_t), 1, "honest allowlist entry still works");

    cap_set_home(0);
    cap_set_allowlist(0);
    return 0;
}

fn test_backup_copy_refuses_symlink_source() {
    test_group("audit-repair: backup_copy fails on symlink source (TOCTOU defense)");

    var scratch = _test_scratch_dir();

    # Plant a regular file and a symlink to it. The probe step
    # in cmd_link / cmd_adopt would only ever pass us a regular
    # file path — but the kernel-level O_NOFOLLOW means even if
    # an attacker races a swap, we refuse rather than copy
    # through the symlink.
    var real = alloc(strlen(scratch) + 16);
    memcpy(real, scratch, strlen(scratch));
    memcpy(real + strlen(scratch), "/real\x00", 6);
    _test_write_file(real, "secret bytes");

    var link = alloc(strlen(scratch) + 16);
    memcpy(link, scratch, strlen(scratch));
    memcpy(link + strlen(scratch), "/link\x00", 6);
    hapi_symlink(real, link);

    var dst = alloc(strlen(scratch) + 16);
    memcpy(dst, scratch, strlen(scratch));
    memcpy(dst + strlen(scratch), "/copy\x00", 6);

    var rc = hapi_backup_copy(link, dst);
    assert(rc < 0, "copy through symlink refused");

    # Direct (non-symlink) copy still works.
    var rc2 = hapi_backup_copy(real, dst);
    assert_eq(rc2, 0, "regular-file copy succeeds");

    return 0;
}

# ============================================================
# 1.1.1 — P(-1) audit repairs (docs/audit/2026-10-28-audit.md)
# ============================================================

# F-037: `hapi check` listed the package with `dir_list`, which answers an
# empty vec for a directory it cannot read. A package dir with its read bit
# cleared still opens its manifest by name (the search bit is enough), so
# the F-028 orphan walk saw nothing and the verb printed `ok`, exit 0, with
# an unclaimed file sitting in the package. Not meaningful as root (DAC is
# bypassed), like the unreadable-trail test above.
fn test_check_refuses_unlistable_package() {
    test_group("check: an unlistable package dir is an error, not clean");

    var env = _test_fresh_env();
    var pkg = _test_make_package("zshrc", ".zshrc");
    var orphan = _fsl_path_join(pkg, "orphaned-by-crash");
    var fd = file_open(orphan, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    file_write(fd, "stranded", 8);
    file_close(fd);
    assert_eq(cmd_check(pkg, 0), 1, "the orphan is reported while the dir is readable");

    assert_eq(sys_chmod(pkg, 0x0C9), 0, "package dir made unlistable (0311)");
    assert_eq(cmd_check(pkg, 0), 1, "an unlistable package dir does not check clean");

    sys_chmod(pkg, 0x1ED);
    hapi_unlink(orphan);
    assert_eq(cmd_check(pkg, 0), 0, "the restored package checks clean again");

    _test_clear_env();
    return 0;
}

# Bare `\n`s not preceded by `\r` in the file at `path` (-1 if unreadable),
# and, through *crs, the number of `\r`s.
fn _t111_bare_lf(path, crs): i64 {
    var n = 0;
    var buf = _hmw_slurp(path, &n);
    if (buf == 0) { return 0 - 1; }
    var bare = 0;
    var cr = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c == 13) { cr = cr + 1; }
        if (c == 10) {
            var prev = 0;
            if (i > 0) { prev = load8(buf + i - 1); }
            if (prev != 13) { bare = bare + 1; }
        }
        i = i + 1;
    }
    store64(crs, cr);
    return bare;
}

# F-041: the appended row's template was LF-only, so `adopt` left a CRLF
# manifest with mixed endings. Matching the ending needs the remove's
# blank-line trim to understand CR too — without it, every adopt →
# rollback on a CRLF manifest left one more blank line behind.
fn test_manifest_append_matches_line_ending() {
    test_group("manifest_write: an appended row matches the file's line ending");

    var cr = 0;
    var crlf = _tdl_manifest(_tdl_hdr_crlf(), "---\r\n# notes\r\n");
    assert_eq(manifest_append_link_row(crlf, "n", ".n"), 0, "CRLF: append succeeds");
    assert_eq(_t111_bare_lf(crlf, &cr), 0, "CRLF: no bare LF after the append");
    assert_eq(_test_links(crlf), 2, "CRLF: the appended row is read");

    var lf = _tdl_manifest(_TDL_HDR, "---\n# notes\n");
    assert_eq(manifest_append_link_row(lf, "n", ".n"), 0, "LF: append succeeds");
    _t111_bare_lf(lf, &cr);
    assert_eq(cr, 0, "LF: no CR introduced");

    # Round trips converge: the second cycle leaves exactly what the first did.
    assert_eq(manifest_remove_link_row(crlf, "n", ".n"), 0, "CRLF: remove succeeds");
    assert_eq(_t111_bare_lf(crlf, &cr), 0, "CRLF: no bare LF after the remove");
    var n1 = _test_file_size(crlf);
    manifest_append_link_row(crlf, "n", ".n");
    manifest_remove_link_row(crlf, "n", ".n");
    assert_eq(_test_file_size(crlf), n1, "CRLF: a second adopt/rollback cycle adds nothing");
    assert_eq(_test_links(crlf), 1, "CRLF: the original row survives");
    return 0;
}

# Plant `<manifest>.<our pid>.tmp` — the staging name this process's next
# manifest write will try to create O_EXCL.
fn _t111_plant_staging(manifest_path): i64 {
    var pids = hapi_itoa(sys_getpid());
    var ml = strlen(manifest_path);
    var pl = strlen(pids);
    var stage = alloc(ml + 1 + pl + 5);
    memcpy(stage, manifest_path, ml);
    store8(stage + ml, 46);
    memcpy(stage + ml + 1, pids, pl);
    memcpy(stage + ml + 1 + pl, ".tmp\x00", 5);
    _test_write_file(stage, "left by a crashed run");
    return stage;
}

# F-038: rollback printed "manifest row not found" for EVERY failed row
# removal and exited 0. When the rewrite itself failed — here a crashed
# run's staging file holding this pid's name — the row stayed in the
# manifest, its source had just been moved out of the package, and the
# verb reported `rolled back 1 / 1`.
fn test_rollback_reports_unremoved_manifest_row() {
    test_group("rollback: a manifest row it could not remove is an error");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _test_make_package(0, 0);
    var mpath = _fsl_path_join(pkg, "hapi.cyml");
    var home_file = _fsl_path_join(scope, ".zshrc");
    _test_write_file(home_file, "user content");
    assert_eq(cmd_adopt(".zshrc", pkg), 0, "adopt succeeds");

    var stage = _t111_plant_staging(mpath);
    assert_eq(manifest_append_link_row(mpath, "x", ".x"), 0 - HapiMfwStagingExists,
        "the writer names a staging leftover");
    assert_eq(cmd_rollback(), 1, "rollback exits 1 when the row stays behind");
    assert_eq(link_probe_kind(link_probe(home_file)), HAPI_LP_FILE, "the file is still restored");
    assert_eq(_test_links(mpath), 1, "the row is still there, as reported");

    hapi_unlink(stage);
    _test_clear_env();
    return 0;
}

# A package dir whose hapi.cyml is the `p` header plus `rows`.
fn _t111_pkg(rows): i64 { return _t111_pkg_at(_test_scratch_dir(), rows); }

fn _t111_pkg_at(pkg, rows): i64 {
    hapi_mkdir(pkg, 0x1ED);
    return _test_manifest_at(pkg, _test_cat(_test_hdr("p"), rows));
}

# F-045: scope containment was decided on the resolved path (F-015), but
# nothing asked whether the target resolves into the PACKAGE. With
# `~/.ssh -> <pkg>/ssh`, the row `ssh/config -> .ssh/config` names the
# row's own source as its target. `link` called it an existing regular
# file; `link --force` deleted the user's only copy, planted a symlink to
# itself, and reported `linked 1 / 1`. `adopt ~/.ssh/config` moved the
# package's file to a second name and left a dangling link in the package.
fn test_link_refuses_target_inside_package() {
    test_group("link / adopt: a target that resolves into the package is refused");

    var env = _test_fresh_env();
    var scope = load64(env);
    # The package lives INSIDE the scope, as a dotfiles repo in $HOME does —
    # otherwise the scope check refuses first and this test proves nothing.
    var pkg = _t111_pkg_at(_fsl_path_join(scope, "dotfiles"),
        "\n[[link]]\nsource = \"ssh/config\"\ntarget = \".ssh/config\"\n");
    hapi_mkdir(_fsl_path_join(pkg, "ssh"), 0x1ED);
    var src = _fsl_path_join(pkg, "ssh/config");
    _test_write_file(src, "only copy");
    assert_eq(hapi_symlink(_fsl_path_join(pkg, "ssh"), _fsl_path_join(scope, ".ssh")), 0,
        "~/.ssh is a symlink to the package's ssh/");

    assert_eq(cmd_link(pkg, 0), 1, "link refuses");
    assert_eq(cmd_link(pkg, 1), 1, "link --force refuses too");
    assert_eq(link_probe_kind(link_probe(src)), HAPI_LP_FILE, "the source is still a regular file");
    assert_eq(_test_file_size(src), 9, "with every byte");

    # Header only, so a duplicate-row refusal cannot stand in for this one.
    _test_write_file(_fsl_path_join(pkg, "hapi.cyml"), "[package]\nname = \"p\"\nversion = \"1.0.0\"\n");
    assert_eq(cmd_adopt(".ssh/config", pkg), 1, "adopt refuses the package's own file");
    assert_eq(link_probe_kind(link_probe(src)), HAPI_LP_FILE, "and leaves it where it was");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(pkg, "config"))), HAPI_LP_ABSENT,
        "no second copy in the package");

    _test_clear_env();
    return 0;
}

# `<scope>/.config -> data/deep/config`, one level deeper than `.config`
# itself, and a package with the row `rc -> .config/rc`.
fn _t111_deep_config(scope): i64 {
    var pkg = _t111_pkg("\n[[link]]\nsource = \"rc\"\ntarget = \".config/rc\"\n");
    _test_write_file(_fsl_path_join(pkg, "rc"), "rc-content");
    hapi_mkdir(_fsl_path_join(scope, "data"), 0x1ED);
    hapi_mkdir(_fsl_path_join(scope, "data/deep"), 0x1ED);
    hapi_mkdir(_fsl_path_join(scope, "data/deep/config"), 0x1ED);
    hapi_symlink("data/deep/config", _fsl_path_join(scope, ".config"));
    return pkg;
}

# F-046: the link text was computed from the target's LEXICAL parent. Under
# a symlinked parent at a different depth the link dangled, while `link`
# reported success, `status` said OK and a re-run said up to date.
fn test_link_text_from_physical_parent() {
    test_group("link: the link text is computed from where the link physically sits");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _t111_deep_config(scope);
    var tgt = _fsl_path_join(scope, ".config/rc");

    assert_eq(cmd_link(pkg, 0), 0, "link succeeds");
    assert_eq(_test_file_size(tgt), 10, "the link resolves to the source");
    assert_eq(cmd_status(pkg), 0, "status agrees");
    assert_eq(cmd_link(pkg, 0), 0, "a re-run is a no-op");
    assert_eq(cmd_unlink("p"), 0, "unlink succeeds");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_ABSENT, "and removes it");

    _test_clear_env();
    return 0;
}

# The other half of F-046: a link 1.1.0 wrote under a symlinked parent
# carries the lexical text. It is broken, `status` must now say so, and it
# is still hapi's — unlink removes it.
fn test_unlink_removes_a_legacy_link() {
    test_group("unlink: a link 1.1.0 wrote under a symlinked parent is still ours");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _t111_deep_config(scope);
    var tgt = _fsl_path_join(scope, ".config/rc");
    var abs_src = _fsl_path_join(pkg, "rc");
    var legacy = fsl_compute_relative(_fsl_path_dirname(tgt), abs_src);
    assert(hapi_cstr_eq(legacy, fsl_link_text(tgt, abs_src)) == 0, "the two texts differ here");
    assert_eq(hapi_symlink(legacy, tgt), 0, "a 1.1.0-shaped link is planted");
    var a_t, a_v = audit_append_link_r("p", "1.0.0", "sha1:0", "rc", ".config/rc", abs_src, tgt, 0);
    assert_eq(is_err_result(a_t), 0, "and recorded in the trail");

    assert_eq(cmd_status(pkg), 1, "status does not call the dangling link OK");
    assert_eq(cmd_unlink("p"), 0, "unlink accepts it as ours");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_ABSENT, "and removes it");

    _test_clear_env();
    return 0;
}

# `rows` naming one link whose target is `abs_target` written relative to
# the root "/" — what a manifest under `--root /` (or agnos's HOME=/) says.
fn _t111_root_row(source, abs_target): i64 {
    var a = "\n[[link]]\nsource = \"";
    var b = "\"\ntarget = \"";
    var c = "\"\n";
    var sl = strlen(source);
    var tl = strlen(abs_target) - 1;               # drop the leading '/'
    var out = alloc(strlen(a) + sl + strlen(b) + tl + strlen(c) + 1);
    var p = 0;
    memcpy(out + p, a, strlen(a)); p = p + strlen(a);
    memcpy(out + p, source, sl); p = p + sl;
    memcpy(out + p, b, strlen(b)); p = p + strlen(b);
    memcpy(out + p, abs_target + 1, tl); p = p + tl;
    memcpy(out + p, c, strlen(c)); p = p + strlen(c);
    store8(out + p, 0);
    return out;
}

# F-047: both containment helpers skipped their trailing-slash strip for a
# prefix of "/" (it would empty it) and then required a second '/' at
# path[1], so "/" contained nothing: `--root /` with HAPI_ALLOWED_ROOTS=/
# refused every row, and agnos — which stages HOME=/ — every row of every
# verb.
fn test_root_prefix_contains_everything() {
    test_group("cap: `/` as a scope or allowlist root contains every absolute path");

    assert_eq(_fsl_within("/p", "/"), 1, "/p is inside /");
    assert_eq(_fsl_within("/", "/"), 1, "/ is inside itself");
    assert_eq(_fsl_within("/p/q", "/"), 1, "the resolved-path helper agrees");
    assert_eq(_fsl_within("p", "/"), 0, "a relative path is not");

    var env = _test_fresh_env();
    var home = load64(env);
    link_set_scope_root("/");
    var tgt = _fsl_path_join(home, ".rc");
    var pkg = _t111_pkg(_t111_root_row("rc", tgt));
    _test_write_file(_fsl_path_join(pkg, "rc"), "rc-content");
    assert_eq(cmd_link(pkg, 0), 0, "link under scope / succeeds");
    assert_eq(_test_file_size(tgt), 10, "and the link resolves");
    assert_eq(cmd_unlink("p"), 0, "unlink under scope / succeeds");

    _test_clear_env();
    return 0;
}

# F-048: `check` tested a row's source for ABSENT alone, while `link` and
# `status` share fsl_source_present, which also refuses ERROR. A source
# that runs through a regular file (`f/sub`: ENOTDIR) passed `check` and
# was refused by `link` — whose message sends the user to `check`.
fn test_check_reports_source_through_a_file() {
    test_group("check: a row source through a regular file is reported");

    var pkg = _t111_pkg("\n[[link]]\nsource = \"f/sub\"\ntarget = \".sub\"\n");
    _test_write_file(_fsl_path_join(pkg, "f"), "a file, not a directory");
    assert_eq(cmd_check(pkg, 0), 1, "check reports it");
    return 0;
}

# F-049: link_probe split file from directory by opening the path O_RDONLY
# and trying getdents. A FIFO at a target blocked that open until a writer
# came — `link` and `status` hung — and any failed open read as FILE, so a
# mode-000 directory was reported as a regular file. Against the old probe
# the first assertion does not fail; it never returns.
fn test_link_probe_fifo_and_unreadable_dir() {
    test_group("fs_link: link_probe classifies a FIFO and a mode-000 directory");

    var d = _test_scratch_dir();
    var fifo = _fsl_path_join(d, "fifo");
    assert_eq(sys_mknodat(AT_FDCWD, fifo, 0x1000 | 0x1A4, 0), 0, "FIFO planted");
    assert_eq(link_probe_kind(link_probe(fifo)), HAPI_LP_FILE, "a FIFO is classified, without blocking");

    var locked = _fsl_path_join(d, "locked");
    hapi_mkdir(locked, 0x1ED);
    assert_eq(sys_chmod(locked, 0), 0, "directory made mode 000");
    assert_eq(link_probe_kind(link_probe(locked)), HAPI_LP_DIRECTORY, "still a directory");
    sys_chmod(locked, 0x1ED);
    return 0;
}

# F-051: `cap_check_root_r` granted `--root` on its spelling. `~/trap`
# with `trap -> /outside` read as "within $HOME"; every later check then
# resolved the target AND the scope root through `trap`, found the target
# contained, and wrote into /outside — `--force` deleted a file there.
fn test_root_grant_is_decided_physically() {
    test_group("cap: a --root reached through a symlink is granted where it resolves");

    var home = _test_scratch_dir();
    var outside = _test_scratch_dir();
    cap_set_home(home);
    cap_set_allowlist("");
    var trap = _fsl_path_join(home, "trap");
    hapi_symlink(outside, trap);
    var real = _fsl_path_join(home, "real");
    hapi_mkdir(real, 0x1ED);

    var r1_t, r1_v = cap_check_root_r(trap);
    assert_eq(is_err_result(r1_t), 1, "a symlinked --root leading out of $HOME is denied");
    var r2_t, r2_v = cap_check_root_r(real);
    assert_eq(is_err_result(r2_t), 0, "a real directory in $HOME is granted");
    cap_set_allowlist(outside);
    var r3_t, r3_v = cap_check_root_r(trap);
    assert_eq(is_err_result(r3_t), 0, "and the symlinked one is granted once its destination is");

    cap_set_allowlist(0);
    cap_set_home(0);
    return 0;
}

# F-052: the resolver lexically collapsed `..` before following symlinks,
# so `a/..` with `a -> /outside/deep` came out as the directory holding
# `a`; the kernel goes to `/outside`.
fn test_resolver_walks_dotdot_physically() {
    test_group("fs_link: `..` after a symlink resolves to the link target's parent");

    var home = _test_scratch_dir();
    var outside = _test_scratch_dir();
    var deep = _fsl_path_join(outside, "deep");
    hapi_mkdir(deep, 0x1ED);
    hapi_symlink(deep, _fsl_path_join(home, "a"));
    var r = fsl_resolve_path(_fsl_path_join(home, "a/../c.conf"));
    var want = _fsl_path_join(fsl_resolve_path(outside), "c.conf");
    assert(r != 0, "it resolves");
    if (r != 0) { assert_eq(hapi_cstr_eq(r, want), 1, "to the outside directory, as the kernel does"); }
    return 0;
}

# F-052 / F-054 at the verb: adopt took `a/../c.conf` (outside $HOME
# through `a`), and a granted path outside the scope root was sliced at the
# root's length — a SIGSEGV when shorter, a garbled row when longer.
fn test_adopt_refuses_dotdot_and_out_of_scope() {
    test_group("adopt: refuses a `..` path and a file outside the scope root");

    var env = _test_fresh_env();
    var scope = load64(env);
    var outside = _test_scratch_dir();
    var pkg = _t111_pkg("");
    var deep = _fsl_path_join(outside, "deep");
    hapi_mkdir(deep, 0x1ED);
    hapi_symlink(deep, _fsl_path_join(scope, "a"));
    var victim = _fsl_path_join(outside, "c.conf");
    _test_write_file(victim, "OUTSIDE");

    assert_eq(cmd_adopt("a/../c.conf", pkg), 1, "a `..` component is refused");
    assert_eq(link_probe_kind(link_probe(victim)), HAPI_LP_FILE, "the outside file is untouched");

    cap_set_allowlist(outside);
    assert_eq(cmd_adopt(victim, pkg), 1, "a granted path outside the scope root is refused, not sliced");
    assert_eq(link_probe_kind(link_probe(victim)), HAPI_LP_FILE, "and is untouched");
    cap_set_allowlist(0);

    _test_clear_env();
    return 0;
}

# F-055: only `link` proved the trail writable before mutating. unlink,
# rollback and adopt mutated first and appended after, so a torn tail (or
# an unwritable trail) left the change made and unrecorded.
fn test_reversal_verbs_preflight_the_trail() {
    test_group("unlink / rollback / adopt: an unwritable trail refuses before any change");

    var env = _test_fresh_env();
    var scope = load64(env);
    var trail = load64(env + 8);
    var pkg = _t111_pkg("\n[[link]]\nsource = \"a\"\ntarget = \".a\"\n");
    _test_write_file(_fsl_path_join(pkg, "a"), "a");
    var tgt = _fsl_path_join(scope, ".a");
    assert_eq(cmd_link(pkg, 0), 0, "linked");

    var fd = file_open(trail, O_WRONLY | O_APPEND, 0);
    file_write(fd, "{\"ts\":\"torn", 11);
    file_close(fd);

    # Through the CLI, so the refusal can be told apart: since 1.3.0 a
    # removal whose append fails is put back (F-061), which on disk looks
    # the same as never having been made. The pre-flight is what refuses
    # BEFORE anything is touched, and only its message says so.
    assert_eq(_cli_run(_cli_av("hapi unlink p")), 1, "unlink refuses on a torn tail");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_SYMLINK, "and the link is still there");
    assert(_test_substr(_cli_err, _cli_err_n, "audit trail is not writable; refusing to unlink") >= 0,
      "refused by the pre-flight, before the link was touched");
    assert_eq(_cli_run(_cli_av("hapi rollback")), 1, "rollback refuses on a torn tail");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_SYMLINK, "and the link is still there");
    assert(_test_substr(_cli_err, _cli_err_n, "audit trail is not writable; refusing to roll back") >= 0,
      "refused by the pre-flight, before the link was touched");

    var dot = _fsl_path_join(scope, ".zz");
    _test_write_file(dot, "user content");
    assert_eq(cmd_adopt(".zz", pkg), 1, "adopt refuses on a torn tail");
    assert_eq(link_probe_kind(link_probe(dot)), HAPI_LP_FILE, "and the file was not moved");

    _test_clear_env();
    return 0;
}

# F-056: with no marker, every rollback re-reversed the previous one's
# entries — 2, 4, 8 … reversals and a trail doubling per run.
fn test_rollback_is_idempotent() {
    test_group("rollback: a second run does nothing");

    var env = _test_fresh_env();
    var trail = load64(env + 8);
    var pkg = _t111_pkg("\n[[link]]\nsource = \"a\"\ntarget = \".a\"\n");
    _test_write_file(_fsl_path_join(pkg, "a"), "a");
    assert_eq(cmd_link(pkg, 0), 0, "linked");
    assert_eq(cmd_rollback(), 0, "first rollback");
    var n1 = _test_file_size(trail);
    assert_eq(cmd_rollback(), 0, "second rollback");
    assert_eq(_test_file_size(trail), n1, "wrote nothing");
    assert_eq(cmd_rollback(), 0, "third rollback");
    assert_eq(_test_file_size(trail), n1, "still nothing");

    _test_clear_env();
    return 0;
}

# F-057: containment is planned before any row is written, so a row
# beneath another row's target was judged while both were absent — then
# written through the outer row's freshly planted symlink.
fn test_link_refuses_nested_targets() {
    test_group("link: a target beneath another row's target is refused");

    var env = _test_fresh_env();
    var scope = load64(env);
    var outside = _test_scratch_dir();
    var outer = "\n[[link]]\nsource = \"escape\"\ntarget = \".x\"\n";
    var inner = "\n[[link]]\nsource = \"payload\"\ntarget = \".x/inner\"\n";
    var pkg = _t111_pkg(_test_cat(outer, inner));
    _test_write_file(_fsl_path_join(pkg, "payload"), "payload");
    hapi_symlink(outside, _fsl_path_join(pkg, "escape"));

    assert_eq(cmd_link(pkg, 0), 1, "link refuses");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".x"))), HAPI_LP_ABSENT, "nothing was planted");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(outside, "inner"))), HAPI_LP_ABSENT,
        "and nothing landed outside");

    _test_clear_env();
    return 0;
}

# F-053: a `./`-prefixed target kept its `.` in the lexical parent, so
# the link text climbed one directory too far and dangled — with `status`
# calling it OK. Computing from the resolved parent (F-046) drops it.
fn test_dot_slash_target_links_correctly() {
    test_group("link: a `./` target links to the source");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _t111_pkg("\n[[link]]\nsource = \"rc\"\ntarget = \"./.rc\"\n");
    _test_write_file(_fsl_path_join(pkg, "rc"), "rc-content");
    assert_eq(cmd_link(pkg, 0), 0, "link succeeds");
    assert_eq(_test_file_size(_fsl_path_join(scope, ".rc")), 10, "and the link resolves");
    assert_eq(cmd_status(pkg), 0, "status agrees");

    _test_clear_env();
    return 0;
}

# F-058: the manifest rewrite renames a staging file over hapi.cyml, which
# replaces a symlinked manifest with a private copy — the shared file it
# pointed to never got the row.
fn test_symlinked_manifest_is_not_rewritten() {
    test_group("manifest_write / adopt: a symlinked hapi.cyml is refused, not replaced");

    var env = _test_fresh_env();
    var scope = load64(env);
    var common = _t111_pkg("");
    var pkg = _test_scratch_dir();
    var mpath = _fsl_path_join(pkg, "hapi.cyml");
    hapi_symlink(_fsl_path_join(common, "hapi.cyml"), mpath);

    assert_eq(manifest_append_link_row(mpath, "n", ".n"), 0 - HapiMfwManifestIsSymlink,
        "the writer refuses a symlinked manifest");
    var dot = _fsl_path_join(scope, ".zz");
    _test_write_file(dot, "user content");
    assert_eq(cmd_adopt(".zz", pkg), 1, "adopt refuses it");
    assert_eq(link_probe_kind(link_probe(dot)), HAPI_LP_FILE, "before moving anything");
    assert_eq(link_probe_kind(link_probe(mpath)), HAPI_LP_SYMLINK, "and the manifest is still a link");

    _test_clear_env();
    return 0;
}

# ============================================================
# 1.1.0 — the `---` body delimiter (bayan 1.7 / 1.8 drift)
# ============================================================

# hapi reads only the CYML header (`cyml_doc_header`), so WHERE bayan splits
# header from body decides which [[link]] rows exist. cyrius 6.7.18 ships bayan
# 1.11.1, whose rule is: a delimiter is a whole `---` line, at byte 0 or after
# a `\n`, ending in `\n`, CR LF, or end of input. Under 6.6.20 (bayan 1.5.12)
# `---\r\n` and a final unterminated `---` were NOT delimiters, so a CRLF
# manifest's markdown body was parsed as manifest. Nothing in hapi noticed the
# rule move; these pin it, so the next bayan bump that moves it fails here.
var _TDL_HDR = "[package]\nname = \"p\"\nversion = \"1.0.0\"\n\n[[link]]\nsource = \"f\"\ntarget = \".f\"\n\n";

# `s` with every `\n` turned into CR LF (fresh buffer, NUL-terminated).
fn _tdl_crlf(s): i64 {
    var n = strlen(s);
    var out = alloc(n * 2 + 1);
    var i = 0;
    var o = 0;
    while (i < n) {
        if (load8(s + i) == 10) { store8(out + o, 13); o = o + 1; }
        store8(out + o, load8(s + i));
        o = o + 1;
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

fn _tdl_hdr_crlf(): i64 { return _tdl_crlf(_TDL_HDR); }

# Write `hdr` then `rest` as a fresh scratch hapi.cyml; return its path.
fn _tdl_manifest(hdr, rest): i64 {
    var dir = _test_manifest_at(_test_scratch_dir(), _test_cat(hdr, rest));
    return _fsl_path_join(dir, "hapi.cyml");
}

fn test_manifest_body_delimiter_reader() {
    test_group("manifest: `---` body delimiter (bayan reader pin)");

    assert_eq(_test_links(_tdl_manifest(_TDL_HDR, "---\n# notes\n")), 1, "LF body is not parsed");
    assert_eq(_test_links(_tdl_manifest(_TDL_HDR, "---\n")), 1, "LF delimiter with an empty body parses");
    assert_eq(_test_links(_tdl_manifest(_TDL_HDR, "---\n[[link]]\nsource = \"g\"\ntarget = \".g\"\n")), 1,
      "a [[link]] in an LF body is not a row");
    assert_eq(_test_links(_tdl_manifest(_tdl_hdr_crlf(),
      "---\r\n[[link]]\r\nsource = \"g\"\r\ntarget = \".g\"\r\n")), 1,
      "a [[link]] in a CRLF body is not a row (6.6.20 counted it)");
    assert_eq(_test_links(_tdl_manifest(_TDL_HDR, "---")), 1, "a final unterminated --- parses");
    assert_eq(_test_links(_tdl_manifest(_TDL_HDR, "--- notes\n[[link]]\nsource = \"g\"\ntarget = \".g\"\n")), 2,
      "--- followed by text is not a delimiter");
    return 0;
}

# The writer must agree with the reader on where the header ends. Through
# 1.0.12 `_hmw_find_separator` knew only `---\n`, so on a manifest whose
# delimiter is `---\r\n` or an unterminated final `---` it found NONE and
# appended at EOF — below the delimiter, in the body, where the 6.7.18 reader
# does not look. `adopt` would move the file in, plant the link, write the
# trail entry, and record a row nothing could ever read (F-028's shape).
fn test_manifest_append_lands_in_header() {
    test_group("manifest_write: append lands above the `---` the reader sees");

    var lf = _tdl_manifest(_TDL_HDR, "---\n[[link]]\nsource = \"g\"\ntarget = \".g\"\n");
    assert_eq(manifest_append_link_row(lf, "n", ".n"), 0, "LF: append succeeds");
    assert_eq(_test_links(lf), 2, "LF: the appended row is read");

    var crlf = _tdl_manifest(_tdl_hdr_crlf(), "---\r\n# notes\r\n");
    assert_eq(manifest_append_link_row(crlf, "n", ".n"), 0, "CRLF: append succeeds");
    assert_eq(_test_links(crlf), 2, "CRLF: the appended row is read");

    var eof = _tdl_manifest(_TDL_HDR, "---");
    assert_eq(manifest_append_link_row(eof, "n", ".n"), 0, "final ---: append succeeds");
    assert_eq(_test_links(eof), 2, "final ---: the appended row is read");

    var eof_cr = _tdl_manifest(_tdl_hdr_crlf(), "---\r");
    assert_eq(manifest_append_link_row(eof_cr, "n", ".n"), 0, "final ---CR: append succeeds");
    assert_eq(_test_links(eof_cr), 2, "final ---CR: the appended row is read");

    # `--- notes` is header text, so the row goes at EOF and is still read.
    var not_delim = _tdl_manifest(_TDL_HDR, "--- notes\n");
    assert_eq(manifest_append_link_row(not_delim, "n", ".n"), 0, "--- text: append succeeds");
    assert_eq(_test_links(not_delim), 2, "--- text: the appended row is read");
    return 0;
}

# Remove scanned the WHOLE file, body included. A [[link]] written as an
# example in the markdown body is not a row, but remove would match it,
# delete the prose, and report success while the reader saw no change.
fn test_manifest_remove_ignores_body() {
    test_group("manifest_write: remove never edits the body");

    var path = _tdl_manifest(_TDL_HDR, "---\n[[link]]\nsource = \"g\"\ntarget = \".g\"\n");
    var before = 0;
    var b0 = _hmw_slurp(path, &before);
    assert(manifest_remove_link_row(path, "g", ".g") < 0, "a body-only row is not found");
    var after = 0;
    var b1 = _hmw_slurp(path, &after);
    assert_eq(after, before, "the file is unchanged");
    assert(_test_substr(b1, after, "source = \"g\"") >= 0, "the body example survives");

    var crlf = _tdl_manifest(_tdl_hdr_crlf(), "---\r\n[[link]]\r\nsource = \"g\"\r\ntarget = \".g\"\r\n");
    assert(manifest_remove_link_row(crlf, "g", ".g") < 0, "CRLF: a body-only row is not found");
    assert_eq(manifest_remove_link_row(crlf, "f", ".f"), 0, "CRLF: a header row is removed");
    assert_eq(_test_links(crlf), 0, "CRLF: the header row is gone");
    return 0;
}

# ============================================================
# 1.0.10 — the agnos-conditional pair (F-027, F-031)
# ============================================================

# F-031: agnos's AO_* open-flag set has no no-follow bit at all, so
# `lib/io.cyr`'s bridge silently DROPPED O_NOFOLLOW and F-003's
# backup-copy TOCTOU defence did not exist there — an attacker who
# swapped the file for a symlink got the symlink's target content
# written into the "snapshot", returning 0 as though it worked.
# `hapi_open_nofollow` centralizes it: atomic O_NOFOLLOW on Linux/macOS,
# a readlink pre-check on agnos. This asserts the Linux arm; the agnos
# arm is covered by scripts/agnos-smoke.sh under mirshi.
fn test_open_nofollow_refuses_symlink() {
    test_group("agnos_compat: no-follow open refuses a symlink");

    var env = _test_fresh_env();
    var scope = load64(env);

    var real = _fsl_path_join(scope, "real");
    var fd = file_open(real, 0x241, 0x1A4);
    file_write(fd, "bytes", 5);
    file_close(fd);

    # A regular file opens.
    var ok = hapi_open_nofollow(real, O_RDONLY);
    assert(ok >= 0, "a regular file opens");
    file_close(ok);

    # A symlink to it does NOT — that is the whole defence.
    var lnk = _fsl_path_join(scope, "lnk");
    assert_eq(hapi_symlink(real, lnk), 0, "symlink created");
    assert(hapi_open_nofollow(lnk, O_RDONLY) < 0, "a symlink is refused");

    # And the backup copy, which rides it, still refuses a symlink source
    # (F-003's standing guarantee, now routed through the shim).
    assert(hapi_backup_copy(lnk, _fsl_path_join(scope, "snap")) < 0,
      "backup_copy refuses a symlink source");

    _test_clear_env();
    return 0;
}

# ============================================================
# 1.0.9 — Tier 2 / Tier 3 batch
# ============================================================

# F-020: `[package].name` is validated only for non-emptiness, so it is
# PACKAGE-chosen input to the --backup-to destination path. A name of
# `../../../pwned` put the snapshot ABOVE the directory the user named.
fn test_backup_tag_is_sanitized() {
    test_group("backup: package name cannot steer the destination");

    var evil = _hbk_safe_tag("../../../pwned");
    assert(evil != 0, "tag produced");
    var i = 0;
    var seps = 0;
    while (i < strlen(evil)) {
        if (load8(evil + i) == 47) { seps = seps + 1; }
        i = i + 1;
    }
    assert_eq(seps, 0, "no path separator survives");
    assert(load8(evil) != 46, "cannot begin with a dot");
    assert_eq(hapi_cstr_eq(_hbk_safe_tag("plain-pkg_1.0"), "plain-pkg_1.0"), 1,
      "an ordinary name is untouched");
    assert_eq(hapi_cstr_eq(_hbk_safe_tag(0), "pkg"), 1, "a null name falls back");

    # End to end: the composed path stays under the user's directory.
    var env = _test_fresh_env();
    var scope = load64(env);
    var bk = _fsl_path_join(scope, "bk");
    var composed = hapi_backup_compose_path(bk, "../../../pwned",
      _fsl_path_join(scope, ".f"));
    assert_eq(_fsl_within(composed, bk), 1, "snapshot stays inside the named directory");
    _test_clear_env();
    return 0;
}

# F-024: an unnormalized package-dir argument produced a `./`-bearing
# symlink body, which every later canonical run called a conflict — so
# `sync`, whose contract IS idempotence, refused with exit 1.
fn test_canonical_arg_normalizes() {
    test_group("cap: a package-dir argument is canonicalized");

    var env = _test_fresh_env();
    var scope = load64(env);
    var messy = _fsl_path_join(scope, "./a/../b//c");
    var clean = fsl_canonical_arg(messy);
    assert_eq(hapi_cstr_eq(clean, _fsl_path_join(scope, "b/c")), 1,
      "`.`, `..` and `//` all collapse");
    assert_eq(hapi_cstr_eq(fsl_canonical_arg(scope), scope), 1,
      "an already-clean path is unchanged");
    _test_clear_env();
    return 0;
}

# F-032: a manifest target ending in `/` can never be created by
# symlink(2), but mkdir_parents had already materialized the directory —
# so a correctly-refused run still left residue behind.
fn test_link_create_refuses_trailing_slash() {
    test_group("fs_link: a trailing-slash target leaves no residue");

    var env = _test_fresh_env();
    var scope = load64(env);
    var bad = _fsl_path_join(scope, "resid/");
    assert(link_create("../src", bad) < 0, "trailing slash refused");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, "resid"))),
      HAPI_LP_ABSENT, "no directory was created");
    _test_clear_env();
    return 0;
}

# F-029: parent directories hapi creates in the user's scope should look
# like ones the user made — 0777 through their umask. hapi's own state
# directories must stay private regardless.
fn test_mkdir_parents_mode_split() {
    test_group("fs_link: created-parent mode is caller-chosen");

    var env = _test_fresh_env();
    var scope = load64(env);

    # A reference directory made at 0777 shows what this umask yields.
    var ref = _fsl_path_join(scope, "ref");
    hapi_mkdir(ref, 0x1FF);
    var st = alloc(STAT_BUFSZ);
    assert(xstat(ref, st) >= 0, "reference stat");
    var ref_mode = load64(st + STAT_MODE) & 0xFFF;

    var umaskd = _fsl_path_join(scope, "u/deep/f");
    assert_eq(fsl_mkdir_parents_mode(umaskd, 0x1FF), 0, "0777 parents created");
    assert(xstat(_fsl_path_join(scope, "u"), st) >= 0, "stat umask dir");
    assert_eq(load64(st + STAT_MODE) & 0xFFF, ref_mode, "matches 0777-through-umask");

    var privd = _fsl_path_join(scope, "p/deep/f");
    assert_eq(fsl_mkdir_parents(privd), 0, "private parents created");
    assert(xstat(_fsl_path_join(scope, "p"), st) >= 0, "stat private dir");
    assert_eq(load64(st + STAT_MODE) & 0xFFF, 0x1C0, "stays 0700 regardless of umask");

    # And `link_create` — the user-facing path — must actually ASK for
    # the umask mode. Asserting the primitive alone leaves the call site
    # free to keep passing 0700, which is exactly what F-029 was.
    var viacreate = _fsl_path_join(scope, "viacreate/deep/lnk");
    assert_eq(link_create("../../../ref", viacreate), 0, "link_create makes parents");
    assert(xstat(_fsl_path_join(scope, "viacreate"), st) >= 0, "stat link_create dir");
    assert_eq(load64(st + STAT_MODE) & 0xFFF, ref_mode,
      "link_create parents follow umask, not a hardcoded 0700");
    _test_clear_env();
    return 0;
}

# F-018: the trail was appended without fsync and with no torn-tail
# guard, and the append happened AFTER the filesystem mutation — so a
# failed append left a symlink no recovery verb could see.
fn test_audit_durable_append_and_preflight() {
    test_group("audit: durable append refuses a torn tail");

    var env = _test_fresh_env();
    var audit_path = load64(env + 8);
    audit_ensure_dir();

    # A healthy trail pre-flights clean and appends.
    assert_eq(is_err_result(audit_preflight_r()), 0, "empty trail pre-flights");
    assert_eq(is_err_result(audit_append_rollback_marker_r()), 0, "marker appends");

    # A trail whose last byte is not `\n` is a torn write: appending onto
    # it would splice two entries into one line and the reader would drop
    # BOTH. Refuse instead.
    var fd = file_open(audit_path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    file_write(fd, "{\"op\":\"link\",\"pkg\":\"a\"}\n{\"op\":\"link\",\"pkg\":\"tor", 45);
    file_close(fd);
    assert_eq(is_err_result(audit_preflight_r()), 1, "torn tail fails pre-flight");
    assert_eq(is_err_result(audit_append_rollback_marker_r()), 1, "and refuses the append");

    _test_clear_env();
    return 0;
}

# ============================================================
# 1.0.8 — the resolved capability boundary (F-015 / F-002)
# ============================================================

# F-015: `fsl_lexical_normalize` collapses `..` but treats every
# component as a plain name, so an ordinary convenience symlink —
# `~/.config -> /mnt/other/etc` — put a manifest target outside the
# scope root on a PLAIN `hapi link`, no flag involved. `--force` then
# deleted whatever was there, and `status` reported the result OK.
fn test_resolve_path_follows_intermediate_symlinks() {
    test_group("cap: path resolution follows a symlinked component");

    var env = _test_fresh_env();
    var scope = load64(env);

    # scope/outside/  and  scope/link -> scope/outside
    var outside = _fsl_path_join(scope, "outside");
    fsl_mkdir_parents(_fsl_path_join(outside, "x"));
    var linkdir = _fsl_path_join(scope, "linkdir");
    assert_eq(hapi_symlink(outside, linkdir), 0, "component symlink created");

    # A path THROUGH the symlink resolves to its physical location.
    var through = _fsl_path_join(linkdir, "foo");
    var resolved = fsl_resolve_path(through);
    assert(resolved != 0, "resolution succeeds");
    assert_eq(hapi_cstr_eq(resolved, _fsl_path_join(outside, "foo")), 1,
      "resolves through the symlinked component");

    # A component that does not exist yet is kept literally — hapi
    # creates parent directories, so an absent parent is routine.
    var absent = _fsl_path_join(scope, "nope/deeper");
    assert_eq(hapi_cstr_eq(fsl_resolve_path(absent), absent), 1,
      "absent components are kept literally");

    _test_clear_env();
    return 0;
}

fn test_cap_target_allowed_resolves() {
    test_group("cap: target containment is decided physically");

    var env = _test_fresh_env();
    var scope = load64(env);
    cap_set_home(scope);

    # An escape hatch OUTSIDE the scope root entirely: a scratch
    # directory of its own (a fixed /tmp name through 1.7.0).
    var out = _test_scratch_dir();
    fsl_mkdir_parents(_fsl_path_join(out, "x"));
    var escape = _fsl_path_join(scope, "escape");
    assert_eq(hapi_symlink(out, escape), 0, "escaping symlink created");

    # Lexically `scope/escape` looks contained; physically it is not.
    assert_eq(cap_within_scope(escape, scope), 1, "lexically inside");
    assert_eq(cap_target_allowed(escape, scope), 0, "physically outside — refused");

    # An ordinary in-scope directory is allowed.
    var inside = _fsl_path_join(scope, "plain");
    fsl_mkdir_parents(_fsl_path_join(inside, "x"));
    assert_eq(cap_target_allowed(inside, scope), 1, "in-scope parent allowed");

    # HAPI_ALLOWED_ROOTS is the grant that authorizes the destination.
    # `--root` is NOT: it re-roots every target, a different operation.
    cap_set_allowlist(out);
    assert_eq(cap_target_allowed(escape, scope), 1, "allowlisted destination permitted");
    cap_set_allowlist(0);
    assert_eq(cap_target_allowed(escape, scope), 0, "refused again once the grant is gone");

    cap_set_home(0);
    _test_clear_env();
    return 0;
}

fn test_link_refuses_symlinked_component_escape() {
    test_group("link: refuses an escape --force cannot override");

    var env = _test_fresh_env();
    var scope = load64(env);
    cap_set_home(scope);

    # Outside the scope: a scratch directory of its own. Through 1.7.0
    # it was a fixed /tmp name, so two runs at once removed each other's
    # PRECIOUS file between its write and the check that it survived.
    var out = _test_scratch_dir();
    fsl_mkdir_parents(_fsl_path_join(out, "x"));
    var precious = _fsl_path_join(out, "zshrc");
    var pf = file_open(precious, 0x241, 0x1A4);
    file_write(pf, "PRECIOUS", 8);
    file_close(pf);

    # ~/.config -> that directory, outside the scope
    var cfg = _fsl_path_join(scope, ".config");
    assert_eq(hapi_symlink(out, cfg), 0, "convenience symlink created");

    var pkg = _test_make_package("zshrc", ".config/zshrc");

    assert_eq(cmd_link(pkg, 0), 1, "plain link refuses the escape");
    # --force must NOT override it: following that advice is what
    # destroyed the file before 1.0.8.
    assert_eq(cmd_link(pkg, 1), 1, "--force does not override the escape");
    assert_eq(link_probe_kind(link_probe(precious)), HAPI_LP_FILE,
      "the file outside the scope is untouched");

    # Nothing was recorded either.
    var tr_t, tr_v = audit_read_default_r();
    assert_eq(is_err_result(tr_t), 0, "trail readable");
    assert_eq(vec_len(tr_v), 0, "no audit entry for a refused escape");

    hapi_unlink(precious);
    cap_set_home(0);
    _test_clear_env();
    return 0;
}

# ============================================================
# 1.0.7 — manifest write-path integrity (F-021, F-028)
# ============================================================

# F-021: the manifest writer wrote source/target raw, so a filename
# containing a quote produced `source = "ev"il"` and the parser read it
# back as `ev` — hapi's declared state describing a file that does not
# exist, at exit 0. Escaping cannot fix it: the parser's
# `\`-skips-the-next-byte rule never strips the backslash, so there is
# no un-escape half to mirror (adding one would change how every
# existing manifest parses — ADR 0001, so v2.0). hapi refuses instead.
fn test_manifest_write_refuses_unrepresentable() {
    test_group("manifest_write: refuses a value hapi.cyml cannot represent");

    var env = _test_fresh_env();
    var pkg = _test_make_package(0, 0);
    var mpath = _fsl_path_join(pkg, "hapi.cyml");

    var quoted = alloc(8);
    memcpy(quoted, "ev", 2); store8(quoted + 2, 34);      # "
    memcpy(quoted + 3, "il", 2); store8(quoted + 5, 0);
    assert_eq(manifest_append_link_row(mpath, quoted, ".ok"),
      0 - HapiMfwUnrepresentable, "quote in source refused");
    assert_eq(manifest_append_link_row(mpath, "ok", quoted),
      0 - HapiMfwUnrepresentable, "quote in target refused");

    var backslash = alloc(6);
    memcpy(backslash, "a", 1); store8(backslash + 1, 92); # \
    memcpy(backslash + 2, "b", 1); store8(backslash + 3, 0);
    assert_eq(manifest_append_link_row(mpath, backslash, ".ok"),
      0 - HapiMfwUnrepresentable, "backslash refused");

    var newline = alloc(6);
    memcpy(newline, "a", 1); store8(newline + 1, 10);     # \n
    memcpy(newline + 2, "b", 1); store8(newline + 3, 0);
    assert_eq(manifest_append_link_row(mpath, newline, ".ok"),
      0 - HapiMfwUnrepresentable, "newline refused");

    # An ordinary row still writes.
    assert_eq(manifest_append_link_row(mpath, "plain", ".plain"), 0,
      "an ordinary row still appends");

    # And adopt refuses BEFORE moving anything.
    var scope = load64(env);
    var evil = alloc(strlen(scope) + 12);
    memcpy(evil, scope, strlen(scope));
    var ep = strlen(scope);
    memcpy(evil + ep, "/.q", 3); ep = ep + 3;
    store8(evil + ep, 34); ep = ep + 1;                   # "
    memcpy(evil + ep, "x", 1); ep = ep + 1;
    store8(evil + ep, 0);
    var fd = file_open(evil, 0x241, 0x1A4);
    assert(fd >= 0, "fixture file with a quote created");
    file_write(fd, "z", 1);
    file_close(fd);
    assert_eq(cmd_adopt(evil, pkg), 1, "adopt refuses an unrepresentable name");
    assert_eq(link_probe_kind(link_probe(evil)), HAPI_LP_FILE,
      "the file was not moved");

    hapi_unlink(evil);
    _test_clear_env();
    return 0;
}

# F-028 (detection half): `adopt` renames the file into the package
# BEFORE writing the row, so an interrupt in that window leaves the
# dotfile in the package with no row, no symlink and no trail entry —
# invisible to every verb that starts from manifest rows. `hapi check`
# now walks the package directory and reports the divergence both ways.
fn test_check_detects_manifest_package_divergence() {
    test_group("check: reports manifest/package divergence");

    var env = _test_fresh_env();
    # A package with a real row AND its source file on disk — the two
    # sides must agree before we can meaningfully diverge them.
    var pkg = _test_make_package("zshrc", ".zshrc");

    # Healthy package agrees with its manifest.
    assert_eq(cmd_check(pkg, 0), 0, "a healthy package checks clean");

    # The crash orphan: a file in the package that no row claims.
    var orphan = _fsl_path_join(pkg, "orphaned-by-crash");
    var fd = file_open(orphan, 0x241, 0x1A4);
    file_write(fd, "stranded", 8);
    file_close(fd);
    assert_eq(cmd_check(pkg, 0), 1, "an unclaimed package file is reported");

    # A staging leftover is not package content and must not be flagged.
    hapi_unlink(orphan);
    var stage = _fsl_path_join(pkg, "hapi.cyml.4242.tmp");
    var sfd = file_open(stage, 0x241, 0x1A4);
    file_write(sfd, "x", 1);
    file_close(sfd);
    assert_eq(cmd_check(pkg, 0), 0, "a .tmp staging leftover is not an orphan");
    hapi_unlink(stage);

    # The other direction: a row whose source has vanished.
    hapi_unlink(_fsl_path_join(pkg, "zshrc"));
    assert_eq(cmd_check(pkg, 0), 1, "a row with a missing source is reported");

    _test_clear_env();
    return 0;
}

# ============================================================
# 1.0.5 P(-1) — buffer-bound regressions (F-014, F-008)
# ============================================================

# F-009: _hmw_slurp read into a fixed alloc(262144) and stopped at the
# cap with no signal, and both callers hand the buffer straight to
# _hmw_write_atomic — so `adopt` on a manifest past 256 KB committed the
# truncation via tmp+rename and permanently destroyed everything beyond
# it at exit 0. ADR 0001 sanctions an arbitrarily long markdown body, so
# that size is reachable without doing anything unusual.
fn test_manifest_write_preserves_large_body() {
    test_group("manifest_write: a manifest past 256 KB survives a row append");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _test_make_package(0, 0);
    var mpath = _fsl_path_join(pkg, "hapi.cyml");

    # Append a >256 KB markdown body below the ADR 0001 `---` separator,
    # ending in a marker that must survive the rewrite.
    var fd = file_open(mpath, O_WRONLY | 1024, 0x1A4);   # O_APPEND
    assert(fd >= 0, "manifest opened for append");
    file_write(fd, "\n---\n", 5);
    var chunk = alloc(4097);
    var i = 0;
    while (i < 4096) { store8(chunk + i, 120); i = i + 1; }   # 'x'
    store8(chunk + 4096, 0);
    var w = 0;
    while (w < 70) { file_write(fd, chunk, 4096); w = w + 1; }  # ~287 KB
    file_write(fd, "\nTAIL-MARKER\n", 13);
    file_close(fd);

    var before = 0;
    var raw = _hmw_slurp(mpath, &before);
    assert(raw != 0, "slurp succeeds on a large manifest");
    assert(before > 262144, "fixture really is past the old 256 KB cap");

    # The append must preserve every byte of the body.
    var rc = manifest_append_link_row(mpath, "newsrc", ".newtgt");
    assert_eq(rc, 0, "row append succeeds");

    var after = 0;
    var raw2 = _hmw_slurp(mpath, &after);
    assert(raw2 != 0, "re-slurp succeeds");
    assert(after > before, "manifest grew rather than being truncated");
    assert(_test_substr(raw2, after, "TAIL-MARKER") >= 0, "body tail survived");
    assert(_test_substr(raw2, after, "newsrc") >= 0, "new row landed");

    _test_clear_env();
    return 0;
}

# F-010: the backup filename is <ts>-<pkg>-<basename>, so two manifest
# rows whose targets share a basename compose the SAME destination
# inside one second. The second copy overwrote the first — destroying
# exactly the bytes --force was about to delete — while both audit
# entries recorded the surviving path.
fn test_backup_disambiguates_colliding_basenames() {
    test_group("backup: colliding basenames get distinct snapshots");

    var env = _test_fresh_env();
    var scope = load64(env);
    var bkdir = _fsl_path_join(scope, "bk");

    # Two different sources that share a basename.
    var da = _fsl_path_join(scope, "a");
    var db = _fsl_path_join(scope, "b");
    fsl_mkdir_parents(_fsl_path_join(da, "x"));
    fsl_mkdir_parents(_fsl_path_join(db, "x"));
    var fa = _fsl_path_join(da, "config");
    var fb = _fsl_path_join(db, "config");
    var f1 = file_open(fa, 0x241, 0x1A4); file_write(f1, "AAAA", 4); file_close(f1);
    var f2 = file_open(fb, 0x241, 0x1A4); file_write(f2, "BBBB", 4); file_close(f2);

    var p1 = hapi_backup_compose_path(bkdir, "pkg", fa);
    assert_eq(hapi_backup_copy(fa, p1), 0, "first snapshot written");
    var p2 = hapi_backup_compose_path(bkdir, "pkg", fb);
    assert_eq(hapi_backup_copy(fb, p2), 0, "second snapshot written");

    # Distinct destinations, and both originals recoverable.
    assert_eq(hapi_cstr_eq(p1, p2), 0, "colliding basenames compose distinct paths");
    assert_eq(link_probe_kind(link_probe(p1)), HAPI_LP_FILE, "first snapshot still present");
    assert_eq(link_probe_kind(link_probe(p2)), HAPI_LP_FILE, "second snapshot present");

    # O_EXCL backstop: copying onto an existing destination refuses.
    assert(hapi_backup_copy(fa, p1) < 0, "copy onto an existing snapshot refuses");

    _test_clear_env();
    return 0;
}

# F-014: hapi_mf_canonicalize accepted `cap` and never read it, so a
# manifest whose canonical form outgrew the caller's buffer overflowed
# the bump heap into the live `sorted` vec and took link / sync / adopt
# down with SIGSEGV (exit 139, outside the documented 0/1/2 contract) —
# `--dry-run` included, because the hash is computed before the dry-run
# branch. It must now refuse, and must not write past `cap`.
fn test_canonicalize_honours_cap() {
    test_group("canonical: canonicalize refuses rather than overflowing");

    var src = "[package]\nname = \"p\"\nversion = \"1.0.0\"\n\n[[link]]\nsource = \"s\"\ntarget = \".t\"\n";
    var t, v = hapi_mf_parse_header_r(src, strlen(src));
    assert_eq(is_err_result(t), 0, "fixture manifest parses");
    var m = v;

    # Full-size run establishes the true length.
    var big = alloc(65536);
    var full = hapi_mf_canonicalize(m, big, 65536);
    assert(full > 0, "canonicalizes at full size");

    # A buffer one byte short must refuse, not truncate and not write.
    # Guard bytes on both sides of an exactly-sized-minus-one buffer
    # prove nothing was written past the cap.
    var small = alloc(full + 16);
    var i = 0;
    while (i < full + 16) { store8(small + i, 170); i = i + 1; }   # 0xAA
    var n = hapi_mf_canonicalize(m, small, full - 1);
    assert_eq(n, 0 - 1, "refuses with -1 when the canonical form does not fit");
    var clean = 1;
    i = full - 1;
    while (i < full + 16) {
        if (load8(small + i) != 170) { clean = 0; }
        i = i + 1;
    }
    assert_eq(clean, 1, "wrote nothing at or past cap");

    # Exactly-sized buffer still succeeds and is byte-identical to the
    # full-size run — the ADR 0002 sha1c: preimage must not shift.
    var exact = alloc(full);
    var n2 = hapi_mf_canonicalize(m, exact, full);
    assert_eq(n2, full, "exact-size buffer succeeds");
    assert_eq(memeq(exact, big, full), 1, "canonical bytes unchanged");

    # The sizing hint must never under-estimate the real length.
    assert(hapi_mf_canonical_size(m) >= full, "size hint bounds the canonical form");
    return 0;
}

# F-008: the audit entry composers accepted `cap` and never read it, so
# a long manifest target composed past the fixed alloc(4096) — writing
# attacker-sized bytes into the heap and splicing a NUL into the trail
# line, which made the whole trail unreadable while `link` exited 0.
fn test_audit_entry_honours_cap() {
    test_group("audit: entry composer refuses rather than overflowing");

    var buf = alloc(4096);
    var full = audit_format_link(buf, 4096, "pkg", "1.0", "h",
      "src", ".tgt", "/abs/src", "/abs/tgt", 0);
    assert(full > 0, "composes at full size");

    var small = alloc(full + 16);
    var i = 0;
    while (i < full + 16) { store8(small + i, 170); i = i + 1; }
    var n = audit_format_link(small, full - 1, "pkg", "1.0", "h",
      "src", ".tgt", "/abs/src", "/abs/tgt", 0);
    assert_eq(n, 0 - 1, "refuses with -1 when the entry does not fit");
    var clean = 1;
    i = full - 1;
    while (i < full + 16) {
        if (load8(small + i) != 170) { clean = 0; }
        i = i + 1;
    }
    assert_eq(clean, 1, "wrote nothing at or past cap");

    # The marker composer shares the bound.
    var mk = alloc(256);
    assert(audit_format_rollback_marker(mk, 256) > 0, "marker composes");
    assert_eq(audit_format_rollback_marker(mk, 8), 0 - 1, "marker refuses when short");

    # Sizing hint must bound a value that needs 6:1 control-byte escaping.
    var ctrl = alloc(33);
    i = 0;
    while (i < 32) { store8(ctrl + i, 1); i = i + 1; }   # 32x 0x01
    store8(ctrl + 32, 0);
    var cap = audit_entry_size("pkg", "1.0", "h", "src", ctrl, "/a", "/b", 0);
    var wide = alloc(cap);
    var wn = audit_format_link(wide, cap, "pkg", "1.0", "h",
      "src", ctrl, "/a", "/b", 0);
    assert(wn > 0, "sized buffer composes an escape-heavy entry");
    assert(cap >= wn, "size hint bounds the escaped entry");
    return 0;
}

# ============================================================
# M7 — manifest-hash canonicalization (sha1: → sha1c:)
# ============================================================

# Hash the canonical form of a literal manifest source. Returns
# a heap cstring "sha1c:" + 40 hex on success, 0 on parse failure.
fn _test_canonical_hash_of(src): i64 {
    var t, v = hapi_mf_parse_header_r(src, strlen(src));
    if (is_err_result(t) == 1) { return 0; }
    var m = v;
    var cap = hapi_mf_canonical_size(m);
    var buf = alloc(cap);
    var n = hapi_mf_canonicalize(m, buf, cap);
    if (n <= 0) { return 0; }
    var digest[20];
    sha1(buf, n, &digest);
    var out = alloc(47);
    memcpy(out, "sha1c:", 6);
    _audit_hex(out + 6, &digest, 20);
    store8(out + 46, 0);
    return out;
}

fn test_canonical_hash_prefix() {
    test_group("canonical: writer emits sha1c: prefix");

    # Use the shipped example manifest so we don't depend on a
    # filesystem path that may not exist in CI.
    var h = audit_manifest_hash("docs/examples/dotfiles-zsh/hapi.cyml");
    assert(h != 0, "hash computed");
    # Must start with "sha1c:" — 6 bytes.
    var prefix = "sha1c:";
    assert_eq(memeq(h, prefix, 6), 1, "prefix is sha1c:");
    assert_eq(strlen(h), 46, "total length is sha1c: + 40 hex chars");
    return 0;
}

fn test_canonical_hash_ignores_comments_and_whitespace() {
    test_group("canonical: cosmetic edits collide");

    var a = "[package]\nname = \"x\"\nversion = \"1.0\"\n[[link]]\nsource = \"s\"\ntarget = \".t\"\n";
    # Kept as an escaped one-liner on purpose: this fixture's whole job is
    # to carry cosmetic noise — trailing whitespace after `# inline`, and a
    # two-blank-line run — and a real multi-line literal cannot hold either
    # without tripping the very lint rules the fixture exists to be immune
    # to.
    var b = "# a leading comment\n\n[package]\n   # inline   \nname    =    \"x\"\nversion = \"1.0\"\n\n\n[[link]]\nsource = \"s\"\ntarget = \".t\"\n\n";   #skip-lint
    var ha = _test_canonical_hash_of(a);
    var hb = _test_canonical_hash_of(b);
    assert(ha != 0, "a hashes");
    assert(hb != 0, "b hashes");
    assert_eq(hapi_cstr_eq(ha, hb), 1, "comments + whitespace yield identical hash");
    return 0;
}

fn test_canonical_hash_row_reorder_collides() {
    test_group("canonical: row order does not affect hash");

    var a = "[package]
name = \"x\"
version = \"1.0\"
[[link]]
source = \"a\"
target = \".a\"
[[link]]
source = \"b\"
target = \".b\"
";
    var b = "[package]
name = \"x\"
version = \"1.0\"
[[link]]
source = \"b\"
target = \".b\"
[[link]]
source = \"a\"
target = \".a\"
";
    var ha = _test_canonical_hash_of(a);
    var hb = _test_canonical_hash_of(b);
    assert_eq(hapi_cstr_eq(ha, hb), 1, "rows reordered yield identical hash");
    return 0;
}

fn test_canonical_hash_value_change_diverges() {
    test_group("canonical: semantic edit changes the hash");

    var a = "[package]\nname = \"x\"\nversion = \"1.0\"\n[[link]]\nsource = \"s\"\ntarget = \".t\"\n";
    var b = "[package]\nname = \"x\"\nversion = \"1.0\"\n[[link]]\nsource = \"s\"\ntarget = \".u\"\n";
    var ha = _test_canonical_hash_of(a);
    var hb = _test_canonical_hash_of(b);
    assert_eq(hapi_cstr_eq(ha, hb), 0, "target rename produces a different hash");
    return 0;
}

# ============================================================
# M7 — --backup-to (link --force / sync / adopt snapshots)
# ============================================================

fn test_backup_compose_path_shape() {
    test_group("backup: compose_path filename layout");
    var p = hapi_backup_compose_path("/var/backup", "myPkg", "/home/user/.zshrc");
    var n = strlen(p);
    # Must start with "/var/backup/<15 ts chars>-myPkg-.zshrc".
    assert(_test_substr(p, n, "/var/backup/") == 0, "starts with dir + slash");
    assert(_test_substr(p, n, "-myPkg-.zshrc") >= 0, "carries pkg + basename");
    # Single trailing slash on the dir collapses to one separator.
    var p2 = hapi_backup_compose_path("/var/backup/", "pkg", "/x/y");
    var n2 = strlen(p2);
    assert(_test_substr(p2, n2, "/var/backup//") < 0, "no doubled slash");
    return 0;
}

fn test_backup_to_link_force_snapshots_file() {
    test_group("backup: link --force snapshots existing file");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);

    # Plant a conflicting file with known content at .zshrc.
    var tgt = alloc(strlen(scope) + 16);
    memcpy(tgt, scope, strlen(scope));
    memcpy(tgt + strlen(scope), "/.zshrc\x00", 8);
    _test_write_file(tgt, "user content");

    # Backup dir under the scratch dir.
    var bdir = alloc(strlen(scope) + 16);
    memcpy(bdir, scope, strlen(scope));
    memcpy(bdir + strlen(scope), "/backups\x00", 9);
    hapi_set_backup_dir(bdir);

    var rc = cmd_link("docs/examples/dotfiles-zsh", 1);
    assert_eq(rc, 0, "link --force succeeds with --backup-to");
    hapi_set_backup_dir(0);

    # Target should now be a symlink.
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_SYMLINK,
      "target is now a symlink");

    # Find the backup_path in the audit trail and read it back.
    var entries = audit_read(audit_path);
    var found_backup = 0;
    var found_content = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        var bp = hae_backup_path(e);
        var t = hae_target(e);
        if (bp != 0 && t != 0 && hapi_cstr_eq(t, ".zshrc") == 1) {
            found_backup = 1;
            var rbuf = alloc(4096);
            var rn = file_read_all(bp, rbuf, 4096);
            if (rn == 12 && memeq(rbuf, "user content", 12) == 1) {
                found_content = 1;
            }
        }
        i = i + 1;
    }
    assert_eq(found_backup, 1, "audit entry carries backup_path");
    assert_eq(found_content, 1, "backup file holds original bytes");

    _test_clear_env();
    return 0;
}

fn test_backup_to_skips_symlink_conflict() {
    test_group("backup: --backup-to does not snapshot symlink conflicts");

    var env = _test_fresh_env();
    var scope = load64(env);

    # Plant a symlink-to-elsewhere at .zshrc (no file bytes to save).
    var tgt = alloc(strlen(scope) + 16);
    memcpy(tgt, scope, strlen(scope));
    memcpy(tgt + strlen(scope), "/.zshrc\x00", 8);
    hapi_symlink("/tmp/elsewhere", tgt);

    var bdir = alloc(strlen(scope) + 16);
    memcpy(bdir, scope, strlen(scope));
    memcpy(bdir + strlen(scope), "/backups\x00", 9);
    hapi_set_backup_dir(bdir);

    assert_eq(cmd_link("docs/examples/dotfiles-zsh", 1), 0, "link --force succeeds");
    hapi_set_backup_dir(0);

    # No backup directory should have been created — symlink
    # conflicts skip the snapshot.
    assert_eq(link_probe_kind(link_probe(bdir)), HAPI_LP_ABSENT,
      "backup dir untouched (no file conflict)");

    _test_clear_env();
    return 0;
}

fn test_backup_to_dry_run_writes_no_backup() {
    test_group("backup: dry-run does not write the snapshot");

    var env = _test_fresh_env();
    var scope = load64(env);

    var tgt = alloc(strlen(scope) + 16);
    memcpy(tgt, scope, strlen(scope));
    memcpy(tgt + strlen(scope), "/.zshrc\x00", 8);
    _test_write_file(tgt, "user content");

    var bdir = alloc(strlen(scope) + 16);
    memcpy(bdir, scope, strlen(scope));
    memcpy(bdir + strlen(scope), "/backups\x00", 9);
    hapi_set_backup_dir(bdir);

    hapi_set_dry_run(1);
    assert_eq(cmd_link("docs/examples/dotfiles-zsh", 1), 0, "dry-run --force succeeds");
    hapi_set_dry_run(0);
    hapi_set_backup_dir(0);

    # Backup dir not created under dry-run; the conflict file is
    # still in place (no unlink happened).
    assert_eq(link_probe_kind(link_probe(bdir)), HAPI_LP_ABSENT,
      "no backup dir under dry-run");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_FILE,
      "conflict file untouched under dry-run");

    _test_clear_env();
    return 0;
}

fn test_backup_to_adopt_snapshots_before_rename() {
    test_group("backup: adopt snapshots before sys_rename");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);

    # Plant the file to adopt with known bytes.
    var tgt = alloc(strlen(scope) + 16);
    memcpy(tgt, scope, strlen(scope));
    memcpy(tgt + strlen(scope), "/.zshrc\x00", 8);
    _test_write_file(tgt, "user content");

    # Fresh package dir.
    var pkg = _test_make_package("a", ".a");
    var bdir = alloc(strlen(scope) + 16);
    memcpy(bdir, scope, strlen(scope));
    memcpy(bdir + strlen(scope), "/backups\x00", 9);

    hapi_set_backup_dir(bdir);
    var rc = cmd_adopt(".zshrc", pkg);
    hapi_set_backup_dir(0);
    assert_eq(rc, 0, "adopt with --backup-to succeeds");

    # Audit entry should carry backup_path on the op:adopt row.
    var entries = audit_read(audit_path);
    var found = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        var op = hae_op(e);
        var bp = hae_backup_path(e);
        if (op != 0 && hapi_cstr_eq(op, "adopt") == 1 && bp != 0) {
            var rbuf = alloc(4096);
            var rn = file_read_all(bp, rbuf, 4096);
            if (rn == 12 && memeq(rbuf, "user content", 12) == 1) { found = 1; }
        }
        i = i + 1;
    }
    assert_eq(found, 1, "adopt audit entry carries a readable backup_path");

    _test_clear_env();
    return 0;
}

# ============================================================
# 1.0.9 — F-022: dangling-source linking
# ============================================================

# `link` never probed the source, so a row naming a file that is not in
# the package produced a symlink pointing at nothing, exit 0. GNU stow
# probes; hapi did not.
fn test_link_refuses_missing_source() {
    test_group("link: refuses a row whose source is not in the package (F-022)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);

    var pkg = _test_make_package("zshrc", ".zshrc");
    # Delete the source out of the package — a manifest typo, a `git
    # checkout` of a branch that lacks it, and a deleted file all land here.
    hapi_unlink(_fsl_path_join(pkg, "zshrc"));

    assert_eq(cmd_link(pkg, 0), 1, "link refuses a row with no source");

    var tgt = _fsl_path_join(scope, ".zshrc");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_ABSENT,
      "no dangling symlink was created");
    assert_eq(_test_file_size(audit_path), 0, "no audit entry for a refused row");

    # --force must not override it: the link would still point at nothing.
    assert_eq(cmd_link(pkg, 1), 1, "--force does not override a missing source");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_ABSENT,
      "--force created no dangling symlink either");

    # sync is cmd_link without --force, so it inherits the refusal.
    assert_eq(cmd_sync(pkg), 1, "sync refuses a missing source too");

    _test_clear_env();
    return 0;
}

# The other half: a link created while the source existed, whose source
# later vanished. The symlink still holds exactly the right target text,
# so `status`'s ownership byte-compare passes — the dangling-ness has to
# be a SEPARATE probe, not a change to what is compared.
fn test_status_reports_dangling_link() {
    test_group("status: a dangling link is drift, not OK (F-022)");

    var env = _test_fresh_env();
    var scope = load64(env);

    var pkg = _test_make_package("zshrc", ".zshrc");
    assert_eq(cmd_link(pkg, 0), 0, "healthy package links");
    assert_eq(cmd_status(pkg), 0, "healthy package reports no drift");

    var tgt = _fsl_path_join(scope, ".zshrc");
    hapi_unlink(_fsl_path_join(pkg, "zshrc"));
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_SYMLINK,
      "the symlink itself is still on disk");

    assert_eq(cmd_status(pkg), 1, "a dangling link is drift -> exit 1");

    _test_clear_env();
    return 0;
}

# The same harm through a different errno: a row source that traverses a
# regular file (`zshrc/sub` where `zshrc` IS the file) probes ERROR, not
# ABSENT — and still produced a dangling link that `status` called OK.
# The predicate is "provably present", not "not ENOENT".
fn test_link_refuses_source_through_a_file() {
    test_group("link: refuses a source that traverses a regular file (F-022)");

    var env = _test_fresh_env();
    var scope = load64(env);

    var pkg = _test_make_package("zshrc", ".zshrc");
    var mp = _fsl_path_join(pkg, "hapi.cyml");
    assert_eq(manifest_append_link_row(mp, "zshrc/sub", ".leaf"), 0, "row appended");

    assert_eq(cmd_link(pkg, 0), 1, "link refuses a source through a file");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".leaf"))),
      HAPI_LP_ABSENT, "no dangling symlink for the ENOTDIR row");
    # ...and the healthy row in the same package was not written either:
    # the refusal is a whole-run refusal, like every other conflict.
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".zshrc"))),
      HAPI_LP_ABSENT, "the run refused as a whole");

    _test_clear_env();
    return 0;
}

# ------------------------------------------------------------
# cli — the argv surface (1.2.0: cmdit). hapi_cli_run is driven
# with a synthetic argv, its stdout and stderr captured to files,
# so the v1.0 messages are asserted byte for byte.
# ------------------------------------------------------------

# A synthetic argv. Slot 0 is the word count; the words follow,
# NULL-terminated, so `av + 8` is the array hapi_cli_run takes.
fn _cli_add(av, w): i64 {
    var c = load64(av);
    store64(av + 8 + c * 8, w);
    store64(av + 16 + c * 8, 0);
    store64(av, c + 1);
    return av;
}

# Split `words` on single spaces. An empty argument, or one with a
# space in it, is added with _cli_add.
fn _cli_av(words): i64 {
    var av = alloc(8 * 40);
    store64(av, 0);
    store64(av + 8, 0);
    var n = strlen(words);
    var start = 0;
    var i = 0;
    while (i <= n) {
        if (i == n || load8(words + i) == 32) {
            if (i > start) {
                var w = alloc(i - start + 1);
                memcpy(w, words + start, i - start);
                store8(w + i - start, 0);
                _cli_add(av, w);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return av;
}

var _cli_dir = 0;
var _cli_out = 0;      # what the last _cli_run wrote to stdout
var _cli_out_n = 0;    # ...in bytes, a NUL included
var _cli_err = 0;
var _cli_err_n = 0;

fn _cli_slurp(path): i64 {
    var size = _test_file_size(path);
    if (size < 0) { size = 0; }
    var buf = alloc(size + 1);
    var n = file_read_all(path, buf, size);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return buf;
}

# Run hapi over `av` with fds 1 and 2 pointed at capture files.
fn _cli_run(av): i64 {
    if (_cli_dir == 0) { _cli_dir = _test_scratch_dir(); }
    var op = _fsl_path_join(_cli_dir, "out");
    var ep = _fsl_path_join(_cli_dir, "err");
    var ofd = file_open(op, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    var efd = file_open(ep, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    var keep1 = syscall(SYS_DUP, 1);
    var keep2 = syscall(SYS_DUP, 2);
    sys_dup2(ofd, 1);
    sys_dup2(efd, 2);
    var rc = hapi_cli_run(load64(av), av + 8);
    sys_dup2(keep1, 1);
    sys_dup2(keep2, 2);
    file_close(keep1);
    file_close(keep2);
    file_close(ofd);
    file_close(efd);
    _cli_out_n = _test_file_size(op);
    _cli_out = _cli_slurp(op);
    _cli_err_n = _test_file_size(ep);
    _cli_err = _cli_slurp(ep);
    return rc;
}

# 1 when the `n` captured bytes are exactly `want`.
fn _cli_same(got, n, want): i64 {
    if (n != strlen(want)) { return 0; }
    return memeq(got, want, n);
}

# Run `av` and assert its exit code, stdout and stderr. A 0 for
# `out` / `err` leaves that stream unchecked.
fn _cli_expect(av, rc, out, err, label): i64 {
    var got = _cli_run(av);
    assert_eq(got, rc, label);
    if (out != 0) { assert(_cli_same(_cli_out, _cli_out_n, out), _test_cat(label, " — stdout")); }
    if (err != 0) { assert(_cli_same(_cli_err, _cli_err_n, err), _test_cat(label, " — stderr")); }
    return got;
}

var _cli_usage = 0;      # `hapi --help`'s stdout, captured once

fn _cli_version_line(): i64 {
    return _test_cat(_test_cat("hapi ", CYRIUS_PKG_VERSION), "\n");
}

fn _cli_unexpected_flag(verb, flag): i64 {
    return _test_cat(_test_cat(_test_cat(_test_cat("hapi: unexpected flag for `", verb), "`: "), flag), "\n");
}

fn _cli_unexpected_arg(verb, arg): i64 {
    return _test_cat(_test_cat(_test_cat(_test_cat("hapi: unexpected argument for `", verb), "`: "), arg), "\n");
}

fn _cli_reset(scope): i64 {
    hapi_set_dry_run(0);
    hapi_set_absolute(0);
    hapi_set_backup_dir(0);
    link_set_scope_root(scope);
    return 0;
}

fn test_cli_top_level() {
    test_group("cli: the command is argv[1] alone");

    assert_eq(_cli_run(_cli_av("hapi --help")), 0, "--help exits 0");
    _cli_usage = _cli_out;
    var head = "usage: hapi <command> [args...]\n";
    assert(_cli_out_n > strlen(head) && memeq(_cli_out, head, strlen(head)) == 1,
      "--help prints the v1.0 usage on stdout");
    assert_eq(_cli_err_n, 0, "--help writes nothing to stderr");

    var ver = _cli_version_line();
    _cli_expect(_cli_av("hapi"), 2, _cli_usage, "", "no arguments: usage, exit 2");
    _cli_expect(_cli_av("hapi -h"), 0, _cli_usage, "", "-h");
    _cli_expect(_cli_av("hapi --version"), 0, ver, "", "--version");
    _cli_expect(_cli_av("hapi -v"), 0, ver, "", "-v, not cmdit's -V");
    # A leading option answers whatever follows it, as since v1.0.
    _cli_expect(_cli_av("hapi --version junk"), 0, ver, "", "--version junk");
    _cli_expect(_cli_av("hapi --version --help"), 0, ver, "", "the first option wins");
    _cli_expect(_cli_av("hapi -h --bogus"), 0, _cli_usage, "", "-h --bogus");

    _cli_expect(_cli_av("hapi -V"), 2, _cli_usage, "hapi: unknown command: -V\n", "-V is unknown");
    _cli_expect(_cli_av("hapi bogus"), 2, _cli_usage, "hapi: unknown command: bogus\n", "unknown verb");
    _cli_expect(_cli_av("hapi LINK"), 2, _cli_usage, "hapi: unknown command: LINK\n", "verbs are case-sensitive");
    _cli_expect(_cli_av("hapi -"), 2, _cli_usage, "hapi: unknown command: -\n", "a lone - is no verb");
    var av0 = _cli_av("hapi");
    _cli_add(av0, "");
    _cli_expect(av0, 2, _cli_usage, "hapi: unknown command: \n", "an empty verb");

    # Nothing is accepted before the verb: not a verb's flag, not `--`.
    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _test_make_package("rc", ".rc");
    var av1 = _cli_av("hapi --dry-run link");
    _cli_add(av1, pkg);
    _cli_expect(av1, 2, _cli_usage, "hapi: unknown command: --dry-run\n", "a flag before the verb");
    var av2 = _cli_av("hapi -- link");
    _cli_add(av2, pkg);
    _cli_expect(av2, 2, _cli_usage, "hapi: unknown command: --\n", "`--` before the verb");
    _cli_expect(_cli_av("hapi --"), 2, _cli_usage, "hapi: unknown command: --\n", "`--` alone");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".rc"))), HAPI_LP_ABSENT,
      "neither ran link");
    assert_eq(_test_file_size(audit_path), 0, "the trail is untouched");
    assert_eq(hapi_dry_run(), 0, "--dry-run before the verb was not applied");

    _test_clear_env();
    return 0;
}

# Probe `hapi <verb> <flag> [x] --help`. cmdit refuses an unregistered
# flag anywhere on the line before it answers --help, so an accepted
# flag exits 0 with the usage and a refused one exits 2, and nothing
# runs either way.
fn _cli_flag_probe(verb, flag, takes_value, accepted): i64 {
    var av = _cli_av("hapi");
    _cli_add(av, verb);
    _cli_add(av, flag);
    if (takes_value == 1) { _cli_add(av, "x"); }
    _cli_add(av, "--help");
    var label = _test_cat(_test_cat(verb, " "), flag);
    if (accepted == 1) { return _cli_expect(av, 0, _cli_usage, "", _test_cat(label, " is accepted")); }
    return _cli_expect(av, 2, "", _cli_unexpected_flag(verb, flag), _test_cat(label, " is refused"));
}

fn _cli_flag_row(verb, force, strict, dry, root, backup, prune): i64 {
    _cli_flag_probe(verb, "--prune", 0, prune);
    _cli_flag_probe(verb, "--force", 0, force);
    _cli_flag_probe(verb, "--strict", 0, strict);
    _cli_flag_probe(verb, "--dry-run", 0, dry);
    _cli_flag_probe(verb, "--root", 1, root);
    _cli_flag_probe(verb, "--backup-to", 1, backup);
    return 0;
}

fn test_cli_verbs_take_only_their_flags() {
    test_group("cli: each verb takes only its own flags (F-033, guides)");

    # The usage calls --root / --dry-run / --backup-to "global"; they are
    # per-verb subsets, and a verb outside the subset owes exit 2 (guides
    # dry-run.md, backup-to.md, capability.md). inspect takes none (F-033).
    # sync's --force (1.3.0) parses; it needs --prune, checked after the
    # parse (test_sync_prune_cli).
    #              verb          force strict dry root backup prune
    _cli_flag_row("inspect",       0,    0,    0,   0,   0,     0);
    _cli_flag_row("link",          1,    0,    1,   1,   1,     0);
    _cli_flag_row("unlink",        0,    0,    1,   0,   0,     0);
    _cli_flag_row("adopt",         0,    0,    1,   1,   1,     0);
    _cli_flag_row("rollback",      0,    0,    1,   0,   0,     0);
    _cli_flag_row("checkpoint",    0,    0,    1,   0,   0,     0);
    _cli_flag_row("status",        0,    0,    0,   1,   0,     0);
    _cli_flag_row("list",          0,    0,    0,   1,   0,     0);
    _cli_flag_row("check",         0,    1,    0,   0,   0,     0);
    _cli_flag_row("sync",          1,    0,    1,   1,   1,     1);
    return 0;
}

fn test_cli_extra_positional_refused() {
    test_group("cli: an extra positional is refused on every verb (F-013)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _test_make_package("rc", ".rc");

    var avl = _cli_av("hapi link");
    _cli_add(avl, pkg);
    assert_eq(_cli_run(avl), 0, "seed: link the package");
    var seeded = _test_file_size(audit_path);
    assert(seeded > 0, "seed: the trail has a row");

    _cli_expect(_cli_av("hapi inspect a extra"), 2, "", _cli_unexpected_arg("inspect", "extra"), "inspect");
    _cli_expect(_cli_av("hapi link a extra"), 2, "", _cli_unexpected_arg("link", "extra"), "link");
    _cli_expect(_cli_av("hapi unlink a extra"), 2, "", _cli_unexpected_arg("unlink", "extra"), "unlink");
    _cli_expect(_cli_av("hapi adopt a b extra"), 2, "", _cli_unexpected_arg("adopt", "extra"), "adopt");
    _cli_expect(_cli_av("hapi checkpoint extra"), 2, "", _cli_unexpected_arg("checkpoint", "extra"), "checkpoint");
    _cli_expect(_cli_av("hapi status a extra"), 2, "", _cli_unexpected_arg("status", "extra"), "status");
    _cli_expect(_cli_av("hapi list extra"), 2, "", _cli_unexpected_arg("list", "extra"), "list");
    _cli_expect(_cli_av("hapi check a extra"), 2, "", _cli_unexpected_arg("check", "extra"), "check");
    _cli_expect(_cli_av("hapi sync a extra"), 2, "", _cli_unexpected_arg("sync", "extra"), "sync");
    # The F-013 case itself: through 1.0.4 this reversed the whole trail.
    var avr = _cli_av("hapi rollback");
    _cli_add(avr, "test-pkg");
    _cli_expect(avr, 2, "", _cli_unexpected_arg("rollback", "test-pkg"), "rollback <pkg>");
    assert_eq(_test_file_size(audit_path), seeded, "no refused verb touched the trail");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".rc"))), HAPI_LP_SYMLINK,
      "the seeded link is still there");

    _test_clear_env();
    return 0;
}

fn test_cli_flag_shaped_value_refused() {
    test_group("cli: a value starting with `-` is refused (F-019)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _test_make_package("rc", ".rc");
    var advice = " argument (a value starting with `-` must be spelled `./-name`)\n";
    var root_msg = _test_cat("hapi: --root requires a path", advice);
    var bk_msg = _test_cat("hapi: --backup-to requires a directory", advice);

    # The F-019 case: `--dry-run` must not become the root.
    var av = _cli_av("hapi link --root --dry-run");
    _cli_add(av, pkg);
    _cli_expect(av, 2, "", root_msg, "--root --dry-run");
    assert_eq(hapi_dry_run(), 0, "--dry-run was not applied either");
    # Refused where it stands, in the parse, as 1.1.1's walk refused it:
    # a `--bogus` after it is never reached.
    _cli_add(av, "--bogus");
    _cli_expect(av, 2, "", root_msg, "--root --dry-run <pkg> --bogus");

    var forms = _test_cat("--root -|--root=-x|--root=--dry-run|--root|",
      "--backup-to --force|--backup-to -|--backup-to=-x|--backup-to");
    var n = strlen(forms);
    var start = 0;
    var i = 0;
    while (i <= n) {
        if (i == n || load8(forms + i) == 124) {
            var f = alloc(i - start + 1);
            memcpy(f, forms + start, i - start);
            store8(f + i - start, 0);
            # The package goes first, so a trailing value flag has no value.
            var a2 = _cli_av("hapi link");
            _cli_add(a2, pkg);
            var fw = _cli_av(f);
            var j = 0;
            while (j < load64(fw)) { _cli_add(a2, load64(fw + 8 + j * 8)); j = j + 1; }
            var msg = root_msg;
            if (load8(f + 2) == 98) { msg = bk_msg; }    # 'b'
            _cli_expect(a2, 2, "", msg, f);
            start = i + 1;
        }
        i = i + 1;
    }
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".rc"))), HAPI_LP_ABSENT,
      "no refused form linked anything");
    assert_eq(_test_file_size(audit_path), 0, "the trail is untouched");

    _cli_reset(0);
    _test_clear_env();
    return 0;
}

fn test_cli_empty_root_writes_no_stray_byte() {
    test_group("cli: an empty --root is refused cleanly (F-060)");

    # Through 1.1.1 this eprint was hand-counted one byte long, and wrote
    # the literal's NUL terminator to stderr after the newline.
    var msg = "hapi: --root requires a path argument\n";
    var av = _cli_av("hapi link pkg --root");
    _cli_add(av, "");
    _cli_expect(av, 2, "", msg, "--root ''");
    _cli_expect(_cli_av("hapi status pkg --root="), 2, "", msg, "--root=");
    return 0;
}

fn test_cli_root_grant_after_parse() {
    test_group("cli: the --root grant runs after the parse (F-051)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    cap_set_home(scope);
    cap_set_allowlist("");
    var pkg = _test_make_package("rc", ".rc");
    var granted = _fsl_path_join(scope, "granted");
    hapi_mkdir(granted, 0x1C0);
    var deny = "hapi: --root path is not in HAPI_ALLOWED_ROOTS (and is not within $HOME)\n";

    var av1 = _cli_av("hapi link");
    _cli_add(av1, pkg);
    _cli_add(av1, "--root");
    _cli_add(av1, "/etc");
    _cli_expect(av1, 1, "", deny, "--root outside the grant: exit 1");
    var av2 = _cli_av("hapi link");
    _cli_add(av2, pkg);
    _cli_add(av2, "--root=/etc");
    _cli_expect(av2, 1, "", deny, "--root=PATH is granted the same way");
    # A usage error is reported before the grant is decided.
    _cli_add(av1, "--bogus");
    _cli_expect(av1, 2, "", _cli_unexpected_flag("link", "--bogus"), "an unknown flag beats a denial");
    # Every --root given must be granted, as each was in 1.1.1's walk.
    var av3 = _cli_av("hapi link");
    _cli_add(av3, pkg);
    _cli_add(av3, "--root");
    _cli_add(av3, "/etc");
    _cli_add(av3, "--root");
    _cli_add(av3, granted);
    _cli_expect(av3, 1, "", deny, "a denied --root is not rescued by a later one");
    assert_eq(_test_file_size(audit_path), 0, "no denied run wrote the trail");

    var av4 = _cli_av("hapi link");
    _cli_add(av4, pkg);
    _cli_add(av4, _test_cat("--root=", granted));
    assert_eq(_cli_run(av4), 0, "a granted --root=PATH links");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(granted, ".rc"))), HAPI_LP_SYMLINK,
      "...into the granted root");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".rc"))), HAPI_LP_ABSENT,
      "...and not into $HOME");

    _cli_reset(0);
    cap_set_home(0);
    cap_set_allowlist(0);
    _test_clear_env();
    return 0;
}

fn test_cli_flags_reach_the_command() {
    test_group("cli: parsed flags reach the command");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _test_make_package("rc", ".rc");
    var target = _fsl_path_join(scope, ".rc");

    var av1 = _cli_av("hapi link --dry-run");
    _cli_add(av1, pkg);
    assert_eq(_cli_run(av1), 0, "link --dry-run exits 0");
    assert_eq(hapi_dry_run(), 1, "--dry-run set the process flag");
    assert_eq(link_probe_kind(link_probe(target)), HAPI_LP_ABSENT, "...and nothing was linked");
    _cli_reset(scope);

    _test_write_file(target, "user");
    var av2 = _cli_av("hapi link");
    _cli_add(av2, pkg);
    assert_eq(_cli_run(av2), 1, "a conflict without --force exits 1");
    var bk = _fsl_path_join(scope, "bk");
    _cli_add(av2, "--force");
    _cli_add(av2, "--backup-to");
    _cli_add(av2, bk);
    assert_eq(_cli_run(av2), 0, "link --force --backup-to replaces it");
    assert_eq(link_probe_kind(link_probe(target)), HAPI_LP_SYMLINK, "the target is now the link");
    assert(hapi_backup_dir() != 0 && streq(hapi_backup_dir(), bk) == 1, "--backup-to set the backup dir");
    assert_eq(link_probe_kind(link_probe(bk)), HAPI_LP_DIRECTORY, "...and the snapshot landed there");
    assert(_test_file_size(audit_path) > 0, "the forced link was recorded");
    _cli_reset(scope);

    var spkg = _test_scratch_dir();
    _test_write_file(_fsl_path_join(spkg, "hapi.cyml"),
      "[package]\nname = \"s\"\nversion = \"1.0\"\nauthor = \"me\"\n");
    var av3 = _cli_av("hapi check");
    _cli_add(av3, spkg);
    assert_eq(_cli_run(av3), 0, "check tolerates an unknown key");
    _cli_add(av3, "--strict");
    assert_eq(_cli_run(av3), 1, "check --strict refuses it");

    _cli_reset(0);
    _test_clear_env();
    return 0;
}

fn test_cli_additive_forms() {
    test_group("cli: 1.2.0's additive forms");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _test_make_package("rc", ".rc");
    var ver = _cli_version_line();

    _cli_expect(_cli_av("hapi link --help"), 0, _cli_usage, "", "<verb> --help");
    _cli_expect(_cli_av("hapi unlink pkg -h"), 0, _cli_usage, "", "<verb> -h");
    _cli_expect(_cli_av("hapi status --version"), 0, ver, "", "<verb> --version");
    _cli_expect(_cli_av("hapi rollback -v"), 0, ver, "", "<verb> -v");
    # --help answers past extra positionals, but not past a bad flag.
    _cli_expect(_cli_av("hapi link a b c --help"), 0, _cli_usage, "", "--help past extras");
    _cli_expect(_cli_av("hapi link --help --bogus"), 2, "", _cli_unexpected_flag("link", "--bogus"),
      "--help does not hide an unknown flag");

    # `--` ends the verb's flags; what follows is positional.
    var av1 = _cli_av("hapi link --");
    _cli_add(av1, pkg);
    assert_eq(_cli_run(av1), 0, "link -- <pkg> links");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(scope, ".rc"))), HAPI_LP_SYMLINK,
      "...the package after `--`");
    var av2 = _cli_av("hapi link");
    _cli_add(av2, pkg);
    _cli_add(av2, "--");
    _cli_add(av2, "--force");
    _cli_expect(av2, 2, "", _cli_unexpected_arg("link", "--force"), "--force after `--` is an argument");
    # A lone `-` is a positional, not a flag.
    _cli_expect(_cli_av("hapi rollback -"), 2, "", _cli_unexpected_arg("rollback", "-"), "- is a positional");

    # A flag error is reported before an extra positional.
    _cli_expect(_cli_av("hapi link a extra --bogus"), 2, "", _cli_unexpected_flag("link", "--bogus"),
      "an unknown flag beats an extra positional");

    _cli_reset(0);
    _test_clear_env();
    return 0;
}

fn test_cli_unexpected_flag_named_as_typed() {
    test_group("cli: an unexpected flag is named as typed");

    var toks = "--x|--x=1|-x|-xy|-V|--force=1|--dry-run=|--strict|--root=";
    var n = strlen(toks);
    var start = 0;
    var i = 0;
    while (i <= n) {
        if (i == n || load8(toks + i) == 124) {
            var t = alloc(i - start + 1);
            memcpy(t, toks + start, i - start);
            store8(t + i - start, 0);
            var av = _cli_av("hapi unlink pkg");
            _cli_add(av, t);
            _cli_expect(av, 2, "", _cli_unexpected_flag("unlink", t), t);
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# ------------------------------------------------------------
# 1.3.0 — sync with no package, and `sync --prune` (ADR 0006)
# ------------------------------------------------------------

# Write `<dir>/hapi.cyml` naming package `name`, with one row per
# space-separated word in `rows`: source <word>, target .<word>. Each
# source file is created if absent. Rewriting with fewer words is how a
# test drops a row. Returns `dir`.
fn _sy_pkg(dir, name, rows): i64 {
    hapi_mkdir(dir, 0x1C0);
    var text = _test_hdr(name);
    var words = _cli_av(rows);
    var i = 0;
    while (i < load64(words)) {
        var w = load64(words + 8 + i * 8);
        text = _test_cat(text, _test_row(w, _test_cat(".", w)));
        var src = _fsl_path_join(dir, w);
        if (link_probe_kind(link_probe(src)) == HAPI_LP_ABSENT) { _test_write_file(src, "x"); }
        i = i + 1;
    }
    return _test_manifest_at(dir, text);
}

fn _sy_kind(scope, name): i64 {
    return link_probe_kind(link_probe(_fsl_path_join(scope, name)));
}

fn _sy_entries(audit_path): i64 { return vec_len(audit_read(audit_path)); }

fn test_sync_prune_removes_the_dropped_row() {
    test_group("sync --prune: removes only the row that left the manifest (1.3.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _sy_pkg(_test_scratch_dir(), "zsh", "a b c d e f");
    assert_eq(cmd_sync_run(pkg, 0, 0), 0, "first sync links six rows");
    assert_eq(_sy_entries(audit_path), 6, "six link entries");

    # The 2026-05-20 dogfood case: one row of six dropped.
    _sy_pkg(pkg, "zsh", "a b c d e");
    hapi_set_dry_run(1);
    assert_eq(cmd_sync_run(pkg, 1, 0), 0, "--prune --dry-run exits 0");
    hapi_set_dry_run(0);
    assert_eq(_sy_kind(scope, ".f"), HAPI_LP_SYMLINK, "dry-run removed nothing");
    assert_eq(_sy_entries(audit_path), 6, "dry-run wrote no entry");

    assert_eq(cmd_sync_run(pkg, 1, 0), 0, "--prune exits 0");
    assert_eq(_sy_kind(scope, ".f"), HAPI_LP_ABSENT, "the dropped row's link is gone");
    assert_eq(_sy_kind(scope, ".a"), HAPI_LP_SYMLINK, "a kept row's link stays");
    assert_eq(_sy_kind(scope, ".e"), HAPI_LP_SYMLINK, "...every kept row's");
    var trail = audit_read(audit_path);
    assert_eq(vec_len(trail), 7, "exactly one new entry, not an 11-entry rotation");
    var last = vec_get(trail, 6);
    assert(hapi_cstr_eq(hae_op(last), "unlink") == 1, "...an op:unlink");
    assert(hapi_cstr_eq(hae_abs_target(last), _fsl_path_join(scope, ".f")) == 1, "...for the dropped target");

    assert_eq(cmd_sync_run(pkg, 1, 0), 0, "a second --prune exits 0");
    assert_eq(_sy_entries(audit_path), 7, "...and writes nothing (idempotent)");
    assert_eq(cmd_sync_run(pkg, 0, 0), 0, "plain sync ignores what --prune would see");

    _test_clear_env();
    return 0;
}

fn test_sync_prune_limit() {
    test_group("sync --prune: refused past half the package's links without --force");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _sy_pkg(_test_scratch_dir(), "two", "p q");
    assert_eq(cmd_sync_run(pkg, 0, 0), 0, "link two rows");

    # An emptied manifest is the accident the limit exists for.
    _sy_pkg(pkg, "two", "");
    assert_eq(cmd_sync_run(pkg, 1, 0), 1, "pruning 2 of 2 is refused");
    assert_eq(_sy_kind(scope, ".p"), HAPI_LP_SYMLINK, "...and removes nothing");
    assert_eq(_sy_kind(scope, ".q"), HAPI_LP_SYMLINK, "...of either");
    assert_eq(_sy_entries(audit_path), 2, "...and writes nothing");
    assert_eq(cmd_sync_run(pkg, 1, 1), 0, "--force lifts the limit");
    assert_eq(_sy_kind(scope, ".p"), HAPI_LP_ABSENT, "both removed");
    assert_eq(_sy_kind(scope, ".q"), HAPI_LP_ABSENT, "...both");
    assert_eq(_sy_entries(audit_path), 4, "two op:unlink entries");

    # Exactly half is not more than half.
    var half = _sy_pkg(_test_scratch_dir(), "half", "h1 h2");
    assert_eq(cmd_sync_run(half, 0, 0), 0, "link two more");
    _sy_pkg(half, "half", "h1");
    assert_eq(cmd_sync_run(half, 1, 0), 0, "pruning 1 of 2 goes through");
    assert_eq(_sy_kind(scope, ".h2"), HAPI_LP_ABSENT, "...and removes it");

    _test_clear_env();
    return 0;
}

fn test_sync_prune_refuses_what_is_not_ours() {
    test_group("sync --prune: never removes what hapi did not make, --force or not");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _sy_pkg(_test_scratch_dir(), "mut", "m1 m2 m3");
    assert_eq(cmd_sync_run(pkg, 0, 0), 0, "link three rows");
    var m3 = _fsl_path_join(scope, ".m3");
    hapi_unlink(m3);
    _test_write_file(m3, "the user's own file");
    _sy_pkg(pkg, "mut", "m1");
    assert_eq(cmd_sync_run(pkg, 1, 1), 1, "a replaced link refuses the package, even with --force");
    assert_eq(_sy_kind(scope, ".m3"), HAPI_LP_FILE, "the user's file is untouched");
    assert_eq(_sy_kind(scope, ".m2"), HAPI_LP_SYMLINK, "...and so is the link that was ours (whole refusal)");
    assert_eq(_sy_entries(audit_path), 3, "...and nothing was written");

    _test_clear_env();
    return 0;
}

fn test_sync_prune_is_scoped() {
    test_group("sync --prune: only this package directory's links, in this scope");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    # Two directories, one package name: the trail cannot tell them apart.
    var a = _sy_pkg(_test_scratch_dir(), "same", "sa");
    var b = _sy_pkg(_test_scratch_dir(), "same", "sb");
    assert_eq(cmd_sync_run(a, 0, 0), 0, "link package dir A");
    assert_eq(cmd_sync_run(b, 0, 0), 0, "link package dir B, same name");
    assert_eq(cmd_sync_run(a, 1, 0), 0, "--prune A");
    assert_eq(_sy_kind(scope, ".sb"), HAPI_LP_SYMLINK, "B's link is not A's to prune");

    # A link made under another scope is that scope's.
    var alt = _test_scratch_dir();
    var c = _sy_pkg(_test_scratch_dir(), "scoped", "s1 s2 s3");
    link_set_scope_root(alt);
    assert_eq(cmd_sync_run(c, 0, 0), 0, "link under another scope");
    link_set_scope_root(scope);
    assert_eq(cmd_sync_run(c, 0, 0), 0, "...and under this one");
    _sy_pkg(c, "scoped", "s1 s2");
    assert_eq(cmd_sync_run(c, 1, 0), 0, "--prune in this scope");
    assert_eq(_sy_kind(scope, ".s3"), HAPI_LP_ABSENT, "this scope's dropped link is gone");
    assert_eq(_sy_kind(alt, ".s3"), HAPI_LP_SYMLINK, "the other scope's is not touched");
    assert(_sy_entries(audit_path) > 0, "trail written");

    _test_clear_env();
    return 0;
}

fn test_sync_scans_package_roots() {
    test_group("sync with no package: every package under HAPI_PACKAGE_ROOTS");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var root = _test_scratch_dir();
    _sy_pkg(_fsl_path_join(root, "git"), "git", "gitconfig");
    _sy_pkg(_fsl_path_join(root, "zsh"), "zsh", "zshrc zshenv");
    _sy_pkg(_fsl_path_join(root, ".hidden"), "hidden", "hid");      # dot-dirs are skipped
    hapi_mkdir(_fsl_path_join(root, "scripts"), 0x1C0);              # no manifest: not a package
    hapi_symlink(_fsl_path_join(root, "git"), _fsl_path_join(root, "gitlink"));   # not followed
    var root2 = _test_scratch_dir();
    _sy_pkg(_fsl_path_join(root2, "kitty"), "kitty", "kittyrc");
    sync_set_package_roots(_test_cat(_test_cat(root, ":"), root2));

    assert_eq(cmd_sync_run(0, 0, 0), 0, "no-arg sync exits 0");
    assert_eq(_sy_kind(scope, ".gitconfig"), HAPI_LP_SYMLINK, "git synced");
    assert_eq(_sy_kind(scope, ".zshenv"), HAPI_LP_SYMLINK, "zsh synced");
    assert_eq(_sy_kind(scope, ".kittyrc"), HAPI_LP_SYMLINK, "a second root synced");
    assert_eq(_sy_kind(scope, ".hid"), HAPI_LP_ABSENT, "a dot-directory is not scanned");
    assert_eq(_sy_entries(audit_path), 4, "four links, the symlinked package not synced twice");
    assert_eq(cmd_sync_run(0, 0, 0), 0, "a second no-arg sync exits 0");
    assert_eq(_sy_entries(audit_path), 4, "...and writes nothing");

    # A failing package does not stop the rest.
    _sy_pkg(_fsl_path_join(root, "broken"), "broken", "gone");
    hapi_unlink(_fsl_path_join(_fsl_path_join(root, "broken"), "gone"));
    _sy_pkg(_fsl_path_join(root, "vim"), "vim", "vimrc");
    assert_eq(cmd_sync_run(0, 0, 0), 1, "one failing package makes the run exit 1");
    assert_eq(_sy_kind(scope, ".vimrc"), HAPI_LP_SYMLINK, "...and the packages after it still sync");

    # --prune applies per package.
    hapi_unlink(_fsl_path_join(root, "broken/hapi.cyml"));
    _sy_pkg(_fsl_path_join(root, "zsh"), "zsh", "zshrc");
    assert_eq(cmd_sync_run(0, 1, 0), 0, "no-arg --prune exits 0");
    assert_eq(_sy_kind(scope, ".zshenv"), HAPI_LP_ABSENT, "zsh's dropped row is pruned");
    assert_eq(_sy_kind(scope, ".gitconfig"), HAPI_LP_SYMLINK, "other packages keep theirs");

    sync_set_package_roots(0);
    _test_clear_env();
    return 0;
}

fn test_sync_scan_refusals() {
    test_group("sync with no package: configuration and refusals");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    sync_set_package_roots("");
    assert_eq(cmd_sync_run(0, 0, 0), 2, "no HAPI_PACKAGE_ROOTS is bad usage");
    sync_set_package_roots("relative/dir");
    assert_eq(cmd_sync_run(0, 0, 0), 2, "a relative root is refused");
    sync_set_package_roots(_test_scratch_dir());
    assert_eq(cmd_sync_run(0, 0, 0), 1, "a root with no packages exits 1");
    sync_set_package_roots("/nonexistent-hapi-package-root");
    assert_eq(cmd_sync_run(0, 0, 0), 1, "a root that cannot be listed exits 1");

    var root = _test_scratch_dir();
    _sy_pkg(_fsl_path_join(root, "one"), "twin", "t1");
    _sy_pkg(_fsl_path_join(root, "two"), "twin", "t2");
    _sy_pkg(_fsl_path_join(root, "solo"), "solo", "so");
    sync_set_package_roots(root);
    assert_eq(cmd_sync_run(0, 0, 0), 1, "two packages sharing a name exit 1");
    assert_eq(_sy_kind(scope, ".t1"), HAPI_LP_ABSENT, "...neither is synced");
    assert_eq(_sy_kind(scope, ".t2"), HAPI_LP_ABSENT, "...neither");
    assert_eq(_sy_kind(scope, ".so"), HAPI_LP_SYMLINK, "...and the rest are");
    assert_eq(_sy_entries(audit_path), 1, "only solo's link was recorded");

    sync_set_package_roots(0);
    _test_clear_env();
    return 0;
}

fn test_sync_prune_guards_the_trail() {
    test_group("sync --prune: a torn or corrupt trail refuses before any change (F-055)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var trail = load64(env + 8);
    var pkg = _sy_pkg(_test_scratch_dir(), "guard", "g1 g2 g3");
    assert_eq(cmd_sync_run(pkg, 0, 0), 0, "link three rows");
    _sy_pkg(pkg, "guard", "g1 g2");

    # A torn tail reads (the reader drops it) but must not be written onto.
    var fd = file_open(trail, O_WRONLY | O_APPEND, 0);
    file_write(fd, "{\"ts\":\"torn", 11);
    file_close(fd);
    var av = _cli_av("hapi sync --prune");
    _cli_add(av, pkg);
    assert_eq(_cli_run(av), 1, "--prune refuses on a torn tail");
    assert_eq(_sy_kind(scope, ".g3"), HAPI_LP_SYMLINK, "...and the link is still there");
    # Refused by the pre-flight, before anything changed — not removed and
    # then put back when the append failed (F-061 would hide that on disk).
    assert(_test_substr(_cli_err, _cli_err_n, "audit trail is not writable; refusing to sync") >= 0,
      "...by the pre-flight");
    assert(_test_substr(_cli_err, _cli_err_n, "audit-trail write failed") < 0,
      "...without touching the link first");

    # A malformed interior line is a partial view of the trail.
    var buf = alloc(65536);
    var n = file_read_all(trail, buf, 65535);
    var fd2 = file_open(trail, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    file_write(fd2, "not a trail line\n", 17);
    file_write(fd2, buf, n - 11);           # without the torn tail
    file_close(fd2);
    assert_eq(cmd_sync_run(pkg, 1, 0), 1, "--prune refuses a corrupt trail");
    assert_eq(_sy_kind(scope, ".g3"), HAPI_LP_SYMLINK, "...and the link is still there");

    _test_clear_env();
    return 0;
}

# F-061: an append that fails AFTER the pre-flight passed (a full disk, a
# file-size limit) left the mutation on disk and unrecorded — `unlink`
# said "unlinked 0 / 2" over two links it had deleted. Every one-step
# mutation is now taken back; the run stops there.
fn test_unwritten_entries_are_taken_back() {
    test_group("audit: a mutation whose entry the trail refuses is taken back (F-061)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);

    # link — the F-018 take-back, never tested until the hook existed.
    var pl = _sy_pkg(_test_scratch_dir(), "fl", "l1");
    audit_test_fail_appends(1);
    assert_eq(cmd_link(pl, 0), 1, "link: a refused entry exits 1");
    audit_test_fail_appends(0);
    assert_eq(_sy_kind(scope, ".l1"), HAPI_LP_ABSENT, "link: the new link is taken back");
    assert_eq(_sy_entries(audit_path), 0, "link: nothing recorded, nothing left");

    # unlink
    var pu = _sy_pkg(_test_scratch_dir(), "fu", "u1 u2");
    assert_eq(cmd_link(pu, 0), 0, "unlink: setup");
    audit_test_fail_appends(1);
    assert_eq(cmd_unlink("fu"), 1, "unlink: a refused entry exits 1");
    audit_test_fail_appends(0);
    assert_eq(_sy_kind(scope, ".u1"), HAPI_LP_SYMLINK, "unlink: the link is put back");
    assert_eq(_sy_kind(scope, ".u2"), HAPI_LP_SYMLINK, "unlink: no link is left removed");
    assert_eq(_sy_entries(audit_path), 2, "unlink: the trail is as it was");
    # ...and the run stops at the first refusal rather than trying the rest.
    audit_test_fail_appends(1);
    assert_eq(_cli_run(_cli_av("hapi unlink fu")), 1, "unlink via the CLI exits 1");
    audit_test_fail_appends(0);
    var mark = "audit-trail write failed for ";
    var first = _test_substr(_cli_err, _cli_err_n, mark);
    assert(first >= 0, "unlink: the refusal is reported");
    assert(_test_substr(_cli_err + first + 1, _cli_err_n - first - 1, mark) < 0,
      "unlink: once — the run stopped at the first");

    # sync --prune
    var pp = _sy_pkg(_test_scratch_dir(), "fp", "p1 p2 p3");
    assert_eq(cmd_link(pp, 0), 0, "prune: setup");
    _sy_pkg(pp, "fp", "p1 p2");
    audit_test_fail_appends(1);
    assert_eq(cmd_sync_run(pp, 1, 0), 1, "prune: a refused entry exits 1");
    audit_test_fail_appends(0);
    assert_eq(_sy_kind(scope, ".p3"), HAPI_LP_SYMLINK, "prune: the link is put back");
    assert_eq(_sy_entries(audit_path), 5, "prune: the trail is as it was");

    _test_clear_env();

    # rollback, reversing a link
    env = _test_fresh_env();
    scope = load64(env);
    audit_path = load64(env + 8);
    var pr = _sy_pkg(_test_scratch_dir(), "fr", "r1");
    assert_eq(cmd_link(pr, 0), 0, "rollback link: setup");
    audit_test_fail_appends(1);
    assert_eq(cmd_rollback(), 1, "rollback link: a refused entry exits 1");
    audit_test_fail_appends(0);
    assert_eq(_sy_kind(scope, ".r1"), HAPI_LP_SYMLINK, "rollback link: the link is put back");
    assert_eq(_sy_entries(audit_path), 1, "rollback link: the trail is as it was");

    # rollback, reversing an unlink
    assert_eq(cmd_unlink("fr"), 0, "rollback unlink: setup");
    audit_test_fail_appends(1);
    assert_eq(cmd_rollback(), 1, "rollback unlink: a refused entry exits 1");
    audit_test_fail_appends(0);
    assert_eq(_sy_kind(scope, ".r1"), HAPI_LP_ABSENT, "rollback unlink: the re-created link is taken back");
    assert_eq(_sy_entries(audit_path), 2, "rollback unlink: the trail is as it was");
    _test_clear_env();

    # rollback, reversing an adopt: three steps, not taken back — reported.
    env = _test_fresh_env();
    scope = load64(env);
    audit_path = load64(env + 8);
    var pa = _sy_pkg(_test_scratch_dir(), "fa", "");
    _test_write_file(_fsl_path_join(scope, ".zz"), "user content");
    assert_eq(cmd_adopt(".zz", pa), 0, "rollback adopt: setup");
    audit_test_fail_appends(1);
    assert_eq(cmd_rollback(), 1, "rollback adopt: a refused entry exits 1");
    audit_test_fail_appends(0);
    assert_eq(_sy_kind(scope, ".zz"), HAPI_LP_FILE, "rollback adopt: the file is back, as reported");
    assert_eq(_sy_entries(audit_path), 1, "rollback adopt: the trail still says adopted, as reported");

    _test_clear_env();
    return 0;
}

# ------------------------------------------------------------
# 1.4.0 — `created_dir` on `op:link`: the directories a link's
# creation made are removed with it, and nothing else is.
# ------------------------------------------------------------

# Write `<dir>/hapi.cyml` for package `name` whose rows are the words of
# `rows`, each `source=target`. Sources are created. Returns `dir`.
fn _cd_pkg(dir, name, rows): i64 {
    hapi_mkdir(dir, 0x1C0);
    var text = _test_hdr(name);
    var words = _cli_av(rows);
    var i = 0;
    while (i < load64(words)) {
        var w = load64(words + 8 + i * 8);
        var eq = 0;
        while (load8(w + eq) != 61) { eq = eq + 1; }
        var src = alloc(eq + 1);
        memcpy(src, w, eq);
        store8(src + eq, 0);
        text = _test_cat(text, _test_row(src, w + eq + 1));
        _test_write_file(_fsl_path_join(dir, src), "x");
        i = i + 1;
    }
    return _test_manifest_at(dir, text);
}

# The trail entry whose abs_target is `abs_tgt` (the last such), or 0.
fn _cd_entry(audit_path, abs_tgt): i64 {
    var trail = audit_read(audit_path);
    var found = 0;
    var i = 0;
    while (i < vec_len(trail)) {
        var e = vec_get(trail, i);
        if (hapi_cstr_eq(hae_abs_target(e), abs_tgt) == 1) { found = e; }
        i = i + 1;
    }
    return found;
}

fn test_link_records_created_dir() {
    test_group("created_dir: link records the outermost directory it made (1.4.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    hapi_mkdir(_fsl_path_join(scope, ".have"), 0x1C0);
    var pkg = _cd_pkg(_test_scratch_dir(), "cd",
      "a=.cd/new/deep/a b=.cd/new/b c=.c x=.have/sub/x");
    assert_eq(cmd_link(pkg, 0), 0, "link four rows");
    var ea = _cd_entry(audit_path, _fsl_path_join(scope, ".cd/new/deep/a"));
    assert(ea != 0 && hapi_cstr_eq(hae_created_dir(ea), _fsl_path_join(scope, ".cd")) == 1,
      "the row that made .cd/new/deep records .cd, the outermost");
    var eb = _cd_entry(audit_path, _fsl_path_join(scope, ".cd/new/b"));
    assert(eb != 0 && hae_created_dir(eb) == 0, "a row reusing a made directory claims none");
    var ec = _cd_entry(audit_path, _fsl_path_join(scope, ".c"));
    assert(ec != 0 && hae_created_dir(ec) == 0, "a row in an existing directory claims none");
    var ex = _cd_entry(audit_path, _fsl_path_join(scope, ".have/sub/x"));
    assert(ex != 0 && hapi_cstr_eq(hae_created_dir(ex), _fsl_path_join(scope, ".have/sub")) == 1,
      "a directory that was already there is not claimed, only what was made below it");

    # The field is last and only on entries that made one; the rest are
    # byte-identical to 1.3.0's.
    var buf = alloc(4096);
    var n = audit_format_link_created(buf, 4096, "p", "1", "h", "s", "t", "/as", "/r/t", 0, "/r");
    var tail = ",\"created_dir\":\"/r\"}\n";
    assert(n > strlen(tail) && memeq(buf + n - strlen(tail), tail, strlen(tail)) == 1,
      "created_dir is written last");
    var buf2 = alloc(4096);
    var n2 = audit_format_link_created(buf2, 4096, "p", "1", "h", "s", "t", "/as", "/r/t", 0, 0);
    var buf3 = alloc(4096);
    var n3 = audit_format_link(buf3, 4096, "p", "1", "h", "s", "t", "/as", "/r/t", 0);
    assert(_test_substr(buf2, n2, "created_dir") < 0, "...and absent when nothing was made");
    assert(n2 > 0 && n2 == n3, "...so such an entry is the 1.3.0 line");

    _test_clear_env();
    return 0;
}

fn test_unlink_removes_made_dirs() {
    test_group("created_dir: unlink removes what the links made, and nothing else");

    var env = _test_fresh_env();
    var scope = load64(env);
    hapi_mkdir(_fsl_path_join(scope, ".have"), 0x1C0);
    var pkg = _cd_pkg(_test_scratch_dir(), "cu",
      "a=.cd/new/deep/a b=.cd/new/b x=.have/sub/x");
    assert_eq(cmd_link(pkg, 0), 0, "link");
    assert_eq(cmd_unlink("cu"), 0, "unlink");
    assert_eq(_sy_kind(scope, ".cd"), HAPI_LP_ABSENT,
      "a directory one row made and another reused goes, the run removed both");
    assert_eq(_sy_kind(scope, ".have/sub"), HAPI_LP_ABSENT, "a made directory goes");
    assert_eq(_sy_kind(scope, ".have"), HAPI_LP_DIRECTORY, "one that was already there stays");

    # Something the user put there keeps it: deepest first, stopping at
    # the first directory that is not empty.
    var pk2 = _cd_pkg(_test_scratch_dir(), "cu2", "a=.k/mid/deep/a");
    assert_eq(cmd_link(pk2, 0), 0, "link into three new directories");
    _test_write_file(_fsl_path_join(scope, ".k/mid/notes"), "the user's");
    assert_eq(cmd_unlink("cu2"), 0, "unlink");
    assert_eq(_sy_kind(scope, ".k/mid/deep"), HAPI_LP_ABSENT, "the emptied directory goes");
    assert_eq(_sy_kind(scope, ".k/mid"), HAPI_LP_DIRECTORY, "the one holding the user's file stays");
    assert_eq(_sy_kind(scope, ".k/mid/notes"), HAPI_LP_FILE, "...with the file");

    # No link removed, no directory removed: a link the user already
    # deleted leaves no proof, and a dry-run removes nothing.
    var pk3 = _cd_pkg(_test_scratch_dir(), "cu3", "a=.gone/a");
    assert_eq(cmd_link(pk3, 0), 0, "link");
    hapi_set_dry_run(1);
    assert_eq(cmd_unlink("cu3"), 0, "unlink --dry-run");
    hapi_set_dry_run(0);
    assert_eq(_sy_kind(scope, ".gone"), HAPI_LP_DIRECTORY, "dry-run removes no directory");
    hapi_unlink(_fsl_path_join(scope, ".gone/a"));
    assert_eq(cmd_unlink("cu3"), 0, "unlink a link that is already gone");
    assert_eq(_sy_kind(scope, ".gone"), HAPI_LP_DIRECTORY, "...leaves the directory: no proof");

    _test_clear_env();
    return 0;
}

fn test_rollback_and_prune_remove_made_dirs() {
    test_group("created_dir: rollback and sync --prune remove what they may");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    hapi_mkdir(_fsl_path_join(scope, ".empty"), 0x1C0);     # there before, and empty
    var pkg = _cd_pkg(_test_scratch_dir(), "cr", "a=.r/new/deep/a b=.r/new/b e=.empty/made/e");
    assert_eq(cmd_link(pkg, 0), 0, "link");
    assert_eq(cmd_rollback(), 0, "rollback");
    assert_eq(_sy_kind(scope, ".r"), HAPI_LP_ABSENT, "rollback removes the made directories, newest first");
    assert_eq(_sy_kind(scope, ".empty/made"), HAPI_LP_ABSENT, "...up to the outermost one it made");
    assert_eq(_sy_kind(scope, ".empty"), HAPI_LP_DIRECTORY, "...and not one further, empty or not");
    _cd_pkg(pkg, "cr", "a=.r/new/deep/a b=.r/new/b");

    # Rolling back an unlink re-makes the directory, and records it.
    assert_eq(cmd_link(pkg, 0), 0, "link again");
    assert_eq(cmd_checkpoint(), 0, "checkpoint");
    assert_eq(cmd_unlink("cr"), 0, "unlink");
    assert_eq(_sy_kind(scope, ".r"), HAPI_LP_ABSENT, "...which removed them");
    assert_eq(cmd_rollback(), 0, "roll the unlink back");
    assert_eq(_sy_kind(scope, ".r/new/deep/a"), HAPI_LP_SYMLINK, "the link is back");
    var re = _cd_entry(audit_path, _fsl_path_join(scope, ".r/new/deep/a"));
    assert(re != 0 && hae_created_dir(re) != 0, "...and its replayed entry records what it made again");

    # prune: a directory a dropped row made stays while a kept row needs it.
    var pp = _cd_pkg(_test_scratch_dir(), "cp", "a=.pr/a b=.pr/b c=.solo/c");
    assert_eq(cmd_link(pp, 0), 0, "link three rows");
    _cd_pkg(pp, "cp", "b=.pr/b");
    assert_eq(cmd_sync_run(pp, 1, 1), 0, "--prune two of three");
    assert_eq(_sy_kind(scope, ".solo"), HAPI_LP_ABSENT, "a directory only the dropped row used goes");
    assert_eq(_sy_kind(scope, ".pr"), HAPI_LP_DIRECTORY, "one a kept row still needs stays");
    assert_eq(_sy_kind(scope, ".pr/b"), HAPI_LP_SYMLINK, "...with its link");

    # A row moved within a directory only it used: prune empties and
    # removes the directory before the create re-makes it, so the new row
    # owns it and a later unlink removes it.
    var pm = _cd_pkg(_test_scratch_dir(), "cm", "a=.mv/a");
    assert_eq(cmd_link(pm, 0), 0, "link .mv/a");
    _cd_pkg(pm, "cm", "a2=.mv/a2");
    assert_eq(cmd_sync_run(pm, 1, 1), 0, "--prune it for .mv/a2");
    var em = _cd_entry(audit_path, _fsl_path_join(scope, ".mv/a2"));
    assert(em != 0 && hapi_cstr_eq(hae_created_dir(em), _fsl_path_join(scope, ".mv")) == 1,
      "the new row made .mv again, and owns it");
    assert_eq(cmd_unlink("cm"), 0, "unlink");
    assert_eq(_sy_kind(scope, ".mv"), HAPI_LP_ABSENT, "...so it goes with it");

    _test_clear_env();
    return 0;
}

fn test_created_dir_is_bounded() {
    test_group("created_dir: a record that is not its link's own removes nothing");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _cd_pkg(_test_scratch_dir(), "cb", "a=.b/a");
    # An empty directory exactly as long as the scope, but not on the link's
    # path, so only the prefix test can tell it is not the link's.
    var other = alloc(strlen(scope) + 1);
    memcpy(other, scope, strlen(scope) + 1);
    if (load8(other + strlen(other) - 1) == 57) { store8(other + strlen(other) - 1, 48); }
    else { store8(other + strlen(other) - 1, load8(other + strlen(other) - 1) + 1); }
    hapi_mkdir(other, 0x1C0);
    _ts_track(other);             # made here, so removed with the rest
    hapi_mkdir(_fsl_path_join(scope, ".b"), 0x1C0);
    var tgt = _fsl_path_join(scope, ".b/a");
    hapi_symlink(fsl_link_text(tgt, _fsl_path_join(pkg, "a")), tgt);
    # A hand-written (or edited) entry claiming a directory elsewhere.
    audit_append_link_created_r("cb", "1.0.0", "h", "a", ".b/a",
      _fsl_path_join(pkg, "a"), tgt, 0, other);
    assert_eq(cmd_unlink("cb"), 0, "unlink");
    assert_eq(_sy_kind(scope, ".b/a"), HAPI_LP_ABSENT, "the link is removed");
    assert_eq(link_probe_kind(link_probe(other)), HAPI_LP_DIRECTORY,
      "a claimed directory not on the link's path is left");
    assert_eq(_sy_kind(scope, ".b"), HAPI_LP_DIRECTORY, "...and so is the link's own, which it did not claim");
    assert_eq(fsl_rmdir_created(tgt, "/", 0), 0, "\"/\" is never a made directory");
    assert_eq(fsl_rmdir_created(tgt, tgt, 0), 0, "nor is the link's own path");
    assert_eq(fsl_rmdir_created(tgt, other, 0), 0, "nor a same-length directory off its path");
    assert_eq(_sy_kind(scope, ".b"), HAPI_LP_DIRECTORY, "...so the link's empty parent is left");

    # F-062: a made directory swapped for a symlink. The made tree is moved
    # aside, `.sw/new` now points at `out`, and the link hapi would expect
    # from there sits in `out/deep`. The walk must not resolve through it.
    var ps = _cd_pkg(_test_scratch_dir(), "cs", "a=.sw/new/deep/a");
    assert_eq(cmd_link(ps, 0), 0, "link into three new directories");
    var out = _test_scratch_dir();
    hapi_mkdir(_fsl_path_join(out, "deep"), 0x1C0);
    hapi_rename(_fsl_path_join(scope, ".sw/new"), _fsl_path_join(_test_scratch_dir(), "moved"));
    hapi_symlink(out, _fsl_path_join(scope, ".sw/new"));
    var swt = _fsl_path_join(scope, ".sw/new/deep/a");
    hapi_symlink(fsl_link_text(swt, _fsl_path_join(ps, "a")), _fsl_path_join(out, "deep/a"));
    assert_eq(cmd_unlink("cs"), 0, "unlink the link at its new place");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(out, "deep"))), HAPI_LP_DIRECTORY,
      "a directory reached through the swapped symlink is not removed");
    # ...and the same through rollback, which walks one link's chain.
    assert_eq(cmd_checkpoint(), 0, "checkpoint");
    var pr2 = _cd_pkg(_test_scratch_dir(), "cs2", "a=.sw2/new/deep/a");
    assert_eq(cmd_link(pr2, 0), 0, "link another");
    var out2 = _test_scratch_dir();
    hapi_mkdir(_fsl_path_join(out2, "deep"), 0x1C0);
    hapi_rename(_fsl_path_join(scope, ".sw2/new"), _fsl_path_join(_test_scratch_dir(), "moved"));
    hapi_symlink(out2, _fsl_path_join(scope, ".sw2/new"));
    var swt2 = _fsl_path_join(scope, ".sw2/new/deep/a");
    hapi_symlink(fsl_link_text(swt2, _fsl_path_join(pr2, "a")), _fsl_path_join(out2, "deep/a"));
    assert_eq(cmd_rollback(), 0, "roll it back");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(out2, "deep/a"))), HAPI_LP_ABSENT, "the link is reversed");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(out2, "deep"))), HAPI_LP_DIRECTORY,
      "...and rollback does not resolve through the swapped symlink either");

    # A symlink that fails after its directories were made takes them back:
    # a final component over NAME_MAX passes mkdir -p and fails symlink(2).
    var longname = alloc(301);
    var li = 0;
    while (li < 300) { store8(longname + li, 120); li = li + 1; }
    store8(longname + 300, 0);
    var lt = _fsl_path_join(_fsl_path_join(scope, ".mk/new"), longname);
    assert(link_create_r("../x", lt, 0) < 0, "a symlink with an over-long name fails");
    assert_eq(_sy_kind(scope, ".mk"), HAPI_LP_ABSENT, "...and the directories made for it are removed");

    # The F-018 take-back now takes back the directories it made too.
    var pt = _cd_pkg(_test_scratch_dir(), "ct", "a=.take/new/a");
    audit_test_fail_appends(1);
    assert_eq(cmd_link(pt, 0), 1, "a link whose entry is refused");
    audit_test_fail_appends(0);
    assert_eq(_sy_kind(scope, ".take"), HAPI_LP_ABSENT, "...leaves neither the link nor its directories");

    _test_clear_env();
    return 0;
}

fn test_sync_prune_cli() {
    test_group("cli: sync's --prune and --force (1.3.0)");

    var msg = _test_cat("hapi: `sync --force` needs `--prune`: on sync it only lifts prune's limit,\n",
      "  and sync never overwrites a conflict (that is `hapi link --force`)\n");
    _cli_expect(_cli_av("hapi sync pkg --force"), 2, "", msg, "sync --force alone is bad usage");
    _cli_expect(_cli_av("hapi --help"), 0, _cli_usage, "", "the usage text is unchanged within a run");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _sy_pkg(_test_scratch_dir(), "clip", "c1 c2 c3");
    var av = _cli_av("hapi sync");
    _cli_add(av, pkg);
    assert_eq(_cli_run(av), 0, "hapi sync <pkg>");
    _sy_pkg(pkg, "clip", "c1 c2");
    _cli_add(av, "--prune");
    assert_eq(_cli_run(av), 0, "hapi sync <pkg> --prune");
    assert_eq(_sy_kind(scope, ".c3"), HAPI_LP_ABSENT, "...pruned the dropped row");
    var tail = "pruned 1 (no longer in the manifest)\n";
    assert(_cli_out_n > strlen(tail) && memeq(_cli_out + _cli_out_n - strlen(tail), tail, strlen(tail)) == 1,
      "...and said so");

    var root = _test_scratch_dir();
    _sy_pkg(_fsl_path_join(root, "nvim"), "nvim", "init");
    sync_set_package_roots(root);
    assert_eq(_cli_run(_cli_av("hapi sync")), 0, "hapi sync with no package");
    assert_eq(_sy_kind(scope, ".init"), HAPI_LP_SYMLINK, "...synced the root's package");
    var sum = "synced 1 / 1 packages\n";
    assert(_cli_out_n > strlen(sum) && memeq(_cli_out + _cli_out_n - strlen(sum), sum, strlen(sum)) == 1,
      "...and summed it up");
    # `clip` was linked from outside the root: named, not synced.
    var note = _test_cat(_test_cat("hapi: note: the trail has live links for `clip` from ", pkg),
      ",\n  which no package root holds; not synced\n");
    assert(_test_substr(_cli_err, _cli_err_n, note) >= 0, "a trail package outside the roots is named");

    sync_set_package_roots(0);
    _test_clear_env();
    return 0;
}

# ------------------------------------------------------------
# 1.5.0 — status --quiet, checkpoint --label, rollback --steps / --to
# (ADR 0002, 1.5.0 addendum)
# ------------------------------------------------------------

# Link package `name`: one row, source `name`, target `.name`, from a
# package directory of its own.
fn _r15_link(name): i64 {
    var pkg = _sy_pkg(_fsl_path_join(_test_scratch_dir(), name), name, name);
    return cmd_link(pkg, 0);
}

fn _r15_live(scope, name): i64 {
    if (_sy_kind(scope, _test_cat(".", name)) == HAPI_LP_SYMLINK) { return 1; }
    return 0;
}

fn _r15_last(audit_path): i64 { return _test_nth_last(audit_path, 1); }

# The trail's `k`-th entry from the end (1 = the last), or an empty entry
# when the trail is shorter, so a failing test reports instead of aborting.
fn _test_nth_last(audit_path, k): i64 {
    var t = audit_read(audit_path);
    if (vec_len(t) < k) { return _hae_new(); }
    return vec_get(t, vec_len(t) - k);
}

# 1 when the trail's last entry is a closing marker with this `from`.
fn _r15_sealed_from(audit_path, from): i64 {
    var e = _r15_last(audit_path);
    if (hapi_cstr_eq(hae_op(e), "rollback-marker") == 0) { return 0; }
    return hapi_cstr_eq(hae_from(e), from);
}

# Append a hand-written line to the trail.
fn _r15_append_raw(audit_path, line): i64 {
    var fd = file_open(audit_path, O_WRONLY | O_CREAT | O_APPEND, 0x1A4);
    file_write(fd, line, strlen(line));
    file_close(fd);
    return 0;
}

fn test_status_quiet() {
    test_group("status --quiet: drift exits 0, only an error exits 1 (1.5.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _sy_pkg(_test_scratch_dir(), "q", "q1 q2");

    var av = _cli_av("hapi status");
    _cli_add(av, pkg);
    assert_eq(_cli_run(av), 1, "status: drift exits 1, as before");
    var out = _cli_out;
    var out_n = _cli_out_n;
    _cli_add(av, "--quiet");
    assert_eq(_cli_run(av), 0, "status --quiet: drift exits 0");
    assert(_cli_out_n == out_n && memeq(_cli_out, out, out_n) == 1, "...printing the same rows");
    assert_eq(_cli_err_n, 0, "...and nothing on stderr");
    cmd_link(pkg, 0);
    assert_eq(_cli_run(av), 0, "status --quiet: clean exits 0");

    # A target status cannot check is an error: a path through a file.
    var bad = _test_scratch_dir();
    _test_write_file(_fsl_path_join(bad, "hapi.cyml"),
      "[package]\nname = \"e\"\nversion = \"1.0.0\"\n\n[[link]]\nsource = \"x\"\ntarget = \"blk/.x\"\n");
    _test_write_file(_fsl_path_join(bad, "x"), "x");
    _test_write_file(_fsl_path_join(scope, "blk"), "a file in the way");
    var avb = _cli_av("hapi status --quiet");
    _cli_add(avb, bad);
    _cli_expect(avb, 1, 0, "hapi: 1 target could not be checked (ERROR above)\n",
      "status --quiet: a target that could not be checked exits 1");
    assert(_test_substr(_cli_out, _cli_out_n, "ERROR") >= 0, "...and its row says ERROR");
    var avn = _cli_av("hapi status");
    _cli_add(avn, bad);
    _cli_expect(avn, 1, 0, "", "status: the same, with nothing extra on stderr");

    _test_write_file(_fsl_path_join(bad, "hapi.cyml"), "garbage\n");
    assert_eq(_cli_run(avb), 1, "status --quiet: an unparseable manifest exits 1");
    assert_eq(_cli_run(_cli_av("hapi status --quiet")), 2, "status --quiet with no package is bad usage");
    assert_eq(_test_file_size(audit_path) > 0, 1, "seed: link wrote the trail");
    var size = _test_file_size(audit_path);
    _cli_run(av);
    assert_eq(_test_file_size(audit_path), size, "status --quiet writes no trail entry");

    _test_clear_env();
    return 0;
}

fn test_checkpoint_label() {
    test_group("checkpoint --label: names the marker (1.5.0)");

    var env = _test_fresh_env();
    var audit_path = load64(env + 8);
    assert_eq(cmd_checkpoint(), 0, "a plain checkpoint");
    assert_eq(cmd_checkpoint_label("pre-deploy"), 0, "a labelled one");
    var body = _cli_slurp(audit_path);
    assert(_test_substr(body, strlen(body), "\",\"op\":\"rollback-marker\"}\n") >= 0,
      "the plain marker is 1.4.0's, byte for byte");
    assert(_test_substr(body, strlen(body), "\",\"op\":\"rollback-marker\",\"label\":\"pre-deploy\"}\n") >= 0,
      "the label is written after op");
    var t = audit_read(audit_path);
    assert_eq(hae_label(vec_get(t, 0)), 0, "a plain marker reads back with no label");
    assert_eq(hapi_cstr_eq(hae_label(vec_get(t, 1)), "pre-deploy"), 1, "the label reads back");
    assert_eq(hae_lineno(vec_get(t, 1)), 2, "an entry knows its line");

    hapi_set_dry_run(1);
    var size = _test_file_size(audit_path);
    assert_eq(cmd_checkpoint_label("x"), 0, "checkpoint --label --dry-run");
    assert_eq(_test_file_size(audit_path), size, "...writes nothing");
    hapi_set_dry_run(0);

    var a64 = alloc(66);
    var i = 0;
    while (i < 65) { store8(a64 + i, 97); i = i + 1; }
    store8(a64 + 65, 0);
    assert_eq(audit_label_ok(a64), 0, "a label of 65 characters is refused");
    store8(a64 + 64, 0);
    assert_eq(audit_label_ok(a64), 1, "64 is accepted");
    assert_eq(audit_label_ok("Pre.deploy_2-x"), 1, "letters, digits, . _ -");
    assert_eq(audit_label_ok("a"), 1, "one character");
    assert_eq(audit_label_ok(""), 0, "empty is refused");
    assert_eq(audit_label_ok(0), 0, "none is refused");
    assert_eq(audit_label_ok("-x"), 0, "a leading - is refused");
    assert_eq(audit_label_ok("a b"), 0, "a space is refused");
    assert_eq(audit_label_ok("a/b"), 0, "a slash is refused");
    assert_eq(audit_label_ok("a:b"), 0, "a colon is refused");
    assert_eq(audit_label_ok("x\x1b[31m"), 0, "a control byte is refused");
    assert_eq(audit_label_ok("\xc3\xa9"), 0, "a non-ASCII byte is refused");

    _test_clear_env();
    return 0;
}

fn test_rollback_steps() {
    test_group("rollback --steps: one checkpoint window per step (1.5.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    _r15_link("sa");            # line 1
    cmd_checkpoint();           # 2
    _r15_link("sb");            # 3
    cmd_checkpoint();           # 4
    cmd_checkpoint();           # 5: back to back with 4, one step
    _r15_link("sc");            # 6

    assert_eq(cmd_rollback_run(1, 0), 0, "--steps 1");
    assert(_r15_live(scope, "sc") == 0 && _r15_live(scope, "sb") == 1, "...undoes the newest window only");
    assert_eq(_r15_sealed_from(audit_path, "6"), 1, "...and its marker records `from` 6");
    assert_eq(cmd_rollback_run(1, 0), 0, "--steps 1 again");
    assert(_r15_live(scope, "sb") == 0 && _r15_live(scope, "sa") == 1,
      "...steps over that range and two markers to the window before");
    assert_eq(_r15_sealed_from(audit_path, "3"), 1, "...from 3");
    assert_eq(cmd_rollback_run(1, 0), 0, "--steps 1 a third time");
    assert_eq(_r15_live(scope, "sa"), 0, "...reaches the start of the trail");
    assert_eq(_r15_sealed_from(audit_path, "1"), 1, "...from 1");
    var size = _test_file_size(audit_path);
    assert_eq(cmd_rollback_run(1, 0), 0, "--steps 1 with every entry rolled back exits 0");
    assert_eq(cmd_rollback(), 0, "so does the no-arg form");
    assert_eq(_test_file_size(audit_path), size, "...and neither writes");
    assert_eq(_sy_entries(audit_path), 12, "three undos, no replay: 6 + 3 unlinks + 3 markers");

    # Several steps at once, and more steps than there are.
    var env2 = _test_fresh_env();
    scope = load64(env2);
    audit_path = load64(env2 + 8);
    _r15_link("ta");
    cmd_checkpoint();
    _r15_link("tb");
    size = _test_file_size(audit_path);
    assert_eq(cmd_rollback_run(3, 0), 1, "--steps 3 with two steps is refused");
    assert(_test_file_size(audit_path) == size && _r15_live(scope, "ta") == 1 && _r15_live(scope, "tb") == 1,
      "...with nothing changed");
    hapi_set_dry_run(1);
    assert_eq(cmd_rollback_run(2, 0), 0, "--steps 2 --dry-run");
    assert(_test_file_size(audit_path) == size && _r15_live(scope, "ta") == 1, "...changes nothing");
    hapi_set_dry_run(0);
    assert_eq(cmd_rollback_run(2, 0), 0, "--steps 2");
    assert(_r15_live(scope, "ta") == 0 && _r15_live(scope, "tb") == 0, "...undoes both windows");
    assert_eq(_r15_sealed_from(audit_path, "1"), 1, "...in one range, from 1");

    # After the no-arg form, a step goes one further: a multi-level undo.
    var env3 = _test_fresh_env();
    scope = load64(env3);
    audit_path = load64(env3 + 8);
    _r15_link("ua");
    cmd_checkpoint();
    _r15_link("ub");
    assert_eq(cmd_rollback(), 0, "the no-arg form");
    assert_eq(_r15_sealed_from(audit_path, "3"), 1, "...records `from` too");
    assert_eq(cmd_rollback_run(1, 0), 0, "then --steps 1");
    assert(_r15_live(scope, "ua") == 0, "...undoes the window before");
    assert_eq(_sy_entries(audit_path), 7, "...without replaying the first undo");

    # A window whose entries need no reversal is still sealed by --steps,
    # so the next step moves on; the no-arg form keeps its 1.1.1 rule.
    var env4 = _test_fresh_env();
    scope = load64(env4);
    audit_path = load64(env4 + 8);
    _r15_link("va");
    cmd_checkpoint();
    _r15_link("vb");
    hapi_unlink(_fsl_path_join(scope, ".vb"));
    size = _test_file_size(audit_path);
    assert_eq(cmd_rollback(), 0, "no-arg over a window already undone by hand");
    assert_eq(_test_file_size(audit_path), size, "...writes no marker");
    assert_eq(cmd_rollback_run(1, 0), 0, "--steps 1 over the same window");
    assert_eq(_r15_sealed_from(audit_path, "3"), 1, "...seals it");
    assert_eq(cmd_rollback_run(1, 0), 0, "--steps 1 again");
    assert_eq(_r15_live(scope, "va"), 0, "...moves on to the window before");

    # A rollback from before 1.5.0 closed with a plain marker. It counts as
    # a checkpoint, and its range is replayed: no net change, one step used.
    var env5 = _test_fresh_env();
    scope = load64(env5);
    audit_path = load64(env5 + 8);
    _r15_link("wa");
    cmd_checkpoint();
    _r15_link("wb");
    cmd_unlink("wb");
    audit_append_rollback_marker_r();
    assert_eq(cmd_rollback_run(1, 0), 0, "--steps 1 over a 1.4.0 rollback");
    assert(_r15_live(scope, "wb") == 0 && _r15_live(scope, "wa") == 1, "...replays it to the same state");
    assert_eq(cmd_rollback_run(1, 0), 0, "the next step");
    assert_eq(_r15_live(scope, "wa"), 0, "...goes on to the window before");

    _test_clear_env();
    return 0;
}

# A closing marker's `from` is trusted only when it names a line before
# the marker's own; anything else makes it a checkpoint. Line 1 links ra,
# line 2 is the marker, line 3 links rb. As a checkpoint the marker makes
# two steps; as the end of a range covering line 1, one.
fn _r15_from_case(from, steps_found): i64 {
    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    _r15_link("ra");
    _r15_append_raw(audit_path,
      _test_cat(_test_cat("{\"ts\":\"2026-10-28T00:00:00Z\",\"op\":\"rollback-marker\",\"from\":\"", from), "\"}\n"));
    _r15_link("rb");
    var label = _test_cat("`from` ", from);
    if (steps_found == 2) {
        assert_eq(cmd_rollback_run(2, 0), 0, _test_cat(label, " is a checkpoint: --steps 2 runs"));
        assert_eq(_r15_live(scope, "ra"), 0, _test_cat(label, " ...and reaches line 1"));
    } else {
        assert_eq(cmd_rollback_run(2, 0), 1, _test_cat(label, " ends a range: --steps 2 is refused"));
        assert_eq(_r15_live(scope, "ra"), 1, _test_cat(label, " ...and line 1 is left"));
    }
    return 0;
}

fn test_rollback_from_is_validated() {
    test_group("rollback: a closing marker's `from` is checked before it is trusted (1.5.0)");

    _r15_from_case("1", 1);
    _r15_from_case("2", 2);                    # its own line
    _r15_from_case("9", 2);                    # past it
    _r15_from_case("0", 2);
    _r15_from_case("", 2);
    _r15_from_case("x", 2);
    _r15_from_case("-1", 2);
    _r15_from_case("1x", 2);
    _r15_from_case("1234567890123456789", 2);  # 19 digits
    # Each of these would read as 1 without the guard that refuses it: a
    # non-digit, and a number that wraps (2^64 + 1).
    _r15_from_case("/;", 2);
    _r15_from_case("18446744073709551617", 2);
    _test_clear_env();
    return 0;
}

# A run that hit an error writes no closing marker, so that it can be
# re-run (F-056): in every form. Here the error is an adopt reversal whose
# manifest row could not be removed, which leaves the trail writable.
fn test_rollback_errored_run_is_not_sealed() {
    test_group("rollback: an errored run is not sealed, in any form (1.5.0)");

    var forms = 0;
    while (forms < 2) {
        var env = _test_fresh_env();
        var scope = load64(env);
        var audit_path = load64(env + 8);
        var pkg = _test_make_package(0, 0);
        var mpath = _fsl_path_join(pkg, "hapi.cyml");
        _test_write_file(_fsl_path_join(scope, ".zshrc"), "user content");
        assert_eq(cmd_adopt(".zshrc", pkg), 0, "seed: adopt");
        var stage = _t111_plant_staging(mpath);
        var rc = 0;
        if (forms == 0) { rc = cmd_rollback(); } else { rc = cmd_rollback_run(1, 0); }
        var label = "rollback";
        if (forms == 1) { label = "rollback --steps 1"; }
        assert_eq(rc, 1, _test_cat(label, ": the row left behind is an error"));
        assert_eq(hapi_cstr_eq(hae_op(_r15_last(audit_path)), "unadopt"), 1,
          _test_cat(label, ": ...and no closing marker follows the reversal"));
        hapi_unlink(stage);
        forms = forms + 1;
    }
    _test_clear_env();
    return 0;
}

fn test_rollback_to_label() {
    test_group("rollback --to: back to a labelled checkpoint (1.5.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    cmd_checkpoint_label("k");      # line 1
    _r15_link("ya");                # 2
    cmd_checkpoint_label("L");      # 3
    _r15_link("yb");                # 4
    _r15_link("yc");                # 5
    cmd_rollback();                 # 6, 7: unlinks; 8: marker from 4
    _r15_link("yd");                # 9
    assert(_r15_live(scope, "yb") == 0 && _r15_live(scope, "yd") == 1, "seed");

    assert_eq(cmd_rollback_run(0, "L"), 0, "--to L");
    assert(_r15_live(scope, "yd") == 0 && _r15_live(scope, "ya") == 1, "...undoes what came after L");
    assert_eq(_sy_entries(audit_path), 11, "...without replaying the earlier rollback (one unlink, one marker)");
    assert_eq(_r15_sealed_from(audit_path, "4"), 1, "...one range from L's next line");
    var size = _test_file_size(audit_path);
    assert_eq(cmd_rollback_run(0, "L"), 0, "--to L again: nothing to do, exit 0");
    assert_eq(cmd_rollback_run(0, "nope"), 1, "--to an unknown label exits 1");
    assert_eq(_test_file_size(audit_path), size, "...and neither writes");
    assert_eq(cmd_rollback_run(0, "k"), 0, "--to k");
    assert_eq(_r15_live(scope, "ya"), 0, "...goes past L");
    size = _test_file_size(audit_path);
    assert_eq(cmd_rollback_run(0, "L"), 0, "--to L, now inside a rolled-back range: exit 0");
    assert_eq(_test_file_size(audit_path), size, "...writing nothing");

    # The most recent marker with the label is the one.
    cmd_checkpoint_label("d");
    _r15_link("ye");
    cmd_checkpoint_label("d");
    _r15_link("yf");
    assert_eq(cmd_rollback_run(0, "d"), 0, "--to a label used twice");
    assert(_r15_live(scope, "yf") == 0 && _r15_live(scope, "ye") == 1, "...goes to the most recent");

    # F-061: a reversal whose entry the trail refuses is taken back, and the
    # range is not sealed.
    _r15_link("yg");
    audit_test_fail_appends(1);
    assert_eq(cmd_rollback_run(0, "d"), 1, "--to with the trail refusing entries exits 1");
    audit_test_fail_appends(0);
    assert_eq(_r15_live(scope, "yg"), 1, "...the link is put back");
    assert_eq(hapi_cstr_eq(hae_op(_r15_last(audit_path)), "link"), 1, "...and no marker was written");
    assert_eq(cmd_rollback_run(0, "d"), 0, "re-run once the trail takes writes");
    assert_eq(_r15_live(scope, "yg"), 0, "...undoes it");

    _test_clear_env();
    return 0;
}

# --steps names the marker it goes back to, from the trail. A label or ts
# a hand edit made unprintable is left out, not written to the terminal.
fn test_rollback_names_only_printable_fields() {
    test_group("rollback --steps: prints a marker's label and ts only when printable (1.5.0)");

    var env = _test_fresh_env();
    var audit_path = load64(env + 8);
    _r15_link("pa");
    _r15_append_raw(audit_path,
      "{\"ts\":\"2026\u001b[2J\",\"op\":\"rollback-marker\",\"label\":\"x\u001b]0;t\u0007\"}\n");
    _r15_link("pb");
    assert_eq(_cli_run(_cli_av("hapi rollback --steps 1")), 0, "rollback --steps 1");
    var head = "rolling back 1 step, to the checkpoint on line 2\n";
    assert(_cli_out_n > strlen(head) && memeq(_cli_out, head, strlen(head)) == 1,
      "...names the marker by its line alone");
    assert_eq(_test_substr(_cli_out, _cli_out_n, "\x1b"), 0 - 1, "...and prints no escape byte");
    _test_clear_env();
    return 0;
}

fn test_cli_script_flags() {
    test_group("cli: 1.5.0's flags, each on its own verb");

    var verbs = _cli_av("inspect link unlink adopt rollback checkpoint status list check sync");
    var i = 0;
    while (i < load64(verbs)) {
        var v = load64(verbs + 8 + i * 8);
        _cli_flag_probe(v, "--quiet", 0, hapi_cstr_eq(v, "status"));
        _cli_flag_probe(v, "--steps", 1, hapi_cstr_eq(v, "rollback"));
        _cli_flag_probe(v, "--to", 1, hapi_cstr_eq(v, "rollback"));
        _cli_flag_probe(v, "--label", 1, hapi_cstr_eq(v, "checkpoint"));
        i = i + 1;
    }

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var steps = "hapi: --steps takes a whole number from 1 to 999999999\n";
    var to = "hapi: --to takes a label: 1 to 64 characters from A-Z a-z 0-9 . _ -,\n  not starting with -\n";
    var lab = "hapi: --label takes a label: 1 to 64 characters from A-Z a-z 0-9 . _ -,\n  not starting with -\n";
    _cli_expect(_cli_av("hapi rollback --steps 0"), 2, "", steps, "--steps 0");
    _cli_expect(_cli_av("hapi rollback --steps x"), 2, "", steps, "--steps x");
    _cli_expect(_cli_av("hapi rollback --steps -1"), 2, "", steps, "--steps -1");
    _cli_expect(_cli_av("hapi rollback --steps 1x"), 2, "", steps, "--steps 1x");
    _cli_expect(_cli_av("hapi rollback --steps 1000000000"), 2, "", steps, "--steps past nine digits");
    _cli_expect(_cli_av("hapi rollback --steps"), 2, "", steps, "--steps with no value");
    _cli_expect(_cli_av("hapi rollback --steps="), 2, "", steps, "--steps=");
    _cli_expect(_cli_av("hapi rollback --steps x --steps 1"), 2, "", steps, "every --steps is checked");
    _cli_expect(_cli_av("hapi rollback --to"), 2, "", to, "--to with no value");
    _cli_expect(_cli_av("hapi rollback --to --dry-run"), 2, "", to, "--to takes no flag as its label");
    _cli_expect(_cli_av("hapi rollback --to=-x"), 2, "", to, "--to=-x");
    _cli_expect(_cli_av("hapi rollback --to a/b"), 2, "", to, "--to a/b");
    _cli_expect(_cli_av("hapi checkpoint --label"), 2, "", lab, "--label with no value");
    _cli_expect(_cli_av("hapi checkpoint --label="), 2, "", lab, "--label=");
    var avs = _cli_av("hapi checkpoint --label");
    _cli_add(avs, "a b");
    _cli_expect(avs, 2, "", lab, "--label with a space");
    _cli_expect(_cli_av("hapi rollback --steps 1 --to k"), 2, "",
      "hapi: `rollback` takes --steps or --to, not both\n", "--steps and --to together");
    assert_eq(_test_file_size(audit_path), 0, "no usage error touched the trail");

    _r15_link("za");
    _cli_expect(_cli_av("hapi checkpoint --label pre"), 0, "checkpoint `pre` written\n", "",
      "hapi checkpoint --label pre");
    _cli_expect(_cli_av("hapi checkpoint --label=x --dry-run"), 0,
      "checkpoint `x` (dry-run; no entry written)\n", "", "--label=x --dry-run");
    _cli_reset(scope);
    _r15_link("zb");
    assert_eq(_r15_live(scope, "zb"), 1, "seed: zb is linked for real");
    assert_eq(_cli_run(_cli_av("hapi rollback --to pre")), 0, "hapi rollback --to pre");
    var head = "rolling back to checkpoint `pre` on line 2 (";
    assert(_cli_out_n > strlen(head) && memeq(_cli_out, head, strlen(head)) == 1, "...names where it goes");
    assert(_r15_live(scope, "zb") == 0 && _r15_live(scope, "za") == 1, "...and goes there");
    assert_eq(_cli_run(_cli_av("hapi rollback --steps 1")), 0, "hapi rollback --steps 1");
    head = "rolling back 1 step, to the start of the trail\n";
    assert(_cli_out_n > strlen(head) && memeq(_cli_out, head, strlen(head)) == 1, "...names where it goes");
    assert_eq(_r15_live(scope, "za"), 0, "...and goes there");
    _cli_expect(_cli_av("hapi rollback --steps 2"), 0,
      "nothing to roll back (every entry is already rolled back)\n", "", "nothing left to step back over");

    _test_clear_env();
    return 0;
}

# ------------------------------------------------------------
# 1.6.0 — `--absolute`: absolute link targets (ADR 0003 addendum)
# ------------------------------------------------------------

# The text of the symlink at `path`, or 0.
fn _ab_text(path): i64 {
    var probe = link_probe(path);
    if (link_probe_kind(probe) != HAPI_LP_SYMLINK) { return 0; }
    return link_probe_target(probe);
}

# 1 when the trail's last line ends with `tail` — how a test pins a
# field's bytes and its place in the line.
fn _ab_last_line_ends(audit_path, tail): i64 {
    var body = _cli_slurp(audit_path);
    var n = strlen(body);
    var t = strlen(tail);
    if (n < t) { return 0; }
    return memeq(body + n - t, tail, t);
}

fn test_absolute_text_helpers() {
    test_group("--absolute: the absolute text and what counts as hapi's (1.6.0)");

    assert_eq(hapi_cstr_eq(fsl_absolute_text("/p/./a"), "/p/a"), 1, "the text is lexically normalized");
    assert_eq(hapi_cstr_eq(fsl_absolute_text("/p/q//a"), "/p/q/a"), 1, "...an empty segment dropped");
    assert_eq(fsl_is_absolute_text("/p/a", "/p/./a"), 1, "the absolute text of the source is accepted");
    assert_eq(fsl_is_absolute_text("/p/./a", "/p/./a"), 0, "...only in its normalized spelling");
    assert_eq(fsl_is_absolute_text("/p/b", "/p/a"), 0, "another source's path is not");
    assert_eq(fsl_is_absolute_text("/p/a", "/p/ab"), 0, "...nor a prefix of the source's path");
    assert_eq(fsl_is_absolute_text("/p/a/", "/p/a"), 0, "...nor a trailing slash");
    assert_eq(fsl_is_absolute_text("p/a", "/p/a"), 0, "a relative text is not");
    assert_eq(fsl_is_absolute_text(0, "/p/a"), 0, "no text is not");
    assert_eq(hapi_cstr_eq(fsl_shape_of("/p/a"), "absolute"), 1, "an absolute text's shape is absolute");
    assert_eq(fsl_shape_of("../p/a"), 0, "a relative one has none");
    assert_eq(fsl_shape_of(0), 0, "...nor does no text");
    assert_eq(fsl_link_text_matches("/p/a", "/h/.a", "/p/a"), 1, "removal accepts the absolute text");
    assert_eq(hapi_cstr_eq(fsl_link_text_shaped("/h/.a", "/p/a", 1), "/p/a"), 1, "shaped, absolute");
    assert_eq(hapi_cstr_eq(fsl_link_text_shaped("/h/.a", "/h/p/a", 0), "p/a"), 1, "shaped, relative");
    return 0;
}

fn test_absolute_link() {
    test_group("--absolute: link writes absolute targets and records the shape (1.6.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _cd_pkg(_test_scratch_dir(), "ab", "./a=.a b=d/e/.b");
    var ta = _fsl_path_join(scope, ".a");
    var tb = _fsl_path_join(scope, "d/e/.b");

    hapi_set_absolute(1);
    assert_eq(cmd_link(pkg, 0), 0, "link --absolute");
    hapi_set_absolute(0);
    assert_eq(hapi_cstr_eq(_ab_text(ta), _fsl_path_join(pkg, "a")), 1,
      "the text is the source's absolute path, normalized");
    assert_eq(hapi_cstr_eq(_ab_text(tb), _fsl_path_join(pkg, "b")), 1, "...for a nested target too");
    assert_eq(_test_file_size(tb), 1, "...and the link resolves");
    assert_eq(hapi_cstr_eq(hae_shape(_cd_entry(audit_path, ta)), "absolute"), 1,
      "the entry records shape absolute");
    var tail = _test_cat(_test_cat("\"created_dir\":\"", _fsl_path_join(scope, "d")), "\",\"shape\":\"absolute\"}\n");
    assert_eq(_ab_last_line_ends(audit_path, tail), 1, "...last, after created_dir");

    var n = _sy_entries(audit_path);
    assert_eq(cmd_link(pkg, 0), 0, "a plain link over the absolute links");
    assert_eq(cmd_sync(pkg), 0, "a plain sync");
    assert_eq(_sy_entries(audit_path), n, "...are both up to date, writing nothing");
    assert_eq(cmd_status(pkg), 0, "status calls them OK, with no flag and no trail");

    # The relative default writes no field at all.
    var env2 = _test_fresh_env();
    audit_path = load64(env2 + 8);
    var rp = _cd_pkg(_test_scratch_dir(), "rl", "r=.r");
    assert_eq(cmd_link(rp, 0), 0, "a plain link");
    var body = _cli_slurp(audit_path);
    assert_eq(_test_substr(body, strlen(body), "shape"), 0 - 1, "...writes no shape field");

    _test_clear_env();
    return 0;
}

fn test_absolute_either_shape() {
    test_group("--absolute: a link of either shape is hapi's, and only those (1.6.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _cd_pkg(_test_scratch_dir(), "es", "a=.a b=.b c=.c");
    var ta = _fsl_path_join(scope, ".a");
    var tb = _fsl_path_join(scope, ".b");
    var tc = _fsl_path_join(scope, ".c");
    assert_eq(cmd_link(pkg, 0), 0, "plain link: relative");
    var n = _sy_entries(audit_path);
    hapi_set_absolute(1);
    assert_eq(cmd_link(pkg, 0), 0, "link --absolute over relative links");
    hapi_set_absolute(0);
    assert_eq(_sy_entries(audit_path), n, "...is up to date: the flag does not re-shape a link");
    assert_eq(load8(_ab_text(ta)), 46, "...the relative text stays");

    # A user swaps .a for the absolute text: still hapi's everywhere.
    hapi_unlink(ta);
    hapi_symlink(_fsl_path_join(pkg, "a"), ta);
    # .b gets an absolute path that is not normalized: not hapi's text.
    hapi_unlink(tb);
    hapi_symlink(_test_cat(pkg, "/./b"), tb);
    # .c points at another file of the package, absolutely.
    hapi_unlink(tc);
    hapi_symlink(_fsl_path_join(pkg, "a"), tc);
    assert_eq(cmd_status(pkg), 1, "status: drift on .b and .c");
    assert_eq(cmd_link(pkg, 0), 1, "link refuses .b and .c as conflicts");
    assert_eq(cmd_unlink("es"), 1, "unlink refuses .b and .c");
    assert_eq(link_probe_kind(link_probe(ta)), HAPI_LP_ABSENT, "...and removes the absolute .a");
    assert_eq(link_probe_kind(link_probe(tb)), HAPI_LP_SYMLINK, "...leaving the unnormalized .b");
    assert_eq(link_probe_kind(link_probe(tc)), HAPI_LP_SYMLINK, "...and the other-source .c");
    assert_eq(hapi_cstr_eq(hae_shape(_r15_last(audit_path)), "absolute"), 1,
      "the unlink entry records the shape it removed");

    _test_clear_env();
    return 0;
}

fn test_absolute_rollback_and_prune() {
    test_group("--absolute: rollback re-creates the shape removed, and takes no flag (1.6.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _cd_pkg(_test_scratch_dir(), "rb", "a=.a b=.b");
    var ta = _fsl_path_join(scope, ".a");
    var tb = _fsl_path_join(scope, ".b");
    hapi_set_absolute(1);
    cmd_link(pkg, 0);
    hapi_set_absolute(0);
    cmd_checkpoint();
    assert_eq(cmd_unlink("rb"), 0, "unlink the absolute links");
    hapi_set_absolute(0);
    assert_eq(cmd_rollback(), 0, "rollback the unlink");
    assert_eq(hapi_cstr_eq(_ab_text(ta), _fsl_path_join(pkg, "a")), 1, "the link comes back absolute");
    assert_eq(hapi_cstr_eq(hae_shape(_cd_entry(audit_path, ta)), "absolute"), 1,
      "...and its replayed entry says so");

    # Rolling back the link itself removes the absolute link, and its
    # unlink entry records the shape.
    var env4 = _test_fresh_env();
    var s4 = load64(env4);
    var a4 = load64(env4 + 8);
    var p4 = _cd_pkg(_test_scratch_dir(), "rl4", "x=.x");
    hapi_set_absolute(1);
    cmd_link(p4, 0);
    hapi_set_absolute(0);
    assert_eq(cmd_rollback(), 0, "rollback an absolute link");
    assert_eq(_sy_kind(s4, ".x"), HAPI_LP_ABSENT, "...removes it");
    var u4 = _test_nth_last(a4, 2);
    assert(hapi_cstr_eq(hae_op(u4), "unlink") == 1 && hapi_cstr_eq(hae_shape(u4), "absolute") == 1,
      "...and its unlink entry records the shape");
    _test_fresh_env();
    link_set_scope_root(scope);
    audit_set_trail_path(audit_path);

    # A relative unlink comes back relative even when the flag is set:
    # rollback follows the trail, never the run.
    cmd_unlink("rb");
    cmd_link(pkg, 0);                    # relative now
    cmd_checkpoint();
    cmd_unlink("rb");
    hapi_set_absolute(1);
    assert_eq(cmd_rollback(), 0, "rollback with --absolute set by a test");
    hapi_set_absolute(0);
    assert_eq(load8(_ab_text(tb)), 46, "the relative link comes back relative");
    assert_eq(hae_shape(_cd_entry(audit_path, tb)), 0, "...with no shape on its entry");

    # A `shape` hapi does not know is the relative default.
    var env2 = _test_fresh_env();
    scope = load64(env2);
    audit_path = load64(env2 + 8);
    var p2 = _cd_pkg(_test_scratch_dir(), "uk", "u=.u");
    var tu = _fsl_path_join(scope, ".u");
    cmd_link(p2, 0);
    cmd_checkpoint();
    hapi_unlink(tu);
    var head = _test_cat("{\"ts\":\"2026-10-28T00:00:00Z\",\"op\":\"unlink\",\"pkg\":\"uk\",",
      "\"source\":\"u\",\"target\":\".u\",\"abs_source\":\"");
    var line = _test_cat(_test_cat(_test_cat(_test_cat(head,
      _fsl_path_join(p2, "u")), "\",\"abs_target\":\""), tu), "\",\"shape\":\"sideways\"}\n");
    _r15_append_raw(audit_path, line);
    assert_eq(cmd_rollback(), 0, "rollback of an unlink with an unknown shape");
    assert_eq(load8(_ab_text(tu)), 46, "...re-creates the relative link");
    # An absolute-shaped unlink whose abs_source is not absolute is skipped.
    cmd_checkpoint();
    hapi_unlink(tu);
    var bad = _test_cat(_test_cat(_test_cat(head, "u\",\"abs_target\":\""),
      tu), "\",\"shape\":\"absolute\"}\n");
    _r15_append_raw(audit_path, bad);
    assert_eq(cmd_rollback(), 0, "rollback of an absolute unlink with a relative abs_source");
    assert_eq(link_probe_kind(link_probe(tu)), HAPI_LP_ABSENT, "...creates nothing");
    assert_eq(fsl_link_text_shaped("/h/.a", "p/a", 1), 0, "the shaped text refuses a relative source");

    # Prune removes an absolute link and records it.
    var env3 = _test_fresh_env();
    scope = load64(env3);
    audit_path = load64(env3 + 8);
    var p3 = _sy_pkg(_test_scratch_dir(), "pr", "p1 p2 p3");
    hapi_set_absolute(1);
    assert_eq(cmd_sync(p3), 0, "sync --absolute");
    _sy_pkg(p3, "pr", "p1 p2");
    assert_eq(cmd_sync_run(p3, 1, 0), 0, "sync --absolute --prune");
    hapi_set_absolute(0);
    assert_eq(_sy_kind(scope, ".p3"), HAPI_LP_ABSENT, "...prunes the absolute link");
    assert_eq(hapi_cstr_eq(hae_shape(_r15_last(audit_path)), "absolute"), 1, "...recording its shape");

    _test_clear_env();
    return 0;
}

fn test_absolute_adopt() {
    test_group("--absolute: adopt links back absolutely, and rollback undoes it (1.6.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var audit_path = load64(env + 8);
    var pkg = _test_make_package(0, 0);
    var home_file = _fsl_path_join(scope, ".zshrc");
    _test_write_file(home_file, "user content");
    hapi_set_absolute(1);
    assert_eq(cmd_adopt(".zshrc", pkg), 0, "adopt --absolute");
    hapi_set_absolute(0);
    var src = _fsl_path_join(pkg, "zshrc");
    assert_eq(hapi_cstr_eq(_ab_text(home_file), src), 1, "the link back is absolute");
    assert_eq(hapi_cstr_eq(hae_shape(_r15_last(audit_path)), "absolute"), 1, "...and the adopt entry says so");
    assert_eq(cmd_rollback(), 0, "rollback the adopt");
    assert_eq(link_probe_kind(link_probe(home_file)), HAPI_LP_FILE, "the file is back");
    var un = _test_nth_last(audit_path, 2);
    assert(hapi_cstr_eq(hae_op(un), "unadopt") == 1 && hapi_cstr_eq(hae_shape(un), "absolute") == 1,
      "the unadopt entry records the shape it removed");

    _test_clear_env();
    return 0;
}

# F-046 cannot happen to an absolute link: its text does not depend on the
# directory the link sits in.
fn test_absolute_under_symlinked_parent() {
    test_group("--absolute: a link under a symlinked parent resolves (1.6.0)");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _t111_deep_config(scope);
    var tgt = _fsl_path_join(scope, ".config/rc");
    hapi_set_absolute(1);
    assert_eq(cmd_link(pkg, 0), 0, "link --absolute");
    hapi_set_absolute(0);
    assert_eq(_test_file_size(tgt), 10, "the link resolves to the source");
    assert_eq(cmd_status(pkg), 0, "status agrees");
    assert_eq(cmd_unlink("p"), 0, "unlink removes it");
    _test_clear_env();
    return 0;
}

fn test_cli_absolute() {
    test_group("cli: --absolute on link, adopt and sync only (1.6.0)");

    var verbs = _cli_av("inspect link unlink adopt rollback checkpoint status list check sync");
    var i = 0;
    while (i < load64(verbs)) {
        var v = load64(verbs + 8 + i * 8);
        var takes = 0;
        if (hapi_cstr_eq(v, "link") == 1 || hapi_cstr_eq(v, "adopt") == 1 || hapi_cstr_eq(v, "sync") == 1) {
            takes = 1;
        }
        _cli_flag_probe(v, "--absolute", 0, takes);
        i = i + 1;
    }
    _cli_expect(_cli_av("hapi link pkg --absolute=1"), 2, "", _cli_unexpected_flag("link", "--absolute=1"),
      "--absolute takes no value");

    var env = _test_fresh_env();
    var scope = load64(env);
    var pkg = _cd_pkg(_test_scratch_dir(), "cl", "a=.a");
    var av = _cli_av("hapi link --absolute");
    _cli_add(av, pkg);
    assert_eq(_cli_run(av), 0, "hapi link --absolute <pkg>");
    var want = _test_cat(_test_cat(_test_cat(_test_cat("  + ", _fsl_path_join(scope, ".a")), " -> "),
      _fsl_path_join(pkg, "a")), "\n");
    assert(_cli_out_n > strlen(want) && memeq(_cli_out, want, strlen(want)) == 1, "...prints the absolute text");
    assert_eq(hapi_cstr_eq(_ab_text(_fsl_path_join(scope, ".a")), _fsl_path_join(pkg, "a")), 1,
      "...and writes it");
    _cli_reset(scope);
    assert_eq(hapi_absolute(), 0, "the test reset clears the flag");

    _test_clear_env();
    return 0;
}

# ------------------------------------------------------------
# 1.7.0 — `hapi fmt`: the header as hapi_mf_canonicalize's bytes
# ------------------------------------------------------------

# A package directory whose hapi.cyml holds `text`; returns its path.
fn _fm_pkg(text): i64 { return _test_manifest_at(_test_scratch_dir(), text); }

fn _fm_bytes(pkg): i64 { return _cli_slurp(_fsl_path_join(pkg, "hapi.cyml")); }

fn _fm_is(pkg, want): i64 { return hapi_cstr_eq(_fm_bytes(pkg), want); }

fn _fm_hash(pkg): i64 { return audit_manifest_hash(_fsl_path_join(pkg, "hapi.cyml")); }

fn _fm_messy(): i64 {
    return _test_cat("[package]\nversion=\"1.0.0\"\nname =   \"p\"\nignore = [\"*.bak\",   \"x\"]\n\n",
      "[[link]]\ntarget=\".zrc\"\nsource=\"zrc\"\n[[link]]\nsource = \"a\"\ntarget = \".a\"\n\n");
}

fn _fm_canon(): i64 {
    return _test_cat("[package]\nname = \"p\"\nversion = \"1.0.0\"\nignore = [\"*.bak\", \"x\"]\n\n",
      "[[link]]\nsource = \"a\"\ntarget = \".a\"\n\n[[link]]\nsource = \"zrc\"\ntarget = \".zrc\"\n");
}

fn test_fmt_formats() {
    test_group("fmt: writes the canonical header and keeps the hash (1.7.0)");

    var body = "---\n# Body\nkept   as is\n[[link]]\nsource = \"not a row\"\n";
    var pkg = _fm_pkg(_test_cat(_fm_messy(), body));
    var h0 = _fm_hash(pkg);
    assert(h0 != 0, "seed: the manifest hashes");
    assert_eq(cmd_fmt_run(pkg, 1, 0), 1, "--check on an unformatted manifest exits 1");
    assert_eq(_fm_is(pkg, _test_cat(_fm_messy(), body)), 1, "...and writes nothing");
    assert_eq(cmd_fmt(pkg), 0, "fmt");
    assert_eq(_fm_is(pkg, _test_cat(_test_cat(_fm_canon(), "\n"), body)), 1,
      "the header is the canonical bytes, then a blank line, then the body byte for byte");
    assert_eq(hapi_cstr_eq(_fm_hash(pkg), h0), 1, "the manifest hash is unchanged");
    assert_eq(cmd_fmt_run(pkg, 1, 0), 0, "--check now exits 0");
    assert_eq(cmd_fmt(pkg), 0, "a second fmt");
    assert_eq(_fm_is(pkg, _test_cat(_test_cat(_fm_canon(), "\n"), body)), 1, "...changes nothing");

    # Without a body the file is exactly the canonical bytes.
    var p2 = _fm_pkg(_fm_messy());
    assert_eq(cmd_fmt(p2), 0, "fmt a manifest with no body");
    assert_eq(_fm_is(p2, _fm_canon()), 1, "...is the canonical bytes exactly");

    # The canonical form is what hapi_mf_format_r produces, and it proves it.
    var f_t, f_v = hapi_mf_format_r(_fm_messy(), strlen(_fm_messy()), 0);
    assert_eq(is_err_result(f_t), 0, "hapi_mf_format_r parses");
    assert_eq(vec_len(hapi_fmt_drops(f_v)), 0, "...a clean header drops nothing");
    assert_eq(hapi_fmt_proven(f_v), 1, "...and its output reads back as itself");
    assert_eq(hapi_fmt_out_len(f_v), strlen(_fm_canon()), "...in the canonical length");
    return 0;
}

# Each kind of content the parse skips is named, with its line; the run
# refuses, and --force drops it.
fn _fm_drop_case(text, what, line): i64 {
    var pkg = _fm_pkg(text);
    var av = _cli_av("hapi fmt");
    _cli_add(av, pkg);
    var want = _test_cat(_test_cat(_test_cat("  line ", line), ": "), what);
    assert_eq(_cli_run(av), 1, _test_cat(what, ": refused"));
    assert(_test_substr(_cli_err, _cli_err_n, want) >= 0, _test_cat(what, ": named, with its line"));
    assert_eq(_fm_is(pkg, text), 1, _test_cat(what, ": the file is untouched"));
    assert_eq(cmd_fmt_run(pkg, 0, 1), 0, _test_cat(what, ": --force formats"));
    hapi_mf_set_strict(1);
    var r_t, r_v = hapi_mf_parse_file_r(_fsl_path_join(pkg, "hapi.cyml"));
    hapi_mf_set_strict(0);
    assert_eq(is_err_result(r_t), 0, _test_cat(what, ": ...and the result passes check --strict"));
    return 0;
}

fn test_fmt_refuses_what_it_would_drop() {
    test_group("fmt: names what the canonical form cannot hold; --force drops it (1.7.0)");

    var H = "[package]\nname = \"d\"\nversion = \"1\"\n";
    _fm_drop_case(_test_cat("# mine\n", H), "a comment", "1");
    _fm_drop_case("[package]\nname = \"d\" # why\nversion = \"1\"\n", "a comment", "2");
    _fm_drop_case(_test_cat(H, "mode = \"x\"\n"), "unknown key `mode` in [package]", "4");
    _fm_drop_case(_test_cat(H, "\n[[link]]\nsource = \"a\"\ntarget = \".a\"\nmode = \"copy\"\n"),
      "unknown key `mode` in a [[link]] row", "8");
    _fm_drop_case(_test_cat(H, "name = \"d2\"\n"), "the earlier `name`, set again here", "4");
    _fm_drop_case(_test_cat(H, "\n[[link]]\nsource = \"a\"\nsource = \"b\"\ntarget = \".a\"\n"),
      "the earlier `source`, set again here", "7");
    _fm_drop_case("[package]\nname = \"d\" junk\nversion = \"1\"\n", "text after the value of `name`", "2");
    _fm_drop_case(_test_cat(H, "tags = 3\n"), "`tags` with a value that is not a double-quoted string", "4");
    _fm_drop_case(_test_cat(H, "\n[extra]\nk = \"v\"\n"), "unknown section [extra] and its keys", "5");
    _fm_drop_case(_test_cat(H, "\n[[extra]]\nk = \"v\"\n"), "unknown section [[extra]] and its keys", "5");
    _fm_drop_case(_test_cat("top = \"x\"\n", H), "key `top` before any section", "1");
    _fm_drop_case(_test_cat(H, "just words\n"), "a line that is not `key = value`", "4");
    _fm_drop_case(_test_cat(H, "ignore = [\"a\", 3]\n"), "a non-string element in an array", "4");
    _fm_drop_case(_test_cat("[package] here\n", "name = \"d\"\nversion = \"1\"\n"), "text after a section header", "1");
    _fm_drop_case(_test_cat(H, "\n[[link]] # row\nsource = \"a\"\ntarget = \".a\"\n"), "a comment", "5");
    _fm_drop_case(_test_cat(H, "ignore = [\"a\"]\nignore = [\"b\"]\n"), "the earlier `ignore`, set again here", "5");
    _fm_drop_case(_test_cat(H, "tags = [\"a\"]\n"), "unknown key `tags` in [package]", "4");

    # Several at once are all listed, in order, and nothing else is.
    var many = _test_cat("# one\n", _test_cat(H, "x = \"1\" # two\n"));
    var pkg = _fm_pkg(many);
    var av = _cli_av("hapi fmt");
    _cli_add(av, pkg);
    var want = _test_cat(_test_cat(_test_cat(_test_cat(_test_cat("hapi: formatting ", _fsl_path_join(pkg, "hapi.cyml")),
      " would drop what its canonical form has no place for:\n"),
      "  line 1: a comment\n  line 5: unknown key `x` in [package]\n  line 5: a comment\n"),
      "  (rerun with --force to drop them; nothing was changed)\n"), "");
    _cli_expect(av, 1, "", want, "every drop is listed, and only those");
    _cli_add(av, "--force");
    assert_eq(_cli_run(av), 0, "fmt --force");
    var said = _test_cat(_test_cat(
      "  line 1: a comment  (dropped)\n  line 5: unknown key `x` in [package]  (dropped)\n",
      "  line 5: a comment  (dropped)\nformatted "), _test_cat(_fsl_path_join(pkg, "hapi.cyml"), "\n"));
    assert(_cli_same(_cli_out, _cli_out_n, said), "...reports each as dropped");
    _cli_reset(0);
    return 0;
}

fn test_fmt_refusals() {
    test_group("fmt: refuses a backslash, a bad manifest and a symlinked one (1.7.0)");

    var bs = "[package]\nname = \"a\\\\b\"\nversion = \"1\"\n";
    var pkg = _fm_pkg(bs);
    assert_eq(cmd_fmt_run(pkg, 0, 1), 1, "a value with a backslash is refused, --force or not");
    assert_eq(_fm_is(pkg, bs), 1, "...untouched");
    var q = "[package]\nname = \"a\\\"b\"\nversion = \"1\"\n";
    var pq = _fm_pkg(q);
    assert_eq(cmd_fmt(pq), 1, "an escaped quote is a backslash too");
    var pl = _fm_pkg("[package]\nname = \"p\"\nversion = \"1\"\n\n[[link]]\nsource = \"a\\\\b\"\ntarget = \".a\"\n");
    var avb = _cli_av("hapi fmt");
    _cli_add(avb, pl);
    assert_eq(_cli_run(avb), 1, "a row's source with a backslash");
    assert(_test_substr(_cli_err, _cli_err_n, "a [[link]] row's `source` holds a backslash") >= 0,
      "...names the field");

    var bad = "[package]\nversion = \"1\"\n";
    var pb = _fm_pkg(bad);
    assert_eq(cmd_fmt(pb), 1, "a manifest with no name does not parse: exit 1");
    assert_eq(_fm_is(pb, bad), 1, "...untouched");
    var pd = _fm_pkg("---\n[package]\nname = \"x\"\nversion = \"1\"\n");
    assert_eq(cmd_fmt(pd), 1, "a delimiter on the first line leaves no header: exit 1");

    # A symlinked manifest: a rename would replace the link (F-058).
    var common = _fm_pkg(_fm_messy());
    var ps = _test_scratch_dir();
    var mp = _fsl_path_join(ps, "hapi.cyml");
    hapi_symlink(_fsl_path_join(common, "hapi.cyml"), mp);
    assert_eq(cmd_fmt(ps), 1, "fmt refuses a symlinked manifest");
    hapi_set_dry_run(1);
    assert_eq(cmd_fmt(ps), 1, "...so does --dry-run, as the real run would");
    hapi_set_dry_run(0);
    assert_eq(link_probe_kind(link_probe(mp)), HAPI_LP_SYMLINK, "...the link stays");
    assert_eq(_fm_is(common, _fm_messy()), 1, "...and so does the file it names");
    assert_eq(cmd_fmt_run(ps, 1, 0), 1, "--check reads through it: not formatted");
    assert_eq(cmd_fmt_run(ps, 0, 0), 1, "...but only reads");

    # The proof refuses what the backslash check cannot see: a value that
    # spans lines in a CR LF manifest would gain a CR from the conversion.
    var ml = "[package]\r\nname = \"two\"\r\nversion = \"1\"\r\ndescription = \"two\nlines\"\r\n";
    var pm = _fm_pkg(ml);
    var avm = _cli_av("hapi fmt");
    _cli_add(avm, pm);
    assert_eq(_cli_run(avm), 1, "a multi-line value in a CR LF manifest is refused");
    assert(_test_substr(_cli_err, _cli_err_n, "would not read back as this manifest") >= 0,
      "...by the read-back proof");
    assert_eq(_fm_is(pm, ml), 1, "...untouched");
    # A trailing comma is punctuation, not content.
    var tc = _fm_pkg("[package]\nname = \"t\"\nversion = \"1\"\nignore = [\"a\", \"b\",]\n");
    assert_eq(cmd_fmt(tc), 0, "a trailing comma in an array formats without --force");
    var dc = _fm_pkg("[package]\nname = \"t\"\nversion = \"1\"\nignore = [\"a\",, \"b\"]\n");
    assert_eq(cmd_fmt(dc), 0, "...so does a doubled one");
    assert_eq(_fm_is(tc, "[package]\nname = \"t\"\nversion = \"1\"\nignore = [\"a\", \"b\"]\n"), 1, "...and goes");

    assert_eq(cmd_fmt(0), 2, "no package is bad usage");
    return 0;
}

fn test_fmt_crlf_and_dry_run() {
    test_group("fmt: keeps CR LF, and --dry-run writes nothing (1.7.0)");

    var crlf = _test_cat("[package]\r\nversion = \"1\"\r\nname = \"c\"\r\n\r\n",
      "[[link]]\r\nsource = \"b\"\r\ntarget = \".b\"\r\n---\r\nbody\r\n");
    var pc = _fm_pkg(crlf);
    var h0 = _fm_hash(pc);
    assert_eq(cmd_fmt(pc), 0, "fmt a CR LF manifest");
    var want = _test_cat("[package]\r\nname = \"c\"\r\nversion = \"1\"\r\n\r\n",
      "[[link]]\r\nsource = \"b\"\r\ntarget = \".b\"\r\n\r\n---\r\nbody\r\n");
    assert_eq(_fm_is(pc, want), 1, "every header line ends CR LF, and the body is untouched");
    assert_eq(hapi_cstr_eq(_fm_hash(pc), h0), 1, "the hash is unchanged");
    assert_eq(cmd_fmt_run(pc, 1, 0), 0, "--check: formatted");

    var pd = _fm_pkg(_fm_messy());
    var av = _cli_av("hapi fmt --dry-run");
    _cli_add(av, pd);
    assert_eq(_cli_run(av), 0, "fmt --dry-run");
    var tail = _test_cat(_test_cat("would format ", _fsl_path_join(pd, "hapi.cyml")), "  (dry-run)\n");
    assert(_cli_same(_cli_out, _cli_out_n, _test_cat(_fm_canon(), tail)), "...prints the header it would write");
    assert_eq(_fm_is(pd, _fm_messy()), 1, "...and writes nothing");
    _cli_reset(0);

    var pf = _fm_pkg(_test_cat("# c\n", _fm_messy()));
    hapi_set_dry_run(1);
    assert_eq(cmd_fmt(pf), 1, "--dry-run refuses what the real run would");
    assert_eq(cmd_fmt_run(pf, 0, 1), 0, "--dry-run --force shows the result");
    hapi_set_dry_run(0);
    assert_eq(_fm_is(pf, _test_cat("# c\n", _fm_messy())), 1, "...and writes nothing either way");
    return 0;
}

fn test_cli_fmt() {
    test_group("cli: fmt and its flags (1.7.0)");

    _cli_flag_probe("fmt", "--check", 0, 1);
    _cli_flag_probe("fmt", "--dry-run", 0, 1);
    _cli_flag_probe("fmt", "--force", 0, 1);
    _cli_flag_probe("fmt", "--root", 1, 0);
    _cli_flag_probe("fmt", "--absolute", 0, 0);
    _cli_flag_probe("fmt", "--strict", 0, 0);
    var verbs = _cli_av("inspect link unlink adopt rollback checkpoint status list check sync");
    var i = 0;
    while (i < load64(verbs)) {
        _cli_flag_probe(load64(verbs + 8 + i * 8), "--check", 0, 0);
        i = i + 1;
    }
    _cli_expect(_cli_av("hapi fmt"), 2, "", "usage: hapi fmt <package-dir|hapi.cyml> [--check] [--force]\n",
      "no package");
    _cli_expect(_cli_av("hapi fmt a b"), 2, "", _cli_unexpected_arg("fmt", "b"), "two packages");

    var pkg = _fm_pkg(_fm_messy());
    var av = _cli_av("hapi fmt --check");
    _cli_add(av, pkg);
    _cli_expect(av, 1, _test_cat(_fsl_path_join(pkg, "hapi.cyml"), ": not formatted\n"), "", "fmt --check");
    var av2 = _cli_av("hapi fmt");
    _cli_add(av2, _fsl_path_join(pkg, "hapi.cyml"));
    _cli_expect(av2, 0, _test_cat(_test_cat("formatted ", _fsl_path_join(pkg, "hapi.cyml")), "\n"), "",
      "fmt <path to hapi.cyml>");
    _cli_expect(av, 0, _test_cat(_fsl_path_join(pkg, "hapi.cyml"), ": already formatted\n"), "",
      "fmt --check, formatted");
    return 0;
}

# ============================================================
# 1.7.1 — the resolver (F-065, F-066)
# ============================================================

# `<d>/home` as the scope root and $HOME, `<d>/outside` beside it, and the
# trail in `<d>`. A relative link out of the scope needs somewhere to go
# that is not the shared /tmp.
fn _r171_env(d): i64 {
    var home = _fsl_path_join(d, "home");
    hapi_mkdir(home, 0x1C0);
    hapi_mkdir(_fsl_path_join(d, "outside"), 0x1C0);
    link_set_scope_root(home);
    audit_set_trail_path(_fsl_path_join(d, "audit.jsonl"));
    cap_set_home(home);
    return home;
}

fn _r171_clear(): i64 {
    cap_set_home(0);
    cap_set_allowlist(0);
    _test_clear_env();
    return 0;
}

# F-065: _fsl_split began at byte 1, and the resolver splits a symlink's
# own text with it, so every relative text lost its first byte.
fn test_resolve_relative_link_texts() {
    test_group("resolve: a relative symlink text is followed whole (F-065)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    hapi_mkdir(_fsl_path_join(home, "short"), 0x1C0);
    fsl_mkdir_parents(_fsl_path_join(home, "a/b/x"));
    hapi_symlink("short", _fsl_path_join(home, "r1"));
    hapi_symlink("../outside", _fsl_path_join(home, "r2"));
    hapi_symlink("a/b", _fsl_path_join(home, "r3"));
    hapi_symlink("./short", _fsl_path_join(home, "r4"));
    hapi_symlink("..", _fsl_path_join(home, "r5"));
    hapi_symlink("c2", _fsl_path_join(home, "c1"));
    hapi_symlink("../outside", _fsl_path_join(home, "c2"));
    hapi_symlink(_fsl_path_join(d, "outside"), _fsl_path_join(home, "abs"));

    var outside = _fsl_path_join(d, "outside");
    _assert_cstr(fsl_resolve_path(_fsl_path_join(home, "r1")), _fsl_path_join(home, "short"),
      "`short` resolves to home/short");
    _assert_cstr(fsl_resolve_path(_fsl_path_join(home, "r2")), outside,
      "`../outside` resolves beside home");
    _assert_cstr(fsl_resolve_path(_fsl_path_join(home, "r3")), _fsl_path_join(home, "a/b"),
      "`a/b` keeps both components");
    _assert_cstr(fsl_resolve_path(_fsl_path_join(home, "r4")), _fsl_path_join(home, "short"),
      "`./short` resolves to home/short");
    _assert_cstr(fsl_resolve_path(_fsl_path_join(home, "r5")), d, "`..` is home's parent");
    _assert_cstr(fsl_resolve_path(_fsl_path_join(home, "c1/x")), _fsl_path_join(outside, "x"),
      "a chain of relative texts, then a name");
    _assert_cstr(fsl_resolve_path(_fsl_path_join(home, "abs")), outside, "an absolute text, as before");

    # The legacy resolver is 1.7.0's, byte for byte: it is how removal
    # recognizes the texts that version wrote. It must stay wrong.
    _assert_cstr(_fsl_resolve_path_legacy(_fsl_path_join(home, "r2")), _fsl_path_join(home, "outside"),
      "the legacy resolver still drops the first byte");

    assert_eq(cap_target_allowed(_fsl_path_join(home, "r2"), home), 0,
      "a relative link out of home is outside the scope");
    assert_eq(cap_target_allowed(_fsl_path_join(home, "r1"), home), 1,
      "a relative link within home is inside it");
    _r171_clear();
    return 0;
}

fn _r171_eputs(s): i64 { eprint(s, strlen(s)); return 0; }

fn _assert_cstr(got, want, label): i64 {
    if (got == 0 || want == 0) { assert(0, label); return 0; }
    var n = strlen(want);
    if (strlen(got) == n && memeq(got, want, n) == 1) { assert(1, label); return 0; }
    assert(0, label);
    _r171_eputs("    got:  "); _r171_eputs(got); _r171_eputs("\n    want: ");
    _r171_eputs(want); _r171_eputs("\n");
    return 0;
}

# F-065 end to end: link --force, adopt, --root and the allowlist each
# escaped through a relative link that leaves home.
fn test_relative_link_escape_refused() {
    test_group("link / adopt / --root / allowlist: a relative link out of home is an escape (F-065)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var outside = _fsl_path_join(d, "outside");
    var victim = _fsl_path_join(outside, "victim");
    _test_write_file(victim, "precious");
    hapi_symlink("../outside", _fsl_path_join(home, ".cfg"));

    var pkg = _t111_pkg("\n[[link]]\nsource = \"f\"\ntarget = \".cfg/victim\"\n");
    _test_write_file(_fsl_path_join(pkg, "f"), "pkgdata");
    assert_eq(cmd_link(pkg, 1), 1, "link --force refuses the escape");
    assert_eq(link_probe_kind(link_probe(victim)), HAPI_LP_FILE, "the file outside is untouched");
    assert_eq(_test_file_size(victim), 8, "with every byte");

    var conf = _fsl_path_join(outside, "app.conf");
    _test_write_file(conf, "outside");
    var apkg = _t111_pkg("");
    assert_eq(cmd_adopt(_fsl_path_join(home, ".cfg/app.conf"), apkg), 1, "adopt refuses the escape");
    assert_eq(link_probe_kind(link_probe(conf)), HAPI_LP_FILE, "the file stays where it was");

    hapi_symlink("../outside", _fsl_path_join(home, "trap"));
    var rt, rv = cap_check_root_r(_fsl_path_join(home, "trap"));
    assert_eq(is_err_result(rt), 1, "--root through a relative link out of home is denied");

    # An allowlist entry reached through a relative link grants where the
    # link physically goes, and not a sibling of its own name.
    hapi_mkdir(_fsl_path_join(d, "grants"), 0x1C0);
    hapi_mkdir(_fsl_path_join(d, "granted"), 0x1C0);
    hapi_mkdir(_fsl_path_join(d, "grants/granted"), 0x1C0);
    hapi_symlink("../granted", _fsl_path_join(d, "grants/g"));
    cap_set_allowlist(_fsl_path_join(d, "grants/g"));
    assert_eq(cap_target_allowed(_fsl_path_join(d, "granted"), home), 1,
      "the directory the entry names is granted");
    assert_eq(cap_target_allowed(_fsl_path_join(d, "grants/granted"), home), 0,
      "a directory it does not name is not");
    _r171_clear();
    return 0;
}

# F-046 under a RELATIVE symlinked parent: the text must be computed from
# where `.config` really leads, or the link dangles while status says OK.
fn test_relative_parent_link_text() {
    test_group("link: the text under a relative symlinked parent resolves (F-065)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    fsl_mkdir_parents(_fsl_path_join(home, "dotfiles/config/x"));
    hapi_symlink("dotfiles/config", _fsl_path_join(home, ".config"));
    var pkg = _t111_pkg_at(_fsl_path_join(home, "dotfiles/nvim"),
      "\n[[link]]\nsource = \"init.lua\"\ntarget = \".config/nvim/init.lua\"\n");
    _test_write_file(_fsl_path_join(pkg, "init.lua"), "lua");

    assert_eq(cmd_link(pkg, 0), 0, "link succeeds");
    var tgt = _fsl_path_join(home, ".config/nvim/init.lua");
    var probe = link_probe(tgt);
    assert_eq(link_probe_kind(probe), HAPI_LP_SYMLINK, "the link is there");
    _assert_cstr(link_probe_target(probe), "../../nvim/init.lua", "its text is from the physical parent");
    assert_eq(_test_file_size(tgt), 3, "and the kernel reaches the source through it");
    assert_eq(cmd_status_run(pkg, 0), 0, "status says OK");
    assert_eq(cmd_link(pkg, 0), 0, "a re-run is up to date");
    _r171_clear();
    return 0;
}

# 1.1.1–1.7.0 wrote the text their resolver computed. After the fix those
# links must stay hapi's to remove, as F-046 kept 1.1.0's lexical text
# removable: unlink, rollback and prune accept the old text. status calls
# it WRONG, and `link --force` rewrites it.
fn _r171_plant_legacy(home, pkg): i64 {
    var tgt = _fsl_path_join(home, ".config/nvim/init.lua");
    var src = _fsl_path_join(pkg, "init.lua");
    fsl_mkdir_parents(tgt);
    assert_eq(hapi_symlink("../../../dotfiles/nvim/init.lua", tgt), 0, "a link with 1.7.0's text");
    var at, av = audit_append_link_r("p", "1.0.0", "sha1c:00",
      "init.lua", ".config/nvim/init.lua", src, tgt, 0);
    assert_eq(is_ok(at), 1, "and 1.7.0's op:link entry");
    return tgt;
}

fn test_legacy_text_links_stay_removable() {
    test_group("unlink / rollback / prune: a link 1.1.1–1.7.0 wrote stays removable (F-065)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    fsl_mkdir_parents(_fsl_path_join(home, "dotfiles/config/x"));
    hapi_symlink("dotfiles/config", _fsl_path_join(home, ".config"));
    var pkg = _t111_pkg_at(_fsl_path_join(home, "dotfiles/nvim"),
      "\n[[link]]\nsource = \"init.lua\"\ntarget = \".config/nvim/init.lua\"\n");
    _test_write_file(_fsl_path_join(pkg, "init.lua"), "lua");

    # The text 1.7.0 computed, pinned: the legacy resolver must reproduce it.
    var tgt = _fsl_path_join(home, ".config/nvim/init.lua");
    var lp = _fsl_resolve_path_legacy(_fsl_path_dirname(tgt));
    _assert_cstr(fsl_compute_relative(lp, _fsl_path_join(pkg, "init.lua")),
      "../../../dotfiles/nvim/init.lua", "the legacy resolver gives 1.7.0's text");

    _r171_plant_legacy(home, pkg);
    assert_eq(cmd_status_run(pkg, 0), 1, "status calls the old text WRONG");
    assert_eq(cmd_unlink("p"), 0, "unlink removes it as hapi's own");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_ABSENT, "it is gone");

    _r171_plant_legacy(home, pkg);
    assert_eq(cmd_rollback(), 0, "rollback reverses it");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_ABSENT, "it is gone again");

    # Its row leaves the manifest: prune takes it (--force passes the
    # more-than-half limit, which one row of one trips).
    _r171_plant_legacy(home, pkg);
    var mf = _fsl_path_join(pkg, "hapi.cyml");
    _test_write_file(mf, "[package]\nname = \"p\"\nversion = \"1.0.0\"\n");
    assert_eq(cmd_sync_run(pkg, 1, 1), 0, "sync --prune removes it as hapi's own");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_ABSENT, "it is pruned");
    _test_write_file(mf, _test_cat(_test_hdr("p"), _test_row("init.lua", ".config/nvim/init.lua")));

    _r171_plant_legacy(home, pkg);
    assert_eq(cmd_link(pkg, 0), 1, "a plain link calls it a conflict");
    assert_eq(cmd_link(pkg, 1), 0, "link --force rewrites it");
    _assert_cstr(link_probe_target(link_probe(tgt)), "../../nvim/init.lua", "with today's text");
    _r171_clear();
    return 0;
}

# F-066: past 4096 resolved bytes readlink says ENAMETOOLONG, the probe
# says ERROR, and the resolver kept the component as a name. The kernel
# walks the short spelled path and follows the link there.
fn test_unprobeable_component_refused() {
    test_group("resolve: a component that cannot be probed is not a name (F-066)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var outside = _fsl_path_join(d, "outside");
    var victim = _fsl_path_join(outside, "victim");
    _test_write_file(victim, "precious");

    # A chain of real directories whose physical path is 4093 bytes, so
    # `<chain>/esc` (4097) cannot be probed by its resolved spelling.
    var chain = home;
    var seg = alloc(256);
    var go = 1;
    while (go == 1) {
        var room = 4093 - strlen(chain) - 1;
        if (room <= 0) { go = 0; continue; }
        var w = 250;
        if (room < 250 + 2) { w = room; }
        memset(seg, 113, w);
        store8(seg + w, 0);
        chain = _fsl_path_join(chain, seg);
        hapi_mkdir(chain, 0x1C0);
    }
    assert_eq(strlen(chain), 4093, "the chain is 4093 bytes");
    assert_eq(hapi_symlink(chain, _fsl_path_join(home, ".cfg")), 0, "~/.cfg leads to it");
    # Made through the short spelling, as the kernel walks it.
    assert_eq(hapi_symlink(outside, _fsl_path_join(home, ".cfg/esc")), 0,
      "<chain>/esc leads out of home");

    assert_eq(cap_target_allowed(_fsl_path_join(home, ".cfg/esc"), home), 0,
      "a link it cannot probe is not inside the scope");
    var pkg = _t111_pkg("\n[[link]]\nsource = \"f\"\ntarget = \".cfg/esc/victim\"\n");
    _test_write_file(_fsl_path_join(pkg, "f"), "pkgdata");
    assert_eq(cmd_link(pkg, 1), 1, "link --force refuses");
    assert_eq(_test_file_size(victim), 8, "the file outside is untouched");

    # Its full spelling is too long for the cleanup's unlink.
    hapi_unlink(_fsl_path_join(home, ".cfg/esc"));
    _r171_clear();
    return 0;
}

# ============================================================
# 1.7.1 — rows compared where they are (F-067), --force replaces (F-068)
# ============================================================

# A package whose `escape` is a link out of the scope, a source `f`, and
# the rows given.
fn _r171_escape_pkg(d, rows): i64 {
    var pkg = _t111_pkg(rows);
    hapi_symlink(_fsl_path_join(d, "outside"), _fsl_path_join(pkg, "escape"));
    _test_write_file(_fsl_path_join(pkg, "f"), "pkgdata");
    return pkg;
}

fn test_nested_rows_by_place() {
    test_group("link: a row beneath another row's target is refused however it is spelled (F-067)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var inner = _fsl_path_join(d, "outside/inner");

    var p1 = _r171_escape_pkg(d, _test_cat(_test_row("escape", ".x"), _test_row("f", "./.x/inner")));
    assert_eq(cmd_link(p1, 0), 1, "`./.x/inner` beneath `.x` is refused");
    var p2 = _r171_escape_pkg(d, _test_cat(_test_row("escape", ".x"), _test_row("f", "/.x/inner")));
    assert_eq(cmd_link(p2, 0), 1, "`/.x/inner` beneath `.x` is refused");
    hapi_symlink(".x", _fsl_path_join(home, "alias"));
    var p3 = _r171_escape_pkg(d, _test_cat(_test_row("escape", ".x"), _test_row("f", "alias/inner")));
    assert_eq(cmd_link(p3, 0), 1, "`alias/inner`, with alias -> .x, is refused");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".x"))), HAPI_LP_ABSENT, "nothing was linked");
    assert_eq(link_probe_kind(link_probe(inner)), HAPI_LP_ABSENT, "nothing was written outside");

    var p4 = _r171_escape_pkg(d, _test_cat(_test_row("escape", ".a"), _test_row("f", "./.a")));
    assert_eq(cmd_link(p4, 1), 1, "two spellings of one target are refused, --force or not");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".a"))), HAPI_LP_ABSENT,
      "and neither was linked");

    # The classification itself: one place, beneath, apart, and the
    # as-spelled comparison when a side could not be resolved.
    assert_eq(_hlnk_overlap("/h/.a", "/h/.a", "/h/./.a", "/h/.a"), 2, "one place, two spellings");
    assert_eq(_hlnk_overlap("/h/al/i", "/h/.x/i", "/h/.x", "/h/.x"), 1, "beneath, through an alias");
    assert_eq(_hlnk_overlap("/h/.xy", "/h/.xy", "/h/.x", "/h/.x"), 0, "a sibling with a longer name");
    assert_eq(_hlnk_overlap("/h/.x/i", 0, "/h/.x", "/h/.x"), 1, "unresolved: compared as spelled");
    assert_eq(_hlnk_overlap("/h/.x", 0, "/h/.x", 0), 0, "unresolved and identical: not beneath");
    _r171_clear();
    return 0;
}

# The plan cannot see this one: `.x` is the user's link to `old`, so
# `alias/inner` is planned at old/inner. --force replaces `.x` first, and
# the next row then leads out of the scope. The run stops before it.
fn test_link_stops_when_a_row_moves() {
    test_group("link --force: a row an earlier write moved is not written (F-067)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    hapi_mkdir(_fsl_path_join(home, "old"), 0x1C0);
    hapi_symlink("old", _fsl_path_join(home, ".x"));
    hapi_symlink(".x", _fsl_path_join(home, "alias"));
    var pkg = _r171_escape_pkg(d, _test_cat(_test_row("escape", ".x"), _test_row("f", "alias/inner")));

    assert_eq(cmd_link(pkg, 1), 1, "the run stops");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(d, "outside/inner"))), HAPI_LP_ABSENT,
      "nothing was written outside the scope");
    var tr_t, tr_v = audit_read_default_r();
    assert_eq(vec_len(tr_v), 1, "the row before it is linked and recorded");
    _r171_clear();
    return 0;
}

# F-068: --force unlinked the file, then made the symlink. A link text
# too long for symlink(2) removed the file and wrote nothing.
fn test_force_failed_symlink_keeps_the_file() {
    test_group("link --force: a symlink that cannot be made leaves the file (F-068)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    # A source whose relative text from the target is past 4095 bytes.
    var pkg = _t111_pkg("");
    var deep = pkg;
    var seg = alloc(256);
    var go = 1;
    while (go == 1) {
        var room = 4085 - strlen(deep) - 1;
        if (room <= 0) { go = 0; continue; }
        var w = 250;
        if (room < 250 + 2) { w = room; }
        memset(seg, 113, w);
        store8(seg + w, 0);
        deep = _fsl_path_join(deep, seg);
        hapi_mkdir(deep, 0x1C0);
    }
    _test_write_file(_fsl_path_join(deep, "s"), "s");
    var rel_src = alloc(4096);
    var off = strlen(pkg) + 1;
    memcpy(rel_src, _fsl_path_join(deep, "s") + off, strlen(deep) + 2 - off);
    var rows = alloc(4300);
    var r1 = "\n[[link]]\nsource = \"";
    memcpy(rows, r1, strlen(r1));
    var rp = strlen(r1);
    memcpy(rows + rp, rel_src, strlen(rel_src)); rp = rp + strlen(rel_src);
    var r2 = "\"\ntarget = \"a/b/c/d/e/f/g/h/.t\"\n";
    memcpy(rows + rp, r2, strlen(r2)); rp = rp + strlen(r2);
    store8(rows + rp, 0);
    _t111_pkg_at(pkg, rows);

    var tgt = _fsl_path_join(home, "a/b/c/d/e/f/g/h/.t");
    fsl_mkdir_parents(tgt);
    _test_write_file(tgt, "user");
    assert(strlen(fsl_link_text(tgt, _fsl_path_join(deep, "s"))) > 4095, "the text is too long");
    assert_eq(cmd_link(pkg, 1), 1, "link --force fails");
    assert_eq(link_probe_kind(link_probe(tgt)), HAPI_LP_FILE, "the user's file is still there");
    assert_eq(_test_file_size(tgt), 4, "with every byte");
    _r171_clear();
    return 0;
}

# ============================================================
# 1.7.1 — a source that is its target (F-069), another package (F-070)
# ============================================================

fn _r171_pkg_in(home, rows): i64 {
    fsl_mkdir_parents(_fsl_path_join(home, "dotfiles/pkg/x"));
    return _t111_pkg_at(_fsl_path_join(home, "dotfiles/pkg"), rows);
}

fn test_source_leading_to_its_target() {
    test_group("link: a source that leads back to its own target is refused (F-069)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var rc = _fsl_path_join(home, ".bashrc");
    _test_write_file(rc, "precious");

    # (a) The reverse layout people migrate from, both shapes.
    var pkg = _r171_pkg_in(home, "\n[[link]]\nsource = \"bashrc\"\ntarget = \".bashrc\"\n");
    hapi_symlink("../../.bashrc", _fsl_path_join(pkg, "bashrc"));
    assert_eq(cmd_link(pkg, 0), 1, "link refuses a relative reverse link");
    assert_eq(cmd_link(pkg, 1), 1, "and --force does not override it");
    hapi_unlink(_fsl_path_join(pkg, "bashrc"));
    hapi_symlink(rc, _fsl_path_join(pkg, "bashrc"));
    assert_eq(cmd_link(pkg, 1), 1, "an absolute reverse link is refused too");
    assert_eq(_test_file_size(rc), 8, "the only copy is untouched");

    # (b) A package directory link to $HOME, row source `home/.bashrc`.
    _t111_pkg_at(pkg, "\n[[link]]\nsource = \"home/.bashrc\"\ntarget = \".bashrc\"\n");
    hapi_symlink("../..", _fsl_path_join(pkg, "home"));
    assert_eq(cmd_link(pkg, 1), 1, "a source through a link to $HOME is refused");
    assert_eq(_test_file_size(rc), 8, "the only copy is untouched");

    # (c) A source that holds its target: link would make a cycle.
    hapi_mkdir(_fsl_path_join(home, ".config"), 0x1C0);
    var app = _fsl_path_join(home, ".config/app");
    _test_write_file(app, "v1");
    _t111_pkg_at(pkg, "\n[[link]]\nsource = \"cfg\"\ntarget = \".config/app\"\n");
    hapi_symlink("../../.config", _fsl_path_join(pkg, "cfg"));
    assert_eq(cmd_link(pkg, 1), 1, "a source holding its target is refused");
    assert_eq(_test_file_size(app), 2, "the file there is untouched");

    # The target absent: a plain link planted a self-loop at exit 0.
    _t111_pkg_at(pkg, "\n[[link]]\nsource = \"zz\"\ntarget = \".zz\"\n");
    hapi_symlink("../../.zz", _fsl_path_join(pkg, "zz"));
    assert_eq(cmd_link(pkg, 0), 1, "a source naming its absent target is refused");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".zz"))), HAPI_LP_ABSENT,
      "no loop was planted");

    # A source that passes through its absent target and leaves by `..`
    # ends elsewhere, but the link would put itself on its own path.
    _test_write_file(_fsl_path_join(home, "real"), "r");
    _t111_pkg_at(pkg, "\n[[link]]\nsource = \"via\"\ntarget = \".t\"\n");
    hapi_symlink("../../.t/../real", _fsl_path_join(pkg, "via"));
    assert_eq(cmd_link(pkg, 0), 1, "a source passing through its target is refused");

    # A source that cannot be followed to an end (a loop) is refused.
    _t111_pkg_at(pkg, "\n[[link]]\nsource = \"loop\"\ntarget = \".lp\"\n");
    hapi_symlink("loop", _fsl_path_join(pkg, "loop"));
    assert_eq(cmd_link(pkg, 0), 1, "a looping source is refused");

    # An ordinary source that is a link elsewhere in $HOME still links.
    _t111_pkg_at(pkg, "\n[[link]]\nsource = \"ok\"\ntarget = \".ok\"\n");
    hapi_symlink("../../real", _fsl_path_join(pkg, "ok"));
    assert_eq(cmd_link(pkg, 0), 0, "a source linking elsewhere is fine");
    _r171_clear();
    return 0;
}

# Package nvim links a directory; package over has a row inside it.
fn _r171_two_pkgs(home): i64 {
    fsl_mkdir_parents(_fsl_path_join(home, "dot/nvim/nvim/x"));
    fsl_mkdir_parents(_fsl_path_join(home, ".config/x"));
    var a = _t111_pkg_at(_fsl_path_join(home, "dot/nvim"),
      "\n[[link]]\nsource = \"nvim\"\ntarget = \".config/nvim\"\n");
    _test_write_file(_fsl_path_join(a, "nvim/init.lua"), "only copy");
    return a;
}

fn test_target_in_another_package() {
    test_group("link / adopt: another package's source is not this package's target (F-070)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var a = _r171_two_pkgs(home);
    var orig = _fsl_path_join(a, "nvim/init.lua");
    # The manifest names the package; give the second one its own name.
    var b = _fsl_path_join(home, "dot/over");
    hapi_mkdir(b, 0x1C0);
    _test_write_file(_fsl_path_join(b, "hapi.cyml"),
      _test_cat(_test_hdr("over"), _test_row("init.lua", ".config/nvim/init.lua")));
    _test_write_file(_fsl_path_join(b, "init.lua"), "override");

    assert_eq(cmd_link(a, 0), 0, "package nvim links its directory");
    assert_eq(cmd_link(b, 0), 1, "package over is refused");
    assert_eq(cmd_link(b, 1), 1, "and --force does not override it");
    assert_eq(link_probe_kind(link_probe(orig)), HAPI_LP_FILE, "nvim's file is still a file");
    assert_eq(_test_file_size(orig), 9, "with every byte");
    assert_eq(cmd_status_run(a, 0), 0, "and nvim is still OK");

    var c = _fsl_path_join(home, "dot/c");
    hapi_mkdir(c, 0x1C0);
    _test_write_file(_fsl_path_join(c, "hapi.cyml"), "[package]\nname = \"c\"\nversion = \"1.0.0\"\n");
    assert_eq(cmd_adopt(_fsl_path_join(home, ".config/nvim/init.lua"), c), 1,
      "adopt into another package refuses it");
    assert_eq(_test_file_size(orig), 9, "the file stays in nvim");

    # Unlinked, nvim's files are still nvim's: a user's own link into
    # them does not make them over's.
    assert_eq(cmd_unlink("p"), 0, "nvim (named p) is unlinked");
    hapi_symlink("../dot/nvim/nvim", _fsl_path_join(home, ".config/nvim"));
    assert_eq(cmd_link(b, 1), 1, "over is still refused, through the user's link");
    assert_eq(_test_file_size(orig), 9, "nvim's file is untouched");
    hapi_unlink(_fsl_path_join(home, ".config/nvim"));
    assert_eq(cmd_link(b, 0), 0, "with no link into nvim, over links");

    # An adopted file is the package's only copy: a row reaching it
    # through a user's link into that package is refused too.
    var e = _fsl_path_join(home, "dot/e");
    hapi_mkdir(e, 0x1C0);
    _test_write_file(_fsl_path_join(e, "hapi.cyml"), "[package]\nname = \"e\"\nversion = \"1.0.0\"\n");
    _test_write_file(_fsl_path_join(home, ".conf"), "adopted");
    assert_eq(cmd_adopt(_fsl_path_join(home, ".conf"), e), 0, "package e adopts ~/.conf");
    hapi_symlink("dot/e", _fsl_path_join(home, "edir"));
    var f = _fsl_path_join(home, "dot/f");
    hapi_mkdir(f, 0x1C0);
    _test_write_file(_fsl_path_join(f, "hapi.cyml"),
      "[package]\nname = \"f\"\nversion = \"1.0.0\"\n\n[[link]]\nsource = \"conf\"\ntarget = \"edir/conf\"\n");
    _test_write_file(_fsl_path_join(f, "conf"), "other");
    assert_eq(cmd_link(f, 1), 1, "a row into e's adopted file is refused");
    assert_eq(_test_file_size(_fsl_path_join(e, "conf")), 7, "e's only copy is untouched");

    # A trail hapi cannot read cannot say whose files these are.
    var tr = _fsl_path_join(d, "audit.jsonl");
    var fd = file_open(tr, O_WRONLY | O_APPEND, 0);
    var junk = "NOT JSON\n{\"op\":\"checkpoint\"}\n";
    file_write(fd, junk, strlen(junk));
    file_close(fd);
    # A row reached through a symlink (the user's `ln -> realdir`) is the
    # kind the trail is read for.
    hapi_mkdir(_fsl_path_join(home, "realdir"), 0x1C0);
    hapi_symlink("realdir", _fsl_path_join(home, "ln"));
    var g = _fsl_path_join(home, "dot/g");
    hapi_mkdir(g, 0x1C0);
    _test_write_file(_fsl_path_join(g, "hapi.cyml"), _test_cat(_test_hdr("g"), _test_row("gf", "ln/gnew")));
    _test_write_file(_fsl_path_join(g, "gf"), "g");
    assert_eq(cmd_link(g, 0), 1, "link refuses when the trail cannot be read");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, "realdir/gnew"))), HAPI_LP_ABSENT,
      "and links nothing");

    # The cheap test before any source is resolved.
    assert_eq(_hlnk_has_component("/h/dot/nvim/x", "nvim"), 1, "a component in the middle");
    assert_eq(_hlnk_has_component("/h/dot/nvim", "nvim"), 1, "the last component");
    assert_eq(_hlnk_has_component("/h/dot/nvimx/y", "nvim"), 0, "not a prefix of a longer name");
    assert_eq(_hlnk_has_component("/h/dot/xnvim", "nvim"), 0, "not a suffix of one");
    _r171_clear();
    return 0;
}

# The package sources are kept for the process and read again only from
# where the last read stopped. A trail now shorter than that, or one set
# again, starts over.
fn _r171_append_src(d, name): i64 {
    var src = _fsl_path_join(d, name);
    var t, v = audit_append_link_r("p", "1.0.0", "sha1c:00", name, name, src, _fsl_path_join(d, "t"), 0);
    return is_ok(t);
}

fn test_package_sources_follow_the_trail() {
    test_group("link: the package sources follow the trail as it grows or is replaced (F-070)");

    var d = _test_scratch_dir();
    var tr = _fsl_path_join(d, "audit.jsonl");
    audit_set_trail_path(tr);
    _r171_append_src(d, "s1");
    _r171_append_src(d, "s2");
    var a = hlnk_package_sources();
    assert(a != 0, "the trail is read");
    if (a != 0) { assert_eq(vec_len(a), 2, "two sources"); }
    _r171_append_src(d, "s3");
    var b = hlnk_package_sources();
    if (b != 0) { assert_eq(vec_len(b), 3, "a third, read from where the last read stopped"); }

    # Replaced by a shorter trail: what was read no longer applies.
    _test_write_file(tr, "");
    _r171_append_src(d, "s9");
    var c = hlnk_package_sources();
    assert(c != 0, "a shorter trail is read again from the start");
    if (c != 0) { assert_eq(vec_len(c), 1, "and holds only its own source"); }

    # Replaced by a longer one, and set again: also from the start.
    _test_write_file(tr, "");
    var k = 0;
    while (k < 4) {
        _r171_append_src(d, _test_cat("n", _test_cat("x", "abcdefghij" + k)));
        k = k + 1;
    }
    audit_set_trail_path(tr);
    var e = hlnk_package_sources();
    assert(e != 0, "a trail set again is read from the start");
    if (e != 0) { assert_eq(vec_len(e), 4, "and holds its four sources"); }
    _test_clear_env();
    return 0;
}

# One no-arg sync: package aa links a directory, then package bb's row
# would be written inside it.
fn test_sync_across_packages() {
    test_group("sync: one package's directory link does not take another's row (F-070)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var root = _fsl_path_join(home, "dots");
    fsl_mkdir_parents(_fsl_path_join(root, "aa/dir/x"));
    _test_write_file(_fsl_path_join(root, "aa/hapi.cyml"),
      "[package]\nname = \"aa\"\nversion = \"1.0.0\"\n\n[[link]]\nsource = \"dir\"\ntarget = \".cfg\"\n");
    hapi_mkdir(_fsl_path_join(root, "bb"), 0x1C0);
    _test_write_file(_fsl_path_join(root, "bb/hapi.cyml"),
      "[package]\nname = \"bb\"\nversion = \"1.0.0\"\n\n[[link]]\nsource = \"f\"\ntarget = \".cfg/f\"\n");
    _test_write_file(_fsl_path_join(root, "bb/f"), "f");
    sync_set_package_roots(root);

    assert_eq(cmd_sync(0), 1, "the sync fails for bb");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(root, "aa/dir/f"))), HAPI_LP_ABSENT,
      "nothing was written into aa's files");
    sync_set_package_roots(0);
    _r171_clear();
    return 0;
}

# F-071: adopt's move never replaces the package-side name. A file, a
# link or a dangling link already there refuses it; an absent name takes
# it, and the old name is gone.
fn test_rename_noreplace() {
    test_group("adopt's move never replaces what is at the package-side name (F-071)");

    var d = _test_scratch_dir();
    var a = _fsl_path_join(d, "a");
    var b = _fsl_path_join(d, "b");
    _test_write_file(a, "AAA");
    _test_write_file(b, "BB");
    assert_eq(hapi_rename_noreplace(a, b), 0 - 17, "an existing file refuses the move");
    assert_eq(link_probe_kind(link_probe(a)), HAPI_LP_FILE, "the file stays where it was");
    assert_eq(link_probe_kind(link_probe(b)), HAPI_LP_FILE, "and so does the one in the way");
    var dl = _fsl_path_join(d, "dl");
    hapi_symlink("nowhere", dl);
    assert_eq(hapi_rename_noreplace(a, dl), 0 - 17, "a dangling link refuses it too");
    var c = _fsl_path_join(d, "c");
    assert_eq(hapi_rename_noreplace(a, c), 0, "an absent name takes it");
    assert_eq(link_probe_kind(link_probe(a)), HAPI_LP_ABSENT, "the old name is gone");
    assert_eq(link_probe_kind(link_probe(c)), HAPI_LP_FILE, "the new one holds the file");
    return 0;
}

# F-072: only an absolute base names the trail. An unset or empty HOME
# fell back to /tmp/.local/state, and a relative XDG_STATE_HOME or HOME
# was used under whatever the cwd was.
fn test_trail_path_needs_an_absolute_base() {
    test_group("audit: the trail lives only under an absolute base (F-072)");

    _assert_cstr(audit_path_from("/x/state", "/h"), "/x/state/hapi/audit.jsonl", "an absolute XDG_STATE_HOME");
    _assert_cstr(audit_path_from(0, "/h"), "/h/.local/state/hapi/audit.jsonl", "unset: under HOME");
    _assert_cstr(audit_path_from("", "/h"), "/h/.local/state/hapi/audit.jsonl", "empty: under HOME");
    _assert_cstr(audit_path_from("rel/state", "/h"), "/h/.local/state/hapi/audit.jsonl",
      "a relative XDG_STATE_HOME is ignored, as the spec says");
    assert_eq(audit_path_from(0, 0), 0, "no HOME: no trail, not /tmp");
    assert_eq(audit_path_from(0, ""), 0, "an empty HOME: no trail");
    assert_eq(audit_path_from(0, "rel"), 0, "a relative HOME: no trail");
    assert_eq(audit_path_from("rel", "rel"), 0, "both relative: no trail");
    return 0;
}

# F-074: a value the header ends inside was read to the end, so a
# manifest cut mid-row parsed with a truncated target.
fn test_unterminated_value_refused() {
    test_group("manifest: a value with no closing quote is an error (F-074)");

    _expect_err("cut inside the last value",
      "[package]\nname = \"p\"\nversion = \"1.0.0\"\n\n[[link]]\nsource = \"a\"\ntarget = \".ab",
      HapiMfUnterminated);
    _expect_err("an escaped quote is not a closing one",
      "[package]\nname = \"p\"\nversion = \"1.0.0\\\"\n", HapiMfUnterminated);

    # Every prefix of a manifest either fails to parse or holds only
    # whole rows of it: a cut can drop a row, never shorten one.
    var full = _test_cat(_test_cat(_test_hdr("p"), _test_row("alpha", ".alpha-target")),
      _test_row("beta", ".beta-target"));
    var fl = strlen(full);
    var bad = 0;
    var n = 1;
    while (n <= fl) {
        var t, v = hapi_mf_parse_header_r(full, n);
        if (is_ok(t) == 1) {
            var links = hapi_mf_links(v);
            var k = 0;
            while (k < vec_len(links)) {
                var l = vec_get(links, k);
                var src = _fsl_str_to_cstr(hapi_link_source(l));
                var tgt = _fsl_str_to_cstr(hapi_link_target(l));
                var whole = 0;
                if (hapi_cstr_eq(src, "alpha") == 1 && hapi_cstr_eq(tgt, ".alpha-target") == 1) { whole = 1; }
                if (hapi_cstr_eq(src, "beta") == 1 && hapi_cstr_eq(tgt, ".beta-target") == 1) { whole = 1; }
                if (whole == 0) { bad = bad + 1; }
                k = k + 1;
            }
        }
        n = n + 1;
    }
    assert_eq(bad, 0, "no prefix yields a shortened row");
    var gt, gv = hapi_mf_parse_header_r(full, fl);
    assert_eq(is_ok(gt), 1, "and after all those, a whole manifest still parses");
    return 0;
}

# F-073: a failed read was taken as the end of the file, and a file that
# changed size while it was read was taken as whole.
fn test_manifest_read_is_whole() {
    test_group("manifest: a read that fails or comes up short is refused (F-073)");

    var d = _test_scratch_dir();
    var len = 0;
    assert_eq(manifest_read(d, &len), 0, "a read that fails (a directory) is not an empty file");
    var mf = _fsl_path_join(d, "hapi.cyml");
    hapi_mkdir(mf, 0x1C0);
    var t, v = hapi_mf_parse_file_r(mf);
    assert_eq(is_err_result(t), 1, "a manifest that cannot be read is an error");
    assert_eq(v, HapiMfIoErr, "reported as could-not-read");

    # sysfs reports 4096 bytes and holds fewer: the size it began with is
    # not what came back, exactly the shape of a file truncated mid-read.
    var sys = "/sys/devices/system/cpu/online";
    if (link_probe_kind(link_probe(sys)) == HAPI_LP_FILE) {
        assert_eq(manifest_read(sys, &len), 0, "a read shorter than the file's size is refused");
        assert_eq(manifest_read_was_torn(), 1, "as a changed file, not an unreadable one");
        var st, sv = hapi_mf_parse_file_r(sys);
        assert_eq(sv, HapiMfChanged, "and the parse says to rerun");
    } else {
        assert(1, "no sysfs here; the short read is not constructed");
    }
    return 0;
}

# ============================================================
# 1.7.1 — tier 2: correctness and error handling (F-076 on)
# ============================================================

# F-076: a target that could not be probed was listed as a conflict,
# with --force advised, and --force then skipped it and exited 0.
fn test_unprobeable_target_refused() {
    test_group("link: a target hapi cannot examine is refused, --force or not (F-076)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    _test_write_file(_fsl_path_join(home, ".cfg"), "a regular file");
    var pkg = _t111_pkg(_test_cat(_test_row("a", ".a"), _test_row("b", ".cfg/b")));
    _test_write_file(_fsl_path_join(pkg, "a"), "a");
    _test_write_file(_fsl_path_join(pkg, "b"), "b");
    assert_eq(cmd_link(pkg, 0), 1, "a path through a regular file is refused");
    assert_eq(cmd_link(pkg, 1), 1, "and --force does not skip it");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".a"))), HAPI_LP_ABSENT,
      "the run wrote nothing, not even the good row");

    var locked = _fsl_path_join(home, "locked");
    hapi_mkdir(locked, 0x1C0);
    var p2 = _t111_pkg(_test_row("b", "locked/b"));
    _test_write_file(_fsl_path_join(p2, "b"), "b");
    sys_chmod(locked, 0);
    assert_eq(cmd_link(p2, 1), 1, "an unsearchable directory is refused under --force");
    sys_chmod(locked, 0x1C0);
    _r171_clear();
    return 0;
}

# F-077: rollback counted an entry it could not probe as already at its
# expected state, exited 0, and --steps / --to sealed it.
fn test_rollback_unprobeable_is_an_error() {
    test_group("rollback: an entry it cannot probe is an error, never sealed (F-077)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_row("f", "box/f"));
    _test_write_file(_fsl_path_join(pkg, "f"), "f");
    assert_eq(cmd_link(pkg, 0), 0, "linked into box/");
    var box = _fsl_path_join(home, "box");
    sys_chmod(box, 0);
    assert_eq(cmd_rollback(), 1, "rollback exits 1 when it cannot look");
    assert_eq(cmd_rollback_run(1, 0), 1, "so does --steps 1");
    sys_chmod(box, 0x1C0);
    assert_eq(cmd_rollback_run(1, 0), 0, "with the directory searchable again, it rolls back");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(box, "f"))), HAPI_LP_ABSENT,
      "the link was not sealed away: it is reversed now");
    _r171_clear();
    return 0;
}

# F-078: an unlink of a link already gone printed a removal, wrote nothing,
# and the entry stayed live for good.
fn test_unlink_retires_an_absent_link() {
    test_group("unlink: a link already gone is retired, and rollback leaves it gone (F-078)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_cat(_test_row("x", ".x"), _test_row("y", ".y")));
    _test_write_file(_fsl_path_join(pkg, "x"), "x");
    _test_write_file(_fsl_path_join(pkg, "y"), "y");
    assert_eq(cmd_link(pkg, 0), 0, "linked");
    assert_eq(cmd_checkpoint(), 0, "checkpoint");
    var x = _fsl_path_join(home, ".x");
    var y = _fsl_path_join(home, ".y");
    hapi_unlink(x);
    assert_eq(cmd_unlink("p"), 0, "unlink exits 0");
    var tr_t, tr_v = audit_read_default_r();
    assert_eq(_hls_live_count(tr_v, "p"), 0, "list counts nothing live");
    var last = vec_get(tr_v, vec_len(tr_v) - 1);
    var retire = vec_get(tr_v, vec_len(tr_v) - 2);
    assert_eq(hae_absent(retire) + hae_absent(last), 1, "one entry retires the absent link");
    var before = _test_file_size(audit_trail_path());
    assert_eq(cmd_unlink("p"), 0, "a second unlink has nothing to do");
    assert_eq(_test_file_size(audit_trail_path()), before, "and writes nothing");

    assert_eq(cmd_rollback_run(1, 0), 0, "rollback --steps 1 undoes the unlink");
    assert_eq(link_probe_kind(link_probe(y)), HAPI_LP_SYMLINK, "the link it removed is back");
    assert_eq(link_probe_kind(link_probe(x)), HAPI_LP_ABSENT,
      "the one you deleted by hand is not");
    _r171_clear();
    return 0;
}

# F-080: prune's scope was lexical and its identity a raw string, and its
# limit counted links already gone.
fn test_prune_scope_and_identity() {
    test_group("sync --prune: its scope, its rows and its limit, as they are (F-080)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var sub = _fsl_path_join(home, "sub");
    hapi_mkdir(sub, 0x1C0);
    var pkg = _t111_pkg(_test_cat(_test_row("a", ".a"), _test_row("b", ".b")));
    _test_write_file(_fsl_path_join(pkg, "a"), "a");
    _test_write_file(_fsl_path_join(pkg, "b"), "b");
    link_set_scope_root(sub);
    assert_eq(cmd_link(pkg, 0), 0, "linked under --root ~/sub");
    link_set_scope_root(home);
    assert_eq(cmd_link(pkg, 0), 0, "and under $HOME");
    _test_write_file(_fsl_path_join(pkg, "hapi.cyml"),
      _test_cat(_test_hdr("p"), _test_cat(_test_row("a", ".a"), _test_row("b", "./.b"))));
    assert_eq(cmd_sync_run(pkg, 1, 0), 0, "a $HOME prune");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(sub, ".a"))), HAPI_LP_SYMLINK,
      "leaves the --root ~/sub run's links alone");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".b"))), HAPI_LP_SYMLINK,
      "and a row it re-spelled is still kept");

    # Four links, two deleted by hand, and the manifest emptied: two links
    # are at stake, and both would go. That is more than half.
    var q = _t111_pkg(_test_cat(_test_cat(_test_row("a", ".qa"), _test_row("b", ".qb")),
      _test_cat(_test_row("c", ".qc"), _test_row("e", ".qe"))));
    _test_write_file(_fsl_path_join(q, "a"), "a");
    _test_write_file(_fsl_path_join(q, "b"), "b");
    _test_write_file(_fsl_path_join(q, "c"), "c");
    _test_write_file(_fsl_path_join(q, "e"), "e");
    _test_write_file(_fsl_path_join(q, "hapi.cyml"), _test_cat(_test_hdr("q"),
      _test_cat(_test_cat(_test_row("a", ".qa"), _test_row("b", ".qb")),
      _test_cat(_test_row("c", ".qc"), _test_row("e", ".qe")))));
    assert_eq(cmd_link(q, 0), 0, "four links");
    hapi_unlink(_fsl_path_join(home, ".qa"));
    hapi_unlink(_fsl_path_join(home, ".qb"));
    _test_write_file(_fsl_path_join(q, "hapi.cyml"), _test_hdr("q"));
    assert_eq(cmd_sync_run(q, 1, 0), 1, "the limit holds: links already gone are not at stake");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".qc"))), HAPI_LP_SYMLINK,
      "and the links that are there stay");

    # A kept row planned through a link the same prune removes: `d` led to
    # elsewhere/, so `d/k` was planned there. Once `d` is gone it would be
    # written at a new place with the old text. The run stops before it.
    var w = _t111_pkg(_test_row("linkdir", "d"));
    hapi_mkdir(_fsl_path_join(home, "elsewhere"), 0x1C0);
    hapi_symlink(_fsl_path_join(home, "elsewhere"), _fsl_path_join(w, "linkdir"));
    _test_write_file(_fsl_path_join(w, "k"), "k");
    assert_eq(cmd_link(w, 0), 0, "d is a link to elsewhere/");
    _test_write_file(_fsl_path_join(w, "hapi.cyml"), _test_cat(_test_hdr("p"), _test_row("k", "d/k")));
    assert_eq(cmd_sync_run(w, 1, 1), 1, "prune removes d, then stops before d/k");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, "d/k"))), HAPI_LP_ABSENT,
      "nothing was written at d/k with a text planned for elsewhere/");
    _r171_clear();
    return 0;
}

# F-079: a no-op wrote nothing, so links the trail did not record for
# this package were never recorded again; and another package's --force
# takeover left the old owner's entry live for good.
fn test_link_records_what_it_finds() {
    test_group("link: a link hapi wrote but the trail does not record is recorded (F-079)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_row("x", ".x"));
    _test_write_file(_fsl_path_join(pkg, "x"), "x");
    assert_eq(cmd_link(pkg, 0), 0, "linked as p");

    # [package].name renamed: the links are b's now.
    _test_write_file(_fsl_path_join(pkg, "hapi.cyml"), _test_cat(_test_hdr("b"), _test_row("x", ".x")));
    var before = _test_file_size(audit_trail_path());
    assert_eq(cmd_link(pkg, 0), 0, "a re-link under the new name");
    assert(_test_file_size(audit_trail_path()) > before, "records the link for b");
    var again = _test_file_size(audit_trail_path());
    assert_eq(cmd_link(pkg, 0), 0, "a second re-link");
    assert_eq(_test_file_size(audit_trail_path()), again, "writes nothing");
    assert_eq(cmd_unlink("b"), 0, "unlink b finds it");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".x"))), HAPI_LP_ABSENT, "and removes it");

    # The trail's last word on .x is now that unlink. The same link made
    # again by hand is hapi's text for the row, so it is recorded again.
    hapi_symlink(fsl_link_text(_fsl_path_join(home, ".x"), _fsl_path_join(pkg, "x")), _fsl_path_join(home, ".x"));
    var after_unlink = _test_file_size(audit_trail_path());
    assert_eq(cmd_link(pkg, 0), 0, "a re-link after the unlink");
    assert(_test_file_size(audit_trail_path()) > after_unlink, "records it again: an unlink is not a claim");
    assert_eq(cmd_unlink("b"), 0, "and unlink removes it");

    # $HOME moved: the relative links moved with it; a re-link records
    # them at their new paths, and unlink removes them there.
    var h2 = _fsl_path_join(d, "home2");
    hapi_mkdir(h2, 0x1C0);
    var pk2 = _t111_pkg_at(_fsl_path_join(d, "dots"), _test_row("y", ".y"));
    _test_write_file(_fsl_path_join(pk2, "y"), "y");
    assert_eq(cmd_link(pk2, 0), 0, "linked in home");
    var moved = _fsl_path_join(h2, ".y");
    assert_eq(hapi_rename(_fsl_path_join(home, ".y"), moved), 0, "the link moves to home2");
    link_set_scope_root(h2);
    assert_eq(cmd_link(pk2, 0), 0, "a re-link in home2 records it there");
    assert_eq(cmd_unlink("p"), 0, "unlink exits 0");
    assert_eq(link_probe_kind(link_probe(moved)), HAPI_LP_ABSENT, "the moved link is removed");

    # Another package's --force over p's link takes it over: p no longer
    # holds it, so p's unlink has nothing to refuse.
    link_set_scope_root(home);
    var pa = _t111_pkg(_test_row("t", ".t"));
    _test_write_file(_fsl_path_join(pa, "t"), "a");
    assert_eq(cmd_link(pa, 0), 0, "p links .t");
    var pb = _t111_pkg_at(_fsl_path_join(d, "other"), "");
    _test_write_file(_fsl_path_join(pb, "hapi.cyml"), _test_cat(_test_hdr("q"), _test_row("t", ".t")));
    _test_write_file(_fsl_path_join(pb, "t"), "b");
    assert_eq(cmd_link(pb, 1), 0, "q takes .t over with --force");
    assert_eq(cmd_unlink("p"), 0, "p's unlink does not refuse a link it no longer holds");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".t"))), HAPI_LP_SYMLINK,
      "and q's link stays");
    _r171_clear();
    return 0;
}

# F-081: a row could target the audit trail, or a directory holding it,
# and --force deleted hapi's record or moved it into the package.
fn test_rows_never_target_the_trail() {
    test_group("link / adopt: the audit trail is never a target (F-081)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    # ~/.local/state is a symlink to ~/realst, where the trail really is.
    var st = _fsl_path_join(home, "realst");
    fsl_mkdir_parents(_fsl_path_join(st, "hapi/x"));
    hapi_mkdir(_fsl_path_join(home, ".local"), 0x1C0);
    hapi_symlink(st, _fsl_path_join(home, ".local/state"));
    var tr = _fsl_path_join(home, ".local/state/hapi/audit.jsonl");
    audit_set_trail_path(tr);
    var c = _t111_pkg(_test_row("c", ".c"));
    _test_write_file(_fsl_path_join(c, "c"), "c");
    assert_eq(cmd_link(c, 0), 0, "a trail exists");

    var pkg = _t111_pkg(_test_row("f", ".local/state"));
    _test_write_file(_fsl_path_join(pkg, "f"), "f");
    assert_eq(cmd_link(pkg, 1), 1, "replacing the symlinked directory that holds the trail is refused");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".local/state"))), HAPI_LP_SYMLINK,
      "the symlink is left");
    # Reached by another spelling: only its physical place says it is the trail.
    hapi_symlink(st, _fsl_path_join(home, "lnk"));
    var p2 = _t111_pkg(_test_row("f", "lnk/hapi/audit.jsonl"));
    _test_write_file(_fsl_path_join(p2, "f"), "f");
    assert_eq(cmd_link(p2, 1), 1, "a row that is the trail by another spelling is refused");
    assert_eq(link_probe_kind(link_probe(tr)), HAPI_LP_FILE, "the trail is still a file");
    var a = _t111_pkg("");
    assert_eq(cmd_adopt(tr, a), 1, "adopt refuses the trail");
    assert_eq(link_probe_kind(link_probe(tr)), HAPI_LP_FILE, "and leaves it where it is");
    _r171_clear();
    return 0;
}

# RLIMIT_FSIZE, for the short write F-082 needs.
fn _r171_fsize_limit(n): i64 {
    var rl[16];
    store64(&rl, n);
    store64(&rl + 8, 0 - 1);
    var nr = 160;
    #ifdef CYRIUS_ARCH_AARCH64
    nr = 164;
    #endif
    return syscall(nr, 1, &rl);
}

# F-082: a short trail write left hapi's own partial line, which every
# later write then refused as a torn tail.
fn test_short_trail_write_is_taken_back() {
    test_group("audit: an append that does not complete is taken back (F-082)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var c = _t111_pkg(_test_row("c", ".c"));
    _test_write_file(_fsl_path_join(c, "c"), "c");
    assert_eq(cmd_link(c, 0), 0, "a trail with one entry");
    var tr = audit_trail_path();
    var size = _test_file_size(tr);
    hapi_ignore_signal(25);                    # SIGXFSZ: a short write, not a kill
    assert_eq(_r171_fsize_limit(size + 10), 0, "a file-size limit ten bytes past it");
    var at, av = audit_append_link_r("p", "1.0.0", "sha1c:00", "a", ".a", "/x/a", "/x/.a", 0);
    _r171_fsize_limit(0 - 1);
    assert_eq(is_err_result(at), 1, "the append fails");
    assert_eq(_test_file_size(tr), size, "and leaves the trail exactly as it was");
    var bt, bv = audit_append_link_r("p", "1.0.0", "sha1c:00", "a", ".a", "/x/a", "/x/.a", 0);
    assert_eq(is_ok(bt), 1, "so the next append is not refused as a torn tail");
    _r171_clear();
    return 0;
}

# F-085: SIGPIPE at its default killed a run mid-way when its output pipe
# closed. Ignored, a write to a pipe nobody reads fails with EPIPE.
fn test_sigpipe_ignored() {
    test_group("main: a closed output pipe is an EPIPE, not a kill (F-085)");

    var fds[16];
    assert_eq(sys_pipe(&fds), 0, "a pipe");
    var rfd = load32(&fds);
    var wfd = load32(&fds + 4);
    file_close(rfd);
    assert_eq(hapi_ignore_signal(13), 0, "SIGPIPE ignored");
    assert_eq(file_write(wfd, "x", 1), 0 - 32, "the write answers EPIPE, and the run goes on");
    file_close(wfd);
    return 0;
}

# F-083: the adopt reversal always edited <dir>/hapi.cyml, and was not
# all-or-none for a symlinked manifest.
fn test_adopt_reversal_finds_its_manifest() {
    test_group("rollback: an adopt is undone in the manifest that holds its row (F-083)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pd = _fsl_path_join(d, "pkgs");
    hapi_mkdir(pd, 0x1C0);
    var other = _fsl_path_join(pd, "hapi.cyml");
    _test_write_file(other, _test_hdr("other"));
    var named = _fsl_path_join(pd, "zsh.cyml");
    _test_write_file(named, _test_hdr("zsh"));
    var rc = _fsl_path_join(home, ".zrc");
    _test_write_file(rc, "zrc");
    assert_eq(cmd_adopt(rc, named), 0, "adopt into a named manifest");
    var other_size = _test_file_size(other);
    assert_eq(cmd_rollback(), 0, "rollback undoes it");
    assert_eq(link_probe_kind(link_probe(rc)), HAPI_LP_FILE, "the file is back");
    var mt, mv = hapi_mf_parse_file_r(named);
    assert_eq(vec_len(hapi_mf_links(mv)), 0, "its row is out of zsh.cyml");
    assert_eq(_test_file_size(other), other_size, "and the other package's hapi.cyml is untouched");

    # A symlinked manifest is refused before any step, not after two.
    var pk = _t111_pkg("");
    var mf = _fsl_path_join(pk, "hapi.cyml");
    var e = _fsl_path_join(home, ".erc");
    _test_write_file(e, "erc");
    assert_eq(cmd_adopt(e, pk), 0, "adopt into p");
    var copy = _fsl_path_join(pk, "real.cyml.txt");
    assert_eq(hapi_rename(mf, copy), 0, "the manifest moves aside");
    assert_eq(hapi_symlink(copy, mf), 0, "and hapi.cyml becomes a link to it");
    assert_eq(cmd_rollback(), 1, "rollback refuses the symlinked manifest");
    assert_eq(link_probe_kind(link_probe(e)), HAPI_LP_SYMLINK, "the adopt is left whole: the link");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(pk, "erc"))), HAPI_LP_FILE,
      "and the file in the package");
    _r171_clear();
    return 0;
}

fn _r171_mode(path): i64 {
    var st = alloc(STAT_BUFSZ);
    if (sys_stat(path, st) < 0) { return 0 - 1; }
    return load64(st + STAT_MODE) & 0x1FF;
}

# F-084: snapshots were always 0644, were not fsynced, survived a failed
# copy under a whole-looking name, and were composed through links the
# same run made.
fn test_snapshots_keep_secrets_private() {
    test_group("--backup-to: a snapshot keeps its mode, and only whole ones remain (F-084)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var bk = _fsl_path_join(d, "bk");
    hapi_mkdir(bk, 0x1ED);
    var sec = _fsl_path_join(home, ".secret");
    var fd = file_open(sec, O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    file_write(fd, "s3cret", 6);
    file_close(fd);
    sys_chmod(sec, 0x180);
    var pkg = _t111_pkg(_test_row("s", ".secret"));
    _test_write_file(_fsl_path_join(pkg, "s"), "pkg");
    hapi_set_backup_dir(bk);
    assert_eq(cmd_link(pkg, 1), 0, "link --force --backup-to replaces the secret");
    var names = vec_new();
    dir_list_checked(str_from(bk), names);
    assert_eq(vec_len(names), 1, "one snapshot");
    if (vec_len(names) == 1) {
        var snap = _fsl_path_join(bk, _fsl_str_to_cstr(vec_get(names, 0)));
        assert_eq(_r171_mode(snap), 0x180, "and it is 0600, as the secret was");
    }

    # A copy cut short is not left behind.
    var big = _fsl_path_join(home, ".big");
    var buf = alloc(65536);
    memset(buf, 120, 65536);
    var bf = file_open(big, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    file_write(bf, buf, 65536);
    file_close(bf);
    var bk2 = _fsl_path_join(d, "bk2");
    hapi_mkdir(bk2, 0x1ED);
    hapi_set_backup_dir(bk2);
    var p2 = _t111_pkg(_test_row("b", ".big"));
    _test_write_file(_fsl_path_join(p2, "b"), "b");
    hapi_ignore_signal(25);
    _r171_fsize_limit(4096);
    var rc = cmd_link(p2, 1);
    _r171_fsize_limit(0 - 1);
    assert_eq(rc, 1, "a snapshot that cannot be written stops the run");
    var n2 = vec_new();
    dir_list_checked(str_from(bk2), n2);
    assert_eq(vec_len(n2), 0, "and leaves no partial snapshot");
    assert_eq(_test_file_size(big), 65536, "the file is untouched");

    # The backup directory may not be in the package, or beneath a target.
    hapi_set_backup_dir(_fsl_path_join(p2, "snaps"));
    assert_eq(cmd_link(p2, 1), 1, "a backup directory in the package is refused");
    var p3 = _t111_pkg(_test_row("b", ".bkparent"));
    _test_write_file(_fsl_path_join(p3, "b"), "b");
    hapi_set_backup_dir(_fsl_path_join(home, ".bkparent/bk"));
    assert_eq(cmd_link(p3, 0), 1, "one beneath a target this run links is refused");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".bkparent"))), HAPI_LP_ABSENT,
      "and nothing was linked");
    _test_write_file(_fsl_path_join(home, ".cfgdir"), "user");
    hapi_set_backup_dir(_fsl_path_join(home, ".cfgdir/bk"));
    assert_eq(cmd_link(p3, 0), 1, "one that cannot be resolved is refused");
    hapi_set_backup_dir(0);
    var af = _fsl_path_join(home, ".adoptbk");
    _test_write_file(af, "a");
    var av = _cli_av("hapi adopt");
    _cli_add(av, af);
    _cli_add(av, _t111_pkg(""));
    _cli_add(av, "--backup-to");
    _cli_add(av, _fsl_path_join(home, ".cfgdir/bk"));
    assert_eq(_cli_run(av), 1, "adopt refuses one that cannot be resolved");
    hapi_set_backup_dir(0);
    assert(_test_substr(_cli_err, _cli_err_n, "cannot be resolved") >= 0,
      "...and says so, not that it is in the package");
    assert_eq(_test_file_size(af), 1, "the file stays where it was");
    _r171_clear();
    return 0;
}

# F-086: the reader took bayan's header, which a `[[entries]]` line ends.
fn test_header_ends_at_the_delimiter() {
    test_group("manifest: the header ends at `---`, whatever the lines are (F-086)");

    var d = _test_scratch_dir();
    var mf = _fsl_path_join(d, "hapi.cyml");
    _test_write_file(mf, _test_cat(_test_cat(_test_hdr("q"), _test_row("zshrc", ".zshrc")),
      _test_cat("\n[[entries]]\n", _test_row("vimrc", ".vimrc"))));
    var t, v = hapi_mf_parse_file_r(mf);
    assert_eq(is_ok(t), 1, "a header with an [[entries]] line parses");
    if (is_ok(t) == 1) { assert_eq(vec_len(hapi_mf_links(v)), 2, "with the row after that line"); }
    _test_write_file(mf, _test_cat(_test_cat(_test_hdr("q"), _test_row("zshrc", ".zshrc")),
      _test_cat("\n---\n# notes\n", _test_cat(_test_row("example", ".ex"), "\n[[entries]]\n"))));
    var t2, v2 = hapi_mf_parse_file_r(mf);
    assert_eq(is_ok(t2), 1, "a body with an [[entries]] line parses");
    if (is_ok(t2) == 1) { assert_eq(vec_len(hapi_mf_links(v2)), 1, "and its [[link]] example is not a row"); }
    return 0;
}

# F-087: a source that is a dangling symlink counted as present.
fn test_dangling_source_is_missing() {
    test_group("link / check: a source that is a dangling symlink is missing (F-087)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_row("s", ".s"));
    hapi_symlink("nowhere", _fsl_path_join(pkg, "s"));
    assert_eq(cmd_link(pkg, 0), 1, "link refuses a source that names nothing");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".s"))), HAPI_LP_ABSENT,
      "and plants no link to nothing");
    assert_eq(cmd_check(pkg, 0), 1, "check reports it missing");
    _test_write_file(_fsl_path_join(pkg, "nowhere"), "now");
    assert_eq(cmd_link(pkg, 0), 0, "once it names a file, the row links");
    _r171_clear();
    return 0;
}

# F-088: rollback --to walked past the label's newest checkpoint, inside
# a range already rolled back, to an older one of the same name.
fn test_rollback_to_newest_label_only() {
    test_group("rollback --to: only the label's newest checkpoint is a destination (F-088)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var x = _t111_pkg(_test_row("x", ".x"));
    _test_write_file(_fsl_path_join(x, "x"), "x");
    var y = _t111_pkg_at(_fsl_path_join(d, "y"), "");
    _test_write_file(_fsl_path_join(y, "hapi.cyml"), _test_cat(_test_hdr("y"), _test_row("y", ".y")));
    _test_write_file(_fsl_path_join(y, "y"), "y");
    var z = _t111_pkg_at(_fsl_path_join(d, "z"), "");
    _test_write_file(_fsl_path_join(z, "hapi.cyml"), _test_cat(_test_hdr("z"), _test_row("z", ".z")));
    _test_write_file(_fsl_path_join(z, "z"), "z");
    assert_eq(cmd_checkpoint_label("a"), 0, "checkpoint a (older)");
    assert_eq(cmd_link(x, 0), 0, "link x");
    assert_eq(cmd_checkpoint_label("a"), 0, "checkpoint a (newer)");
    assert_eq(cmd_link(y, 0), 0, "link y");
    assert_eq(cmd_rollback_run(2, 0), 0, "rollback --steps 2: the newer a is inside what it undid");
    assert_eq(cmd_link(z, 0), 0, "new work: link z");
    assert_eq(cmd_rollback_run(0, "a"), 0, "rollback --to a");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".z"))), HAPI_LP_SYMLINK,
      "does not go back to the older a: z stays");
    _r171_clear();
    return 0;
}

# F-090: adopt with the scope root itself as the file wrote an empty
# target; and nothing read the appended row back.
fn test_adopt_reads_its_row_back() {
    test_group("adopt: the scope root is not a file to adopt, and its row reads back (F-090)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var f = _fsl_path_join(home, "somefile");
    _test_write_file(f, "content");
    link_set_scope_root(f);
    var pkg = _t111_pkg("");
    assert_eq(cmd_adopt(f, pkg), 1, "the scope root itself is refused");
    link_set_scope_root(home);
    assert_eq(link_probe_kind(link_probe(f)), HAPI_LP_FILE, "and stays where it is");

    var mf = _fsl_path_join(pkg, "hapi.cyml");
    _test_write_file(mf, _test_cat(_test_hdr("p"), _test_row("a", ".a")));
    assert_eq(_hap_row_read_back(mf, 0, "a", ".a"), 1, "one more row, and it is there");
    assert_eq(_hap_row_read_back(mf, 1, "a", ".a"), 0, "the wrong row count is not a read-back");
    assert_eq(_hap_row_read_back(mf, 0, "b", ".a"), 0, "nor is another row");
    _test_write_file(mf, "[package]\nname = \"p");
    assert_eq(_hap_row_read_back(mf, 0, "a", ".a"), 0, "nor a manifest that does not parse");
    _r171_clear();
    return 0;
}

# ============================================================
# 1.7.1 — tier 3: robustness and messages (F-091 on)
# ============================================================

# The warm run's trail scan skips instead of stepping (_hlnk_last_at).
# A skip that is one byte too long misses a match, so it is checked
# against the byte-by-byte scan it replaced, on buffers drawn from four
# bytes, one of them above 0x7F, where partial matches are everywhere.
fn _r171_last_at_plain(buf, n, needle): i64 {
    var k = strlen(needle);
    var i = n - k;
    while (i >= 0) {
        if (memeq(buf + i, needle, k) == 1) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

fn test_trail_scan_matches_a_plain_scan() {
    test_group("link: the trail scan finds the match a byte-by-byte scan finds");
    assert_eq(_hlnk_last_at("xaab", 4, "aab"), 1, "a match inside a run of its first byte");
    assert_eq(_hlnk_last_at("abcab", 5, "ab"), 3, "the last of two matches");
    assert_eq(_hlnk_last_at("abc", 3, "abc"), 0, "a match that is the whole buffer");
    assert_eq(_hlnk_last_at("ab", 2, "abc"), 0 - 1, "a needle longer than the buffer");
    var alph = alloc(4);
    store8(alph, 97); store8(alph + 1, 98); store8(alph + 2, 34); store8(alph + 3, 0xE9);
    var buf = alloc(512);
    var nd = alloc(16);
    var seed = 12345;
    var bad = 0;
    var found = 0;
    var t = 0;
    while (t < 400) {
        var n = 20 + (t * 37) % 480;
        var x = 0;
        while (x < n) {
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
            store8(buf + x, load8(alph + ((seed >> 16) & 3)));
            x = x + 1;
        }
        var k = 2 + t % 6;
        x = 0;
        while (x < k) {
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
            store8(nd + x, load8(alph + ((seed >> 16) & 3)));
            x = x + 1;
        }
        store8(nd + k, 0);
        var want = _r171_last_at_plain(buf, n, nd);
        if (_hlnk_last_at(buf, n, nd) != want) { bad = bad + 1; }
        if (want >= 0) { found = found + 1; }
        t = t + 1;
    }
    assert_eq(bad, 0, "400 random buffers: the same answer every time");
    assert_eq(found > 40 && found < 360, 1, "...and both answers, found and not, were drawn");
}

# Finding 42: no-arg sync's note said a package linked through a symlink
# to its root was held by no root, though the same run scanned it.
fn test_unscanned_note_resolves() {
    test_group("sync: a package linked through a symlink to its root is not called unscanned (finding 42)");
    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var roots = _fsl_path_join(d, "roots");
    var pkg = _fsl_path_join(roots, "pkg");
    fsl_mkdir_parents(_fsl_path_join(pkg, "x"));
    hapi_mkdir(pkg, 0x1C0);
    _test_write_file(_fsl_path_join(pkg, "hapi.cyml"), _test_cat(_test_hdr("pkg"), _test_row("a", ".a")));
    _test_write_file(_fsl_path_join(pkg, "a"), "a");
    var alias = _fsl_path_join(d, "alias");
    hapi_symlink("roots", alias);
    assert_eq(cmd_link(_fsl_path_join(alias, "pkg"), 0), 0, "linked through the alias");
    sync_set_package_roots(roots);
    _cli_run(_cli_av("hapi sync"));
    sync_set_package_roots(0);
    assert(_test_substr(_cli_err, _cli_err_n, "which no package root holds") < 0,
      "the root it was linked through resolves to the one scanned");
    var other = _fsl_path_join(d, "other");
    var q = _fsl_path_join(other, "q");
    fsl_mkdir_parents(_fsl_path_join(q, "x"));
    hapi_mkdir(q, 0x1C0);
    _test_write_file(_fsl_path_join(q, "hapi.cyml"), _test_hdr("q"));
    sync_set_package_roots(other);
    _cli_run(_cli_av("hapi sync"));
    sync_set_package_roots(0);
    assert(_test_substr(_cli_err, _cli_err_n, "which no package root holds") >= 0,
      "...and a root that does not hold it still gets the note");
    _r171_clear();
}

# Finding 43: a dry run composed snapshot names by probing the disk, where
# it copies nothing, so two same-named files got one path.
fn test_dry_run_snapshot_names() {
    test_group("--backup-to: a dry run names two same-named snapshots apart (finding 43)");
    var bk = _fsl_path_join(_test_scratch_dir(), "bk");
    hapi_set_dry_run(1);
    var a = hapi_backup_compose_path(bk, "p", "/x/a/config");
    var b = hapi_backup_compose_path(bk, "p", "/x/b/config");
    hapi_set_dry_run(0);
    assert_eq(hapi_cstr_eq(a, b), 0, "the second is not given the first one's name");
    # In one second the second is the first with `-2`, as the real run
    # names it; across a tick the timestamps differ anyway.
    if (strlen(b) == strlen(a) + 2 && memeq(a, b, strlen(a)) == 1) {
        assert_eq(hapi_cstr_eq(b + strlen(a), "-2"), 1, "...it is the first with -2");
    }
}

# Finding 132: each recorded drop counted lines from byte 0, which made
# fmt quadratic. It counts on from the previous drop now; a drop behind
# it, or in another buffer, counts from the start.
fn test_drop_lines_count_on() {
    test_group("fmt: a skip's line is counted on from the previous one (finding 132)");
    var drops = vec_new();
    hapi_mf_track_drops(drops);
    var buf = "a\nb\nc\nd\ne\n";
    _hapi_mf_drop(buf, 4, "x", 0, "");
    _hapi_mf_drop(buf, 8, "x", 0, "");
    _hapi_mf_drop(buf, 2, "x", 0, "");
    var other = "\n\n\nq";
    _hapi_mf_drop(other, 3, "x", 0, "");
    hapi_mf_track_drops(0);
    assert_eq(vec_len(drops), 4, "four skips");
    assert_eq(hapi_mf_drop_line(vec_get(drops, 0)), 3, "line 3");
    assert_eq(hapi_mf_drop_line(vec_get(drops, 1)), 5, "line 5, counted on");
    assert_eq(hapi_mf_drop_line(vec_get(drops, 2)), 2, "line 2, behind the last, counted from the start");
    assert_eq(hapi_mf_drop_line(vec_get(drops, 3)), 4, "line 4 of another buffer");
}

# Finding 229: unlink removed the directories its links made only after
# the whole loop, so a run stopped partway left them for good. Each goes
# right after its own link, which is what the order of the lines shows.
fn test_made_dirs_go_with_their_link() {
    test_group("unlink: a link's made directories go right after it (finding 229)");
    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_cat(_test_row("b", ".cd/deep/b"), _test_row("z", ".zz")));
    _test_write_file(_fsl_path_join(pkg, "b"), "b");
    _test_write_file(_fsl_path_join(pkg, "z"), "z");
    assert_eq(cmd_link(pkg, 0), 0, "linked, making .cd/deep");
    assert_eq(_cli_run(_cli_av("hapi unlink p")), 0, "unlinked");
    var at_dir = _test_substr(_cli_out, _cli_out_n, "/.cd/  (a directory hapi made)");
    var at_zz = _test_substr(_cli_out, _cli_out_n, "/.zz\n");
    assert(at_dir >= 0 && at_zz >= 0, "both lines are printed");
    assert(at_dir < at_zz, "the directory goes before the next link is removed");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".cd"))), HAPI_LP_ABSENT, "and it is gone");

    # sync --prune removes dropped rows the same way.
    var pp = _t111_pkg_at(_fsl_path_join(d, "pp"), _test_cat(_test_row("b", ".pd/deep/b"), _test_row("z", ".pz")));
    _test_write_file(_fsl_path_join(pp, "b"), "b");
    _test_write_file(_fsl_path_join(pp, "z"), "z");
    assert_eq(cmd_link(pp, 0), 0, "linked, making .pd/deep");
    _t111_pkg_at(pp, "");
    var sv = _cli_av("hapi sync --prune --force");   # both rows: over the half limit
    _cli_add(sv, pp);
    assert_eq(_cli_run(sv), 0, "pruned both rows");
    var pd = _test_substr(_cli_out, _cli_out_n, "/.pd/  (a directory hapi made)");
    var pz = _test_substr(_cli_out, _cli_out_n, "/.pz\n");
    assert(pd >= 0 && pz >= 0, "both prune lines are printed");
    assert(pd < pz, "the directory goes before the next dropped row is pruned");
    _r171_clear();
}

fn _r171_mkfifo(path): i64 {
    return sys_mknodat(AT_FDCWD, path, 0x1180, 0);   # S_IFIFO|0600
}

# F-091: a FIFO where hapi read a manifest, the trail, or a snapshot's
# source blocked it forever; adopt moved one despite its own refusal.
fn test_fifos_do_not_hang() {
    test_group("manifest / trail / adopt / --backup-to: a FIFO is refused, not waited on (F-091)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pk = _fsl_path_join(d, "fpkg");
    hapi_mkdir(pk, 0x1C0);
    var mf = _fsl_path_join(pk, "hapi.cyml");
    assert_eq(_r171_mkfifo(mf), 0, "a FIFO named hapi.cyml");
    var t, v = hapi_mf_parse_file_r(mf);
    assert_eq(is_err_result(t), 1, "is not read as a manifest");

    assert_eq(hapi_open_regular(mf, O_RDONLY, 0), 0 - 22, "the open itself refuses what is not a regular file");
    var tf = _fsl_path_join(d, "trail.fifo");
    _r171_mkfifo(tf);
    var at, av = audit_read_r(tf);
    assert_eq(is_err_result(at), 1, "a FIFO trail is an error, not a wait");

    var ff = _fsl_path_join(home, ".pipe");
    _r171_mkfifo(ff);
    var ap = _t111_pkg("");
    assert_eq(cmd_adopt(ff, ap), 1, "adopt refuses a FIFO");
    assert_eq(link_probe_kind(link_probe(ff)), HAPI_LP_FILE, "and leaves it where it was");

    var bk = _fsl_path_join(d, "bk");
    hapi_mkdir(bk, 0x1C0);
    hapi_set_backup_dir(bk);
    var lp = _t111_pkg(_test_row("f", ".pipe"));
    _test_write_file(_fsl_path_join(lp, "f"), "f");
    assert_eq(cmd_link(lp, 1), 1, "link --force --backup-to over a FIFO stops, without waiting");
    hapi_set_backup_dir(0);
    _r171_clear();
    return 0;
}

# F-092: control bytes in a value. A NUL passed the `..` check, which
# sees the whole value, while the path stopped at it.
fn test_values_hold_no_control_bytes() {
    test_group("manifest: a value holds no control byte, but a description may span lines (F-092)");

    var hdr = "[package]\nname = \"p\"\nversion = \"1\"\n\n[[link]]\nsource = \"..";
    var tail = "\"\ntarget = \".x\"\n";
    var hl = strlen(hdr);
    var tl = strlen(tail);
    var buf = alloc(hl + tl + 2);
    memcpy(buf, hdr, hl);
    store8(buf + hl, 0);                          # `..\0`
    memcpy(buf + hl + 1, tail, tl);
    var t, v = hapi_mf_parse_header_r(buf, hl + 1 + tl);
    assert_eq(is_err_result(t), 1, "a source of `..` and a NUL is refused");
    assert_eq(v, HapiMfControlByte, "as a control byte, before anything uses the path");
    _expect_err("a newline in a target",
      "[package]\nname = \"p\"\nversion = \"1\"\n[[link]]\nsource = \"a\"\ntarget = \".a\nfake\"\n",
      HapiMfControlByte);
    _expect_err("an escape in a name", "[package]\nname = \"p\x1b[2J\"\nversion = \"1\"\n",
      HapiMfControlByte);
    var ok = "[package]\nname = \"p\"\nversion = \"1\"\ndescription = \"two\nlines\"\n";
    var ot, ov = hapi_mf_parse_header_r(ok, strlen(ok));
    assert_eq(is_ok(ot), 1, "a description that spans lines still parses");
    return 0;
}

# F-094: a dry run skipped the trail's pre-flight, and adopt's returned
# before its refusals, so each exited 0 where the real run exited 1.
fn test_dry_run_answers_as_the_real_run() {
    test_group("--dry-run: exits as the real run would (F-094)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_row("x", ".x"));
    _test_write_file(_fsl_path_join(pkg, "x"), "x");
    assert_eq(cmd_link(pkg, 0), 0, "linked");
    var tr = audit_trail_path();
    sys_chmod(tr, 0x124);                          # read-only: the real runs refuse
    hapi_set_dry_run(1);
    assert_eq(cmd_unlink("p"), 1, "unlink --dry-run refuses an unwritable trail");
    assert_eq(cmd_rollback(), 1, "rollback --dry-run too");
    assert_eq(cmd_checkpoint(), 1, "checkpoint --dry-run too");
    hapi_set_dry_run(0);
    sys_chmod(tr, 0x1A4);
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".x"))), HAPI_LP_SYMLINK,
      "and none of them changed anything");

    # adopt --dry-run with a symlinked manifest: the real run refuses it.
    var ap = _t111_pkg("");
    var mf = _fsl_path_join(ap, "hapi.cyml");
    hapi_rename(mf, _fsl_path_join(ap, "real.txt"));
    hapi_symlink(_fsl_path_join(ap, "real.txt"), mf);
    var f = _fsl_path_join(home, ".f");
    _test_write_file(f, "f");
    hapi_set_dry_run(1);
    assert_eq(cmd_adopt(f, ap), 1, "adopt --dry-run refuses a symlinked manifest");

    # link --dry-run --force --backup-to a directory it cannot write.
    var ro = _fsl_path_join(d, "ro");
    hapi_mkdir(ro, 0x1C0);
    var lp = _t111_pkg(_test_row("f", ".f"));
    _test_write_file(_fsl_path_join(lp, "f"), "pkg");
    hapi_set_backup_dir(_fsl_path_join(ro, "bk"));
    sys_chmod(ro, 0x140);
    assert_eq(cmd_link(lp, 1), 1, "link --dry-run --force with an unwritable --backup-to");
    sys_chmod(ro, 0x1C0);
    hapi_set_backup_dir(0);
    hapi_set_dry_run(0);
    _r171_clear();
    return 0;
}

# F-095: check took every `*.tmp` for a staging file, called a named
# manifest its own orphan, and missed a `./`-spelled source.
fn test_check_orphans_exactly() {
    test_group("check: orphans, staging files and named manifests, exactly (F-095)");

    var p1 = _t111_pkg(_test_row("z", ".z"));
    _test_write_file(_fsl_path_join(p1, "z"), "z");
    assert_eq(cmd_check(p1, 0), 0, "a package that agrees");
    _test_write_file(_fsl_path_join(p1, "hapi.cyml.4242.tmp"), "staged");
    assert_eq(cmd_check(p1, 0), 0, "hapi's own staging file is a note, not an orphan");
    _test_write_file(_fsl_path_join(p1, "zzzzzzzzz.4242.tmp"), "mine");
    assert_eq(cmd_check(p1, 0), 1, "a *.tmp of another name is an orphan like any file");

    var p2 = _t111_pkg_at(_fsl_path_join(_test_scratch_dir(), "named"), "");
    hapi_unlink(_fsl_path_join(p2, "hapi.cyml"));
    var zm = _fsl_path_join(p2, "zsh.cyml");
    _test_write_file(zm, _test_cat(_test_hdr("zsh"), _test_row("./z", ".z")));
    _test_write_file(_fsl_path_join(p2, "z"), "z");
    assert_eq(cmd_check(zm, 0), 0, "a named manifest is not its own orphan, and ./z claims z");

    var p3 = _t111_pkg(_test_row("ab", ".ab"));
    _test_write_file(_fsl_path_join(p3, "ab"), "ab");
    _test_write_file(_fsl_path_join(p3, "a"), "a");
    assert_eq(cmd_check(p3, 0), 1, "a row `ab` does not claim a file `a`");
    return 0;
}

# F-096: every link_probe took a fresh 4 KiB and a stat buffer from an
# allocator that never frees.
fn test_link_probe_memory_is_bounded() {
    test_group("fs_link: probing does not grow memory per call (F-096)");

    var d = _test_scratch_dir();
    var f = _fsl_path_join(d, "file");
    _test_write_file(f, "x");
    var before = alloc(8);
    var i = 0;
    while (i < 2000) {
        link_probe(f);
        i = i + 1;
    }
    var after = alloc(8);
    assert(after - before < 1048576, "2,000 probes take under 1 MB (they took 8.5 MB)");
    return 0;
}

# F-097: a loop was reported as an escape, with advice that could not
# help; sync's conflicts advised a --force sync does not take; and a
# package root hapi could not search was skipped with a wrong reason.
fn test_messages_say_what_happened() {
    test_group("link / sync: refusals say what happened (F-097)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    hapi_symlink("loop2", _fsl_path_join(home, "loop1"));
    hapi_symlink("loop1", _fsl_path_join(home, "loop2"));
    var lp = _t111_pkg(_test_row("f", "loop1/f"));
    _test_write_file(_fsl_path_join(lp, "f"), "f");
    var av = _cli_av("hapi link");
    _cli_add(av, lp);
    assert_eq(_cli_run(av), 1, "a target through a symlink loop is refused");
    assert(_test_substr(_cli_err, _cli_err_n, "cannot be followed") >= 0, "...as a path that cannot be followed");
    assert(_test_substr(_cli_err, _cli_err_n, "HAPI_ALLOWED_ROOTS") < 0, "...without advice that cannot help");

    var cp = _t111_pkg(_test_row("c", ".conf"));
    _test_write_file(_fsl_path_join(cp, "c"), "c");
    _test_write_file(_fsl_path_join(home, ".conf"), "user");
    var sv = _cli_av("hapi sync");
    _cli_add(sv, cp);
    assert_eq(_cli_run(sv), 1, "a sync with a conflict is refused");
    assert(_test_substr(_cli_err, _cli_err_n, "hapi link --force") >= 0, "...pointing at link --force");
    assert(_test_substr(_cli_err, _cli_err_n, "rerun with --force") < 0, "...not at a --force sync refuses");

    var root = _fsl_path_join(d, "roots");
    hapi_mkdir(root, 0x1C0);
    var shut = _fsl_path_join(root, "shut");
    hapi_mkdir(shut, 0x1C0);
    _test_write_file(_fsl_path_join(shut, "hapi.cyml"), _test_hdr("shut"));
    var good = _fsl_path_join(root, "good");
    hapi_mkdir(good, 0x1C0);
    _test_write_file(_fsl_path_join(good, "hapi.cyml"), _test_hdr("good"));
    sys_chmod(shut, 0);
    sync_set_package_roots(root);
    assert_eq(cmd_sync(0), 1, "a package root it cannot search fails the run");
    sync_set_package_roots(0);
    sys_chmod(shut, 0x1C0);
    _r171_clear();
    return 0;
}

# F-098: an empty argument meant the cwd to some verbs and /hapi.cyml to
# others, and `--backup-to ""` put snapshots at the filesystem root.
fn test_empty_arguments_refused() {
    test_group("cli: an empty argument or --backup-to value is a usage error (F-098)");

    var a1 = _cli_av("hapi link");
    _cli_add(a1, "");
    assert_eq(_cli_run(a1), 2, "link with an empty package is exit 2");
    var a2 = _cli_av("hapi inspect");
    _cli_add(a2, "");
    assert_eq(_cli_run(a2), 2, "and inspect, which read /hapi.cyml");
    var a3 = _cli_av("hapi link --backup-to");
    _cli_add(a3, "");
    _cli_add(a3, "docs/examples/dotfiles-zsh");
    assert_eq(_cli_run(a3), 2, "an empty --backup-to is exit 2");
    assert(_test_substr(_cli_err, _cli_err_n, "not an empty value") >= 0, "...and says why");
    return 0;
}

fn _r171_trail_is(d, text): i64 {
    var tr = _fsl_path_join(d, "t.jsonl");
    _test_write_file(tr, text);
    return tr;
}

# F-099 / F-100 / F-101 / F-104: what the trail reader accepts.
fn test_trail_reader_strictness() {
    test_group("audit_reader: whole lines, real escapes, and a dangling link is not absent (F-099 - F-104)");

    var d = _test_scratch_dir();
    var j = _r171_trail_is(d, "{\"op\":\"link\",\"pkg\":\"a\"}{\"op\":\"link\",\"pkg\":\"b\"}\n");
    var t1, v1 = audit_read_r(j);
    assert_eq(is_err_result(t1), 1, "two entries joined on one line are corrupt");
    var e2 = _r171_trail_is(d, "{} junk\n");
    var t2, v2 = audit_read_r(e2);
    assert_eq(is_err_result(t2), 1, "and so is text after an empty object");

    var ul = "{\"op\":\"link\",\"pkg\":\"caf\\u00e9\",\"target\":\"\\ud83d\\ude00\",\"source\":\"\\u0001\"}\n";
    var u = _r171_trail_is(d, ul);
    var t3, v3 = audit_read_r(u);
    assert_eq(is_ok(t3), 1, "a line with \\u escapes reads");
    if (is_ok(t3) == 1) {
        var e = vec_get(v3, 0);
        _assert_cstr(hae_pkg(e), "caf\xc3\xa9", "\\u00e9 is the two UTF-8 bytes of e-acute");
        _assert_cstr(hae_target(e), "\xf0\x9f\x98\x80", "a surrogate pair is its one four-byte code point");
        assert_eq(load8(hae_source(e)), 1, "the writer's own \\u0001 is still that one byte");
        assert_eq(strlen(hae_source(e)), 1, "...and only that byte");
    }
    var lone = _r171_trail_is(d, "{\"op\":\"link\",\"pkg\":\"\\udc00\"}\n");
    var t4, v4 = audit_read_r(lone);
    assert_eq(is_err_result(t4), 1, "a lone surrogate is corrupt");
    var bad = _r171_trail_is(d, "{\"op\":\"link\",\"pkg\":\"\\x41\"}\n");
    var t5, v5 = audit_read_r(bad);
    assert_eq(is_err_result(t5), 1, "so is an escape JSON does not have");

    var dl = _fsl_path_join(d, "dangling.jsonl");
    hapi_symlink(_fsl_path_join(d, "nowhere"), dl);
    var t6, v6 = audit_read_r(dl);
    assert_eq(is_err_result(t6), 1, "a dangling trail symlink is an error, not an empty trail");
    var t7, v7 = audit_read_r(_fsl_path_join(d, "absent.jsonl"));
    assert_eq(is_ok(t7), 1, "while a trail that is not there yet is empty");

    _assert_cstr(hae_shown("/h/.a\x1b[2J"), "/h/.a?[2J", "a printed trail field shows a control byte as ?");
    _assert_cstr(hae_shown("/h/.a"), "/h/.a", "and a plain one as it is");
    return 0;
}

# F-105: a rewrite reset the manifest's mode and split its hard links;
# a removal took the comments after its row, and missed an indented one.
fn test_manifest_rewrite_keeps_what_is_not_its() {
    test_group("manifest_write: rewrites keep the mode and the neighbours, and find any [[link]] (F-105)");

    var d = _test_scratch_dir();
    var mf = _fsl_path_join(d, "hapi.cyml");
    var text = _test_cat(_test_cat(_test_hdr("p"), _test_row("a", ".a")),
      _test_cat("\n# about b\n", _test_row("b", ".b")));
    _test_write_file(mf, text);
    assert_eq(manifest_remove_link_row(mf, "a", ".a"), 0, "row a removed");
    var len = 0;
    var got = manifest_read(mf, &len);
    assert(_test_substr(got, len, "# about b") >= 0, "the comment that belongs to b stays");
    assert(_test_substr(got, len, "source = \"b\"") >= 0, "and so does b");

    var ib = "[package]\nname = \"p\"\nversion = \"1\"\n\n  [[link]]\n  source = \"a\"\n  target = \".a\"\n";
    _test_write_file(mf, ib);
    assert_eq(manifest_remove_link_row(mf, "a", ".a"), 0, "an indented row is found");
    var t, v = hapi_mf_parse_file_r(mf);
    if (is_ok(t) == 1) { assert_eq(vec_len(hapi_mf_links(v)), 0, "and removed"); }

    sys_chmod(mf, 0x180);
    assert_eq(manifest_commit(mf, "[package]\nname = \"p\"\nversion = \"2\"\n", 35), 0, "a rewrite");
    assert_eq(_r171_mode(mf), 0x180, "keeps the manifest 0600");
    var other = _fsl_path_join(d, "other.cyml.txt");
    assert_eq(sys_link(mf, other), 0, "a second hard link to the manifest");
    assert_eq(manifest_commit(mf, "[package]\nname = \"p\"\nversion = \"3\"\n", 35), 0 - HapiMfwHardLinked,
      "a rewrite would leave it behind, and refuses");
    return 0;
}

# F-106: `unlink <path>` and an adopt-only package both said `no live
# links` at exit 0; `list --root` counted the whole trail.
fn test_unlink_and_list_say_what_they_hold() {
    test_group("unlink / list: a path, an adopt, and --root are answered as they are (F-106)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_row("x", ".x"));
    _test_write_file(_fsl_path_join(pkg, "x"), "x");
    assert_eq(cmd_link(pkg, 0), 0, "p linked");
    assert_eq(cmd_unlink(pkg), 1, "unlink given p's path says it takes the name");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".x"))), HAPI_LP_SYMLINK,
      "and removes nothing");

    var a = _t111_pkg_at(_fsl_path_join(d, "ad"), "");
    _test_write_file(_fsl_path_join(a, "hapi.cyml"), _test_hdr("ad"));
    _test_write_file(_fsl_path_join(home, ".rc"), "rc");
    assert_eq(cmd_adopt(_fsl_path_join(home, ".rc"), a), 0, "ad adopts .rc");
    var uv = _cli_av("hapi unlink ad");
    assert_eq(_cli_run(uv), 0, "unlink ad has no live link of its own");
    assert(_test_substr(_cli_out, _cli_out_n, "hapi rollback") >= 0, "...and says rollback reverses an adopt");

    var sub = _fsl_path_join(home, "sub");
    hapi_mkdir(sub, 0x1C0);
    link_set_scope_root(sub);
    var lv = _cli_av("hapi list");
    assert_eq(_cli_run(lv), 0, "list with the scope at ~/sub");
    assert(_test_substr(_cli_out, _cli_out_n, "p  0 live links") >= 0, "counts no link outside it");
    _r171_clear();
    return 0;
}

# F-107: a byte-order mark hid [package]; check --strict passed what the
# lenient parser skips without a word.
fn test_strict_means_nothing_skipped() {
    test_group("manifest / check --strict: a BOM is read past, and strict fails on skips (F-107)");

    var bom = "\xef\xbb\xbf[package]\nname = \"p\"\nversion = \"1\"\n";
    var t, v = hapi_mf_parse_header_r(bom, strlen(bom));
    assert_eq(is_ok(t), 1, "a manifest with a UTF-8 byte-order mark parses");

    var p1 = _t111_pkg("");
    var mf = _fsl_path_join(p1, "hapi.cyml");
    _test_write_file(mf, "# notes\n[package]\nname = \"p\"\nversion = \"1\"\n");
    assert_eq(cmd_check(p1, 1), 0, "comments are fine under --strict");
    _test_write_file(mf, "[package]\nname = \"p\"\nname = \"q\"\nversion = \"1\"\n");
    assert_eq(cmd_check(p1, 1), 1, "a key given twice fails --strict");
    _test_write_file(mf, "stray = \"x\"\n[package]\nname = \"p\"\nversion = \"1\"\n");
    assert_eq(cmd_check(p1, 1), 1, "a key before any section fails --strict");
    assert_eq(cmd_check(p1, 0), 0, "and is still fine without it");
    return 0;
}

# F-108: status read the target alone.
fn test_status_reports_refused_rows() {
    test_group("status: a row link refuses is REFUSED, and --quiet fails on it (F-108)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    hapi_symlink("../outside", _fsl_path_join(home, ".out"));
    var pkg = _t111_pkg(_test_row("f", ".out/f"));
    _test_write_file(_fsl_path_join(pkg, "f"), "f");
    var sv = _cli_av("hapi status --quiet");
    _cli_add(sv, pkg);
    assert_eq(_cli_run(sv), 1, "status --quiet exits 1 for a row out of the scope");
    assert(_test_substr(_cli_err, _cli_err_n, "(REFUSED above)") >= 0, "...and says the row is REFUSED");
    assert(_test_substr(_cli_err, _cli_err_n, "could not be checked") < 0, "...not that it could not be checked");
    var av = _cli_av("hapi status");
    _cli_add(av, pkg);
    _cli_run(av);
    assert(_test_substr(_cli_out, _cli_out_n, "REFUSED") >= 0, "and calls it REFUSED, not MISSING");
    _r171_clear();
    return 0;
}

# F-109: a relative scope root put every target under the cwd.
fn test_scope_root_is_absolute() {
    test_group("link / status: the scope root is an absolute path (F-109)");

    var d = _test_scratch_dir();
    var pkg = _t111_pkg(_test_row("f", ".f"));
    _test_write_file(_fsl_path_join(pkg, "f"), "f");
    audit_set_trail_path(_fsl_path_join(d, "audit.jsonl"));
    # A relative spelling of a directory that exists, from the cwd.
    var rel = fsl_compute_relative(_fsl_getcwd(), d);
    link_set_scope_root(rel);
    assert_eq(cmd_link(pkg, 0), 1, "link refuses a relative scope root");
    assert_eq(cmd_status_run(pkg, 0), 1, "and so does status");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(d, ".f"))), HAPI_LP_ABSENT,
      "nothing was linked under it");
    _test_clear_env();
    return 0;
}

# F-110: the smaller edges.
fn test_small_edges() {
    test_group("adopt / sync / rollback / --backup-to: the smaller edges (F-110)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var dots = _fsl_path_join(home, "...");
    _test_write_file(dots, "x");
    var ap = _t111_pkg("");
    var dv = _cli_av("hapi adopt");
    _cli_add(dv, dots);
    _cli_add(dv, ap);
    assert_eq(_cli_run(dv), 1, "a file named ... is refused");
    assert(_test_substr(_cli_err, _cli_err_n, "leaves no name") >= 0, "...because it leaves no name in the package");

    var root = _fsl_path_join(d, "r");
    var one = _fsl_path_join(root, "one");
    fsl_mkdir_parents(_fsl_path_join(one, "x"));
    _test_write_file(_fsl_path_join(one, "hapi.cyml"), _test_hdr("one"));
    sync_set_package_roots(_test_cat(_test_cat(root, ":"), root));
    assert_eq(cmd_sync(0), 0, "a root given twice is one root");
    sync_set_package_roots(0);

    var pkg = _t111_pkg(_test_row("g", ".g"));
    var src = _fsl_path_join(pkg, "g");
    _test_write_file(src, "g");
    assert_eq(cmd_link(pkg, 0), 0, "linked");
    assert_eq(cmd_checkpoint(), 0, "checkpoint");
    assert_eq(cmd_unlink("p"), 0, "unlinked");
    hapi_unlink(src);
    assert_eq(cmd_rollback_run(1, 0), 0, "rollback of the unlink");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, ".g"))), HAPI_LP_ABSENT,
      "does not re-create a link to a source that is gone");

    var long = alloc(256);
    memset(long, 108, 250);
    store8(long + 250, 0);
    var lt = _fsl_path_join(home, long);
    _test_write_file(lt, "user");
    var lp = _t111_pkg(_test_row("l", long));
    _test_write_file(_fsl_path_join(lp, "l"), "pkg");
    var bk = _fsl_path_join(d, "bk");
    hapi_mkdir(bk, 0x1C0);
    hapi_set_backup_dir(bk);
    assert_eq(cmd_link(lp, 1), 0, "a 250-byte name still gets a snapshot");
    hapi_set_backup_dir(0);
    _r171_clear();
    return 0;
}

# F-111: directories hapi makes, under odd spellings and failures.
fn test_made_directories_edges() {
    test_group("link / unlink: the directories hapi makes, whatever the spelling (F-111)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);
    var pkg = _t111_pkg(_test_row("f", "a//b/f"));
    _test_write_file(_fsl_path_join(pkg, "f"), "f");
    assert_eq(cmd_link(pkg, 0), 0, "a target spelled with // links");
    assert_eq(cmd_unlink("p"), 0, "unlink");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(home, "a"))), HAPI_LP_ABSENT,
      "and the directories it made are gone");

    var long = alloc(320);
    memset(long, 113, 300);
    store8(long + 300, 0);
    var deep = _fsl_path_join(_fsl_path_join(_fsl_path_join(d, "new1"), long), "f");
    var made = 0;
    assert(fsl_mkdir_parents_mode_r(deep, 0x1C0, &made) < 0, "a chain cut short by an over-long name fails");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(d, "new1"))), HAPI_LP_ABSENT,
      "and takes back the directory it had made");

    link_set_scope_root(_fsl_path_join(d, "no/such/root"));
    var p2 = _t111_pkg(_test_row("f", ".f"));
    _test_write_file(_fsl_path_join(p2, "f"), "f");
    assert_eq(cmd_link(p2, 0), 1, "an absent scope root with an absent parent is refused");
    assert_eq(link_probe_kind(link_probe(_fsl_path_join(d, "no"))), HAPI_LP_ABSENT,
      "and none of its ancestors were made");
    _r171_clear();
    return 0;
}

# Guards the 2026-10-29 audit found unpinned (its tests-ci unit, findings
# 187-205): each assertion here goes red when its guard is removed.
fn test_audit_gaps_pinned() {
    test_group("guards the audit found unpinned are pinned (1.7.1 test gaps)");

    var d = _test_scratch_dir();
    var home = _r171_env(d);

    # adopt: an existing package-side name, and a duplicate source row.
    var ap = _t111_pkg(_test_row("conf", ".other"));
    _test_write_file(_fsl_path_join(ap, "conf"), "package's own");
    _test_write_file(_fsl_path_join(home, ".conf"), "user's");
    assert_eq(cmd_adopt(_fsl_path_join(home, ".conf"), ap), 1, "adopt refuses a source the manifest has");
    _test_write_file(_fsl_path_join(ap, "hapi.cyml"), _test_hdr("p"));
    assert_eq(cmd_adopt(_fsl_path_join(home, ".conf"), ap), 1, "and a package-side name already taken");
    assert_eq(_test_file_size(_fsl_path_join(ap, "conf")), 13, "the package's file is untouched");

    # A relative HAPI_ALLOWED_ROOTS entry grants nothing.
    cap_set_allowlist("outside");
    assert_eq(cap_target_allowed(_fsl_path_join(d, "outside"), home), 0, "a relative grant is ignored");
    cap_set_allowlist(0);

    # Manifest path edges: a whole `..`, a trailing `/..`, an empty value.
    _expect_err("source = \"..\"",
      "[package]\nname = \"x\"\nversion = \"1\"\n[[link]]\nsource = \"..\"\ntarget = \".x\"\n", HapiMfPathTraversal);
    _expect_err("target = \"a/..\"",
      "[package]\nname = \"x\"\nversion = \"1\"\n[[link]]\nsource = \"a\"\ntarget = \"a/..\"\n", HapiMfPathTraversal);
    _expect_err("an empty source",
      "[package]\nname = \"x\"\nversion = \"1\"\n[[link]]\nsource = \"\"\ntarget = \".x\"\n", HapiMfMissingSource);

    # The trail reader's line checks, one by one; a blank line is fine.
    var t1, v1 = audit_read_r(_r171_trail_is(d, "\"op\":\"link\"}\n"));
    assert_eq(is_err_result(t1), 1, "a line with no { is corrupt");
    var t2, v2 = audit_read_r(_r171_trail_is(d, "{\"op\" \"link\"}\n"));
    assert_eq(is_err_result(t2), 1, "a field with no : is corrupt");
    var t3, v3 = audit_read_r(_r171_trail_is(d, "{\"op\":\"link\" junk ,\"pkg\":\"p\"}\n"));
    assert_eq(is_err_result(t3), 1, "junk between fields is corrupt");
    var t4, v4 = audit_read_r(_r171_trail_is(d, "{\"op\":\"link\"}\n\n{\"op\":\"link\"}\n"));
    assert_eq(is_ok(t4), 1, "a blank interior line is tolerated");

    # The writer escapes every control byte, not only `"` and `\`.
    var buf = alloc(4096);
    var n = audit_format_link(buf, 4096, "p", "1", "sha1c:00", "a\x01b", ".a", "/x/a", "/x/.a", 0);
    assert(_test_substr(buf, n, "a\\u0001b") >= 0, "a 0x01 in a field is written as \\u0001");

    # list's ownership: adopt creates, a --force takeover moves it, and a
    # non-owner's unlink does not release it.
    var e = _t111_pkg_at(_fsl_path_join(d, "e"), "");
    _test_write_file(_fsl_path_join(e, "hapi.cyml"), _test_hdr("e"));
    _test_write_file(_fsl_path_join(home, ".erc"), "e");
    assert_eq(cmd_adopt(_fsl_path_join(home, ".erc"), e), 0, "e adopts .erc");
    var tr_t, tr_v = audit_read_default_r();
    assert_eq(_hls_live_count(tr_v, "e"), 1, "an adopt counts as e's link");
    var f2 = _t111_pkg_at(_fsl_path_join(d, "f2"), "");
    _test_write_file(_fsl_path_join(f2, "hapi.cyml"), _test_cat(_test_hdr("f2"), _test_row("erc", ".erc")));
    _test_write_file(_fsl_path_join(f2, "erc"), "f2");
    assert_eq(cmd_link(f2, 1), 0, "f2 takes .erc over with --force");
    var tr2_t, tr2_v = audit_read_default_r();
    assert_eq(_hls_live_count(tr2_v, "e"), 0, "e no longer owns it");
    assert_eq(_hls_live_count(tr2_v, "f2"), 1, "f2 does");

    # unlink's live set: a second unlink has nothing left to remove.
    assert_eq(cmd_unlink("f2"), 0, "f2 unlinks");
    var before = _test_file_size(audit_trail_path());
    assert_eq(cmd_unlink("f2"), 0, "a second unlink");
    assert_eq(_test_file_size(audit_trail_path()), before, "finds nothing: the unlink superseded the link");

    # A force-only run gets the trail pre-flight: with the trail read-only
    # the file --force would delete is kept.
    var fp = _t111_pkg_at(_fsl_path_join(d, "fp"), "");
    _test_write_file(_fsl_path_join(fp, "hapi.cyml"), _test_cat(_test_hdr("fp"), _test_row("k", ".keep")));
    _test_write_file(_fsl_path_join(fp, "k"), "pkg");
    _test_write_file(_fsl_path_join(home, ".keep"), "user's only copy");
    sys_chmod(audit_trail_path(), 0x124);
    assert_eq(cmd_link(fp, 1), 1, "link --force with a read-only trail is refused");
    sys_chmod(audit_trail_path(), 0x1A4);
    assert_eq(_test_file_size(_fsl_path_join(home, ".keep")), 16, "and the user's file is still there");

    # adopt whose trail entry cannot be written after the pre-flight: exit 1.
    var g = _t111_pkg_at(_fsl_path_join(d, "g"), "");
    _test_write_file(_fsl_path_join(g, "hapi.cyml"), _test_hdr("g"));
    _test_write_file(_fsl_path_join(home, ".grc"), "g");
    audit_test_fail_appends(1);
    var arc = cmd_adopt(_fsl_path_join(home, ".grc"), g);
    audit_test_fail_appends(0);
    assert_eq(arc, 1, "an adopt whose entry could not be written exits 1");
    _r171_clear();
    return 0;
}

# ============================================================
# 1.7.1 — the run removes its scratch directories
# ============================================================

# Removal never follows a link: what a link in a scratch directory names
# survives, a directory or a file. A directory left mode 000 is emptied.
fn test_scratch_rmtree_never_follows() {
    test_group("scratch: removal never follows a link");

    var keep = _test_scratch_dir();
    var kept = _fsl_path_join(keep, "keep");
    _test_write_file(kept, "keep");

    var gone = _test_scratch_dir();
    assert_eq(hapi_symlink(keep, _fsl_path_join(gone, "dirlink")), 0, "a link to a directory");
    assert_eq(hapi_symlink(kept, _fsl_path_join(gone, "filelink")), 0, "a link to a file");
    var deep = _fsl_path_join(gone, "a/b");
    fsl_mkdir_parents(_fsl_path_join(deep, "x"));
    assert_eq(_test_write_file(_fsl_path_join(deep, "f"), "f"), 1, "a file two levels down");
    var locked = _fsl_path_join(gone, "locked");
    hapi_mkdir(locked, 0x1C0);
    _test_write_file(_fsl_path_join(locked, "inner"), "inner");
    assert_eq(sys_chmod(locked, 0), 0, "a directory left mode 000");

    assert_eq(_ts_rmtree(gone), 0, "the tree is removed");
    assert_eq(link_probe_kind(link_probe(gone)), HAPI_LP_ABSENT, "nothing of it is left");
    assert_eq(link_probe_kind(link_probe(keep)), HAPI_LP_DIRECTORY,
      "the directory a link named survives");
    assert_eq(link_probe_kind(link_probe(kept)), HAPI_LP_FILE,
      "the file a link named survives");

    # A directory that cannot be removed is reported, not taken as gone.
    var ro = _test_scratch_dir();
    var stuck = _fsl_path_join(ro, "stuck");
    hapi_mkdir(stuck, 0x1C0);
    assert_eq(sys_chmod(ro, 0x140), 0, "its parent made read-only (0500)");
    assert(_ts_rmtree(stuck) < 0, "a directory that stays is reported");
    sys_chmod(ro, 0x1C0);

    # Whatever is recorded, nothing outside /tmp/hapi-… is removed.
    assert_eq(_ts_removable("/tmp/hapi-"), 0, "the bare prefix is refused");
    assert_eq(_ts_removable("/home/x/hapi-test-1"), 0, "a path elsewhere is refused");
    assert_eq(_ts_removable(0), 0, "no path is refused");
    assert_eq(_ts_removable(keep), 1, "a scratch directory is removable");
    return 0;
}

# The last group: every directory the run made is removed, and nothing
# named for this run is left in /tmp, recorded or not.
fn test_scratch_cleanup() {
    test_group("scratch: the run leaves nothing in /tmp");

    assert(_ts_tracked() > 0, "the run made scratch directories");
    assert_eq(_ts_cleanup(), 0, "every directory it made is removed");

    var buf[64];
    var pre = "hapi-test-";
    var p = strlen(pre);
    memcpy(&buf, pre, p);
    p = p + fmt_int_buf(syscall(SYS_GETPID), &buf + p);
    store8(&buf + p, 45); p = p + 1;
    var names = vec_new();
    assert_eq(dir_list_checked(str_from("/tmp"), names), 0, "/tmp is listable");
    var left = 0;
    var i = 0;
    while (i < vec_len(names)) {
        var nm = vec_get(names, i);
        if (str_len(nm) >= p && memeq(str_data(nm), &buf, p) == 1) { left = left + 1; }
        i = i + 1;
    }
    assert_eq(left, 0, "no /tmp/hapi-test-<pid>-* is left");
    return 0;
}

