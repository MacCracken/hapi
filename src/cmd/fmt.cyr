# cmd/fmt.cyr — `hapi fmt <package-dir|hapi.cyml>` (1.7.0)
#
# Rewrites a manifest's header as hapi_mf_canonicalize's bytes: fixed
# field order, rows sorted by target, one blank line between sections,
# values in double quotes. The `sha1c:` manifest hash is computed over
# exactly those bytes, so a formatted manifest hashes as it did before
# (the roadmap's condition for fmt in v1.x). Everything from the body
# delimiter `---` on is kept byte for byte, after one blank line; a
# CRLF manifest keeps CRLF.
#
# What the canonical form cannot hold — comments, unknown keys, a key
# given twice, text after a value — is listed with its line, and the run
# refuses unless `--force`, which drops it. A value holding a backslash
# is refused even then: formatting would escape it again and change it.
#
# fmt moves no link and leaves the hash as it was, so it writes no trail
# entry. It rewrites through manifest_write.cyr's pieces, holding the
# package-directory lock from read to commit, as `adopt` does.
#
# Exit codes:
#   0  formatted, or already formatted (--check: already formatted)
#   1  --check: not formatted; or a refusal — content it would drop
#      without --force, a backslash, a manifest that does not parse, a
#      symlinked manifest, an IO failure
#   2  bad usage

include "src/manifest.cyr"
include "src/manifest_write.cyr"
include "src/fs_link.cyr"
include "src/dry_run.cyr"

fn _hfm_puts(s): i64 { print(s, strlen(s)); return 0; }
fn _hfm_eputs(s): i64 { eprint(s, strlen(s)); return 0; }

# Same resolver as status / check — a *.cyml path or a package directory.
fn _hfm_resolve_manifest(arg): i64 { return fsl_manifest_of_arg(arg); }

# Print each recorded drop as `  line N: <what><tail>`.
fn _hfm_print_drops(drops, to_err, tail): i64 {
    var i = 0;
    while (i < vec_len(drops)) {
        var d = vec_get(drops, i);
        var line = "  line ";
        if (to_err == 1) {
            _hfm_eputs(line);
            fmt_int_fd(2, hapi_mf_drop_line(d));
            _hfm_eputs(": ");
            _hfm_eputs(hapi_mf_drop_what(d));
            _hfm_eputs(tail);
        } else {
            _hfm_puts(line);
            fmt_int(hapi_mf_drop_line(d));
            _hfm_puts(": ");
            _hfm_puts(hapi_mf_drop_what(d));
            _hfm_puts(tail);
        }
        i = i + 1;
    }
    return 0;
}

fn cmd_fmt(pkg_arg): i64 { return cmd_fmt_run(pkg_arg, 0, 0); }

fn cmd_fmt_run(pkg_arg, check, force): i64 {
    if (pkg_arg == 0) {
        _hfm_eputs("usage: hapi fmt <package-dir|hapi.cyml> [--check] [--force]\n");
        return 2;
    }
    var path = _hfm_resolve_manifest(pkg_arg);
    if (path == 0) {
        _hfm_eputs("hapi: cannot resolve a relative package path — the working\n");
        _hfm_eputs("  directory is not knowable on this target. Pass an absolute\n");
        _hfm_eputs("  path, or set PWD.\n");
        return 1;
    }

    # A real run commits by rename, which would replace a symlinked
    # manifest with a private copy (F-058). --dry-run answers as the real
    # run would; --check only reads, so it may look through the link.
    if (check == 0 && hapi_mfw_manifest_is_symlink(path) == 1) {
        _hfm_eputs("hapi: ");
        _hfm_eputs(hapi_mfw_err_msg(HapiMfwManifestIsSymlink));
        _hfm_eputs(" (");
        _hfm_eputs(path);
        _hfm_eputs(")\n");
        return 1;
    }

    var writing = 0;
    if (check == 0 && hapi_dry_run() == 0) { writing = 1; }
    var lk = 0 - 1;
    if (writing == 1) {
        lk = manifest_lock(path);
        if (lk < 0) {
            _hfm_eputs("hapi: could not lock the package directory of ");
            _hfm_eputs(path);
            _hfm_eputs("\n");
            return 1;
        }
    }
    var rc = _hfm_locked(path, check, force, writing);
    if (writing == 1) { manifest_unlock(lk); }
    return rc;
}

# The rest of cmd_fmt_run, under the lock when the run writes.
fn _hfm_locked(path, check, force, writing): i64 {
    var len = 0;
    var buf = manifest_read(path, &len);
    if (buf == 0) {
        _hfm_eputs("hapi: ");
        _hfm_eputs(hapi_mfw_err_msg(HapiMfwReadFailed));
        _hfm_eputs(" (");
        _hfm_eputs(path);
        _hfm_eputs(")\n");
        return 1;
    }
    var sep = manifest_body_start(buf, len);
    var hlen = len;
    if (sep >= 0) { hlen = sep; }
    var crlf = manifest_uses_crlf(buf, len);

    var f_t, f_v = hapi_mf_format_r(buf, hlen, crlf);
    if (is_err_result(f_t) == 1) {
        _hfm_eputs("hapi: ");
        _hfm_eputs(hapi_mf_err_msg(f_v));
        _hfm_eputs(" (");
        _hfm_eputs(path);
        _hfm_eputs(")\n");
        return 1;
    }
    var f = f_v;
    if (hapi_fmt_backslash(f) != 0) {
        _hfm_eputs("hapi: ");
        _hfm_eputs(hapi_fmt_backslash(f));
        _hfm_eputs(" holds a backslash, which formatting would escape again,\n");
        _hfm_eputs("  changing the value and the manifest's hash; nothing was changed (");
        _hfm_eputs(path);
        _hfm_eputs(")\n");
        return 1;
    }
    if (hapi_fmt_proven(f) == 0) {
        _hfm_eputs("hapi: the formatted header would not read back as this manifest;\n");
        _hfm_eputs("  nothing was changed (");
        _hfm_eputs(path);
        _hfm_eputs(")\n");
        return 1;
    }

    # The file fmt would leave: the header, then — if there is a body — one
    # blank line and everything from the delimiter on, byte for byte.
    var out = hapi_fmt_out(f);
    var on = hapi_fmt_out_len(f);
    var nl = on;
    if (sep >= 0) { nl = on + 2 + (len - sep); }
    var next = alloc(nl + 1);
    memcpy(next, out, on);
    var pos = on;
    if (sep >= 0) {
        if (crlf == 1) { store8(next + pos, 13); pos = pos + 1; }
        store8(next + pos, 10);
        pos = pos + 1;
        memcpy(next + pos, buf + sep, len - sep);
        pos = pos + (len - sep);
    }

    if (pos == len && memeq(next, buf, len) == 1) {
        _hfm_puts(path);
        _hfm_puts(": already formatted\n");
        return 0;
    }
    if (check == 1) {
        _hfm_puts(path);
        _hfm_puts(": not formatted\n");
        return 1;
    }

    var drops = hapi_fmt_drops(f);
    if (vec_len(drops) > 0 && force == 0) {
        _hfm_eputs("hapi: formatting ");
        _hfm_eputs(path);
        _hfm_eputs(" would drop what its canonical form has no place for:\n");
        _hfm_print_drops(drops, 1, "\n");
        _hfm_eputs("  (rerun with --force to drop them; nothing was changed)\n");
        return 1;
    }

    if (writing == 0) {
        print(out, on);
        if (vec_len(drops) > 0) { _hfm_print_drops(drops, 0, "  (would drop)\n"); }
        _hfm_puts("would format ");
        _hfm_puts(path);
        if (sep >= 0) { _hfm_puts(", keeping its body"); }
        _hfm_puts("  (dry-run)\n");
        return 0;
    }

    var wrc = manifest_commit(path, next, pos);
    if (wrc < 0) {
        _hfm_eputs("hapi: ");
        _hfm_eputs(hapi_mfw_err_msg(0 - wrc));
        _hfm_eputs(" (");
        _hfm_eputs(path);
        _hfm_eputs(")\n");
        return 1;
    }
    if (vec_len(drops) > 0) { _hfm_print_drops(drops, 0, "  (dropped)\n"); }
    _hfm_puts("formatted ");
    _hfm_puts(path);
    _hfm_puts("\n");
    return 0;
}
