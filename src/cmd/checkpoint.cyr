# cmd/checkpoint.cyr — `hapi checkpoint`
#
# Appends a single `op:rollback-marker` entry to the audit
# trail. The marker is the boundary that `hapi rollback` stops
# at — every subsequent link / unlink / adopt is in scope for
# the next rollback; everything before is sealed.
#
# Per-entry machinery (audit_append_rollback_marker_r) shipped
# in M3 alongside rollback's walk-to-marker logic. This is the
# user-facing surface the M5 roadmap calls out.
#
# `hapi checkpoint --label <name>` (1.5.0) names the marker, so that
# `hapi rollback --to <name>` can find it (ADR 0002, 1.5.0 addendum). The
# label is checked by the command line (audit_label_ok) before this runs.
#
# Exit codes:
#   0  marker appended
#   1  audit-trail write failed

include "src/audit.cyr"
include "src/dry_run.cyr"

fn _hck_puts(s): i64 { print(s, strlen(s)); return 0; }
fn _hck_eputs(s): i64 { eprint(s, strlen(s)); return 0; }

fn cmd_checkpoint(): i64 { return cmd_checkpoint_label(0); }

# `label` 0 writes the plain marker, byte for byte what 1.4.0 wrote.
fn cmd_checkpoint_label(label): i64 {
    if (hapi_dry_run() == 1) {
        _hck_puts("checkpoint");
        _hck_say_label(label);
        _hck_puts(" (dry-run; no entry written)\n");
        return 0;
    }
    var r_t, r_v = audit_append_marker_r(label, 0);
    if (is_err_result(r_t) == 1) {
        _hck_eputs("hapi: audit-trail write failed (could not append checkpoint)\n");
        return 1;
    }
    _hck_puts("checkpoint");
    _hck_say_label(label);
    _hck_puts(" written\n");
    return 0;
}

fn _hck_say_label(label): i64 {
    if (label == 0) { return 0; }
    _hck_puts(" `");
    _hck_puts(label);
    _hck_puts("`");
    return 0;
}
