# cmd/adopt.cyr — `hapi adopt <file> <package-dir>`
#
# Move an existing file into a package, create the symlink
# back, append the [[link]] row to the package manifest,
# write a single atomic op:adopt audit entry.
#
# Per ADR 0004 the source path inside the package is the
# target's basename with one leading `.` stripped. Refuses on
# any of: target is a symlink / target is a directory / target
# absent / source name already exists in the package /
# manifest already has a row for this target.
#
# Exit codes:
#   0  adopted cleanly
#   1  parse / probe / move / audit / manifest-edit failure
#   2  bad usage

include "src/manifest.cyr"
include "src/manifest_write.cyr"
include "src/audit.cyr"
include "src/fs_link.cyr"
include "src/cmd/link.cyr"   # link_scope_root
include "src/dry_run.cyr"
include "src/backup.cyr"
include "src/out.cyr"

# Resolve the package-dir argument to an absolute manifest path.
# Mirrors the inspect / link resolvers.
fn _hap_resolve_manifest(arg): i64 { return fsl_manifest_of_arg(arg); }

# Resolve a scope-root-relative path to an absolute one.
# Mirrors the link command's scope-root resolution.
fn _hap_resolve_target(arg, scope_root_abs): i64 {
    if (strlen(arg) > 0 && load8(arg) == 47) { return _fsl_cstr_dup(arg); }
    return _fsl_path_join(scope_root_abs, arg);
}

# Derive the in-package source name from a target path's
# basename, stripping one leading `.`. Returns a heap cstring.
fn _hap_derive_source(target_abs): i64 {
    var b = _fsl_path_basename(target_abs);
    if (strlen(b) > 1 && load8(b) == 46) { return b + 1; }
    return b;
}

# Check whether the parsed manifest already has a row whose
# target matches `target_cstr`. Used to refuse on duplicate.
fn _hap_manifest_has_target(m, target_cstr): i64 { return _hap_manifest_has(m, target_cstr, 1); }
fn _hap_manifest_has_source(m, source_cstr): i64 { return _hap_manifest_has(m, source_cstr, 0); }

# 1 when a row of `m` has `value` as its target (`target` = 1) or its
# source (0).
fn _hap_manifest_has(m, value, target): i64 {
    var links = hapi_mf_links(m);
    var n = vec_len(links);
    var vlen = strlen(value);
    var i = 0;
    while (i < n) {
        var l = vec_get(links, i);
        var f = hapi_link_source(l);
        if (target == 1) { f = hapi_link_target(l); }
        if (str_len(f) == vlen) {
            if (memeq(str_data(f), value, vlen) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Move the file back from the package after a failed adopt, and say what
# happened. Through 1.7.0 the move back was a plain rename whose result
# was ignored, and the message said `restored` regardless.
fn _hap_say_restored(abs_source, abs_target): i64 {
    if (hapi_rename_noreplace(abs_source, abs_target) == 0) {
        hapi_eputs(" (file restored)\n");
        return 0;
    }
    hapi_eputs("\n  the file could NOT be moved back; it is in the package at\n  ");
    hapi_eputs(abs_source);
    hapi_eputs("\n");
    return 0 - 1;
}

# 1 when the manifest at `path` parses, has `old_rows` + 1 rows, and one
# of them is (source, target) (F-090).
fn _hap_row_read_back(path, old_rows, source, target): i64 {
    var t, v = hapi_mf_parse_file_r(path);
    if (is_err_result(t) == 1) { return 0; }
    var links = hapi_mf_links(v);
    if (vec_len(links) != old_rows + 1) { return 0; }
    var i = 0;
    while (i < vec_len(links)) {
        var l = vec_get(links, i);
        if (hapi_cstr_eq(_fsl_str_to_cstr(hapi_link_source(l)), source) == 1
            && hapi_cstr_eq(_fsl_str_to_cstr(hapi_link_target(l)), target) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn cmd_adopt(file_arg, pkg_arg): i64 {
    if (file_arg == 0 || pkg_arg == 0) {
        hapi_eputs("usage: hapi adopt <file> <package-dir>\n");
        return 2;
    }

    var scope_root = link_scope_root("cannot resolve scope root");
    if (scope_root == 0) { return 1; }
    # Normalized once, here: the target slice below measures it, so it
    # must be spelled exactly as abs_target's prefix is.
    var scope_root_abs = fsl_to_absolute(scope_root);
    if (scope_root_abs == 0) {
        hapi_eputs("hapi: cannot resolve a relative scope root — the working\n");
        hapi_eputs("  directory is not knowable on this target\n");
        return 1;
    }
    scope_root_abs = fsl_lexical_normalize(scope_root_abs);

    # A `..` in <file> is refused, not collapsed (F-052). Collapsing it
    # lexically pops the name before it, while the kernel follows that
    # name first if it is a symlink — `a/../c.conf` with `a -> /outside`
    # named a file outside $HOME, and the row recorded `a/../c.conf`, which
    # the manifest parser itself rejects. The manifest cannot say `..`, so
    # adopt cannot either.
    if (_hapi_mf_has_dotdot(str_from(file_arg)) == 1) {
        hapi_eputs("hapi: refusing a `..` component in the file to adopt: ");
        hapi_eputs(file_arg);
        hapi_eputs("\n  (spell the path without `..` — a [[link]] target cannot hold one)\n");
        return 1;
    }
    # With no `..` left, normalizing only drops `.` and `//` — no-ops to
    # the kernel, but not to the target this records (F-053: `./.bashrc`
    # gave a link computed one directory too high).
    var abs_target = fsl_lexical_normalize(_hap_resolve_target(file_arg, scope_root_abs));

    # The row's `target` is <file> relative to the scope root, so <file>
    # must be under it by spelling (F-054). Through 1.1.0 a path outside
    # it that HAPI_ALLOWED_ROOTS let through was sliced at the scope
    # root's length regardless: shorter than the root it read before the
    # buffer and crashed (SIGSEGV, exit 139), longer it recorded a
    # garbled target in the manifest and the trail.
    if (_fsl_within(abs_target, scope_root_abs) == 0) {
        hapi_eputs("hapi: refusing to adopt a file outside the scope root: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n  (scope: ");
        hapi_eputs(scope_root_abs);
        hapi_eputs(")\n  a [[link]] target is relative to the scope root, so a file\n");
        hapi_eputs("  outside it has no row to record — pass --root to adopt there\n");
        return 1;
    }

    # The <file> argument is a write target: adopt renames it away and
    # plants a symlink where it stood. It must therefore be inside the
    # scope root, exactly like a manifest [[link]] target. `--root`
    # widens the scope legitimately (scope_root is already the
    # cap-approved override by this point); without it an absolute or
    # `..` path used to escape $HOME entirely at exit 0.
    if (cap_target_allowed(_fsl_path_dirname(abs_target), scope_root_abs) == 0) {
        hapi_eputs("hapi: refusing to adopt outside the scoped root: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n  (scope: ");
        hapi_eputs(scope_root_abs);
        hapi_eputs(")\n  (pass --root <path> to open a different scope)\n");
        return 1;
    }

    var manifest_path = _hap_resolve_manifest(pkg_arg);
    # 0 = a relative package argument with no determinable cwd (agnos
    # without a usable PWD). Refuse loudly: continuing would put a
    # non-absolute path into the trail's `abs_source`, which ADR 0002
    # requires to be absolute, and the symlink body would resolve
    # against the wrong directory (F-027).
    if (manifest_path == 0) {
        hapi_refuse_unknown_cwd();
        return 1;
    }
    var pkg_dir_abs = _fsl_path_dirname(manifest_path);

    # Probe target: must be a regular file.
    var probe = link_probe(abs_target);
    var kind = link_probe_kind(probe);
    if (kind == HAPI_LP_SYMLINK) {
        hapi_eputs("hapi: target is already a symlink: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n  (use `hapi unlink <pkg>` first if hapi created it)\n");
        return 1;
    }
    if (kind == HAPI_LP_DIRECTORY) {
        hapi_eputs("hapi: target is a directory (adopt is file-scoped): ");
        hapi_eputs(abs_target);
        hapi_eputs("\n");
        return 1;
    }
    if (kind == HAPI_LP_ABSENT) {
        hapi_eputs("hapi: target does not exist: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n");
        return 1;
    }
    # link_probe's FILE is anything that is not a directory; adopt moves
    # only a regular file (F-091). Through 1.7.0 it moved a FIFO or a
    # socket into the package despite this very message.
    if (kind != HAPI_LP_FILE || fsl_is_regular(abs_target) == 0) {
        hapi_eputs("hapi: target is not a regular file: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n");
        return 1;
    }

    # A file that is already package content, reached through a symlinked
    # parent (`~/.ssh -> dotfiles/pkg/ssh`), is not the user's to adopt
    # (F-045): adopt moved it to a second name in the package and planted
    # a dangling symlink where it had been — inside the package itself.
    if (fsl_lands_in(abs_target, pkg_dir_abs) == 1) {
        var phys = fsl_physical_target(abs_target);
        hapi_eputs("hapi: file is already inside the package: ");
        hapi_eputs(abs_target);
        if (phys != 0) {
            hapi_eputs("\n  (it resolves to ");
            hapi_eputs(phys);
            hapi_eputs(")");
        }
        hapi_eputs("\n");
        return 1;
    }

    # Nor is the audit trail itself (F-081): adopt would move hapi's own
    # record into the package and plant a link where it was.
    var trail_now = audit_trail_path();
    if (trail_now != 0) {
        var tphys = fsl_physical_target(trail_now);
        var aph = fsl_physical_target(abs_target);
        if (hapi_cstr_eq(fsl_lexical_normalize(trail_now), fsl_lexical_normalize(abs_target)) == 1
            || (tphys != 0 && aph != 0 && hapi_cstr_eq(tphys, aph) == 1)) {
            hapi_eputs("hapi: the audit trail is hapi's own record, not a file to adopt: ");
            hapi_eputs(abs_target);
            hapi_eputs("\n");
            return 1;
        }
    }

    # Nor is a file that is ANOTHER package's source, reached through
    # a link that package made (F-070): adopt moved it from that package
    # into this one and planted a link inside the other package's tree.
    var others = hlnk_package_sources();
    if (others == 0) {
        hapi_eputs("hapi: the audit trail could not be read, so hapi cannot tell\n");
        hapi_eputs("  whether the file is another package's; nothing was changed\n");
        return 1;
    }
    var aphys = fsl_physical_target(abs_target);
    var owner = hlnk_owner_at(others, aphys);
    if (owner != 0) {
        hapi_eputs("hapi: file is package `");
        hapi_eputs(owner);
        hapi_eputs("`'s source: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n  (it resolves to ");
        hapi_eputs(aphys);
        hapi_eputs("); change it through that package\n");
        return 1;
    }

    # From the manifest read to the trail entry, adopt holds the package
    # lock (F-071). Through 1.7.0 its checks — no row has this source or
    # target, nothing sits at the package-side name — ran with nothing
    # held, and the lock covered only the append. Two adopts deriving the
    # same name both passed, and the second rename replaced the first
    # one's file: the user's only copy. A --dry-run changes nothing and
    # takes no lock.
    # A package that is not one — no manifest, or one that does not parse
    # — is reported as such, before the lock, which needs its directory.
    var pre_t, pre_v = hapi_mf_parse_file_r(manifest_path);
    if (is_err_result(pre_t) == 1) {
        hapi_mf_report_err(pre_v, manifest_path);
        return 1;
    }
    var lk = 0 - 1;
    if (hapi_dry_run() == 0) {
        lk = manifest_lock(manifest_path);
        if (lk < 0) {
            hapi_eputs("hapi: could not lock the package directory of ");
            hapi_eputs(manifest_path);
            hapi_eputs("\n");
            return 1;
        }
    }
    var rc = _hap_locked(manifest_path, pkg_dir_abs, abs_target, scope_root_abs);
    if (lk >= 0) { manifest_unlock(lk); }
    return rc;
}

# The rest of cmd_adopt, under the package lock when the run writes.
fn _hap_locked(manifest_path, pkg_dir_abs, abs_target, scope_root_abs): i64 {
    # Parse the manifest (must exist).
    var mr_t, mr_v = hapi_mf_parse_file_r(manifest_path);
    if (is_err_result(mr_t) == 1) {
        hapi_mf_report_err(mr_v, manifest_path);
        return 1;
    }
    var m = mr_v;

    # Derive the in-package source name + the manifest's
    # relative target (everything after the scope root, no
    # leading slash).
    var source_cstr = _hap_derive_source(abs_target);
    # `...` derives `..`, and `.` alone `.`: neither is a name in the
    # package (F-110). Through 1.7.0 `..` was refused only by accident.
    if (hapi_cstr_eq(source_cstr, ".") == 1 || hapi_cstr_eq(source_cstr, "..") == 1) {
        hapi_eputs("hapi: the file's name leaves no name for it in the package: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n");
        return 1;
    }
    var srl = strlen(scope_root_abs);
    var atl = strlen(abs_target);
    var rel_target_start = srl;
    if (atl > srl && load8(abs_target + srl) == 47) { rel_target_start = srl + 1; }
    var rel_target_len = atl - rel_target_start;
    # The scope root itself has no target to record (F-090): with
    # `--root ~/somefile`, adopt wrote `target = ""`, a row no verb could
    # parse, at exit 0.
    if (rel_target_len <= 0) {
        hapi_eputs("hapi: the file is the scope root itself, which no [[link]] row can name: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n");
        return 1;
    }
    var target_cstr = alloc(rel_target_len + 1);
    memcpy(target_cstr, abs_target + rel_target_start, rel_target_len);
    store8(target_cstr + rel_target_len, 0);

    # Refuse on duplicate source / target in the manifest.
    if (_hap_manifest_has_target(m, target_cstr) == 1) {
        hapi_eputs("hapi: manifest already has a [[link]] row with target = \"");
        hapi_eputs(target_cstr);
        hapi_eputs("\"\n");
        return 1;
    }
    if (_hap_manifest_has_source(m, source_cstr) == 1) {
        hapi_eputs("hapi: manifest already has a [[link]] row with source = \"");
        hapi_eputs(source_cstr);
        hapi_eputs("\"\n");
        return 1;
    }

    # Refuse if the source path already exists in the package
    # (a non-manifest file would get clobbered by the move).
    var abs_source = _fsl_path_join(pkg_dir_abs, source_cstr);
    var src_probe = link_probe(abs_source);
    if (link_probe_kind(src_probe) != HAPI_LP_ABSENT) {
        hapi_eputs("hapi: source path already exists in package: ");
        hapi_eputs(abs_source);
        hapi_eputs("\n");
        return 1;
    }

    # Relative, or absolute under --absolute (1.6.0), as `link` writes.
    var rel = fsl_link_text_shaped(abs_target, abs_source, hapi_absolute());

    # --backup-to: opt-in pre-rename snapshot. The original
    # bytes are recoverable from the package after the move,
    # so this is belt-and-suspenders — the user opts in when
    # they want a parallel copy outside the package tree.
    # Composed at the directory's physical place, and never in the package
    # (F-084): a snapshot there lands in its working tree.
    var pkg_name_for_backup = _fsl_str_to_cstr(hapi_mf_name(m));
    var backup_path = 0;
    if (hapi_backup_dir() != 0) {
        var bphys = fsl_resolve_path(hapi_backup_dir());
        var pphys = fsl_resolve_path(pkg_dir_abs);
        if (bphys == 0) {
            hapi_eputs("hapi: the --backup-to directory cannot be resolved: ");
            hapi_eputs(hapi_backup_dir());
            hapi_eputs("\n  (a file where a directory should be, or a loop); nothing was changed\n");
            return 1;
        }
        if (pphys != 0 && _fsl_within(bphys, pphys) == 1) {
            hapi_eputs("hapi: the --backup-to directory is in the package: ");
            hapi_eputs(hapi_backup_dir());
            hapi_eputs("\n  choose one outside it; nothing was changed\n");
            return 1;
        }
        backup_path = hapi_backup_compose_path(bphys, pkg_name_for_backup, abs_target);
    }

    # The manifest edit at the end would refuse a symlinked hapi.cyml
    # (F-058); refuse it here, before anything moves.
    if (hapi_mfw_manifest_is_symlink(manifest_path) == 1) {
        hapi_eputs("hapi: ");
        hapi_eputs(hapi_mfw_err_msg(HapiMfwManifestIsSymlink));
        hapi_eputs("\n  (");
        hapi_eputs(manifest_path);
        hapi_eputs(")\n");
        return 1;
    }

    # Prove the trail takes a write before any mutation (F-055). Through
    # 1.1.0 adopt moved the file, planted the link and wrote the row, and
    # only then found the trail unwritable — "adopt succeeded but
    # audit-trail write failed", the adopt kept, and `rollback` later
    # reporting an empty trail with nothing to undo.
    if (audit_preflight_or_refuse("adopt") != 0) { return 1; }

    # 0. Refuse an unrepresentable name BEFORE any mutation. The
    # manifest write below would refuse it too, but only after the
    # rename and the symlink had already committed — which is exactly
    # the shape (mutations without a record) this arc exists to remove.
    # Before the snapshot too (F-084): a refusal after it left a
    # snapshot no trail entry names.
    if (_hmw_representable(source_cstr) == 0 || _hmw_representable(target_cstr) == 0) {
        hapi_eputs("hapi: cannot adopt ");
        hapi_eputs(abs_target);
        hapi_eputs("\n  ");
        hapi_eputs(hapi_mfw_err_msg(HapiMfwUnrepresentable));
        hapi_eputs("\n  (nothing was moved; rename the file and try again)\n");
        return 1;
    }

    # A dry run answers here, after every refusal the real run makes
    # (F-094): through 1.7.0 it returned before them and said `would adopt`.
    if (hapi_dry_run() == 1) {
        hlnk_say_action("~", abs_target, rel, backup_path);
        hapi_puts("  (dry-run)\nwould adopt into ");
        hapi_puts(manifest_path);
        hapi_puts("\n");
        return 0;
    }

    # 0b. --backup-to: write the snapshot before any mutation.
    if (backup_path != 0) {
        var brc = hapi_backup_copy(abs_target, backup_path);
        if (brc < 0) {
            hapi_eputs("hapi: backup-to copy failed (");
            hapi_eputs(abs_target);
            hapi_eputs(" -> ");
            hapi_eputs(backup_path);
            hapi_eputs(")\n");
            return 1;
        }
    }

    # 1. Move the file into the package, never over anything there
    # (F-071): the probe above and this move are one step only because
    # every hapi writer holds the lock, and a non-hapi writer does not.
    # The target is checked again for the same reason.
    if (link_probe_kind(link_probe(abs_target)) != HAPI_LP_FILE) {
        hapi_eputs("hapi: target changed before it could be moved: ");
        hapi_eputs(abs_target);
        hapi_eputs("\n  (nothing was moved)\n");
        if (backup_path != 0) { hapi_unlink(backup_path); }
        return 1;
    }
    var rrc = hapi_rename_noreplace(abs_target, abs_source);
    if (rrc < 0) {
        if (backup_path != 0) { hapi_unlink(backup_path); }
        hapi_eputs("hapi: rename failed (");
        hapi_eputs(abs_target);
        hapi_eputs(" -> ");
        hapi_eputs(abs_source);
        if (rrc == 0 - 17) { hapi_eputs(": the package-side name now exists"); }
        if (rrc == 0 - 18) {
            # F-110: a bare "rename failed" said nothing of the cause.
            hapi_eputs(": the file and the package are on different filesystems,");
            hapi_eputs(" and a move cannot cross them; move the file to the package's");
            hapi_eputs(" filesystem first");
        }
        hapi_eputs(")\n  (nothing was moved)\n");
        return 1;
    }

    # 2. Create the symlink back. Same relative-target math as link.
    var crc = link_create(rel, abs_target);
    if (crc < 0) {
        # Move it back — never over something that appeared meanwhile.
        hapi_eputs("hapi: symlink failed at ");
        hapi_eputs(abs_target);
        _hap_say_restored(abs_source, abs_target);
        return 1;
    }

    # 3. Append the [[link]] row to the manifest, under the lock held, and
    # read the result back (F-090): it must parse, hold every row it held
    # and this one. Through 1.7.0 nothing checked, and adopt reported
    # success with a row that had vanished or another row's target
    # rewritten. On a mismatch the manifest is put back as it was.
    var old_len = 0;
    var old_buf = manifest_read(manifest_path, &old_len);
    var old_rows = vec_len(hapi_mf_links(m));
    var mwrc = manifest_append_link_row_locked(manifest_path, source_cstr, target_cstr);
    if (mwrc >= 0 && _hap_row_read_back(manifest_path, old_rows, source_cstr, target_cstr) == 0) {
        if (old_buf != 0) { manifest_commit(manifest_path, old_buf, old_len); }
        mwrc = 0 - HapiMfwWriteFailed;
        hapi_eputs("hapi: the manifest did not read back with the new row; it was put back\n");
    }
    if (mwrc < 0) {
        # Undo symlink + move on failure to keep the world consistent.
        hapi_unlink(abs_target);
        hapi_eputs("hapi: manifest edit failed (");
        hapi_eputs(hapi_mfw_err_msg(0 - mwrc));
        hapi_eputs(")");
        _hap_say_restored(abs_source, abs_target);
        return 1;
    }

    # 4. Audit the adopt (with the new manifest's hash).
    var manifest_hash = audit_manifest_hash(manifest_path);
    var pkg_name = _fsl_str_to_cstr(hapi_mf_name(m));
    var pkg_ver = _fsl_str_to_cstr(hapi_mf_version(m));
    var ar_t, ar_v = audit_append_adopt_shaped_r(pkg_name, pkg_ver, manifest_hash,
      source_cstr, target_cstr,
      abs_source, abs_target,
      backup_path, fsl_shape_of(rel));
    if (is_err_result(ar_t) == 1) {
        hapi_eputs("hapi: adopt succeeded but audit-trail write failed\n");
        return 1;
    }

    hlnk_say_action("~", abs_target, rel, backup_path);
    hapi_puts("\nadopted into ");
    hapi_puts(manifest_path);
    hapi_puts("\n");
    return 0;
}
