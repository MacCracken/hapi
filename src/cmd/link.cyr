# cmd/link.cyr — `hapi link <package> [--force] [--absolute]`
#
# Pre-flight every link target via link_probe, classify each as
# CREATE / NOOP / CONFLICT_*, refuse the run if any conflict
# exists (unless --force is on). Then execute the CREATE actions,
# appending one audit-trail entry per actual link write.
#
# Idempotency rule per the M2 acceptance test: a re-run with no
# state change produces zero CREATE actions, zero audit writes,
# and exit code 0.
#
# --force semantics:
#   - Replaces a SYMLINK pointing elsewhere
#   - Replaces a regular FILE (destructive, user-explicit)
#   - REFUSES a DIRECTORY even with --force (data-holding;
#     killing one needs more deliberate confirmation than a flag)
#
# Exit codes:
#   0  links applied (or already up-to-date)
#   1  manifest parse failure, conflict without --force, IO error,
#      audit-trail write failure
#   2  bad usage

include "src/manifest.cyr"
include "src/audit.cyr"
include "src/fs_link.cyr"
include "src/cap.cyr"
include "src/dry_run.cyr"
include "src/absolute.cyr"
include "src/backup.cyr"
include "src/audit_reader.cyr"
include "lib/hashmap.cyr"     # hlnk_package_sources
include "src/out.cyr"

enum HapiLinkAction {
    LINK_ACT_CREATE = 0;
    LINK_ACT_NOOP = 1;
    LINK_ACT_CONFLICT_SYMLINK = 2;
    LINK_ACT_CONFLICT_FILE = 3;
    LINK_ACT_CONFLICT_DIR = 4;
    LINK_ACT_ERROR = 5;
    LINK_ACT_ESCAPE = 6;
    LINK_ACT_NO_SOURCE = 7;
    LINK_ACT_INTO_PACKAGE = 8;
    LINK_ACT_NESTED = 9;
    LINK_ACT_SAME_TARGET = 10;
    LINK_ACT_SOURCE_LOOP = 11;
    LINK_ACT_OTHER_PACKAGE = 12;
    LINK_ACT_TRAIL = 13;
}

# Set by sync while it plans a package: a conflict's advice is then
# `hapi link --force`, which sync itself does not take (F-097).
var _hlnk_in_sync = 0;
fn hlnk_set_in_sync(v): i64 { _hlnk_in_sync = v; return 0; }

# Where --backup-to's directory physically is, set once per planned run
# (F-084). Snapshots are written there, not through the spelling: a link
# this same run made could otherwise lead the spelled path into a
# package's working tree.
var _hlnk_backup_phys = 0;
fn _hlnk_backup_place(): i64 {
    if (_hlnk_backup_phys != 0) { return _hlnk_backup_phys; }
    return hapi_backup_dir();
}

# Where the audit trail is, set once per planned run (F-081): its path
# lexically normalized, and its physical place. 0 when there is none.
var _hlnk_trail_lex = 0;
var _hlnk_trail_phys = 0;

# The scope root `--root` set, taking precedence over $HOME; 0 for none.
# The tests set it too.
var _hlnk_scope_root_override = 0;

fn link_set_scope_root(root_cstr): i64 {
    _hlnk_scope_root_override = root_cstr;
    return 0;
}
fn link_scope_override(): i64 { return _hlnk_scope_root_override; }

# The scope root: `--root`, else $HOME, and only an absolute one; 0 after
# saying why there is none. `unset` is the verb's own words for an unset
# $HOME, since they are output. A relative scope root put every target
# under the cwd (F-109): from another directory, link made `./home` and
# wrote there. link, adopt, status and list each fetched it with their
# own copy, reading this module's private override (finding 160).
fn link_scope_root(unset): i64 {
    var scope_root = _hlnk_scope_root_override;
    if (scope_root == 0) { scope_root = getenv("HOME"); }
    if (scope_root == 0 || strlen(scope_root) == 0) {
        hapi_eputs("hapi: $HOME is unset; ");
        hapi_eputs(unset);
        hapi_eputs("\n");
        return 0;
    }
    if (load8(scope_root) != 47) {
        hapi_eputs("hapi: the scope root is not an absolute path: ");
        hapi_eputs(scope_root);
        hapi_eputs("\n");
        return 0;
    }
    return scope_root;
}

# Plan item — 48 bytes.
#   +0   link             (HapiLink ptr from the manifest)
#   +8   abs_source       (cstring)
#   +16  abs_target       (cstring)
#   +24  relative_target  (cstring — what we'd write into the symlink)
#   +32  action           (HapiLinkAction)
#   +40  existing_target  (cstring — only set when action == CONFLICT_SYMLINK)
# Every package source the trail records (F-070): a vec of 32-byte
# {pkg, source, place, resolved} records, one per source, or 0 when the
# trail cannot be read. `place`, where the source physically sits, is
# resolved only when hlnk_owner_at needs it. Every link and adopt counts, unlinked or not: a
# package's files are its own whether or not hapi's link to them is
# still there. The place is the source's parent resolved, plus its name
# — a package reached through a symlinked directory is found where it
# really is, and a source that is itself a symlink protects only that
# link. The caller's own package is refused before this, as F-045's
# into-package case.
#
# A no-arg sync plans every package against a trail that grows as it
# goes. Reading and resolving the whole trail again per package made a
# cold 100-package sync 5.8 times slower, so the list is kept for the
# process and only the lines appended since are read. It starts again
# for another trail path, and for one now shorter than what was read.
var _hlnk_src_gen = 0 - 1;
var _hlnk_src_path = 0;
var _hlnk_src_end = 0;
var _hlnk_src_lines = 0;
var _hlnk_src_list = 0;
var _hlnk_src_seen = 0;

fn _hlnk_sources_reset(path): i64 {
    _hlnk_src_gen = audit_path_gen();
    _hlnk_src_path = path;
    _hlnk_src_end = 0;
    _hlnk_src_lines = 0;
    _hlnk_src_list = vec_new();
    _hlnk_src_seen = map_new();
    return 0;
}

fn hlnk_package_sources(): i64 {
    var path = audit_trail_path();
    if (path == 0) { return 0; }
    if (_hlnk_src_list == 0 || _hlnk_src_gen != audit_path_gen()
        || hapi_cstr_eq(_hlnk_src_path, path) == 0) {
        _hlnk_sources_reset(path);
    }
    var tr_t, tr_v = audit_read_from_r(path, _hlnk_src_end, _hlnk_src_lines);
    if (is_err_result(tr_t) == 1 && tr_v == HapiArShrunk) {
        _hlnk_sources_reset(path);
        tr_t, tr_v = audit_read_from_r(path, 0, 0);
    }
    if (is_err_result(tr_t) == 1) { return 0; }
    _hlnk_src_end = audit_read_end();
    _hlnk_src_lines = audit_read_lines();
    var i = 0;
    while (i < vec_len(tr_v)) {
        var e = vec_get(tr_v, i);
        var op = hae_op(e);
        var src = hae_abs_source(e);
        if (src != 0 && hae_pkg(e) != 0
            && (hapi_cstr_eq(op, "link") == 1 || hapi_cstr_eq(op, "adopt") == 1)) {
            if (map_has(_hlnk_src_seen, src) == 0) {
                map_set(_hlnk_src_seen, src, 1);
                var rec = alloc(32);
                store64(rec, hae_pkg(e));
                store64(rec + 8, src);
                store64(rec + 16, 0);
                store64(rec + 24, 0);
                vec_push(_hlnk_src_list, rec);
            }
        }
        i = i + 1;
    }
    return _hlnk_src_list;
}

# The package whose source holds `phys`, or 0. A source's place ends in
# the source's own name, so it can hold `phys` only if that name is one
# of `phys`'s components: the cheap test comes first, and a source is
# resolved only when it passes. Resolving every source per process made
# each cold `sync <pkg>` several milliseconds slower.
fn hlnk_owner_at(sources, phys): i64 {
    if (sources == 0 || phys == 0) { return 0; }
    var i = 0;
    while (i < vec_len(sources)) {
        var rec = vec_get(sources, i);
        if (_hlnk_has_component(phys, _fsl_path_basename(load64(rec + 8))) == 1) {
            if (load64(rec + 24) == 0) {
                store64(rec + 16, fsl_physical_target(load64(rec + 8)));
                store64(rec + 24, 1);
            }
            var place = load64(rec + 16);
            if (place != 0) {
                if (_fsl_within(phys, place) == 1) { return load64(rec); }
            }
        }
        i = i + 1;
    }
    return 0;
}

# 1 when `name` is one of the `/`-separated components of `path`.
fn _hlnk_has_component(path, name): i64 {
    if (path == 0 || name == 0) { return 0; }
    var pn = strlen(path);
    var nn = strlen(name);
    if (nn == 0) { return 0; }
    var i = 0;
    while (i + nn <= pn) {
        if ((i == 0 || load8(path + i - 1) == 47)
            && (i + nn == pn || load8(path + i + nn) == 47)
            && memeq(path + i, name, nn) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Print the refusal header and one line per row whose action is `kind`.
# Returns 1 when any row was printed, else 0.
fn _hlnk_refuse_kind(m, plans, kind, why): i64 {
    if (_hlnk_count_kind(plans, kind) == 0) { return 0; }
    _hlnk_say_pkg(m);
    hapi_eputs(why);
    _hlnk_print_kind(plans, kind);
    return 1;
}

# How many planned rows have action `kind`.
fn _hlnk_count_kind(plans, kind): i64 {
    var c = 0;
    var i = 0;
    while (i < vec_len(plans)) {
        if (load64(vec_get(plans, i) + 32) == kind) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# The conflict line of every planned row with action `kind`.
fn _hlnk_print_kind(plans, kind): i64 {
    var i = 0;
    while (i < vec_len(plans)) {
        var pl = vec_get(plans, i);
        if (load64(pl + 32) == kind) { _hlnk_print_conflict(pl); }
        i = i + 1;
    }
    return 0;
}

# "hapi: refusing to link `<package>", which every package-level refusal
# begins with.
fn _hlnk_say_pkg(m): i64 {
    hapi_eputs("hapi: refusing to link `");
    var nm = hapi_mf_name(m);
    eprint(str_data(nm), str_len(nm));
    return 0;
}

# How row A's target relates to row B's (F-067), given as spelled (`at`,
# `bt`) and where each physically sits (`ap`, `bp`): 2 when they are one
# place, 1 when A lies beneath B, else 0. A row whose place could not be
# resolved (0) is refused as an escape anyway; it is compared as spelled,
# as through 1.7.0.
fn _hlnk_overlap(at, ap, bt, bp): i64 {
    if (ap != 0 && bp != 0) {
        if (hapi_cstr_eq(ap, bp) == 1) { return 2; }
        if (_fsl_within(ap, bp) == 1) { return 1; }
        return 0;
    }
    if (_fsl_within(at, bt) == 1 && hapi_cstr_eq(at, bt) == 0) { return 1; }
    return 0;
}

fn _hlnk_plan_new(): i64 {
    var p = alloc(56);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0);
    store64(p + 24, 0);
    store64(p + 32, 0);
    store64(p + 40, 0);
    store64(p + 48, 0);      # where the target physically sits, at plan time
    return p;
}

# Resolve the user's `<package>` argument to an absolute path
# to the manifest file. Mirrors the inspect-command resolver:
# if it ends in .cyml use as-is, else append /hapi.cyml.
fn _hlnk_resolve_manifest(arg): i64 { return fsl_manifest_of_arg(arg); }

# Build one plan item from one HapiLink + the resolved
# absolute package dir + absolute scope root.
fn _hlnk_plan_one(lnk, pkg_dir_abs, scope_root_abs): i64 {
    var plan = _hlnk_plan_new();
    store64(plan, lnk);

    var src_cstr = _fsl_str_to_cstr(hapi_link_source(lnk));
    var tgt_cstr = _fsl_str_to_cstr(hapi_link_target(lnk));
    var abs_src = _fsl_path_join(pkg_dir_abs, src_cstr);
    # Lexically normalized (F-111): a target spelled with `//` or `./`
    # made its directories under one spelling and recorded them under
    # another, so unlink could not remove them. The parser has already
    # refused `..`.
    var abs_tgt = fsl_lexical_normalize(_fsl_path_join(scope_root_abs, tgt_cstr));
    var tgt_parent = _fsl_path_dirname(abs_tgt);
    var rel = fsl_link_text(abs_tgt, abs_src);
    # What this run writes: the relative text, or under --absolute (1.6.0)
    # the absolute one. Either shape already on disk is up to date below.
    var text = rel;
    if (hapi_absolute() == 1) { text = fsl_absolute_text(abs_src); }

    store64(plan + 8, abs_src);
    store64(plan + 16, abs_tgt);
    store64(plan + 24, text);
    store64(plan + 48, fsl_physical_target(abs_tgt));

    # Does the target's parent PHYSICALLY sit inside the scope root?
    # An ordinary convenience symlink — `~/.config -> /mnt/other/etc` —
    # puts this row outside the scope on a plain `hapi link`, with no
    # flag involved, and `--force` then deletes whatever is there
    # (F-015). Lexical containment cannot see it; only following the
    # links can. Checked before the probe, because if we are outside the
    # scope the state of the target is not our business.
    if (cap_target_allowed(tgt_parent, scope_root_abs) == 0) {
        store64(plan + 32, LINK_ACT_ESCAPE);
        # A path that cannot be followed at all — a symlink loop, a
        # component hapi cannot probe — is refused the same way, but is
        # not an escape, and HAPI_ALLOWED_ROOTS cannot help it (F-097).
        if (fsl_resolve_path(tgt_parent) == 0) { store64(plan + 40, 1); }
        return plan;
    }

    # GNU stow probes the source before it links; hapi did not, so a
    # manifest typo, a file deleted from the package, or a branch that
    # lacks it produced a symlink pointing at nothing — and `status`,
    # which F-006 designates the post-recovery source of truth, then
    # called it OK (F-022). Same idiom `check` uses for its rows
    # (_hck_covers). Probed after the scope check (an escaping row is
    # refused on its own terms) and before the target probe (the state
    # of the target is irrelevant if we cannot link anything there).
    if (fsl_source_present(abs_src) == 0) {
        store64(plan + 32, LINK_ACT_NO_SOURCE);
        return plan;
    }

    # A target that physically lands inside the package is never ours to
    # touch (F-045): through a symlinked parent it can be this row's own
    # source, which `--force` deleted. Checked before the target probe,
    # which would call that file an ordinary conflict.
    if (fsl_lands_in(abs_tgt, pkg_dir_abs) == 1) {
        store64(plan + 32, LINK_ACT_INTO_PACKAGE);
        return plan;
    }

    # A target that is the audit trail, or a directory holding it, is
    # hapi's own record (F-081): `--force` deleted the trail, or replaced
    # a symlinked `~/.local/state` and moved it into the package, and a
    # row for `.local` was planned as a create the trail's own mkdir then
    # took first.
    if (_hlnk_trail_lex != 0) {
        var tphys = load64(plan + 48);
        if (_fsl_within(_hlnk_trail_lex, fsl_lexical_normalize(abs_tgt)) == 1
            || (tphys != 0 && _hlnk_trail_phys != 0 && _fsl_within(_hlnk_trail_phys, tphys) == 1)) {
            store64(plan + 32, LINK_ACT_TRAIL);
            store64(plan + 40, _hlnk_trail_lex);
            return plan;
        }
    }

    # A source that leads back to its own target would make the link
    # point at itself, and `--force` would delete the only copy (F-069).
    if (fsl_source_reaches(abs_src, load64(plan + 48)) == 1) {
        store64(plan + 32, LINK_ACT_SOURCE_LOOP);
        store64(plan + 40, fsl_resolve_path(abs_src));
        return plan;
    }

    var probe = link_probe(abs_tgt);
    var kind = link_probe_kind(probe);
    if (kind == HAPI_LP_ABSENT) {
        store64(plan + 32, LINK_ACT_CREATE);
    } elif (kind == HAPI_LP_SYMLINK) {
        var existing = link_probe_target(probe);
        store64(plan + 40, existing);
        # A link of either shape naming this source is hapi's, and
        # current: the flag shapes only links a run creates (ADR 0003,
        # 1.6.0 addendum). Re-shaping one is `unlink`, then `link`.
        if (hapi_cstr_eq(existing, rel) == 1 || fsl_is_absolute_text(existing, abs_src) == 1) {
            store64(plan + 32, LINK_ACT_NOOP);
        } else {
            store64(plan + 32, LINK_ACT_CONFLICT_SYMLINK);
        }
    } elif (kind == HAPI_LP_FILE) {
        store64(plan + 32, LINK_ACT_CONFLICT_FILE);
    } elif (kind == HAPI_LP_DIRECTORY) {
        store64(plan + 32, LINK_ACT_CONFLICT_DIR);
    } else {
        store64(plan + 32, LINK_ACT_ERROR);
    }
    return plan;
}

# Render a one-line conflict description to stderr.
fn _hlnk_print_conflict(plan): i64 {
    var abs_tgt = load64(plan + 16);
    var rel = load64(plan + 24);
    var action = load64(plan + 32);
    hapi_eputs("  ");
    eprint(abs_tgt, strlen(abs_tgt));
    hapi_eputs("  ");
    if (action == LINK_ACT_CONFLICT_SYMLINK) {
        var existing = load64(plan + 40);
        hapi_eputs("(symlink -> ");
        if (existing != 0) { eprint(existing, strlen(existing)); }
        hapi_eputs("; expected -> ");
        eprint(rel, strlen(rel));
        hapi_eputs(")");
    } elif (action == LINK_ACT_CONFLICT_FILE) {
        if (fsl_is_regular(abs_tgt) == 1) { hapi_eputs("(existing regular file)"); }
        else { hapi_eputs("(existing file, not a regular one: a FIFO, socket or device)"); }
    } elif (action == LINK_ACT_CONFLICT_DIR) {
        hapi_eputs("(existing directory)");
    } elif (action == LINK_ACT_ESCAPE) {
        if (load64(plan + 40) == 1) {
            hapi_eputs("(cannot be followed: a symlink loop, or a path hapi cannot probe)");
        } else {
            hapi_eputs("(resolves outside the scoped root)");
        }
    } elif (action == LINK_ACT_NO_SOURCE) {
        var abs_src = load64(plan + 8);
        hapi_eputs("(source missing: ");
        eprint(abs_src, strlen(abs_src));
        hapi_eputs(")");
    } elif (action == LINK_ACT_NESTED) {
        var outer = load64(plan + 40);
        hapi_eputs("(beneath another row's target: ");
        if (outer != 0) { eprint(outer, strlen(outer)); }
        hapi_eputs(")");
    } elif (action == LINK_ACT_TRAIL) {
        var tl = load64(plan + 40);
        hapi_eputs("(the audit trail is at or beneath it: ");
        if (tl != 0) { eprint(tl, strlen(tl)); }
        hapi_eputs(")");
    } elif (action == LINK_ACT_SOURCE_LOOP) {
        var ends = load64(plan + 40);
        if (ends == 0) {
            hapi_eputs("(the source cannot be followed to an end)");
        } else {
            hapi_eputs("(the source leads back to the target: ");
            eprint(ends, strlen(ends));
            hapi_eputs(")");
        }
    } elif (action == LINK_ACT_OTHER_PACKAGE) {
        var owner = load64(plan + 40);
        hapi_eputs("(resolves into package `");
        if (owner != 0) { eprint(owner, strlen(owner)); }
        hapi_eputs("`'s source: ");
        var ph = load64(plan + 48);
        if (ph != 0) { eprint(ph, strlen(ph)); }
        hapi_eputs(")");
    } elif (action == LINK_ACT_SAME_TARGET) {
        var other = load64(plan + 40);
        hapi_eputs("(the same place as another row's target: ");
        if (other != 0) { eprint(other, strlen(other)); }
        hapi_eputs(")");
    } elif (action == LINK_ACT_INTO_PACKAGE) {
        var phys = fsl_physical_target(abs_tgt);
        hapi_eputs("(resolves into the package");
        if (phys != 0) {
            hapi_eputs(": ");
            eprint(phys, strlen(phys));
        }
        hapi_eputs(")");
    } else {
        hapi_eputs("(probe error)");
    }
    hapi_eputs("\n");
    return 0;
}

# Plan a link run: parse the manifest, classify every row, and refuse —
# reporting why — anything `link` must not write, all before a single
# write. Ok(run) means the run may execute; Err(rc) means it was refused
# and already reported, rc being the exit code (1, or 2 for usage).
# 1.3.0 split this from execution so `sync --prune` can plan its
# removals beside the links and refuse the package as a whole.
fn _hlnk_plan_run(pkg_arg, force): Result {
    if (pkg_arg == 0) {
        hapi_eputs("usage: hapi link <package-dir|hapi.cyml> [--force]\n");
        return Err(2);
    }

    var manifest_path = _hlnk_resolve_manifest(pkg_arg);
    # 0 = a relative package argument with no determinable cwd (agnos
    # without a usable PWD). Refuse loudly: continuing would put a
    # non-absolute path into the trail's `abs_source`, which ADR 0002
    # requires to be absolute, and the symlink body would resolve
    # against the wrong directory (F-027).
    if (manifest_path == 0) {
        hapi_refuse_unknown_cwd();
        return Err(1);
    }
    var pkg_dir_abs = _fsl_path_dirname(manifest_path);

    var mr_t, mr_v = hapi_mf_parse_file_r(manifest_path);
    if (is_err_result(mr_t) == 1) {
        hapi_mf_report_err(mr_v, manifest_path);
        return Err(1);
    }
    var m = mr_v;

    var manifest_hash = audit_manifest_hash_of(m);   # the rows it applies (F-075)
    if (manifest_hash == 0) {
        hapi_eputs("hapi: could not hash manifest at ");
        eprint(manifest_path, strlen(manifest_path));
        hapi_eputs("\n");
        return Err(1);
    }

    var scope_root = link_scope_root("cannot resolve link targets");
    if (scope_root == 0) { return Err(1); }
    var scope_root_abs = fsl_to_absolute(scope_root);
    # An absent scope root whose parent is absent too would be made with
    # its ancestors, outside the root that was granted (F-111).
    if (hapi_exists(scope_root_abs) == 0 && hapi_exists(_fsl_path_dirname(scope_root_abs)) == 0) {
        hapi_eputs("hapi: the scope root does not exist, nor its parent: ");
        eprint(scope_root_abs, strlen(scope_root_abs));
        hapi_eputs("\n  create it first; nothing was changed\n");
        return Err(1);
    }

    var links = hapi_mf_links(m);
    var nlinks = vec_len(links);
    var plans = vec_new();
    var conflict_count = 0;
    var noop_count = 0;
    var create_count = 0;

    # A target that physically lands in ANOTHER package's live source is
    # that package's file (F-070). F-045 asked the question of this
    # package only: with package A's `.config/nvim -> A/nvim`, package
    # B's row `.config/nvim/init.lua` is A's only copy of init.lua, which
    # `link --force B` deleted while `status A` still said OK. The trail
    # says where every package's sources are; it is read once, and only
    # when a row reached through a symlink would write.
    var others = 0;
    _hlnk_trail_lex = 0;
    _hlnk_trail_phys = 0;
    var tpath = audit_trail_path();
    if (tpath != 0) {
        _hlnk_trail_lex = fsl_lexical_normalize(tpath);
        _hlnk_trail_phys = fsl_physical_target(tpath);
    }
    _hlnk_backup_phys = 0;
    if (hapi_backup_dir() != 0) {
        _hlnk_backup_phys = fsl_resolve_path(hapi_backup_dir());
        if (_hlnk_backup_phys == 0) {
            hapi_eputs("hapi: the --backup-to directory cannot be resolved: ");
            eprint(hapi_backup_dir(), strlen(hapi_backup_dir()));
            hapi_eputs("\n  (a file where a directory should be, or a loop); nothing was changed\n");
            return Err(1);
        }
    }
    var i = 0;
    while (i < nlinks) {
        var p = _hlnk_plan_one(vec_get(links, i), pkg_dir_abs, scope_root_abs);
        vec_push(plans, p);
        var pa = load64(p + 32);
        # Only a target reached through a symlink can land in another
        # package's files: with none in its chain, its physical place is
        # its own spelling, which the user chose. So the trail is read
        # only for such a row.
        var ph = load64(p + 48);
        var through_link = 0;
        if (ph != 0) {
            if (hapi_cstr_eq(ph, fsl_lexical_normalize(load64(p + 16))) == 0) { through_link = 1; }
        }
        if (through_link == 1 && (pa == LINK_ACT_CREATE || pa == LINK_ACT_CONFLICT_SYMLINK
            || pa == LINK_ACT_CONFLICT_FILE || pa == LINK_ACT_CONFLICT_DIR)) {
            if (others == 0) {
                others = hlnk_package_sources();
                if (others == 0) {
                    hapi_eputs("hapi: the audit trail could not be read, so hapi cannot tell\n");
                    hapi_eputs("  whether a target is another package's file; nothing was changed\n");
                    return Err(1);
                }
            }
            var owner = hlnk_owner_at(others, load64(p + 48));
            if (owner != 0) {
                store64(p + 32, LINK_ACT_OTHER_PACKAGE);
                store64(p + 40, owner);
            }
        }
        var act = load64(p + 32);
        if (act == LINK_ACT_CREATE) { create_count = create_count + 1; }
        elif (act == LINK_ACT_NOOP) { noop_count = noop_count + 1; }
        else { conflict_count = conflict_count + 1; }     # every refusal, ERROR included
        i = i + 1;
    }

    # A row that resolves outside the scope root is refused FIRST, and
    # `--force` does not override it. The generic conflict message below
    # advises `--force`, and following that advice is precisely what
    # deleted a file outside $HOME before 1.0.8 — so this must be
    # reported on its own terms, pointing at `--root` instead.
    var escaped = 0;
    var unfollowed = 0;
    var ke = 0;
    while (ke < nlinks) {
        var ple = vec_get(plans, ke);
        if (load64(ple + 32) == LINK_ACT_ESCAPE) {
            if (load64(ple + 40) == 1) { unfollowed = unfollowed + 1; }
            else { escaped = escaped + 1; }
        }
        ke = ke + 1;
    }
    if (escaped == 0 && unfollowed > 0) {
        hapi_eputs("hapi: refusing to link: a target's path cannot be followed:\n");
        _hlnk_print_kind(plans, LINK_ACT_ESCAPE);
        hapi_eputs("  a symlink loop, or a directory hapi cannot search, is on its path.\n");
        hapi_eputs("  --force does NOT override this; nothing was changed.\n");
        return Err(1);
    }
    if (escaped > 0) {
        hapi_eputs("hapi: refusing to link outside the scoped root:\n");
        _hlnk_print_kind(plans, LINK_ACT_ESCAPE);
        hapi_eputs("  scope: ");
        hapi_eputs(scope_root_abs);
        hapi_eputs("\n  a symlinked parent directory can put a target outside the\n");
        hapi_eputs("  scope even though the manifest path looks relative to it.\n");
        hapi_eputs("  --force does NOT override this. To authorize that location,\n");
        hapi_eputs("  add it to HAPI_ALLOWED_ROOTS (ADR 0005); `--root` re-roots\n");
        hapi_eputs("  every target and is a different operation.\n");
        return Err(1);
    }

    # A row whose source is not in the package is refused before the
    # generic conflict block, because that block advises `--force` and
    # `--force` cannot help here: the link would still point at nothing
    # (F-022). Refused on `--dry-run` too — the plan is already built.
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_NO_SOURCE,
          "` — source missing from the package:\n") == 1) {
        hapi_eputs("  --force does NOT override this: the symlink would\n");
        hapi_eputs("  dangle. Restore the file or fix the [[link]] source,\n");
        hapi_eputs("  then re-run. `hapi check <package>` lists every row\n");
        hapi_eputs("  whose source is missing.\n");
        return Err(1);
    }

    # A row whose target lies beneath another row's target is refused
    # (F-057). Containment is planned for every row before any is written,
    # while both targets are still absent and so look contained. The outer
    # row then plants a symlink, and the inner row is written THROUGH it:
    # a package symlink `escape -> /outside` behind `.x`, and `.x/inner`
    # landed in /outside, exit 0. Even without an escape the inner row
    # writes into the package through hapi's own link. No layout needs it.
    #
    # Rows are compared where they are, not as spelled (F-067). Through
    # 1.7.0 the raw strings were compared, so `./.x/inner`, `/.x/inner`
    # and a user's `alias -> .x` with a row `alias/inner` all passed, and
    # the inner row was written through the outer row's new link. Two
    # rows that name one place the same way passed the parser's duplicate
    # check by spelling too, and the second replaced the first. Each row
    # is compared at its physical location (the planner's +48).
    var ka = 0;
    while (ka < nlinks) {
        var pla = vec_get(plans, ka);
        var kb = 0;
        while (kb < nlinks) {
            if (kb != ka) {
                var plb = vec_get(plans, kb);
                var ov = _hlnk_overlap(load64(pla + 16), load64(pla + 48),
                  load64(plb + 16), load64(plb + 48));
                if (ov == 2) {
                    store64(pla + 32, LINK_ACT_SAME_TARGET);
                    store64(pla + 40, load64(plb + 16));
                } elif (ov == 1 && load64(pla + 32) != LINK_ACT_SAME_TARGET) {
                    store64(pla + 32, LINK_ACT_NESTED);
                    store64(pla + 40, load64(plb + 16));
                }
            }
            kb = kb + 1;
        }
        ka = ka + 1;
    }
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_SAME_TARGET,
          "` — two rows name the same target:\n") == 1) {
        hapi_eputs("  the second link would replace the first. --force does NOT\n");
        hapi_eputs("  override this.\n");
        return Err(1);
    }
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_NESTED,
          "` — a target lies beneath another row's target:\n") == 1) {
        hapi_eputs("  the outer row becomes a symlink, so the inner one would be\n");
        hapi_eputs("  written through it — into the package, or wherever its\n");
        hapi_eputs("  source leads. --force does NOT override this.\n");
        return Err(1);
    }

    # A row whose target lands back inside the package is refused before
    # the generic conflict block too: that block advises `--force`, and
    # `--force` is what deleted the package's own file (F-045).
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_INTO_PACKAGE,
          "` — target resolves into the package itself:\n") == 1) {
        hapi_eputs("  a symlinked parent directory leads this target back into\n");
        hapi_eputs("  the package, so what sits there is package content —\n");
        hapi_eputs("  possibly the row's own source. --force does NOT override\n");
        hapi_eputs("  this. Point the target elsewhere, or remove the symlinked\n");
        hapi_eputs("  parent if the package is meant to be reached directly.\n");
        return Err(1);
    }

    # --backup-to's directory must not be a target, sit beneath one, or be
    # in the package (F-084): its mkdir took a path a row was planned to
    # create, or a snapshot of a 0600 secret landed in the package's git
    # working tree.
    if (_hlnk_backup_phys != 0) {
        var bad = 0;
        var rp = fsl_resolve_path(pkg_dir_abs);
        if (rp != 0 && _fsl_within(_hlnk_backup_phys, rp) == 1) { bad = 1; }
        var kb2 = 0;
        while (kb2 < nlinks) {
            var plb2 = vec_get(plans, kb2);
            var pp = load64(plb2 + 48);
            if (pp != 0 && _fsl_within(_hlnk_backup_phys, pp) == 1) { bad = 1; }
            kb2 = kb2 + 1;
        }
        if (bad == 1) {
            _hlnk_say_pkg(m);
            hapi_eputs("` — the --backup-to directory is in the package, or at or\n");
            hapi_eputs("  beneath a target this run would link: ");
            eprint(_hlnk_backup_phys, strlen(_hlnk_backup_phys));
            hapi_eputs("\n  choose a directory outside both; nothing was changed\n");
            return Err(1);
        }
    }
    # A dry run answers as the real run would (F-094): a snapshot it could
    # not write there stops the real run.
    if (hapi_dry_run() == 1 && force == 1 && _hlnk_backup_phys != 0) {
        var needs = 0;
        var kd = 0;
        while (kd < nlinks) {
            if (load64(vec_get(plans, kd) + 32) == LINK_ACT_CONFLICT_FILE) { needs = 1; }
            kd = kd + 1;
        }
        if (needs == 1 && hapi_could_create_under(_fsl_path_join(_hlnk_backup_phys, "x")) == 0) {
            hapi_eputs("hapi: the --backup-to directory is not writable: ");
            eprint(_hlnk_backup_phys, strlen(_hlnk_backup_phys));
            hapi_eputs("  (dry-run)\n");
            return Err(1);
        }
    }
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_TRAIL,
          "` — a target is the audit trail, or holds it:\n") == 1) {
        hapi_eputs("  linking it would delete or move hapi's own record. --force\n");
        hapi_eputs("  does NOT override this. Point the target elsewhere, or set\n");
        hapi_eputs("  XDG_STATE_HOME to keep the trail out of the way.\n");
        return Err(1);
    }
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_OTHER_PACKAGE,
          "` — a target resolves into another package's source:\n") == 1) {
        hapi_eputs("  a link that package made leads this target into its files.\n");
        hapi_eputs("  --force does NOT override this. Change the file through that\n");
        hapi_eputs("  package, or point the target elsewhere.\n");
        return Err(1);
    }
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_SOURCE_LOOP,
          "` — a row's source leads back to its own target:\n") == 1) {
        hapi_eputs("  the link would point at itself, and the file there is what\n");
        hapi_eputs("  the source shows. --force does NOT override this. Put the file\n");
        hapi_eputs("  itself in the package (`hapi adopt` moves it there), or fix\n");
        hapi_eputs("  the source.\n");
        return Err(1);
    }

    # A target hapi could not examine — a regular file where a directory
    # is expected (ENOTDIR), a directory it cannot search (EACCES) — is
    # refused on its own terms (F-076). Through 1.7.0 it sat in the
    # conflict list, which advised --force, and --force then skipped it in
    # silence and exited 0, the row neither linked nor reported.
    if (_hlnk_refuse_kind(m, plans, LINK_ACT_ERROR,
          "` — a target could not be examined:\n") == 1) {
        hapi_eputs("  something on its path is not a directory hapi can search: a\n");
        hapi_eputs("  file where a directory should be, or no permission. --force\n");
        hapi_eputs("  does NOT override this; nothing was changed.\n");
        return Err(1);
    }

    # If any conflicts and --force isn't on, refuse and list them.
    if (conflict_count > 0 && force == 0) {
        _hlnk_say_pkg(m);
        hapi_eputs("` — ");
        fmt_int_fd(2, conflict_count);
        hapi_eputs(" conflict");
        if (conflict_count > 1) { hapi_eputs("s"); }
        if (_hlnk_in_sync == 1) {
            # sync never overwrites; `sync --force` is a usage error (F-097).
            hapi_eputs(" (sync never overwrites; `hapi link --force` on the package does):\n");
        } else {
            hapi_eputs(" (rerun with --force to override):\n");
        }
        var k = 0;
        while (k < nlinks) {
            var pl = vec_get(plans, k);
            var ak = load64(pl + 32);
            if (ak != LINK_ACT_CREATE && ak != LINK_ACT_NOOP) {
                _hlnk_print_conflict(pl);
            }
            k = k + 1;
        }
        return Err(1);
    }

    # Refuse to --force over a directory regardless of the flag.
    # Directories hold user data; the right escape hatch for that
    # is `rm -rf` with the user's eyes on the screen.
    if (_hlnk_count_kind(plans, LINK_ACT_CONFLICT_DIR) > 0) {
        hapi_eputs("hapi: --force does not override existing directories:\n");
        _hlnk_print_kind(plans, LINK_ACT_CONFLICT_DIR);
        return Err(1);
    }

    var run = alloc(56);
    store64(run, m);
    store64(run + 8, manifest_path);
    store64(run + 16, pkg_dir_abs);
    store64(run + 24, scope_root_abs);
    store64(run + 32, plans);
    store64(run + 40, manifest_hash);
    store64(run + 48, noop_count);
    return Ok(run);
}

# A planned run's fields (see _hlnk_plan_run).
fn hlnk_run_manifest(run): i64 { return load64(run); }
fn hlnk_run_pkg_dir(run): i64 { return load64(run + 16); }
fn hlnk_run_scope_root(run): i64 { return load64(run + 24); }
fn hlnk_run_plans(run): i64 { return load64(run + 32); }

# The abs_target of every row in the plan, for `sync --prune`.
fn hlnk_plan_abs_target(plan): i64 { return load64(plan + 16); }
fn hlnk_plan_place(plan): i64 { return load64(plan + 48); }

# Set when this process removed links before a link run executes (sync
# --prune): every row is then checked against its plan-time place, not
# only those after the run's first write.
var _hlnk_tree_changed = 0;
fn hlnk_note_tree_changed(): i64 { _hlnk_tree_changed = 1; return 0; }

# How many rows the run will write: creates, and with --force the
# conflicts it replaces. Skipped when 0, so a no-op or a dry-run never
# materializes an empty trail where none existed.
fn _hlnk_will_write(run, force): i64 {
    var plans = load64(run + 32);
    var nlinks = vec_len(plans);
    var will_write = 0;
    var kw = 0;
    while (kw < nlinks) {
        var aw = load64(vec_get(plans, kw) + 32);
        if (aw == LINK_ACT_CREATE) { will_write = will_write + 1; }
        elif (force == 1 && (aw == LINK_ACT_CONFLICT_SYMLINK || aw == LINK_ACT_CONFLICT_FILE)) {
            will_write = will_write + 1;
        }
        kw = kw + 1;
    }
    return will_write;
}

# Write a planned run: each create (and, with --force, each replaced
# conflict), one audit entry per link, then the summary line.
# Does the trail already record this row's link for this package (F-079)?
# The trail's last word on `abs_tgt` — the last line naming it — must be
# this package's link or adopt. `trail` holds the trail's raw bytes; the
# lines are matched on the exact bytes the writer emits for each field,
# so a line hapi wrote is found without parsing the trail, which a warm
# `sync` per package could not afford.
fn _hlnk_recorded(trail, tlen, pkg, abs_tgt): i64 {
    var nt = audit_field_bytes("abs_target", abs_tgt);
    var np = audit_field_bytes("pkg", pkg);
    if (nt == 0 || np == 0) { return 0; }
    var at = _hlnk_last_at(trail, tlen, nt);
    if (at < 0) { return 0; }
    var ls = at;
    while (ls > 0 && load8(trail + ls - 1) != 10) { ls = ls - 1; }
    var le = at;
    while (le < tlen && load8(trail + le) != 10) { le = le + 1; }
    var ln = le - ls;
    if (_hlnk_has_at(trail + ls, ln, np) == 0) { return 0; }
    if (_hlnk_has_at(trail + ls, ln, "\"op\":\"link\"") == 1) { return 1; }
    if (_hlnk_has_at(trail + ls, ln, "\"op\":\"adopt\"") == 1) { return 1; }
    return 0;
}

# The offset of the last occurrence of `needle` in buf[0..n), or -1. A
# warm run calls this once per linked row, over the whole trail, so it
# skips instead of stepping: when the window at `i` fails, the byte at
# `i` can only begin a match ending further left if it occurs at some
# offset j >= 1 of the needle, so the window moves left by the smallest
# such j, or by the needle's whole length when there is none. A byte-
# by-byte scan made a warm `sync` 1.8x slower than 1.7.0.
var _hlnk_shift = 0;          # 256 shift distances, allocated once

fn _hlnk_last_at(buf, n, needle): i64 {
    var k = strlen(needle);
    if (k < 2) { return 0 - 1; }
    if (_hlnk_shift == 0) { _hlnk_shift = alloc(256 * 8); }
    var c = 0;
    while (c < 256) { store64(_hlnk_shift + c * 8, k); c = c + 1; }
    var j = k - 1;
    while (j >= 1) { store64(_hlnk_shift + load8(needle + j) * 8, j); j = j - 1; }
    var first = load8(needle);
    var i = n - k;
    while (i >= 0) {
        var b = load8(buf + i);
        if (b == first) {
            if (memeq(buf + i, needle, k) == 1) { return i; }
        }
        i = i - load64(_hlnk_shift + b * 8);
    }
    return 0 - 1;
}

fn _hlnk_has_at(buf, n, needle): i64 {
    var k = strlen(needle);
    var i = 0;
    while (i + k <= n) {
        if (load8(buf + i) == load8(needle) && memeq(buf + i, needle, k) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# "  <sigil> <tgt> -> <text>", with "  (backup -> <snapshot>)" when there
# is one: the line link prints for each link it makes, and adopt for the
# file it moves. The caller ends the line. Each verb had two copies, one
# for --dry-run (finding 163).
fn hlnk_say_action(sigil, abs_tgt, rel, backup_path): i64 {
    hapi_puts("  ");
    hapi_puts(sigil);
    hapi_puts(" ");
    hapi_puts(abs_tgt);
    hapi_puts(" -> ");
    hapi_puts(rel);
    if (backup_path != 0) {
        hapi_puts("  (backup -> ");
        hapi_puts(backup_path);
        hapi_puts(")");
    }
    return 0;
}

# Replace what is at `abs_tgt` with a symlink to `text`, in one step: the
# link is made under a temporary name beside it, then renamed over it.
# Either the old file is still there, untouched, or the new link is. The
# temporary name is never one hapi did not create: an existing one fails
# the symlink, and is left alone. Returns 0, or <0 with the old file kept.
fn _hlnk_replace(text, abs_tgt): i64 {
    var buf[32];
    var pre = ".hapi-new-";
    var p = strlen(pre);
    memcpy(&buf, pre, p);
    p = p + fmt_int_buf(sys_getpid(), &buf + p);
    store8(&buf + p, 0);
    var tmp = _fsl_path_join(_fsl_path_dirname(abs_tgt), &buf);
    if (hapi_symlink(text, tmp) < 0) { return 0 - 1; }
    if (hapi_rename(tmp, abs_tgt) < 0) {
        hapi_unlink(tmp);
        return 0 - 1;
    }
    return 0;
}

fn _hlnk_execute(run, force): i64 {
    var m = load64(run);
    var plans = load64(run + 32);
    var manifest_hash = load64(run + 40);
    var noop_count = load64(run + 48);
    var nlinks = vec_len(plans);
    var pkg_name_cstr = _fsl_str_to_cstr(hapi_mf_name(m));
    var pkg_ver_cstr = _fsl_str_to_cstr(hapi_mf_version(m));
    var written = 0;
    var claimed = 0;
    var trail = 0 - 1;            # the trail's bytes, read at the first no-op row
    var tlen = 0;

    var j = 0;
    while (j < nlinks) {
        var pl = vec_get(plans, j);
        var act = load64(pl + 32);
        var abs_tgt = load64(pl + 16);
        var abs_src = load64(pl + 8);
        var rel = load64(pl + 24);

        # A row already linked as hapi writes it, which the trail does not
        # record for this package, is recorded now (F-079). Through 1.7.0
        # a no-op wrote nothing, so after a trail was lost (F-006), a
        # `[package].name` was renamed or `$HOME` moved, no verb ever
        # recorded the links again: unlink found none, prune removed none,
        # and list credited the old name. The proof is the one removal
        # uses: the link's text is exactly what hapi writes for this row.
        # The next run finds it recorded and writes nothing.
        if (act == LINK_ACT_NOOP) {
            if (trail == 0 - 1) {
                trail = 0;
                var tp = audit_trail_path();
                if (tp != 0) {
                    if (link_probe_kind(link_probe(tp)) == HAPI_LP_ABSENT) {
                        trail = alloc(1);
                        tlen = 0;
                    } else {
                        trail = manifest_read(tp, &tlen);
                    }
                }
            }
            if (trail != 0 && _hlnk_recorded(trail, tlen, pkg_name_cstr, abs_tgt) == 0) {
                hapi_puts("  ~ ");
                print(abs_tgt, strlen(abs_tgt));
                hapi_puts("  (already linked; now recorded");
                if (hapi_dry_run() == 1) { hapi_puts("; dry-run"); }
                hapi_puts(")\n");
                if (hapi_dry_run() == 0) {
                    var clnk = load64(pl);
                    var cl_t, cl_v = audit_append_link_full_r(pkg_name_cstr, pkg_ver_cstr,
                      manifest_hash,
                      _fsl_str_to_cstr(hapi_link_source(clnk)), _fsl_str_to_cstr(hapi_link_target(clnk)),
                      abs_src, abs_tgt, 0, 0, fsl_shape_of(load64(pl + 40)));
                    if (is_err_result(cl_t) == 1) {
                        hapi_eputs("hapi: audit-trail write failed recording ");
                        eprint(abs_tgt, strlen(abs_tgt));
                        hapi_eputs("\n  the link is as it was; the trail still does not record it\n");
                        return 1;
                    }
                }
                claimed = claimed + 1;
            }
        }

        var should_create = 0;
        var replace = 0;
        var backup_path = 0;
        if (act == LINK_ACT_CREATE) { should_create = 1; }
        var forced = 0;
        if (force == 1 && (act == LINK_ACT_CONFLICT_SYMLINK || act == LINK_ACT_CONFLICT_FILE)) { forced = 1; }

        # The place a row was planned for must still be the place it
        # writes (F-067). The plan was made before any write; a link this
        # run made since can change where a later row's path leads — a
        # user's `alias -> .x` that a --force row replaced makes the row
        # `alias/inner` land wherever the new `.x` points. So once
        # anything is written, each row's physical location is checked
        # again, and the run stops before a row that moved.
        if ((should_create == 1 || forced == 1) && (written > 0 || _hlnk_tree_changed == 1)
            && hapi_dry_run() == 0) {
            var was = load64(pl + 48);
            var now = fsl_physical_target(abs_tgt);
            if (was == 0 || now == 0 || hapi_cstr_eq(was, now) == 0) {
                hapi_eputs("hapi: stopped before ");
                eprint(abs_tgt, strlen(abs_tgt));
                hapi_eputs(": an earlier step of this run changed where it leads\n");
                if (was != 0) { hapi_eputs("  planned at "); eprint(was, strlen(was)); hapi_eputs("\n"); }
                if (now != 0) { hapi_eputs("  now at     "); eprint(now, strlen(now)); hapi_eputs("\n"); }
                hapi_eputs("  the rows before it were linked and recorded; nothing else changed\n");
                return 1;
            }
        }

        if (forced == 1) {
            # --backup-to: snapshot the existing regular file
            # before we destroy it. Only meaningful for FILE
            # conflicts — symlinks point at content elsewhere,
            # so the bytes survive without our help.
            if (act == LINK_ACT_CONFLICT_FILE && hapi_backup_dir() != 0) {
                backup_path = hapi_backup_compose_path(
                  _hlnk_backup_place(), pkg_name_cstr, abs_tgt);
                if (hapi_dry_run() == 0) {
                    var brc = hapi_backup_copy(abs_tgt, backup_path);
                    if (brc < 0) {
                        hapi_eputs("hapi: backup-to copy failed (");
                        eprint(abs_tgt, strlen(abs_tgt));
                        hapi_eputs(" -> ");
                        eprint(backup_path, strlen(backup_path));
                        hapi_eputs(")\n");
                        return 1;
                    }
                }
            }
            #ifdef CYRIUS_TARGET_AGNOS
            # A real agnos kernel cannot rename over an existing file
            # (F-059), so the agnos arm keeps 1.7.0's order: remove, then
            # create.
            if (hapi_dry_run() == 0) {
                var urc = hapi_unlink(abs_tgt);
                if (urc < 0) {
                    hapi_eputs("hapi: could not remove existing ");
                    eprint(abs_tgt, strlen(abs_tgt));
                    hapi_eputs(" (--force)\n");
                    return 1;
                }
            }
            #else
            # The new link replaces the old file in one rename (F-068).
            # Through 1.7.0 the file was unlinked first: if symlink(2)
            # then failed, the user's file was gone and nothing recorded.
            replace = 1;
            #endif
            should_create = 1;
        }

        if (should_create == 1) {
            if (hapi_dry_run() == 1) {
                hlnk_say_action("+", abs_tgt, rel, backup_path);
                hapi_puts("  (dry-run)\n");
                written = written + 1;
            } else {
                var made = 0;
                var crc = 0;
                if (replace == 1) {
                    crc = _hlnk_replace(rel, abs_tgt);
                    if (crc < 0) {
                        hapi_eputs("hapi: could not replace ");
                        eprint(abs_tgt, strlen(abs_tgt));
                        hapi_eputs(" (--force); it was left as it was\n");
                        # The file is still there, so its snapshot is not
                        # needed, and no entry would name it (F-084).
                        if (backup_path != 0) { hapi_unlink(backup_path); }
                        return 1;
                    }
                } else {
                    crc = link_create_r(rel, abs_tgt, &made);
                }
                if (crc < 0) {
                    hapi_eputs("hapi: symlink failed at ");
                    eprint(abs_tgt, strlen(abs_tgt));
                    hapi_eputs("\n");
                    return 1;
                }
                var lnk = load64(pl);
                var src_cstr = _fsl_str_to_cstr(hapi_link_source(lnk));
                var tgt_cstr = _fsl_str_to_cstr(hapi_link_target(lnk));
                # On a refused entry, exactly THIS link is undone — never the
                # earlier ones in the run. Those are in the trail and `unlink`
                # / `rollback` can reverse them; unwinding them here would
                # need further appends, which are failing by construction,
                # and would recreate this very defect in mirror image.
                var rr = audit_record_link_or_take_back(pkg_name_cstr, pkg_ver_cstr,
                  manifest_hash,
                  src_cstr, tgt_cstr,
                  abs_src, abs_tgt,
                  backup_path, made, rel);
                if (rr < 0) {
                    hapi_eputs("hapi: audit-trail write failed for ");
                    eprint(abs_tgt, strlen(abs_tgt));
                    if (rr == 0 - 3) {
                        hapi_eputs("\n  the symlink is on disk and NOT recorded; remove it by hand\n");
                    } else {
                        hapi_eputs("\n  symlink removed; this run left nothing unrecorded\n");
                    }
                    if (act == LINK_ACT_CONFLICT_FILE && force == 1) {
                        hapi_eputs("  the file that was here was already deleted by --force and is NOT restored");
                        if (backup_path != 0) {
                            hapi_eputs("; snapshot: ");
                            eprint(backup_path, strlen(backup_path));
                        }
                        hapi_eputs("\n");
                    }
                    return 1;
                }
                written = written + 1;
                hlnk_say_action("+", abs_tgt, rel, backup_path);
                hapi_puts("\n");
            }
        }
        j = j + 1;
    }

    # Summary line — matches the inspect command's terse output style.
    hapi_puts("linked ");
    fmt_int(written);
    hapi_puts(" / ");
    fmt_int(nlinks);
    hapi_puts(" (");
    fmt_int(noop_count);
    hapi_puts(" already up-to-date");
    if (claimed > 0) {
        hapi_puts(", ");
        fmt_int(claimed);
        hapi_puts(" now recorded");
    }
    hapi_puts(")\n");
    return 0;
}

fn cmd_link(pkg_arg, force): i64 {
    var pr_t, pr_v = _hlnk_plan_run(pkg_arg, force);
    if (is_err_result(pr_t) == 1) { return pr_v; }
    var run = pr_v;
    if (_hlnk_will_write(run, force) > 0) {
        if (audit_preflight_or_refuse("link") != 0) { return 1; }
    }
    return _hlnk_execute(run, force);
}
