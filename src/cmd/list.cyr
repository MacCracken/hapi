# cmd/list.cyr — `hapi list`
#
# Walks the audit trail, groups by package name, prints one
# row per package with the count of live (still-on-disk) links.
# Read-only — no audit writes, no filesystem mutation.
#
# A link is "live" when the last entry for its target (per
# package) is a creator (`op:link` or `op:adopt`) rather than
# a remover (`op:unlink` or `op:unadopt`). This is the same
# last-write-wins reduction `unlink` uses, generalized to
# include adopt/unadopt.
#
# Scope is `$HOME` at v0.5.x — capability-bounded `--root`
# support lands in M6. The line is informational either way.
#
# Exit codes:
#   0  trail walked (empty trail is not an error)
#   1  audit-read or env failure

include "lib/hashmap.cyr"
include "src/audit.cyr"
include "src/audit_reader.cyr"
include "src/cmd/link.cyr"   # _hlnk_scope_root_override

fn _hls_puts(s): i64 { print(s, strlen(s)); return 0; }
fn _hls_eputs(s): i64 { eprint(s, strlen(s)); return 0; }

fn _hls_cstr_eq(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var an = strlen(a);
    var bn = strlen(b);
    if (an != bn) { return 0; }
    return memeq(a, b, an);
}

# Build the per-target CURRENT-OWNER map for the whole trail, in
# one pass. A target is owned by at most one package at a time:
# link/adopt claim it for the entry's package, displacing any prior
# owner — that is what a `--force` takeover (or a re-link over a
# target another package left behind) records. unlink/unadopt
# release it, but only when the remover is the package that
# currently holds the claim, so a stale non-owner remove cannot
# retire someone else's live link.
#
# Returns a 16-byte pair: { targets: vec<cstr>, owner: vec<cstr|0> }.
# Built ONCE per `list` invocation — the per-package count is then a
# scan of the parallel vecs, not a re-walk of the trail.
fn _hls_owner_map(trail): i64 {
    var targets = vec_new();   # distinct abs_targets, first-seen order
    var owner   = vec_new();   # parallel: current owner cstr, 0 = released
    var idx     = map_new();   # abs_target -> slot index in the parallel vecs

    var n = vec_len(trail);
    var i = 0;
    while (i < n) {
        var e = vec_get(trail, i);
        var ep = hae_pkg(e);
        if (ep != 0 && strlen(ep) > 0) {
            var op = hae_op(e);
            var tgt = hae_abs_target(e);
            if (tgt != 0) {
                var is_create = 0;
                if (_hls_cstr_eq(op, "link") == 1)  { is_create = 1; }
                elif (_hls_cstr_eq(op, "adopt") == 1) { is_create = 1; }
                var is_remove = 0;
                if (_hls_cstr_eq(op, "unlink") == 1)   { is_remove = 1; }
                elif (_hls_cstr_eq(op, "unadopt") == 1) { is_remove = 1; }

                if (is_create == 1 || is_remove == 1) {
                    var found = 0 - 1;
                    if (map_has(idx, tgt) == 1) { found = map_get(idx, tgt); }
                    if (is_create == 1) {
                        if (found < 0) {
                            map_set(idx, tgt, vec_len(targets));
                            vec_push(targets, tgt);
                            vec_push(owner, ep);
                        } else {
                            vec_set(owner, found, ep);
                        }
                    } else {
                        if (found >= 0) {
                            if (_hls_cstr_eq(vec_get(owner, found), ep) == 1) {
                                vec_set(owner, found, 0);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    var om = alloc(16);
    store64(om, targets);
    store64(om + 8, owner);
    return om;
}

# Count the targets `pkg_cstr` currently owns in a prebuilt map.
fn _hls_count_owned(om, pkg_cstr): i64 {
    var owner = load64(om + 8);
    var count = 0;
    var i = 0;
    while (i < vec_len(owner)) {
        if (_hls_cstr_eq(vec_get(owner, i), pkg_cstr) == 1) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

# One-shot convenience: build the map and count in one call.
fn _hls_live_count(trail, pkg_cstr): i64 {
    return _hls_count_owned(_hls_owner_map(trail), pkg_cstr);
}

# Build the vec of unique non-null pkg names that appear in the
# trail, in first-seen order. Skip entries without a pkg field
# (rollback-marker).
fn _hls_unique_pkgs(trail): i64 {
    var seen = vec_new();
    var n = vec_len(trail);
    var i = 0;
    while (i < n) {
        var e = vec_get(trail, i);
        var p = hae_pkg(e);
        if (p != 0 && strlen(p) > 0) {
            var dup = 0;
            var j = 0;
            while (j < vec_len(seen) && dup == 0) {
                if (_hls_cstr_eq(vec_get(seen, j), p) == 1) { dup = 1; }
                j = j + 1;
            }
            if (dup == 0) { vec_push(seen, p); }
        }
        i = i + 1;
    }
    return seen;
}

fn cmd_list(): i64 {
    var scope_root = _hlnk_scope_root_override;
    if (scope_root == 0) { scope_root = getenv("HOME"); }
    if (scope_root == 0 || strlen(scope_root) == 0) {
        _hls_eputs("hapi: $HOME is unset; cannot resolve scope\n");
        return 1;
    }

    # A trail that exists but will not read, or that has a malformed
    # interior line, is a conflict with the user's own history — surface
    # it rather than acting on a partial view. An ABSENT trail is still
    # Ok(empty): that is the first-run case, not a failure.
    var tr = audit_read_default_r();
    if (is_err_result(tr) == 1) {
        var trc = load64(tr + 8);
        _hls_eputs("hapi: ");
        _hls_eputs(hapi_ar_err_msg(trc));
        if (trc == HapiArCorrupt) {
            _hls_eputs(" (line ");
            _hls_eputs(_har_itoa(audit_corrupt_line()));
            _hls_eputs(")");
        }
        _hls_eputs("\n  refusing to act on a partial view of the trail\n");
        return 1;
    }
    var trail = load64(tr + 8);
    var pkgs = _hls_unique_pkgs(trail);
    var npkg = vec_len(pkgs);

    _hls_puts("scope: ");
    _hls_puts(scope_root);
    _hls_puts("\n");

    if (npkg == 0) {
        _hls_puts("(no packages in audit trail)\n");
        return 0;
    }

    var om = _hls_owner_map(trail);
    var i = 0;
    while (i < npkg) {
        var p = vec_get(pkgs, i);
        var live = _hls_count_owned(om, p);
        _hls_puts("  ");
        _hls_puts(p);
        _hls_puts("  ");
        fmt_int(live);
        _hls_puts(" live link");
        if (live != 1) { _hls_puts("s"); }
        _hls_puts("\n");
        i = i + 1;
    }
    return 0;
}
