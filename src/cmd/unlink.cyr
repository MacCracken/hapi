# cmd/unlink.cyr — `hapi unlink <package>`
#
# Removes the symlinks created by prior `link` operations for
# the named package. Trail-driven, not manifest-driven: hapi
# only removes what the audit trail says hapi created.
#
# Safety contract (CLAUDE.md / roadmap M3):
#   - Never deletes a user file
#   - Never deletes a user-created symlink
#   - Refuses any target whose current state diverges from
#     what the trail recorded (user-mutated: hapi removes only
#     what it created, by design)
#
# The trail's `link` entries record both `abs_source` and
# `abs_target`. We recompute the text `hapi link` would have
# written (fsl_link_text_matches — today's, or 1.1.0's lexical
# one) and compare to the symlink's actual value — that's the
# "current state matches what we wrote" check.
#
# Exit codes:
#   0  all in-scope symlinks removed (or none were live)
#   1  at least one entry was refused (user-mutated); the
#      rest still get processed
#   2  bad usage

include "src/audit.cyr"
include "src/audit_reader.cyr"
include "src/fs_link.cyr"
include "src/dry_run.cyr"

fn _hul_puts(s): i64 { print(s, strlen(s)); return 0; }
fn _hul_eputs(s): i64 { eprint(s, strlen(s)); return 0; }

# Walk the trail; for the named package, build a vec of
# "live" HapiAuditEntry pointers — those whose `target` has
# a link entry not superseded by a later unlink entry for the
# same target. Returns vec (possibly empty).
fn _hul_live_entries_for(trail, pkg_cstr): i64 {
    # Two-pass: walk forward, last-write-wins per target.
    # We tag each entry's slot by absorbing "unlink" into a
    # sentinel; final pass collects non-sentinel entries.
    #
    # Implementation: a parallel vec of "target -> entry-or-0".
    # Small N (typical user has < 100 links per package), so
    # linear search per target is fine.
    var live_targets = vec_new();
    var live_entries = vec_new();

    var n = vec_len(trail);
    var i = 0;
    while (i < n) {
        var e = vec_get(trail, i);
        var ep = hae_pkg(e);
        if (_har_cstr_eq(ep, pkg_cstr) == 1) {
            var op = hae_op(e);
            var tgt = hae_abs_target(e);
            if (tgt != 0) {
                # Find existing slot for this target
                var found = 0 - 1;
                var j = 0;
                while (j < vec_len(live_targets) && found < 0) {
                    if (_har_cstr_eq(vec_get(live_targets, j), tgt) == 1) { found = j; }
                    j = j + 1;
                }
                if (_har_cstr_eq(op, "link") == 1) {
                    if (found < 0) {
                        vec_push(live_targets, tgt);
                        vec_push(live_entries, e);
                    } else {
                        # Overwrite — re-link of the same target.
                        # vec doesn't expose set; we mark + clean later.
                        # Simpler: just leave the old, append the new,
                        # filter on collection. But that requires uniq.
                        # Actually: a fresh link entry overrides the
                        # previous one; remove the previous from both
                        # vecs by re-creating. Cheap given the small
                        # N expected.
                        var nt = vec_new();
                        var ne = vec_new();
                        var k = 0;
                        while (k < vec_len(live_targets)) {
                            if (k != found) {
                                vec_push(nt, vec_get(live_targets, k));
                                vec_push(ne, vec_get(live_entries, k));
                            }
                            k = k + 1;
                        }
                        vec_push(nt, tgt);
                        vec_push(ne, e);
                        live_targets = nt;
                        live_entries = ne;
                    }
                } elif (_har_cstr_eq(op, "unlink") == 1) {
                    if (found >= 0) {
                        var nt = vec_new();
                        var ne = vec_new();
                        var k = 0;
                        while (k < vec_len(live_targets)) {
                            if (k != found) {
                                vec_push(nt, vec_get(live_targets, k));
                                vec_push(ne, vec_get(live_entries, k));
                            }
                            k = k + 1;
                        }
                        live_targets = nt;
                        live_entries = ne;
                    }
                }
            }
        }
        i = i + 1;
    }
    return live_entries;
}

# Is `current` a symlink text `hapi link` wrote for this audit entry?
# That is the proof of "this is the link we created" — today's text, the
# absolute text (1.6.0), or the lexical-parent text of 1.1.0 and earlier
# (fsl_link_text_matches).
fn _hul_is_ours(entry, current): i64 {
    var abs_tgt = hae_abs_target(entry);
    var abs_src = hae_abs_source(entry);
    if (abs_tgt == 0 || abs_src == 0) { return 0; }
    return fsl_link_text_matches(current, abs_tgt, abs_src);
}

# Remove one live entry. Returns:
#    0 — removed and recorded
#    2 — already absent: nothing to remove or record
#    1 — refused (current state diverges from trail)
#   -1 — could not remove it; nothing changed
#   -2 — removed, but its trail entry could not be written, so the link
#        was put back: nothing changed (F-061)
#   -3 — removed, entry not written, and the link could not be put back:
#        gone and NOT recorded
# On -2 / -3 the caller reports (audit_report_unwritten) and stops: the
# trail that refused this entry will refuse the next.
fn _hul_remove_one(entry): i64 {
    var abs_tgt = hae_abs_target(entry);
    if (abs_tgt == 0) { return 1; }
    var probe = link_probe(abs_tgt);
    var kind = link_probe_kind(probe);
    if (kind == HAPI_LP_ABSENT) {
        # Already gone — nothing to do, but worth a note rather
        # than treating as an error. We DON'T audit (no state
        # change occurred), and the directories it may have made
        # are left: without the link in them there is no proof they
        # are still hapi's. Caller decides how to report.
        return 2;
    }
    if (kind != HAPI_LP_SYMLINK) {
        return 1;
    }
    var current = link_probe_target(probe);
    if (_hul_is_ours(entry, current) == 0) {
        return 1;
    }
    if (hapi_dry_run() == 1) { return 0; }
    var urc = hapi_unlink(abs_tgt);
    if (urc < 0) { return 0 - 1; }
    # The entry says which shape it removed (1.6.0), so reversing it
    # re-creates the same one.
    var ar_t, ar_v = audit_append_unlink_shaped_r(
        hae_pkg(entry), hae_pkg_version(entry), hae_manifest_hash(entry),
        hae_source(entry), hae_target(entry),
        hae_abs_source(entry), hae_abs_target(entry), fsl_shape_of(current));
    if (is_err_result(ar_t) == 1) {
        # Put back exactly this link, with the text it had, as `link`'s
        # write path takes back exactly its own (F-018). Through 1.2.1 it
        # stayed removed: the trail still called it live, and the run said
        # "unlinked 0 / N" over links it had deleted (F-061).
        if (hapi_symlink(current, abs_tgt) < 0) { return 0 - 3; }
        return 0 - 2;
    }
    return 0;
}

# Remove the directories the run's removed links had made (1.4.0), all
# together after the removals, so one a row made and another reused goes
# too when the run removed both, in whatever order. Reports each one.
fn hul_remove_created_dirs(tgts, dirs): i64 {
    var gone = fsl_rmdir_created_all(tgts, dirs);
    var i = 0;
    while (i < vec_len(gone)) {
        fsl_print_removed_dir(vec_get(gone, i));
        i = i + 1;
    }
    return vec_len(gone);
}

# The F-061 report for a -2 / -3 from _hul_remove_one.
fn hul_report_unwritten(entry, rc): i64 {
    var abs_tgt = hae_abs_target(entry);
    if (rc == 0 - 2) { return audit_report_unwritten(abs_tgt, 1, 0); }
    return audit_report_unwritten(abs_tgt, 0,
      "the link is removed and the trail still calls it live");
}

fn _hul_cstr_eq(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var an = strlen(a);
    var bn = strlen(b);
    if (an != bn) { return 0; }
    return memeq(a, b, an);
}

fn cmd_unlink(pkg_arg): i64 {
    if (pkg_arg == 0) {
        _hul_eputs("usage: hapi unlink <package-name>\n");
        return 2;
    }

    # A trail that exists but will not read, or that has a malformed
    # interior line, is a conflict with the user's own history — surface
    # it rather than acting on a partial view. An ABSENT trail is still
    # Ok(empty): that is the first-run case, not a failure.
    var tr_t, tr_v = audit_read_default_r();
    if (is_err_result(tr_t) == 1) {
        var trc = tr_v;
        _hul_eputs("hapi: ");
        _hul_eputs(hapi_ar_err_msg(trc));
        if (trc == HapiArCorrupt) {
            _hul_eputs(" (line ");
            _hul_eputs(_har_itoa(audit_corrupt_line()));
            _hul_eputs(")");
        }
        _hul_eputs("\n  refusing to act on a partial view of the trail\n");
        return 1;
    }
    var trail = tr_v;
    if (vec_len(trail) == 0) {
        _hul_eputs("hapi: audit trail is empty — nothing to unlink\n");
        return 0;
    }

    var live = _hul_live_entries_for(trail, pkg_arg);
    var nlive = vec_len(live);
    if (nlive == 0) {
        _hul_puts("no live links for `");
        _hul_puts(pkg_arg);
        _hul_puts("` in the audit trail\n");
        return 0;
    }

    # Prove the trail takes a write before removing anything (F-055).
    # Through 1.1.0 only `link` checked; unlink removed each symlink and
    # THEN appended, so a torn tail or an unwritable trail left every link
    # gone and none recorded — "unlinked 0 / 3", the links deleted anyway.
    if (hapi_dry_run() == 0) {
        var pf_t, pf_v = audit_preflight_r();
        if (is_err_result(pf_t) == 1) {
            _hul_eputs("hapi: audit trail is not writable; refusing to unlink\n  ");
            _hul_eputs(audit_trail_path_shown());
            _hul_eputs("\n  every hapi write must be auditable; nothing was changed\n");
            return 1;
        }
    }

    var removed = 0;
    var refused = 0;
    var errored = 0;
    var stop = 0;
    var gone_tgts = vec_new();      # links this run removed, and the
    var gone_dirs = vec_new();      # directories their creation made
    var i = 0;
    while (i < nlive && stop == 0) {
        var entry = vec_get(live, i);
        var rc = _hul_remove_one(entry);
        var abs_tgt = hae_abs_target(entry);
        if (rc < 0 - 1) {
            hul_report_unwritten(entry, rc);
            errored = errored + 1;
            stop = 1;
        } elif (rc == 0 || rc == 2) {
            _hul_puts("  - ");
            _hul_puts(abs_tgt);
            if (hapi_dry_run() == 1) { _hul_puts("  (dry-run)"); }
            _hul_puts("\n");
            removed = removed + 1;
            if (rc == 0 && hapi_dry_run() == 0) {
                vec_push(gone_tgts, abs_tgt);
                vec_push(gone_dirs, hae_created_dir(entry));
            }
        } elif (rc == 1) {
            _hul_eputs("  ! ");
            _hul_eputs(abs_tgt);
            _hul_eputs("  (user-mutated; skipped)\n");
            refused = refused + 1;
        } else {
            _hul_eputs("  ! ");
            _hul_eputs(abs_tgt);
            _hul_eputs("  (IO error)\n");
            errored = errored + 1;
        }
        i = i + 1;
    }
    hul_remove_created_dirs(gone_tgts, gone_dirs);

    _hul_puts("unlinked ");
    fmt_int(removed);
    _hul_puts(" / ");
    fmt_int(nlive);
    if (refused > 0) {
        _hul_puts(" (");
        fmt_int(refused);
        _hul_puts(" refused)");
    }
    _hul_puts("\n");
    if (refused > 0 || errored > 0) { return 1; }
    return 0;
}
