# cmd/unlink.cyr — `hapi unlink <package>`
#
# Removes the symlinks created by prior `link` operations for
# the named package. Trail-driven, not manifest-driven: hapi
# only removes what the audit trail says hapi created.
#
# Safety contract (CLAUDE.md / roadmap M3):
#   - Never deletes a user file
#   - Never deletes a user-created symlink
#   - Refuses any target whose current state diverges from
#     what the trail recorded (user-mutated: hapi removes only
#     what it created, by design)
#
# The trail's `link` entries record both `abs_source` and
# `abs_target`. We recompute the text `hapi link` would have
# written (fsl_link_text_matches — today's, or 1.1.0's lexical
# one) and compare to the symlink's actual value — that's the
# "current state matches what we wrote" check.
#
# Exit codes:
#   0  all in-scope symlinks removed (or none were live)
#   1  at least one entry was refused (user-mutated); the
#      rest still get processed
#   2  bad usage

include "src/audit.cyr"
include "src/audit_reader.cyr"
include "src/fs_link.cyr"
include "src/dry_run.cyr"
include "src/manifest.cyr"     # hapi_mf_parse_file_r, for a path given as a name
include "src/out.cyr"

# Walk the trail; for the named package, build a vec of
# "live" HapiAuditEntry pointers — those whose `target` has
# a link entry not superseded by a later unlink entry for the
# same target, or by another package's link or adopt of it
# (F-079). Returns vec (possibly empty).
fn _hul_live_entries_for(trail, pkg_cstr): i64 {
    # Walk forward, last write wins per target: a parallel pair of vecs,
    # each target and its live entry. A user has < 100 links per package,
    # so a linear search per target is fine. Removal keeps the order, so
    # unlink's lines come out in trail order.
    var live_targets = vec_new();
    var live_entries = vec_new();

    var n = vec_len(trail);
    var i = 0;
    while (i < n) {
        var e = vec_get(trail, i);
        var ep = hae_pkg(e);
        var op = hae_op(e);
        var tgt = hae_abs_target(e);
        if (ep != 0 && tgt != 0) {
            var found = _hul_slot(live_targets, tgt);
            if (hapi_cstr_eq(ep, pkg_cstr) == 0) {
                # Another package's later link or adopt of a target this one
                # holds takes it over (F-079): `link --force B` over A's link.
                # Through 1.7.0 A's entry stayed live, and A's unlink and prune
                # then refused it as user-mutated, forever.
                if (found >= 0 && (hapi_cstr_eq(op, "link") == 1 || hapi_cstr_eq(op, "adopt") == 1)) {
                    vec_remove(live_targets, found);
                    vec_remove(live_entries, found);
                }
            } elif (hapi_cstr_eq(op, "link") == 1) {
                # A re-link of the same target replaces the earlier entry.
                if (found >= 0) {
                    vec_remove(live_targets, found);
                    vec_remove(live_entries, found);
                }
                vec_push(live_targets, tgt);
                vec_push(live_entries, e);
            } elif (hapi_cstr_eq(op, "unlink") == 1 && found >= 0) {
                vec_remove(live_targets, found);
                vec_remove(live_entries, found);
            }
        }
        i = i + 1;
    }
    return live_entries;
}

# The slot of `tgt` in `targets`, or -1.
fn _hul_slot(targets, tgt): i64 {
    var j = 0;
    while (j < vec_len(targets)) {
        if (hapi_cstr_eq(vec_get(targets, j), tgt) == 1) { return j; }
        j = j + 1;
    }
    return 0 - 1;
}

# Is `current` a symlink text `hapi link` wrote for this audit entry?
# That is the proof of "this is the link we created" — today's text, the
# absolute text (1.6.0), or the lexical-parent text of 1.1.0 and earlier
# (fsl_link_text_matches).
fn _hul_is_ours(entry, current): i64 {
    var abs_tgt = hae_abs_target(entry);
    var abs_src = hae_abs_source(entry);
    if (abs_tgt == 0 || abs_src == 0) { return 0; }
    return fsl_link_text_matches(current, abs_tgt, abs_src);
}

# Remove one live entry. Returns:
#    0 — removed and recorded
#    2 — already absent: nothing to remove or record
#    1 — refused (current state diverges from trail)
#   -1 — could not remove it; nothing changed
#   -2 — removed, but its trail entry could not be written, so the link
#        was put back: nothing changed (F-061)
#   -3 — removed, entry not written, and the link could not be put back:
#        gone and NOT recorded
# On -2 / -3 the caller reports (audit_report_unwritten) and stops: the
# trail that refused this entry will refuse the next.
fn _hul_remove_one(entry): i64 {
    var abs_tgt = hae_abs_target(entry);
    if (abs_tgt == 0) { return 1; }
    var probe = link_probe(abs_tgt);
    var kind = link_probe_kind(probe);
    if (kind == HAPI_LP_ABSENT) {
        # Already gone. Nothing is removed here; the caller retires
        # the entry (F-078). The directories it may have made are
        # left: without the link in them there is no proof they are
        # still hapi's.
        return 2;
    }
    if (kind != HAPI_LP_SYMLINK) {
        return 1;
    }
    var current = link_probe_target(probe);
    if (_hul_is_ours(entry, current) == 0) {
        return 1;
    }
    return hul_remove_recorded(entry, current);
}

# Remove the link at the entry's abs_target, whose text is `current`, and
# record its op:unlink. 0 removed (or, under --dry-run, would be); -1 the
# unlink(2) failed; -2 the trail refused the entry and the link was put
# back; -3 it could not be put back (F-061). unlink, prune and rollback
# share it: rollback had its own copy (finding 162).
fn hul_remove_recorded(entry, current): i64 {
    if (hapi_dry_run() == 1) { return 0; }
    var abs_tgt = hae_abs_target(entry);
    if (hapi_unlink(abs_tgt) < 0) { return 0 - 1; }
    # The entry says which shape it removed (1.6.0), so reversing it
    # re-creates the same one.
    var ar_t, ar_v = audit_append_unlink_shaped_r(
        hae_pkg(entry), hae_pkg_version(entry), hae_manifest_hash(entry),
        hae_source(entry), hae_target(entry),
        hae_abs_source(entry), hae_abs_target(entry), fsl_shape_of(current));
    if (is_err_result(ar_t) == 1) {
        # Put back exactly this link, with the text it had, as `link`'s
        # write path takes back exactly its own (F-018). Through 1.2.1 it
        # stayed removed: the trail still called it live, and the run said
        # "unlinked 0 / N" over links it had deleted (F-061).
        if (hapi_symlink(current, abs_tgt) < 0) { return 0 - 3; }
        return 0 - 2;
    }
    return 0;
}

# Remove the directories the run's removed links had made (1.4.0), all
# together after the removals, so one a row made and another reused goes
# too when the run removed both, in whatever order. Reports each one.
# How many of `pkg`'s live targets were made by an adopt (F-106).
fn _hul_adopted_live(trail, pkg): i64 {
    var tgts = vec_new();
    var ops = vec_new();
    var i = 0;
    while (i < vec_len(trail)) {
        var e = vec_get(trail, i);
        var tg = hae_abs_target(e);
        if (tg != 0 && hapi_cstr_eq(hae_pkg(e), pkg) == 1) {
            var op = hae_op(e);
            var f = 0 - 1;
            var j = 0;
            while (j < vec_len(tgts) && f < 0) {
                if (hapi_cstr_eq(vec_get(tgts, j), tg) == 1) { f = j; }
                j = j + 1;
            }
            if (f < 0) { vec_push(tgts, tg); vec_push(ops, op); }
            else { vec_set(ops, f, op); }
        }
        i = i + 1;
    }
    var n = 0;
    var k = 0;
    while (k < vec_len(ops)) {
        if (hapi_cstr_eq(vec_get(ops, k), "adopt") == 1) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

# Retire a live entry whose link is already gone (F-078).
fn hul_retire(entry): Result {
    return audit_append_unlink_absent_r(hae_pkg(entry), hae_pkg_version(entry),
      hae_manifest_hash(entry), hae_source(entry), hae_target(entry),
      hae_abs_source(entry), hae_abs_target(entry));
}

fn hul_remove_created_dirs(tgts, dirs): i64 {
    var gone = fsl_rmdir_created_all(tgts, dirs);
    var i = 0;
    while (i < vec_len(gone)) {
        fsl_print_removed_dir(vec_get(gone, i));
        i = i + 1;
    }
    return vec_len(gone);
}

# The directories one removed link made, removed as soon as its op:unlink
# is recorded (finding 229). Through 1.7.0 they went only after the whole
# loop, so a run stopped partway (Ctrl-C, a closed pipe) left them, and no
# later verb saw an entry that claimed them. The pass after the loop still
# runs, for a directory one row made and another row's link kept until
# its own removal.
fn hul_remove_created_dirs_of(abs_tgt, top): i64 {
    if (top == 0) { return 0; }
    var t = vec_new();
    vec_push(t, abs_tgt);
    var d = vec_new();
    vec_push(d, top);
    return hul_remove_created_dirs(t, d);
}

# The F-061 report for a -2 / -3 from _hul_remove_one.
fn hul_report_unwritten(entry, rc): i64 {
    var abs_tgt = hae_abs_target(entry);
    if (rc == 0 - 2) { return audit_report_unwritten(abs_tgt, 1, 0); }
    return audit_report_unwritten(abs_tgt, 0,
      "the link is removed and the trail still calls it live");
}

fn cmd_unlink(pkg_arg): i64 {
    if (pkg_arg == 0) {
        hapi_eputs("usage: hapi unlink <package-name>\n");
        return 2;
    }

    # A trail that exists but will not read, or that has a malformed
    # interior line, is a conflict with the user's own history — surface
    # it rather than acting on a partial view. An ABSENT trail is still
    # Ok(empty): that is the first-run case, not a failure.
    var tr_t, tr_v = audit_read_or_refuse("act");
    if (is_err_result(tr_t) == 1) { return 1; }
    var trail = tr_v;
    if (vec_len(trail) == 0) {
        hapi_eputs("hapi: audit trail is empty — nothing to unlink\n");
        return 0;
    }

    var live = _hul_live_entries_for(trail, pkg_arg);
    var nlive = vec_len(live);
    if (nlive == 0) {
        # A package directory or manifest given where its name belongs
        # (F-106): through 1.7.0 this said `no live links` and exited 0,
        # removing nothing, for the form link, sync and status take.
        var mp = _fsl_path_join(pkg_arg, "hapi.cyml");
        var nl = strlen(pkg_arg);
        if (nl > 5 && memeq(pkg_arg + nl - 5, ".cyml", 5) == 1) { mp = pkg_arg; }
        if (fsl_is_regular(mp) == 1) {
            var mt, mv = hapi_mf_parse_file_r(mp);
            if (is_ok(mt) == 1 && hapi_cstr_eq(_fsl_str_to_cstr(hapi_mf_name(mv)), pkg_arg) == 0) {
                hapi_eputs("hapi: unlink takes a package's name, not its path: `");
                hapi_eputs(pkg_arg);
                hapi_eputs("` holds package `");
                hapi_eputs(_fsl_str_to_cstr(hapi_mf_name(mv)));
                hapi_eputs("`\n  run: hapi unlink ");
                hapi_eputs(_fsl_str_to_cstr(hapi_mf_name(mv)));
                hapi_eputs("\n");
                return 1;
            }
        }
        hapi_puts("no live links for `");
        hapi_puts(hae_shown(pkg_arg));
        hapi_puts("` in the audit trail\n");
        # Links an adopt made are rollback's to reverse (ADR 0004); list
        # counts them, so say where they went (F-106).
        var adopted = _hul_adopted_live(trail, pkg_arg);
        if (adopted > 0) {
            hapi_puts("  (");
            fmt_int(adopted);
            hapi_puts(" of its links came from `hapi adopt`; `hapi rollback` reverses an adopt)\n");
        }
        return 0;
    }

    # Prove the trail takes a write before removing anything (F-055).
    # Through 1.1.0 only `link` checked; unlink removed each symlink and
    # THEN appended, so a torn tail or an unwritable trail left every link
    # gone and none recorded — "unlinked 0 / 3", the links deleted anyway.
    # A dry run checks it too (F-094).
    if (audit_preflight_or_refuse("unlink") != 0) { return 1; }

    var removed = 0;
    var absent = 0;
    var refused = 0;
    var errored = 0;
    var stop = 0;
    var gone_tgts = vec_new();      # links this run removed, and the
    var gone_dirs = vec_new();      # directories their creation made
    var i = 0;
    while (i < nlive && stop == 0) {
        var entry = vec_get(live, i);
        var rc = _hul_remove_one(entry);
        var abs_tgt = hae_abs_target(entry);
        if (rc < 0 - 1) {
            hul_report_unwritten(entry, rc);
            errored = errored + 1;
            stop = 1;
        } elif (rc == 2) {
            # Already gone (F-078). Through 1.7.0 this printed a removal,
            # wrote nothing, and the entry stayed live: every later unlink
            # "removed" it again and `list` counted it forever. It is
            # retired now, with an op:unlink rollback will not reverse.
            hapi_puts("  = ");
            hapi_puts(hae_shown(abs_tgt));
            hapi_puts("  (already absent");
            if (hapi_dry_run() == 1) { hapi_puts("; dry-run"); }
            hapi_puts(")\n");
            absent = absent + 1;
            if (hapi_dry_run() == 0) {
                var ab_t, ab_v = hul_retire(entry);
                if (is_err_result(ab_t) == 1) {
                    audit_report_unwritten(abs_tgt, 1, 0);
                    errored = errored + 1;
                    stop = 1;
                }
            }
        } elif (rc == 0) {
            hapi_puts("  - ");
            hapi_puts(hae_shown(abs_tgt));
            if (hapi_dry_run() == 1) { hapi_puts("  (dry-run)"); }
            hapi_puts("\n");
            removed = removed + 1;
            if (hapi_dry_run() == 0) {
                vec_push(gone_tgts, abs_tgt);
                vec_push(gone_dirs, hae_created_dir(entry));
                hul_remove_created_dirs_of(abs_tgt, hae_created_dir(entry));
            }
        } elif (rc == 1) {
            hapi_eputs("  ! ");
            hapi_eputs(hae_shown(abs_tgt));
            hapi_eputs("  (user-mutated; skipped)\n");
            refused = refused + 1;
        } else {
            hapi_eputs("  ! ");
            hapi_eputs(hae_shown(abs_tgt));
            hapi_eputs("  (IO error)\n");
            errored = errored + 1;
        }
        i = i + 1;
    }
    hul_remove_created_dirs(gone_tgts, gone_dirs);

    hapi_puts("unlinked ");
    fmt_int(removed);
    hapi_puts(" / ");
    fmt_int(nlive);
    if (absent > 0) {
        hapi_puts(" (");
        fmt_int(absent);
        hapi_puts(" already absent)");
    }
    if (refused > 0) {
        hapi_puts(" (");
        fmt_int(refused);
        hapi_puts(" refused)");
    }
    hapi_puts("\n");
    if (refused > 0 || errored > 0) { return 1; }
    return 0;
}
