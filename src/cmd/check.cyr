# cmd/check.cyr — `hapi check <package> [--strict]`
#
# Like `hapi inspect`, but with an opt-in `--strict` mode that
# rejects unknown [section] headers and unknown keys inside
# the known sections. Targets CI / lint use — the default
# parser is lenient by design (ADR 0001 leaves schema headroom
# for additive growth), and the strict surface is the one that
# guards against typos and stale schema drift.
#
# Exit codes:
#   0  manifest parsed cleanly AND agrees with the package directory
#   1  parse error (including strict-mode rejection), or a divergence
#      between the manifest and what is actually in the package
#   2  bad usage
#
# The divergence check is the detection half of F-028. `adopt` renames
# the file into the package BEFORE it writes the row, so a SIGKILL, an
# OOM kill or a closing lid in that window leaves the user's dotfile
# sitting in the package with no row, no symlink and no trail entry —
# and every other verb then reports a clean world, because they all
# start from manifest rows. Only a directory walk can see it. True
# crash-atomicity (an intent record written before the rename) is an
# ADR 0004 revision, not a patch; this is the half a patch can carry.

include "src/manifest.cyr"
include "src/cmd/inspect.cyr"   # reuse _hapi_inspect_print_manifest / _hi_eputs
include "src/fs_link.cyr"
include "lib/fs.cyr"            # dir_list_checked — portable across the dirent layouts
include "src/audit_reader.cyr"   # _har_itoa

# Same resolver as inspect; keeping it inline so check stays
# decoupled from the inspect module's private helpers.
fn _hck_resolve_manifest(arg): i64 {
    var n = strlen(arg);
    if (n >= 5) {
        if (load8(arg + n - 5) == 46 && load8(arg + n - 4) == 99
            && load8(arg + n - 3) == 121 && load8(arg + n - 2) == 109
            && load8(arg + n - 1) == 108) {
            var out = alloc(n + 1);
            memcpy(out, arg, n);
            store8(out + n, 0);
            return out;
        }
    }
    var trim = n;
    if (trim > 0 && load8(arg + trim - 1) == 47) { trim = trim - 1; }
    var suffix = "/hapi.cyml";
    var slen = 10;
    var out = alloc(trim + slen + 1);
    memcpy(out, arg, trim);
    memcpy(out + trim, suffix, slen);
    store8(out + trim + slen, 0);
    return out;
}

# Does `name` correspond to manifest row source `src`? True when they
# are equal, or when `src` lives beneath `name` (a row source of
# `config/zsh` is covered by the top-level entry `config`).
fn _hck_covers(src, name): i64 {
    # A source spelled `./x` (or `.//x`) claims `x` (F-095): link and
    # status accept that spelling, and check called `x` an orphan.
    while (strlen(src) >= 2 && load8(src) == 46 && load8(src + 1) == 47) {
        src = src + 2;
        while (load8(src) == 47) { src = src + 1; }
    }
    var sn = strlen(src);
    var nn = strlen(name);
    if (nn > sn) { return 0; }
    if (memeq(src, name, nn) == 0) { return 0; }
    if (sn == nn) { return 1; }
    if (load8(src + nn) == 47) { return 1; }
    return 0;
}

# Is `name` a staging file from an interrupted write, rather than
# package content? `<manifest>.<pid>.tmp` — see _hmw_write_atomic —
# exactly (F-095): through 1.7.0 every `*.tmp` name counted, so a
# package's own `notes.tmp` was hidden from the orphan check, and check
# advised deleting a file a row links.
fn _hck_is_staging(name, mbase): i64 {
    var n = strlen(name);
    var b = strlen(mbase);
    if (n < b + 6) { return 0; }
    if (memeq(name, mbase, b) == 0 || load8(name + b) != 46) { return 0; }
    if (memeq(name + n - 4, ".tmp", 4) == 0) { return 0; }
    var i = b + 1;
    if (i >= n - 4) { return 0; }
    while (i < n - 4) {
        var c = load8(name + i);
        if (c < 48 || c > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Compare the manifest against the package directory, both ways.
# Returns the number of divergences reported (0 = they agree), or -1
# when the package directory could not be listed.
fn _hck_report_divergence(mpath, m): i64 {
    var pkg_dir = _fsl_path_dirname(mpath);
    var mbase = _fsl_path_basename(mpath);
    var links = hapi_mf_links(m);
    var nl = vec_len(links);
    var bad = 0;
    var orphans = 0;

    # 1. Every row must have its source present in the package.
    var i = 0;
    while (i < nl) {
        var lk = vec_get(links, i);
        var src = _fsl_str_to_cstr(hapi_link_source(lk));
        var abs_src = _fsl_path_join(pkg_dir, src);
        # The predicate `link` and `status` share (F-048): testing for
        # ABSENT alone passed a row whose source runs through a regular
        # file (`f/sub`, ENOTDIR), which `link` then refused — while
        # telling the user that `check` lists every such row.
        if (fsl_source_present(abs_src) == 0) {
            if (bad == 0) { _hi_eputs("\ndivergence between the manifest and the package:\n"); }
            _hi_eputs("  row source is missing: ");
            _hi_eputs(src);
            _hi_eputs("\n");
            bad = bad + 1;
        }
        i = i + 1;
    }

    # 2. Every file in the package must be claimed by a row. An
    # unclaimed one is the F-028 crash orphan: adopt moved it in and
    # died before recording it.
    #
    # dir_list_checked, not dir_list (F-037): dir_list answers an empty
    # vec for a directory it cannot open or read, so a package dir with
    # its read bit cleared (0311 — the manifest still opens by name)
    # passed this check with an orphan sitting in it. A listing that
    # failed has not shown the package agrees; it is an error.
    var names = vec_new();
    if (dir_list_checked(str_from(pkg_dir), names) < 0) {
        _hi_eputs("hapi: could not list the package directory (");
        _hi_eputs(pkg_dir);
        _hi_eputs(")\n");
        return 0 - 1;
    }
    var nn = vec_len(names);
    var j = 0;
    while (j < nn) {
        var nm = _fsl_str_to_cstr(vec_get(names, j));
        var skip = 0;
        # The manifest checked, and any other `*.cyml` beside it, is not
        # package content (F-095): checked as `pkg/zsh.cyml`, check
        # reported zsh.cyml itself as an orphan and always exited 1.
        var nml = strlen(nm);
        if (_hck_cstr_eq(nm, mbase) == 1) { skip = 1; }
        if (nml > 5 && memeq(nm + nml - 5, ".cyml", 5) == 1) { skip = 1; }
        if (_hck_is_staging(nm, mbase) == 1) {
            # Not package content, so not a divergence — but it is not
            # harmless either: it refuses every later manifest write by a
            # process that draws the same pid (F-038). Name it.
            _hi_eputs("note: staging file from an interrupted write: ");
            _hi_eputs(nm);
            _hi_eputs(" (delete it once no hapi is running)\n");
            skip = 1;
        }
        if (skip == 0) {
            var claimed = 0;
            var k = 0;
            while (k < nl) {
                var src2 = _fsl_str_to_cstr(hapi_link_source(vec_get(links, k)));
                if (_hck_covers(src2, nm) == 1) { claimed = 1; }
                k = k + 1;
            }
            if (claimed == 0) {
                if (bad == 0) { _hi_eputs("\ndivergence between the manifest and the package:\n"); }
                _hi_eputs("  file in the package with no [[link]] row: ");
                _hi_eputs(nm);
                _hi_eputs("\n");
                bad = bad + 1;
                orphans = orphans + 1;
            }
        }
        j = j + 1;
    }

    if (orphans > 0) {
        _hi_eputs("  (an unclaimed file is the signature of an `adopt` that was\n");
        _hi_eputs("   interrupted after the move and before the manifest write)\n");
    }
    return bad;
}

fn _hck_cstr_eq(a, b): i64 { return hapi_cstr_eq(a, b); }

fn cmd_check(path, strict): i64 {
    if (path == 0) {
        _hi_eputs("usage: hapi check <package-dir|hapi.cyml> [--strict]\n");
        return 2;
    }
    var mpath = _hck_resolve_manifest(path);

    # --strict also fails on what the lenient parser skips without a
    # word, other than comments (F-107): a key before any section, a key
    # given twice, text after a value, a value that is not a string, a
    # byte-order mark. Through 1.7.0 strict rejected only unknown sections
    # and keys, and passed the rest, which `fmt` would then drop.
    var drops = 0;
    if (strict == 1) {
        hapi_mf_set_strict(1);
        drops = vec_new();
        hapi_mf_track_drops(drops);
    }
    var res_t, res_v = hapi_mf_parse_file_r(mpath);
    if (strict == 1) {
        hapi_mf_set_strict(0);
        hapi_mf_track_drops(0);
    }
    if (strict == 1 && is_err_result(res_t) == 0) {
        var bad = 0;
        var di = 0;
        while (di < vec_len(drops)) {
            var dd = vec_get(drops, di);
            if (_hck_cstr_eq(hapi_mf_drop_what(dd), "a comment") == 0) {
                if (bad == 0) { _hi_eputs("hapi: the manifest has what the parser skips (strict mode):\n"); }
                _hi_eputs("  line ");
                _hi_eputs(_har_itoa(hapi_mf_drop_line(dd)));
                _hi_eputs(": ");
                _hi_eputs(hapi_mf_drop_what(dd));
                _hi_eputs("\n");
                bad = bad + 1;
            }
            di = di + 1;
        }
        if (bad > 0) { return 1; }
    }

    if (is_err_result(res_t) == 1) {
        var code = res_v;
        var msg = hapi_mf_err_msg(code);
        _hi_eputs("hapi: ");
        eprint(msg, strlen(msg));
        _hi_eputs(" (");
        eprint(mpath, strlen(mpath));
        _hi_eputs(")\n");
        return 1;
    }
    var m = res_v;
    _hapi_inspect_print_manifest(m);

    var diverged = _hck_report_divergence(mpath, m);
    if (diverged != 0) { return 1; }

    if (strict == 1) {
        print("ok (strict)\n", 12);
    } else {
        print("ok\n", 3);
    }
    return 0;
}
