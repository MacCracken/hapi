# cmd/status.cyr — `hapi status <package>`
#
# Read-only drift check: parse the manifest, classify each
# [[link]] row against the on-disk state, print a per-row
# summary. No audit writes, no filesystem mutation.
#
# Classifications:
#   OK          — symlink points where hapi link would write, in
#                 either shape: relative, or absolute (1.6.0)
#   BROKEN      — symlink text is right, but the source it names is
#                 gone: the link dangles (F-022)
#   MISSING     — target absent
#   WRONG       — symlink points elsewhere (user / other tool wrote)
#   FILE        — regular file at target (link would refuse)
#   DIRECTORY   — directory at target (link would refuse)
#   ERROR       — probe failed (permission, etc.)
#
# Exit codes:
#   0  all rows OK
#   1  any row drifted, or manifest parse failed
#   2  bad usage
#
# `--quiet` (1.5.0) keeps the rows and changes only the exit code: drift
# exits 0, and 1 means an actual error — a manifest that will not resolve
# or parse, no $HOME, a target that could not be checked (ERROR), or since
# 1.7.1 a row link refuses outright (REFUSED, F-108). It is
# the predicate a `status && link --force` chain wants; the default stays
# the assertion CI wants (guides/status.md).

include "src/manifest.cyr"
include "src/fs_link.cyr"
include "src/cmd/link.cyr"   # scope-root override hook
include "src/out.cyr"

# Same resolver as inspect/link — accept a *.cyml path or a
# package directory.
fn _hst_resolve_manifest(arg): i64 { return fsl_manifest_of_arg(arg); }

fn cmd_status(pkg_arg): i64 { return cmd_status_run(pkg_arg, 0); }

fn cmd_status_run(pkg_arg, quiet): i64 {
    if (pkg_arg == 0) {
        hapi_eputs("usage: hapi status <package-dir|hapi.cyml>\n");
        return 2;
    }

    var manifest_path = _hst_resolve_manifest(pkg_arg);
    # 0 = a relative package argument with no determinable cwd (agnos
    # without a usable PWD). Refuse loudly: continuing would put a
    # non-absolute path into the trail's `abs_source`, which ADR 0002
    # requires to be absolute, and the symlink body would resolve
    # against the wrong directory (F-027).
    if (manifest_path == 0) {
        hapi_refuse_unknown_cwd();
        return 1;
    }
    var pkg_dir_abs = _fsl_path_dirname(manifest_path);

    var mr_t, mr_v = hapi_mf_parse_file_r(manifest_path);
    if (is_err_result(mr_t) == 1) {
        hapi_mf_report_err(mr_v, manifest_path);
        return 1;
    }
    var m = mr_v;

    var scope_root = link_scope_root("cannot resolve link targets");
    if (scope_root == 0) { return 1; }
    var scope_root_abs = fsl_to_absolute(scope_root);

    var links = hapi_mf_links(m);
    var nlinks = vec_len(links);
    var ok = 0;
    var drift = 0;
    var unchecked = 0;    # ERROR rows: the probe itself failed
    var nrefused = 0;     # REFUSED rows: link refuses them outright

    var i = 0;
    while (i < nlinks) {
        var lnk = vec_get(links, i);
        var src_cstr = _fsl_str_to_cstr(hapi_link_source(lnk));
        var tgt_cstr = _fsl_str_to_cstr(hapi_link_target(lnk));
        var abs_src = _fsl_path_join(pkg_dir_abs, src_cstr);
        var abs_tgt = _fsl_path_join(scope_root_abs, tgt_cstr);
        var expected = fsl_link_text(abs_tgt, abs_src);

        var probe = link_probe(abs_tgt);
        var kind = link_probe_kind(probe);
        var status_lit = "ERROR  ";
        var detail = 0;
        var row_ok = 0;
        var broken = 0;
        var refused = 0;
        var no_src = 0;
        # A row `link` refuses outright is reported so (F-108): through
        # 1.7.0 status read the target alone, and called a row whose parent
        # leads outside the scope OK or MISSING.
        if (cap_target_allowed(_fsl_path_dirname(abs_tgt), scope_root_abs) == 0) {
            status_lit = "REFUSED";
            refused = 1;
            kind = HAPI_LP_ERROR;
        } elif (kind == HAPI_LP_ABSENT) {
            status_lit = "MISSING";
            if (fsl_source_present(abs_src) == 0) { no_src = 1; }
        } elif (kind == HAPI_LP_SYMLINK) {
            var existing = link_probe_target(probe);
            # Either shape naming the source is OK (1.6.0): `--absolute`
            # shapes only the links a run creates, and status reads no
            # trail, so it needs no flag (F-006).
            if (hapi_cstr_eq(existing, expected) == 1 || fsl_is_absolute_text(existing, abs_src) == 1) {
                # Ownership is still proved by the byte-compare above,
                # unchanged. This is an ADDITIONAL probe: a dangling link
                # holds exactly the right target text, so the compare
                # passes while the file it names is gone (F-022).
                if (link_probe_kind(link_probe(abs_src)) == HAPI_LP_ERROR) {
                    # A source hapi cannot probe is not known to be gone
                    # (F-108): it was BROKEN, which --quiet let pass.
                    status_lit = "ERROR  ";
                    kind = HAPI_LP_ERROR;
                } elif (fsl_source_present(abs_src) == 0) {
                    status_lit = "BROKEN ";
                    broken = 1;
                } else {
                    status_lit = "OK     ";
                    row_ok = 1;
                }
            } else {
                status_lit = "WRONG  ";
                detail = existing;
            }
        } elif (kind == HAPI_LP_FILE) {
            status_lit = "FILE   ";
        } elif (kind == HAPI_LP_DIRECTORY) {
            status_lit = "DIR    ";
        }

        hapi_puts("  ");
        hapi_puts(status_lit);
        hapi_puts("  ");
        hapi_puts(abs_tgt);
        if (refused == 1) {
            hapi_puts("  (resolves outside the scoped root, or cannot be followed; link refuses it)");
        } elif (broken == 1 || no_src == 1) {
            hapi_puts("  (source missing: ");
            hapi_puts(abs_src);
            hapi_puts(")");
        } elif (kind == HAPI_LP_SYMLINK && row_ok == 0) {
            hapi_puts("  (-> ");
            hapi_puts(detail);
            hapi_puts("; expected -> ");
            hapi_puts(expected);
            hapi_puts(")");
        }
        hapi_puts("\n");

        if (row_ok == 1) { ok = ok + 1; }
        else { drift = drift + 1; }
        if (refused == 1) { nrefused = nrefused + 1; }
        elif (kind == HAPI_LP_ERROR) { unchecked = unchecked + 1; }
        i = i + 1;
    }

    hapi_puts("status ");
    fmt_int(ok);
    hapi_puts(" / ");
    fmt_int(nlinks);
    hapi_puts(" OK");
    if (drift > 0) {
        hapi_puts(" (");
        fmt_int(drift);
        hapi_puts(" drift)");
    }
    hapi_puts("\n");
    if (quiet == 1) {
        if (unchecked == 0 && nrefused == 0) { return 0; }
        if (unchecked > 0) {
            hapi_eputs("hapi: ");
            fmt_int_fd(2, unchecked);
            if (unchecked == 1) { hapi_eputs(" target could not be checked (ERROR above)\n"); }
            else { hapi_eputs(" targets could not be checked (ERROR above)\n"); }
        }
        if (nrefused > 0) {
            hapi_eputs("hapi: ");
            fmt_int_fd(2, nrefused);
            if (nrefused == 1) { hapi_eputs(" row resolves"); }
            else { hapi_eputs(" rows resolve"); }
            hapi_eputs(" outside the scope or cannot be followed (REFUSED above)\n");
        }
        return 1;
    }
    if (drift > 0) { return 1; }
    return 0;
}
