# cmd/rollback.cyr — `hapi rollback`
#
# Walks the audit trail backward from EOF, stopping at the
# most recent `rollback-marker` (or at the start of the trail
# if no marker exists). Within that window, reverses every
# entry — newer entries first.
#
# Reversal semantics:
#   link entry   → if the symlink at abs_target still matches
#                  what the trail says we wrote, sys_unlink it
#                  and append a fresh op=unlink entry.
#   unlink entry → if the abs_target is currently absent,
#                  recreate the symlink and append op=link.
#   marker       → stop (we've reached the boundary).
#
# Each reversal is conditional: if the user already
# unlinked / overwrote / reorganized something, we leave it
# alone. That makes rollback idempotent — running it twice
# produces the same end state as running it once.
#
# 1.5.0 adds two ways to reach further back; the no-arg form above is
# unchanged. `--steps N` reverses the N most recent checkpoint windows
# still in effect; `--to <label>` reverses back to the most recent marker
# `checkpoint --label` named so. Both step over a range an earlier
# rollback already undid, which its closing marker records as `from`
# (the line the range began on), so they are a multi-level undo rather
# than a redo of the last one. Design: ADR 0007; the fields: ADR 0002,
# 1.5.0 addendum.

include "src/audit.cyr"
include "src/audit_reader.cyr"
include "src/fs_link.cyr"
include "src/manifest_write.cyr"
include "src/dry_run.cyr"

fn _hrb_puts(s): i64 { print(s, strlen(s)); return 0; }
fn _hrb_eputs(s): i64 { eprint(s, strlen(s)); return 0; }

fn _hrb_cstr_eq(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var an = strlen(a);
    var bn = strlen(b);
    if (an != bn) { return 0; }
    return memeq(a, b, an);
}

# Find the index of the most recent rollback-marker, walking
# backward from `start` toward 0. Returns -1 if none (meaning
# "rollback to the beginning of the trail").
fn _hrb_find_marker(trail, start): i64 {
    var i = start;
    var found = 0 - 1;
    var go = 1;
    while (i >= 0 && go == 1) {
        var e = vec_get(trail, i);
        if (_hrb_cstr_eq(hae_op(e), "rollback-marker") == 1) {
            found = i;
            go = 0;
        }
        i = i - 1;
    }
    return found;
}

# Reverse one link entry: if the symlink at abs_target still
# matches what hapi link would have written, unlink it.
# Returns 1 if the reversal happened, 0 if skipped (state
# diverged), -1 on IO error (nothing changed), and -2 / -3 when its
# trail entry could not be written: the link was put back (-2), or
# could not be (-3). See F-061 in _hul_remove_one.
fn _hrb_reverse_link(entry): i64 {
    var abs_tgt = hae_abs_target(entry);
    var abs_src = hae_abs_source(entry);
    if (abs_tgt == 0 || abs_src == 0) { return 0; }

    var probe = link_probe(abs_tgt);
    if (link_probe_kind(probe) != HAPI_LP_SYMLINK) { return 0; }

    if (fsl_link_text_matches(link_probe_target(probe), abs_tgt, abs_src) == 0) { return 0; }

    if (hapi_dry_run() == 1) { return 1; }
    var urc = hapi_unlink(abs_tgt);
    if (urc < 0) { return 0 - 1; }
    var ar_t, ar_v = audit_append_unlink_shaped_r(
        hae_pkg(entry), hae_pkg_version(entry), hae_manifest_hash(entry),
        hae_source(entry), hae_target(entry),
        hae_abs_source(entry), hae_abs_target(entry), fsl_shape_of(link_probe_target(probe)));
    if (is_err_result(ar_t) == 1) {
        if (hapi_symlink(link_probe_target(probe), abs_tgt) < 0) { return 0 - 3; }
        return 0 - 2;
    }
    return 1;
}

# Reverse one unlink entry: if abs_target is absent, recreate
# the symlink. Returns 1 if applied, 0 if skipped, -1 on IO, and
# -2 / -3 when its trail entry could not be written: the new link
# was taken back (-2), or could not be (-3) — F-061.
# The replay entry carries `backup_path` 0 — the reversal only
# ever writes into an absent target, so nothing is overwritten
# and there is no snapshot to record (ADR 0002 additive field).
# Passing it explicitly is load-bearing: the argument was omitted
# from 0.8.0 through 1.0.3, and until cyrius 6.5.1 promoted a wrong
# argument count from warning to error, the callee simply read an
# uninitialized slot.
fn _hrb_reverse_unlink(entry): i64 {
    var abs_tgt = hae_abs_target(entry);
    var abs_src = hae_abs_source(entry);
    if (abs_tgt == 0 || abs_src == 0) { return 0; }

    var probe = link_probe(abs_tgt);
    if (link_probe_kind(probe) != HAPI_LP_ABSENT) { return 0; }

    # In the shape the unlink removed (1.6.0): its entry says "absolute"
    # for an absolute link. Never the run's --absolute; rollback takes none.
    var rel = fsl_link_text_shaped(abs_tgt, abs_src, hae_absolute(entry));
    if (rel == 0) { return 0; }

    if (hapi_dry_run() == 1) { return 1; }
    var made = 0;
    var crc = link_create_r(rel, abs_tgt, &made);
    if (crc < 0) { return 0 - 1; }
    var ar_t, ar_v = audit_append_link_full_r(
        hae_pkg(entry), hae_pkg_version(entry), hae_manifest_hash(entry),
        hae_source(entry), hae_target(entry),
        hae_abs_source(entry), hae_abs_target(entry), 0, made, fsl_shape_of(rel));
    if (is_err_result(ar_t) == 1) {
        if (hapi_unlink(abs_tgt) < 0) { return 0 - 3; }
        if (made != 0) { fsl_rmdir_created(abs_tgt, made, 0); }
        return 0 - 2;
    }
    return 1;
}

# Reverse one adopt entry. Per ADR 0004 this is a three-step
# conditional reversal: remove the symlink, move the file back,
# remove the manifest row. ALL preconditions checked up front;
# either all three apply or none do.
#
# Manifest path is derived from the package dir (dirname of
# abs_source) — the audit entry doesn't carry it explicitly.
# Returns 1 applied, 0 skipped (state diverged), -1 IO error, 2 applied
# but the manifest row could not be removed (an error for the exit code).
fn _hrb_reverse_adopt(entry): i64 {
    var abs_tgt = hae_abs_target(entry);
    var abs_src = hae_abs_source(entry);
    var source = hae_source(entry);
    var target = hae_target(entry);
    if (abs_tgt == 0 || abs_src == 0 || source == 0 || target == 0) { return 0; }

    # Symlink at target must still point where adopt would have written.
    var probe_t = link_probe(abs_tgt);
    if (link_probe_kind(probe_t) != HAPI_LP_SYMLINK) { return 0; }
    var found = link_probe_target(probe_t);
    if (fsl_link_text_matches(found, abs_tgt, abs_src) == 0) { return 0; }

    # Source must still be a regular file in the package.
    var probe_s = link_probe(abs_src);
    if (link_probe_kind(probe_s) != HAPI_LP_FILE) { return 0; }

    # Manifest must still exist at <pkg_dir>/hapi.cyml. We don't
    # re-validate the row's presence ahead of time — the remove
    # call will report not-found and we treat that as state-diverged.
    var pkg_dir = _fsl_path_dirname(abs_src);
    var manifest_path = _fsl_path_join(pkg_dir, "hapi.cyml");

    # All preconditions held. Execute the three steps. Any
    # IO failure mid-sequence is a hard error — we don't try to
    # back out partial work (the audit trail is the recovery path).

    if (hapi_dry_run() == 1) { return 1; }
    var urc = hapi_unlink(abs_tgt);
    if (urc < 0) { return 0 - 1; }

    var rrc = hapi_rename(abs_src, abs_tgt);
    if (rrc < 0) {
        # Re-attach what we just broke so the world is at least
        # consistent with the trail again — byte for byte what was there.
        link_create(found, abs_tgt);
        return 0 - 1;
    }

    var mrc = manifest_remove_link_row(manifest_path,
        _fsl_str_to_cstr_helper(source), _fsl_str_to_cstr_helper(target));
    var row_left = 0;
    if (mrc == 0 - HapiMfwRowNotFound) {
        # Manifest row already gone or never present. Filesystem
        # changes already committed; treat as warning-level.
        _hrb_eputs("  ! ");
        _hrb_eputs(abs_tgt);
        _hrb_eputs("  (manifest row not found; filesystem reverted)\n");
    } elif (mrc < 0) {
        # The row IS there and the rewrite failed (F-038). Through 1.1.0
        # this branch printed "manifest row not found" and the verb exited
        # 0, leaving a row whose source had just been moved out of the
        # package. The filesystem revert is real, so it is still recorded
        # below; the row is the user's to remove, and the exit says so.
        _hrb_eputs("  ! ");
        _hrb_eputs(abs_tgt);
        _hrb_eputs("  (file restored, but its manifest row was NOT removed: ");
        _hrb_eputs(hapi_mfw_err_msg(0 - mrc));
        _hrb_eputs(")\n");
        row_left = 1;
    }

    var ar_t, ar_v = audit_append_unadopt_shaped_r(
        hae_pkg(entry), hae_pkg_version(entry), hae_manifest_hash(entry),
        source, target, abs_src, abs_tgt, fsl_shape_of(found));
    # Three steps are not taken back in one (F-061): the file is back at
    # the target and the row is out of the manifest, but the trail still
    # says adopted. Said exactly, rather than as an IO error.
    if (is_err_result(ar_t) == 1) { return 0 - 3; }
    if (row_left == 1) { return 2; }
    return 1;
}

# Bridge: source / target in the audit entry are cstrings
# already (audit_reader unescapes into heap cstrings). The
# manifest_remove_link_row signature takes cstrings. This
# helper just acknowledges the convention so the call site
# reads clearly.
fn _fsl_str_to_cstr_helper(c): i64 { return c; }

# The F-061 report for a reversal whose trail entry could not be written.
fn _hrb_report_unwritten(entry, rc, left): i64 {
    if (rc == 0 - 2) { return audit_report_unwritten(hae_abs_target(entry), 1, 0); }
    return audit_report_unwritten(hae_abs_target(entry), 0, left);
}

fn cmd_rollback(): i64 { return cmd_rollback_run(0, 0); }

# The line a closing marker's range began on, or 0 when `e` is no such
# marker: no `from` (a checkpoint, or a rollback before 1.5.0), or one
# that is not a line before the marker's own — digits only, few enough not
# to wrap, at least 1. Such a marker is treated as a checkpoint, which only
# ever makes a walk stop sooner.
fn _hrb_from_line(e): i64 {
    var f = hae_from(e);
    if (f == 0) { return 0; }
    var n = strlen(f);
    if (n == 0 || n > 18) { return 0; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(f + i);
        if (c < 48 || c > 57) { return 0; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (v >= hae_lineno(e)) { return 0; }
    return v;                     # 0 for "0": no line, as for no `from`
}

# The ops a rollback reverses.
fn _hrb_reversible(op): i64 {
    if (_hrb_cstr_eq(op, "link") == 1) { return 1; }
    if (_hrb_cstr_eq(op, "unlink") == 1) { return 1; }
    if (_hrb_cstr_eq(op, "adopt") == 1) { return 1; }
    return 0;
}

# Walk back from EOF over what is still in effect, for `--steps` (steps >
# 0) or `--to` (label), pushing the index of each reversible entry onto
# `live`, newest first. A closing marker with a `from` ends a range an
# earlier rollback undid: the walk jumps to the line before it, so neither
# its reversals nor what they reversed are touched again. Every other
# marker is a checkpoint. For --steps it closes a window, and counts only
# if the window holds a live entry — back-to-back markers are one step,
# and a window a rollback emptied is none. Returns the boundary marker's
# index, -1 for the start of the trail, or -2 when the walk ran out; then
# *windows_out says how many steps there were.
fn _hrb_select(trail, steps, label, live, windows_out): i64 {
    var i = vec_len(trail) - 1;
    var windows = 0;
    var in_window = 0;
    var boundary = 0 - 2;
    while (i >= 0 && boundary == 0 - 2) {
        var e = vec_get(trail, i);
        var op = hae_op(e);
        var next = i - 1;
        if (_hrb_cstr_eq(op, "rollback-marker") == 1) {
            var f = _hrb_from_line(e);
            if (f > 0) {
                while (next >= 0 && hae_lineno(vec_get(trail, next)) >= f) { next = next - 1; }
            } elif (steps > 0) {
                if (in_window > 0) { windows = windows + 1; in_window = 0; }
                if (windows == steps) { boundary = i; }
            } elif (_hrb_cstr_eq(hae_label(e), label) == 1) {
                boundary = i;
            }
        } elif (_hrb_reversible(op) == 1) {
            vec_push(live, i);
            in_window = in_window + 1;
        }
        i = next;
    }
    if (boundary == 0 - 2 && steps > 0) {
        if (in_window > 0) { windows = windows + 1; }
        if (windows == steps) { boundary = 0 - 1; }
    }
    store64(windows_out, windows);
    return boundary;
}

# 1 when any marker in the trail carries `label`, inside a rolled-back
# range or not.
fn _hrb_label_anywhere(trail, label): i64 {
    var i = 0;
    while (i < vec_len(trail)) {
        var e = vec_get(trail, i);
        if (_hrb_cstr_eq(hae_op(e), "rollback-marker") == 1
            && _hrb_cstr_eq(hae_label(e), label) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when `s` is printable ASCII, space through `~`.
fn _hrb_printable(s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 32 || c > 126) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Name the marker a --steps / --to run goes back to. Its label and ts come
# from the trail, where a hand edit can put any byte (the reader unescapes
# \u001b), so each is printed only in a shape hapi itself writes: a label
# that passes the label rule, a ts that is printable.
fn _hrb_say_boundary(trail, b): i64 {
    if (b < 0) { _hrb_puts("the start of the trail"); return 0; }
    var e = vec_get(trail, b);
    if (audit_label_ok(hae_label(e)) == 1) {
        _hrb_puts("checkpoint `");
        _hrb_puts(hae_label(e));
        _hrb_puts("` on line ");
    } else {
        _hrb_puts("the checkpoint on line ");
    }
    _hrb_puts(_har_itoa(hae_lineno(e)));
    if (hae_ts(e) != 0 && _hrb_printable(hae_ts(e)) == 1) {
        _hrb_puts(" (");
        _hrb_puts(hae_ts(e));
        _hrb_puts(")");
    }
    return 0;
}

# A --steps / --to walk that ran out (`_hrb_select` returned -2). Nothing
# was changed.
fn _hrb_report_unreached(trail, steps, label, windows): i64 {
    if (steps > 0) {
        if (windows == 0) {
            _hrb_puts("nothing to roll back (every entry is already rolled back)\n");
            return 0;
        }
        _hrb_eputs("hapi: --steps ");
        _hrb_eputs(_har_itoa(steps));
        _hrb_eputs(" asks for more than the trail holds: ");
        _hrb_eputs(_har_itoa(windows));
        if (windows == 1) { _hrb_eputs(" step to roll back\n"); }
        else { _hrb_eputs(" steps to roll back\n"); }
        _hrb_eputs("  nothing was changed\n");
        return 1;
    }
    if (_hrb_label_anywhere(trail, label) == 1) {
        _hrb_puts("nothing to roll back (checkpoint `");
        _hrb_puts(label);
        _hrb_puts("` is in a range already rolled back)\n");
        return 0;
    }
    _hrb_eputs("hapi: no checkpoint labelled `");
    _hrb_eputs(label);
    _hrb_eputs("` in the trail\n  nothing was changed\n");
    return 1;
}

# `steps` 0 and `to_label` 0 is the v1.0 form: back to the most recent
# marker of either kind. `steps` > 0 is --steps, `to_label` --to; the
# command line refuses both at once, and checks the label (audit_label_ok).
fn cmd_rollback_run(steps, to_label): i64 {
    # A trail that exists but will not read, or that has a malformed
    # interior line, is a conflict with the user's own history — surface
    # it rather than acting on a partial view. An ABSENT trail is still
    # Ok(empty): that is the first-run case, not a failure.
    var tr_t, tr_v = audit_read_default_r();
    if (is_err_result(tr_t) == 1) {
        var trc = tr_v;
        _hrb_eputs("hapi: ");
        _hrb_eputs(hapi_ar_err_msg(trc));
        if (trc == HapiArCorrupt) {
            _hrb_eputs(" (line ");
            _hrb_eputs(_har_itoa(audit_corrupt_line()));
            _hrb_eputs(")");
        }
        _hrb_eputs("\n  refusing to act on a partial view of the trail\n");
        return 1;
    }
    var trail = tr_v;
    var n = vec_len(trail);
    if (n == 0) {
        _hrb_eputs("hapi: audit trail is empty — nothing to roll back\n");
        return 0;
    }

    # The entries to reverse, newest first, and the index the range
    # begins at: its line is what the closing marker records as `from`.
    var idxs = vec_new();
    var first = 0;
    var b = 0;
    if (steps == 0 && to_label == 0) {
        var marker = _hrb_find_marker(trail, n - 1);
        var start = marker + 1;
        if (start >= n) {
            _hrb_puts("nothing to roll back (already at most recent marker)\n");
            return 0;
        }
        var k = n - 1;
        while (k >= start) { vec_push(idxs, k); k = k - 1; }
        first = start;
    } else {
        var windows = 0;
        b = _hrb_select(trail, steps, to_label, idxs, &windows);
        if (b == 0 - 2) { return _hrb_report_unreached(trail, steps, to_label, windows); }
        # Only --to gets here: a --steps boundary is counted only past a
        # window that holds a live entry, so its range is never empty.
        if (vec_len(idxs) == 0) {
            _hrb_puts("nothing to roll back (already at checkpoint `");
            _hrb_puts(to_label);
            _hrb_puts("`)\n");
            return 0;
        }
        first = b + 1;
    }

    # Prove the trail takes a write before reversing anything (F-055) —
    # the reversals append after they mutate, as `link` once did.
    if (hapi_dry_run() == 0) {
        var pf_t, pf_v = audit_preflight_r();
        if (is_err_result(pf_t) == 1) {
            _hrb_eputs("hapi: audit trail is not writable; refusing to roll back\n  ");
            _hrb_eputs(audit_trail_path());
            _hrb_eputs("\n  every hapi write must be auditable; nothing was changed\n");
            return 1;
        }
    }

    if (steps > 0 || to_label != 0) {
        _hrb_puts("rolling back ");
        if (steps > 0) {
            _hrb_puts(_har_itoa(steps));
            if (steps == 1) { _hrb_puts(" step, to "); }
            else { _hrb_puts(" steps, to "); }
        } else {
            _hrb_puts("to ");
        }
        _hrb_say_boundary(trail, b);
        _hrb_puts("\n");
    }

    var applied = 0;
    var skipped = 0;
    var errored = 0;
    var stop = 0;

    var x = 0;
    while (x < vec_len(idxs) && stop == 0) {
        var entry = vec_get(trail, vec_get(idxs, x));
        var op = hae_op(entry);
        var rc = 0;
        var dr_suffix = "";
        if (hapi_dry_run() == 1) { dr_suffix = "; dry-run"; }

        if (_hrb_cstr_eq(op, "link") == 1) {
            rc = _hrb_reverse_link(entry);
            if (rc < 0 - 1) {
                _hrb_report_unwritten(entry, rc,
                  "the link is removed and the trail still calls it live");
                errored = errored + 1;
                stop = 1;
            } elif (rc == 1) {
                _hrb_puts("  - ");
                _hrb_puts(hae_abs_target(entry));
                _hrb_puts("  (was link");
                _hrb_puts(dr_suffix);
                _hrb_puts(")\n");
                applied = applied + 1;
                # The directories this link's creation made (1.4.0). Per
                # entry is enough here: rollback runs newest first, so a
                # link that reused a directory is reversed before the
                # link that made it.
                if (hapi_dry_run() == 0) {
                    var gone = vec_new();
                    fsl_rmdir_created(hae_abs_target(entry), hae_created_dir(entry), gone);
                    var g = 0;
                    while (g < vec_len(gone)) { fsl_print_removed_dir(vec_get(gone, g)); g = g + 1; }
                }
            } elif (rc == 0) {
                skipped = skipped + 1;
            } else {
                _hrb_eputs("  ! ");
                _hrb_eputs(hae_abs_target(entry));
                _hrb_eputs("  (IO error reversing link)\n");
                errored = errored + 1;
            }
        } elif (_hrb_cstr_eq(op, "unlink") == 1) {
            rc = _hrb_reverse_unlink(entry);
            if (rc < 0 - 1) {
                _hrb_report_unwritten(entry, rc,
                  "the link is re-created and the trail does not record it");
                errored = errored + 1;
                stop = 1;
            } elif (rc == 1) {
                _hrb_puts("  + ");
                _hrb_puts(hae_abs_target(entry));
                _hrb_puts("  (was unlink");
                _hrb_puts(dr_suffix);
                _hrb_puts(")\n");
                applied = applied + 1;
            } elif (rc == 0) {
                skipped = skipped + 1;
            } else {
                _hrb_eputs("  ! ");
                _hrb_eputs(hae_abs_target(entry));
                _hrb_eputs("  (IO error reversing unlink)\n");
                errored = errored + 1;
            }
        } elif (_hrb_cstr_eq(op, "adopt") == 1) {
            rc = _hrb_reverse_adopt(entry);
            if (rc < 0 - 1) {
                _hrb_report_unwritten(entry, rc,
                  "the file is back and its row removed, but the trail still says adopted");
                errored = errored + 1;
                stop = 1;
            }
            if (rc == 2) { errored = errored + 1; }
            if (rc == 1 || rc == 2) {
                _hrb_puts("  ~ ");
                _hrb_puts(hae_abs_target(entry));
                _hrb_puts("  (was adopt; file restored");
                _hrb_puts(dr_suffix);
                _hrb_puts(")\n");
                applied = applied + 1;
            } elif (rc == 0) {
                skipped = skipped + 1;
            } elif (rc == 0 - 1) {
                _hrb_eputs("  ! ");
                _hrb_eputs(hae_abs_target(entry));
                _hrb_eputs("  (IO error reversing adopt)\n");
                errored = errored + 1;
            }
        }
        # rollback-marker entries are stopping points, not
        # reversible ops — they fall through silently. We
        # already excluded those before `start` via _hrb_find_marker.
        # `unadopt` entries are the synthetic reverse-of-adopt
        # records; rollback ignores them (they exist for forward
        # replay, not for re-reversal — same pattern as
        # unlink-entries-after-link rollback).
        x = x + 1;
    }

    _hrb_puts("rolled back ");
    fmt_int(applied);
    _hrb_puts(" / ");
    fmt_int(vec_len(idxs));
    _hrb_puts(" entries");
    if (skipped > 0) {
        _hrb_puts(" (");
        fmt_int(skipped);
        _hrb_puts(" already at expected state)");
    }
    _hrb_puts("\n");

    # Seal the window (F-056). With no marker the window is the whole
    # trail — including the entries a previous rollback appended — so a
    # second run reversed those too, then a third the second's: the same
    # end state, but 2, 4, 8 … reversals and a trail doubling every run.
    # The guide promised "a second run … does nothing". A marker here,
    # the entry `checkpoint` writes, makes that true. Only after a clean
    # run that changed something: an errored one is meant to be re-run.
    #
    # Since 1.5.0 the marker records `from`, the line the range began on,
    # so --steps and --to can step over what this run undid. They also seal
    # a range in which nothing needed reversing: their walk passes a sealed
    # range, so the next `--steps 1` moves on to the window before instead
    # of finding this one again. The no-arg form keeps its rule.
    var seal = 0;
    if (hapi_dry_run() == 0 && errored == 0) {
        if (applied > 0) { seal = 1; }
        if (steps > 0 || to_label != 0) { seal = 1; }
    }
    if (seal == 1) {
        var from = _har_itoa(hae_lineno(vec_get(trail, first)));
        var mk_t, mk_v = audit_append_marker_r(0, from);
        if (is_err_result(mk_t) == 1) {
            _hrb_eputs("hapi: rolled back, but could not append the closing marker\n");
            _hrb_eputs("  (a later rollback would re-reverse this run's entries)\n");
            return 1;
        }
    }
    if (errored > 0) { return 1; }
    return 0;
}
