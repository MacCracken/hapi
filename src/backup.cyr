# backup.cyr — opt-in pre-`--force` file snapshots.
#
# When `--backup-to <dir>` is set on the command line, the
# mutating verbs (link --force, sync --force, adopt) snapshot
# the existing on-disk file content to a timestamped path under
# <dir> *before* the destructive step (unlink / rename). The
# audit-trail entry gains an additive `backup_path` field per
# ADR 0002's growth contract.
#
# Filename shape: <YYYYMMDD-HHMMSS>-<pkg>-<basename>. The
# timestamp is the local wall clock at snapshot time; the pkg
# tag disambiguates concurrent backups across packages; the
# basename keeps human reviewers oriented.
#
# Process-wide state mirrors the dry-run setter/getter pattern
# in `cli.cyr`. Tests flip `_hapi_backup_dir` via the setter;
# the dispatcher sets it from `--backup-to <path>` in main();
# nobody else.

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/chrono.cyr"
include "src/fs_link.cyr"
include "src/agnos_compat.cyr"   # hapi_cstr_eq
include "src/dry_run.cyr"

var _hapi_backup_dir = 0;

fn hapi_set_backup_dir(d): i64 { _hapi_backup_dir = d; return 0; }
fn hapi_backup_dir(): i64 { return _hapi_backup_dir; }

# Build the timestamp half of the backup filename — 15 chars,
# format "YYYYMMDD-HHMMSS". Heap-allocated, null-terminated.
fn _hbk_ts(): i64 {
    var d = epoch_to_date(clock_epoch_secs());
    var out = alloc(16);
    var y  = load64(d);
    var mo = load64(d + 8);
    var dy = load64(d + 16);
    var hr = load64(d + 24);
    var mn = load64(d + 32);
    var sc = load64(d + 40);
    store8(out,      48 + y / 1000);
    store8(out + 1,  48 + (y / 100) % 10);
    store8(out + 2,  48 + (y / 10) % 10);
    store8(out + 3,  48 + y % 10);
    store8(out + 4,  48 + mo / 10);
    store8(out + 5,  48 + mo % 10);
    store8(out + 6,  48 + dy / 10);
    store8(out + 7,  48 + dy % 10);
    store8(out + 8,  45);                   # -
    store8(out + 9,  48 + hr / 10);
    store8(out + 10, 48 + hr % 10);
    store8(out + 11, 48 + mn / 10);
    store8(out + 12, 48 + mn % 10);
    store8(out + 13, 48 + sc / 10);
    store8(out + 14, 48 + sc % 10);
    store8(out + 15, 0);
    return out;
}

# Basename of `path` (everything after the last `/`). Returns a
# heap-allocated cstring. "/foo" → "foo"; "x" → "x"; "/a/" → "".
fn _hbk_basename(path): i64 {
    var n = strlen(path);
    var last = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    var start = last + 1;
    var len = n - start;
    var out = alloc(len + 1);
    memcpy(out, path + start, len);
    store8(out + len, 0);
    return out;
}

# Compose the destination backup path:
#   <dir>/<ts>-<pkg>-<basename(src_path)>
# Inserts a `/` between <dir> and the tail only if <dir> doesn't
# already end in one. Returns a heap cstring.
# Reduce a manifest-supplied [package].name to ONE filename-safe path
# component. `[package].name` is validated only for non-emptiness, so it
# is PACKAGE-chosen input to a path hapi is about to write: a name of
# `../../../../pwned` put the snapshot of the user's file above the
# directory the user named with --backup-to (F-020).
#
# This is NOT a capability check — `--backup-to`'s destination is
# deliberately uncapped (the USER typed it, and pointing it at /tmp or
# an external drive is legitimate). What is restored here is that the
# directory the user named is the one that receives the bytes.
#
# Sanitize rather than refuse: `hapi_backup_compose_path` has no error
# channel, and both callers read 0 as "no backup requested" — so
# refusing would SILENTLY SKIP the snapshot at exactly the moment the
# original is about to be deleted.
fn _hbk_safe_tag(pkg): i64 {
    var n = 0;
    if (pkg != 0) { n = strlen(pkg); }
    if (n == 0) {
        var d = alloc(4);
        memcpy(d, "pkg", 3);
        store8(d + 3, 0);
        return d;
    }
    var out = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var c = load8(pkg + i);
        var ok = 0;
        if (c >= 97 && c <= 122) { ok = 1; }            # a-z
        if (c >= 65 && c <= 90)  { ok = 1; }            # A-Z
        if (c >= 48 && c <= 57)  { ok = 1; }            # 0-9
        if (c == 46 || c == 95 || c == 45) { ok = 1; }  # . _ -
        if (ok == 1) { store8(out + i, c); }
        else { store8(out + i, 95); }                   # _
        i = i + 1;
    }
    store8(out + n, 0);
    # A leading '.' would hide the snapshot, and is the only way a
    # sanitized tag could still read as "." or "..".
    if (load8(out) == 46) { store8(out, 95); }
    return out;
}

fn _hbk_compose_base(dir, pkg, src_path): i64 {
    var ts = _hbk_ts();
    var bn = _hbk_basename(src_path);
    var tag = _hbk_safe_tag(pkg);
    var dl = strlen(dir);
    var tl = strlen(ts);
    var pl = strlen(tag);
    var bl = strlen(bn);
    # The name fits NAME_MAX with room for a `-NNN` suffix (F-110):
    # through 1.7.0 a long basename made --backup-to refuse a file plain
    # adopt or link --force handled. The basename's end is kept.
    var room = 255 - 4 - tl - 1 - pl - 1;
    if (room < 16) { room = 16; }
    if (bl > room) {
        bn = bn + (bl - room);
        bl = room;
    }
    var sep = 1;
    if (dl > 0 && load8(dir + dl - 1) == 47) { sep = 0; }
    var total = dl + sep + tl + 1 + pl + 1 + bl + 1;
    var out = alloc(total);
    var pos = 0;
    memcpy(out, dir, dl); pos = dl;
    if (sep == 1) { store8(out + pos, 47); pos = pos + 1; }
    memcpy(out + pos, ts, tl); pos = pos + tl;
    store8(out + pos, 45); pos = pos + 1;   # -
    memcpy(out + pos, tag, pl); pos = pos + pl;
    store8(out + pos, 45); pos = pos + 1;   # -
    memcpy(out + pos, bn, bl); pos = pos + bl;
    store8(out + pos, 0);
    return out;
}

# Public composer: the base name above, made unique.
#
# The base is <ts>-<pkg>-<basename>, so two manifest rows whose targets
# share a basename (`a/config` and `b/config`) compose the SAME path
# within one second. That silently destroyed the first snapshot — the
# very bytes --force was about to delete — and left both audit entries
# pointing `backup_path` at the survivor. Suffix `-2`, `-3`, ... until
# the name is free, so the earlier snapshot survives AND the path
# recorded in the trail names the file that actually holds these bytes.
#
# The O_EXCL open in hapi_backup_copy is the backstop for the residual
# race between this probe and the create.
# The names a dry run has composed. Nothing is copied under --dry-run, so
# the probe alone gave two same-named files one snapshot path, where the
# real run gives the second `-2` (finding 43). Both are taken here.
var _hbk_planned = 0;

fn _hbk_taken(p): i64 {
    if (link_probe_kind(link_probe(p)) != HAPI_LP_ABSENT) { return 1; }
    if (_hbk_planned == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_hbk_planned)) {
        if (hapi_cstr_eq(vec_get(_hbk_planned, i), p) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _hbk_plan(p): i64 {
    if (hapi_dry_run() == 1) {
        if (_hbk_planned == 0) { _hbk_planned = vec_new(); }
        vec_push(_hbk_planned, p);
    }
    return p;
}

fn hapi_backup_compose_path(dir, pkg, src_path): i64 {
    var base = _hbk_compose_base(dir, pkg, src_path);
    if (_hbk_taken(base) == 0) { return _hbk_plan(base); }

    var bl = strlen(base);
    var out = base;
    var k = 2;
    var go = 1;
    while (go == 1) {
        # "-" + up to 3 decimal digits + NUL
        var cand = alloc(bl + 6);
        memcpy(cand, base, bl);
        var p2 = bl;
        store8(cand + p2, 45); p2 = p2 + 1;        # -
        if (k >= 100) {
            store8(cand + p2, 48 + k / 100); p2 = p2 + 1;
        }
        if (k >= 10) {
            var t = k / 10;
            store8(cand + p2, 48 + t - (t / 10) * 10); p2 = p2 + 1;
        }
        store8(cand + p2, 48 + k - (k / 10) * 10); p2 = p2 + 1;
        store8(cand + p2, 0);
        if (_hbk_taken(cand) == 0) {
            out = cand;
            go = 0;
        } else {
            k = k + 1;
            # Give up rather than spin; O_EXCL then refuses the copy
            # loudly instead of overwriting.
            if (k > 999) { out = cand; go = 0; }
        }
    }
    return _hbk_plan(out);
}

# Byte-copy a regular file from `src` to `dst`. mkdir -p the
# parent of `dst` first. Returns 0 on success or a negative
# errno on the first IO failure. 8 KiB read buffer; loop to
# handle short writes.
#
# Source open uses O_NOFOLLOW so a TOCTOU race that swaps the
# regular file for a symlink between the link/adopt probe and
# the copy fails with ELOOP rather than leaking the symlink
# target's content into the backup. The caller's probe already
# verified the path is a regular file; O_NOFOLLOW makes the
# property survive the race window.
fn hapi_backup_copy(src, dst): i64 {
    # Private (0700) parents on purpose. Since 1.7.1 a snapshot also
    # keeps its source's permission bits (F-084): through 1.7.0 it was
    # always 0644, so a 0600 secret was world-readable in a backup
    # directory that already existed.
    var mkrc = fsl_mkdir_parents(dst);
    if (mkrc < 0) { return mkrc; }
    # Via the shim: Linux/macOS get atomic O_NOFOLLOW, agnos gets a
    # readlink pre-check because it has no no-follow flag at all (F-031).
    # A FIFO's open does not block with O_NONBLOCK; its read would
    # (F-091). Only a regular file has bytes to keep. agnos has neither
    # the flag nor fstat here: it asks stat before the open.
    #ifdef CYRIUS_TARGET_AGNOS
    if (fsl_is_regular(src) == 0) { return 0 - 22; }
    var rfd = hapi_open_nofollow(src, O_RDONLY);
    if (rfd < 0) { return rfd; }
    #else
    var rfd = hapi_open_nofollow(src, O_RDONLY | O_NONBLOCK);
    if (rfd < 0) { return rfd; }
    var fst = alloc(STAT_BUFSZ);
    if (sys_fstat(rfd, fst) < 0 || (load64(fst + STAT_MODE) & 0xF000) != 0x8000) {
        file_close(rfd);
        return 0 - 22;
    }
    #endif
    # O_EXCL, not O_TRUNC: the destination name is
    # <ts>-<pkg>-<basename>, so two manifest rows whose targets share a
    # basename (`a/config` and `b/config`) compose the SAME path inside
    # one second. With O_TRUNC the second copy silently overwrote the
    # first — destroying exactly the bytes `--force` was about to
    # delete, while both audit entries recorded the same `backup_path`,
    # so the trail pointed at the surviving snapshot for both. Failing
    # closed on an existing destination matches hapi's stated rule that
    # conflicts surface explicitly rather than overwrite.
    var mode = 0x180;                            # 0600: agnos has no fstat here
    #ifndef CYRIUS_TARGET_AGNOS
    var st = alloc(STAT_BUFSZ);
    if (sys_fstat(rfd, st) >= 0) { mode = load64(st + STAT_MODE) & 0x1FF; }
    #endif
    var wfd = file_open(dst, O_WRONLY | O_CREAT | O_EXCL, mode);
    if (wfd < 0) { file_close(rfd); return wfd; }
    var buf = alloc(8192);
    var go = 1;
    var err = 0;
    while (go == 1) {
        var n = file_read(rfd, buf, 8192);
        if (n < 0) { err = n; go = 0; }
        elif (n == 0) { go = 0; }
        else {
            var wp = 0;
            while (wp < n && err == 0) {
                var w = file_write(wfd, buf + wp, n - wp);
                # w == 0 must be an error, not a retry: `err = w` would
                # leave err at 0 and spin here forever.
                if (w == 0) { err = 0 - 5; }          # EIO
                elif (w < 0) { err = w; }
                else { wp = wp + w; }
            }
            if (err != 0) { go = 0; }
        }
    }
    file_close(rfd);
    # On disk before the step it guards deletes the original (F-084).
    if (err == 0) {
        var frc = xfsync(wfd);
        if (frc < 0) { err = frc; }
    }
    # The backup is the last copy of bytes --force is about to delete,
    # so a write error surfaced only at close must not be discarded.
    var crc = file_close(wfd);
    if (err == 0 && crc < 0) { err = crc; }
    # A copy that failed is not left under a name that looks whole
    # (F-084). The name is this call's: O_EXCL created it.
    if (err != 0) { hapi_unlink(dst); }
    return err;
}
