# audit.cyr — append-only audit trail writer.
#
# Implements ADR 0002 (`docs/adr/0002-audit-trail-format.md`).
# Format: JSON Lines at `$XDG_STATE_HOME/hapi/audit.jsonl`
# (or `$HOME/.local/state/hapi/audit.jsonl` when unset).
#
# Write path: single `write(2)` per entry, gated by flock so two
# concurrent hapi processes don't interleave half-lines. PIPE_BUF is
# not the guarantee here — it bounds atomic writes to PIPES, not regular
# files (and is 512 on agnos). What holds is O_APPEND plus the flock on
# Linux, and the flock plus an explicit SEEK_END on agnos, whose kernel
# does not honour AO_APPEND. A crash mid-write can still leave a torn
# final line: the reader drops it, and the next append refuses to write
# onto it (see _audit_append_durable).
#
# M3 (`unlink`, `rollback`) layers the *reader* on top of this
# same file; nothing in this module needs to change for M3.

include "lib/io.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/sha1.cyr"
include "lib/chrono.cyr"
include "lib/result.cyr"
include "src/manifest.cyr"

enum HapiAuditError {
    HapiAuditMkdirFailed;
    HapiAuditOpenFailed;
    HapiAuditWriteFailed;
}

# Default audit-trail path under XDG_STATE_HOME (or
# $HOME/.local/state when unset). Returns a heap-allocated
# null-terminated cstring. May be overridden by tests via
# `audit_set_trail_path()` — that path takes precedence.
fn _audit_default_path(): i64 {
    var xdg = getenv("XDG_STATE_HOME");
    var base = 0;
    if (xdg != 0 && strlen(xdg) > 0) {
        base = xdg;
    } else {
        var home = getenv("HOME");
        if (home == 0 || strlen(home) == 0) {
            # Last-ditch fallback. Better than crashing.
            home = "/tmp";
        }
        var hlen = strlen(home);
        var suffix = "/.local/state";
        var slen = 13;
        base = alloc(hlen + slen + 1);
        memcpy(base, home, hlen);
        memcpy(base + hlen, suffix, slen);
        store8(base + hlen + slen, 0);
    }
    var blen = strlen(base);
    var tail = "/hapi/audit.jsonl";
    var tlen = 17;
    var out = alloc(blen + tlen + 1);
    memcpy(out, base, blen);
    memcpy(out + blen, tail, tlen);
    store8(out + blen + tlen, 0);
    return out;
}

# Test/CI override: when set, `audit_trail_path()` returns this
# instead of the XDG-default. The value MUST be a path to a
# .jsonl file under a directory hapi is allowed to create.
# Reset to 0 to restore default behavior.
var _audit_override_path = 0;

fn audit_set_trail_path(path): i64 {
    _audit_override_path = path;
    return 0;
}

fn audit_trail_path(): i64 {
    if (_audit_override_path != 0) { return _audit_override_path; }
    return _audit_default_path();
}

# Recursively mkdir the parent of `file_path`. Treats EEXIST
# (errno 17) as success. Returns 0 on success, negative on
# failure of any single mkdir.
fn _audit_mkdir_parents(file_path): i64 {
    var n = strlen(file_path);
    # Walk forward, mkdir at each `/` we hit (except position 0).
    # Stop before the final component (the file itself).
    var last_slash = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(file_path + i) == 47) { last_slash = i; }
        i = i + 1;
    }
    if (last_slash <= 0) { return 0; }

    # Walk every intermediate '/' from left to right, mkdir each
    # accumulated prefix. We pass a temporary buffer where the
    # slash gets temporarily replaced by '\0' so the mkdir sees
    # only the prefix.
    var tmp = alloc(n + 1);
    memcpy(tmp, file_path, n);
    store8(tmp + n, 0);

    var j = 1;
    while (j <= last_slash) {
        if (load8(tmp + j) == 47) {
            store8(tmp + j, 0);
            var rc = hapi_mkdir(tmp, 0x1C0);   # 0700
            if (rc < 0) {
                # EEXIST = 17. Anything else is fatal.
                var err = 0 - rc;
                if (err != 17) { return rc; }
            }
            store8(tmp + j, 47);
        }
        j = j + 1;
    }
    # Final mkdir for the parent itself (everything up to last_slash).
    store8(tmp + last_slash, 0);
    var rc = hapi_mkdir(tmp, 0x1C0);
    if (rc < 0) {
        var err = 0 - rc;
        if (err != 17) { return rc; }
    }
    return 0;
}

# Ensure the trail's parent directory exists. Returns 0 on
# success, Err(...) shape encoded as a negative value otherwise.
fn audit_ensure_dir(): i64 {
    var path = audit_trail_path();
    return _audit_mkdir_parents(path);
}

# JSON-escape a single byte into `out`, returning bytes written.
# Out buffer must have >= 6 bytes (worst case: `\uXXXX`).   #skip-lint
fn _audit_json_escape_byte(c, out): i64 {
    if (c == 34) { store8(out, 92); store8(out + 1, 34); return 2; }
    if (c == 92) { store8(out, 92); store8(out + 1, 92); return 2; }
    if (c == 10) { store8(out, 92); store8(out + 1, 110); return 2; }
    if (c == 13) { store8(out, 92); store8(out + 1, 114); return 2; }
    if (c == 9)  { store8(out, 92); store8(out + 1, 116); return 2; }
    if (c < 32) {
        # \u00XX
        store8(out, 92);
        store8(out + 1, 117);
        store8(out + 2, 48);
        store8(out + 3, 48);
        var hi = c / 16;
        var lo = c - hi * 16;
        if (hi < 10) { store8(out + 4, 48 + hi); } else { store8(out + 4, 87 + hi); }
        if (lo < 10) { store8(out + 5, 48 + lo); } else { store8(out + 5, 87 + lo); }
        return 6;
    }
    store8(out, c);
    return 1;
}

# Entry-composition overflow flag. Set by the bounded writers when a
# write would pass `cap`; `_audit_format_link_op` clears it on entry and
# turns it into a refusal on exit.
#
# A refusal, never a truncation: a short line has no `\n`, so the next
# genuine entry concatenates onto it and the reader drops BOTH. Losing
# the trail is worse than refusing the write, and refusing is already an
# enumerated outcome (`hapi: audit-trail write failed`, exit 1).
var _audit_ovf = 0;

# Write one byte at *pos_ptr if it fits in `cap`; else set the flag.
fn _audit_put8(out, pos_ptr, cap, c): i64 {
    var pos = load64(pos_ptr);
    if (pos + 1 > cap) { _audit_ovf = 1; return 0; }
    store8(out + pos, c);
    store64(pos_ptr, pos + 1);
    return 0;
}

# Copy `n` bytes at *pos_ptr if they fit in `cap`; else set the flag.
fn _audit_putn(out, pos_ptr, cap, src, n): i64 {
    var pos = load64(pos_ptr);
    if (pos + n > cap) { _audit_ovf = 1; return 0; }
    memcpy(out + pos, src, n);
    store64(pos_ptr, pos + n);
    return 0;
}

# Emit a JSON string field — `"key":"value"` — into out at *pos.
# `value` is a cstring; null is rendered as empty string. Every write is
# bounded by `cap`; the escape writer can emit up to 6 bytes per input
# byte (`\u00XX`), so the per-byte headroom check reserves 6.
fn _audit_emit_field(out, pos_ptr, cap, key, value): i64 {
    _audit_put8(out, pos_ptr, cap, 34);
    _audit_putn(out, pos_ptr, cap, key, strlen(key));
    _audit_put8(out, pos_ptr, cap, 34);
    _audit_put8(out, pos_ptr, cap, 58);
    _audit_put8(out, pos_ptr, cap, 34);
    if (value != 0) {
        var vlen = strlen(value);
        var i = 0;
        while (i < vlen) {
            var pos = load64(pos_ptr);
            if (pos + 6 > cap) {
                _audit_ovf = 1;
                i = vlen;
                continue;
            }
            var c = load8(value + i);
            store64(pos_ptr, pos + _audit_json_escape_byte(c, out + pos));
            i = i + 1;
        }
    }
    _audit_put8(out, pos_ptr, cap, 34);
    return 0;
}

fn _audit_emit_comma(out, pos_ptr, cap): i64 {
    return _audit_put8(out, pos_ptr, cap, 44);
}

# Upper bound on the composed length of a link-shape entry. Every value
# is counted at 6x for worst-case `\u00XX` control-byte escaping, plus
# the fixed key/punctuation overhead and the ISO-8601 `ts`. A sizing
# hint, not the safety mechanism — the bounded writers are that.
fn _audit_vlen(v): i64 {
    if (v == 0) { return 0; }
    return strlen(v);
}

fn audit_entry_size(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path): i64 {
    var n = 256;                       # `{`, `ts`, `op`, keys, commas, `}\n`
    n = n + 6 * _audit_vlen(pkg);
    n = n + 6 * _audit_vlen(pkg_version);
    n = n + 6 * _audit_vlen(manifest_hash);
    n = n + 6 * _audit_vlen(source);
    n = n + 6 * _audit_vlen(target);
    n = n + 6 * _audit_vlen(abs_source);
    n = n + 6 * _audit_vlen(abs_target);
    n = n + 6 * _audit_vlen(backup_path);
    return n;
}

# Compose a single audit-trail line for a link-shape op into
# `out`. Used by every per-op formatter — same field set,
# different `op` value. Returns bytes written. Field order is
# fixed per ADR 0002. `backup_path` is appended as an additive
# field per the ADR's growth contract when non-zero / non-empty;
# otherwise the entry shape is identical to the v0.7.0 format.
fn _audit_format_link_op(out, cap, op, pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path, created_dir, shape): i64 {
    var pos = 0;
    _audit_ovf = 0;
    var ts = iso8601_now();
    _audit_put8(out, &pos, cap, 123);          # {
    _audit_emit_field(out, &pos, cap, "ts", ts);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "op", op);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "pkg", pkg);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "pkg_version", pkg_version);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "manifest_hash", manifest_hash);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "source", source);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "target", target);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "abs_source", abs_source);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "abs_target", abs_target);
    if (backup_path != 0 && strlen(backup_path) > 0) {
        _audit_emit_comma(out, &pos, cap);
        _audit_emit_field(out, &pos, cap, "backup_path", backup_path);
    }
    # 1.4.0 (ADR 0002 addendum): the outermost directory this link's
    # creation made. Last, and only when it made one, so every other
    # entry is byte-identical to 1.3.0's.
    if (created_dir != 0 && strlen(created_dir) > 0) {
        _audit_emit_comma(out, &pos, cap);
        _audit_emit_field(out, &pos, cap, "created_dir", created_dir);
    }
    # 1.6.0 (ADR 0002 addendum): "absolute" when the entry's link text is
    # absolute (`--absolute`); no field for the relative default.
    if (shape != 0 && strlen(shape) > 0) {
        _audit_emit_comma(out, &pos, cap);
        _audit_emit_field(out, &pos, cap, "shape", shape);
    }
    _audit_put8(out, &pos, cap, 125);         # }
    _audit_put8(out, &pos, cap, 10);          # \n
    if (_audit_ovf == 1) { return 0 - 1; }
    return pos;
}

# Compose a link entry. Bytes returned; output is single JSON
# object + `\n`. Field order per ADR 0002. `backup_path` is an
# optional additive field — pass 0 when --backup-to was off.
fn audit_format_link(out, cap, pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path): i64 {
    return _audit_format_link_op(out, cap, "link",
      pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, backup_path, 0, 0);
}

# A link entry carrying `created_dir` (1.4.0): the outermost directory the
# link's creation made, or 0 when it made none (then identical to
# audit_format_link).
fn audit_format_link_created(out, cap, pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path, created_dir): i64 {
    return _audit_format_link_op(out, cap, "link",
      pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, backup_path, created_dir, 0);
}

# A link entry with every additive field: `created_dir` (1.4.0) and
# `shape` (1.6.0; "absolute", or 0 for the relative default).
fn audit_format_link_full(out, cap, pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path, created_dir, shape): i64 {
    return _audit_format_link_op(out, cap, "link",
      pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, backup_path, created_dir, shape);
}

# Compose an unlink entry. Same shape as link with op="unlink".
# No `backup_path` field on unlink — there's no destructive
# overwrite to snapshot.
fn audit_format_unlink(out, cap, pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target): i64 {
    return _audit_format_link_op(out, cap, "unlink",
      pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0, 0, 0);
}

# Compose an adopt entry. Same shape as link with op="adopt".
# Per ADR 0004 adopt records as a single atomic entry.
# `backup_path` is an optional additive field as on link.
fn audit_format_adopt(out, cap, pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path): i64 {
    return _audit_format_link_op(out, cap, "adopt",
      pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, backup_path, 0, 0);
}

# Compose an unadopt entry — the rollback-reverse of adopt.
# Same shape; op="unadopt". No backup_path field — rollback
# reverses a move; nothing is destructively overwritten.
fn audit_format_unadopt(out, cap, pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target): i64 {
    return _audit_format_link_op(out, cap, "unadopt",
      pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0, 0, 0);
}

# Compose a rollback-marker entry. Minimal fields — just `ts`
# and `op`. Used to delimit rollback windows (ADR 0002).
fn audit_format_rollback_marker(out, cap): i64 {
    return audit_format_marker(out, cap, 0, 0);
}

# A rollback-marker with its 1.5.0 additive fields (ADR 0002, 1.5.0
# addendum), each written only when given, so a plain marker is
# byte-identical to 1.4.0's. `label` is what `checkpoint --label` names it;
# `from` (a decimal cstring) is the line a rollback's range began on, on
# the closing marker rollback writes. A marker carries one or neither.
fn audit_format_marker(out, cap, label, from): i64 {
    var pos = 0;
    _audit_ovf = 0;
    var ts = iso8601_now();
    _audit_put8(out, &pos, cap, 123);
    _audit_emit_field(out, &pos, cap, "ts", ts);
    _audit_emit_comma(out, &pos, cap);
    _audit_emit_field(out, &pos, cap, "op", "rollback-marker");
    if (label != 0 && strlen(label) > 0) {
        _audit_emit_comma(out, &pos, cap);
        _audit_emit_field(out, &pos, cap, "label", label);
    }
    if (from != 0 && strlen(from) > 0) {
        _audit_emit_comma(out, &pos, cap);
        _audit_emit_field(out, &pos, cap, "from", from);
    }
    _audit_put8(out, &pos, cap, 125);
    _audit_put8(out, &pos, cap, 10);
    if (_audit_ovf == 1) { return 0 - 1; }
    return pos;
}

# 1 when `label` is a checkpoint label: 1 to 64 bytes of A-Z a-z 0-9
# `.` `_` `-`, not starting with `-` (it would read as a flag). Narrow on
# purpose: rollback prints labels back, and matches them byte for byte.
fn audit_label_ok(label): i64 {
    if (label == 0) { return 0; }
    var n = strlen(label);
    if (n == 0 || n > 64) { return 0; }
    if (load8(label) == 45) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(label + i);
        var ok = 0;
        if (c >= 65 && c <= 90) { ok = 1; }          # A-Z
        if (c >= 97 && c <= 122) { ok = 1; }         # a-z
        if (c >= 48 && c <= 57) { ok = 1; }          # 0-9
        if (c == 46 || c == 95 || c == 45) { ok = 1; }   # . _ -
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Append a formatted entry to the audit trail. Shared core
# used by the link / unlink / rollback-marker callers.
# Durable append. `lib/io.cyr`'s `file_append_locked` does
# open/lock/write/unlock/close with no fsync and no close-return check,
# and lib/ is a pinned snapshot we do not edit — so hapi appends the
# trail itself, out of the same public primitives, portable across all
# three targets with no raw syscall.
#
# Two properties `file_append_locked` does not give us (F-018):
#   - **fsync before the lock is dropped.** The symlink metadata op is
#     journalled within ~5 s on ext4 while a dirty trail page can sit up
#     to `dirty_expire_centisecs` (30 s), so a power loss in that window
#     left a link on disk that no recovery verb could see.
#   - **a torn-tail guard.** If the last byte of the trail is not `\n`,
#     a previous write was interrupted; appending onto it would splice
#     two entries into one line and the reader would drop BOTH. Refuse
#     instead, and let the caller say so.
# The close return is checked too: a write error that surfaces only at
# close must not read as success.
fn _audit_append_durable(path, buf, n): i64 {
    var flags = O_RDWR | O_CREAT;
    #ifndef CYRIUS_TARGET_AGNOS
    flags = flags | O_APPEND;
    #endif
    var fd = file_open(path, flags, 0x1A4);
    if (fd < 0) { return fd; }
    # The lock is what makes the append atomic on agnos (no AO_APPEND
    # there), so an append without it is refused, not attempted. agnos's
    # flock#59 can fail: a non-ext2 fd, or a full 16-slot lock table.
    if (file_lock(fd) < 0) {
        file_close(fd);
        return 0 - 5;
    }

    var end = xlseek(fd, 0, 2);                 # SEEK_END
    if (end > 0) {
        var probe = alloc(1);
        xlseek(fd, end - 1, 0);                 # SEEK_SET
        var r = file_read(fd, probe, 1);
        xlseek(fd, 0, 2);
        if (r != 1 || load8(probe) != 10) {
            file_unlock(fd);
            file_close(fd);
            return 0 - 5;                       # torn tail — refuse
        }
    }

    if (n == 0) {                               # pre-flight probe only
        file_unlock(fd);
        var crc0 = file_close(fd);
        if (crc0 < 0) { return crc0; }
        return 0;
    }

    var w = file_write(fd, buf, n);
    var frc = 0;
    if (w == n) { frc = xfsync(fd); }
    file_unlock(fd);
    var crc = file_close(fd);
    if (w < 0) { return w; }
    if (w != n) { return 0 - 5; }
    if (frc < 0) { return frc; }
    if (crc < 0) { return crc; }
    return w;
}

# Can the trail be appended to at all? Opens, locks, runs the torn-tail
# guard, writes nothing. Lets a mutating verb refuse BEFORE it touches
# the filesystem, instead of discovering the trail is unwritable after
# the symlink is already on disk.
fn audit_preflight_r(): Result {
    var mkrc = audit_ensure_dir();
    if (mkrc < 0) { return Err(HapiAuditMkdirFailed); }
    var rc = _audit_append_durable(audit_trail_path(), "", 0);
    if (rc < 0) { return Err(HapiAuditWriteFailed); }
    return Ok(0);
}

# Test hook: when 1, every append is refused as a failed write, while the
# pre-flight still passes — the window F-061 is about, which a test cannot
# open any other way without raw syscalls (an RLIMIT_FSIZE between the
# pre-flight and the append). 0 in the binary; nothing but tests sets it.
var _audit_fail_appends = 0;
fn audit_test_fail_appends(on): i64 { _audit_fail_appends = on; return 0; }

# F-061: report a mutation whose trail entry could not be written, after
# the pre-flight passed (a full disk, a file-size limit). `undone` = 1
# when the caller took the mutation back; otherwise `left` says what is
# on disk and unrecorded. Callers stop the run after this: the trail
# that refused one entry will refuse the next.
fn audit_report_unwritten(abs_tgt, undone, left): i64 {
    var t0 = "hapi: audit-trail write failed for ";
    eprint(t0, strlen(t0));
    eprint(abs_tgt, strlen(abs_tgt));
    if (undone == 1) {
        var t1 = "\n  it was taken back; this run left nothing unrecorded\n";
        eprint(t1, strlen(t1));
    } else {
        var t2 = "\n  it was NOT taken back: ";
        eprint(t2, strlen(t2));
        eprint(left, strlen(left));
        eprint("\n", 1);
    }
    var t3 = "  nothing after it was touched\n";
    eprint(t3, strlen(t3));
    return 0;
}

fn _audit_append_bytes(buf, n): Result {
    if (_audit_fail_appends == 1) { return Err(HapiAuditWriteFailed); }
    # A composer that overflowed its buffer returns -1. Refuse the
    # write rather than handing a negative length to the writer: a
    # truncated line has no `\n`, so the next entry would concatenate
    # onto it and the reader would drop both.
    if (n <= 0) { return Err(HapiAuditWriteFailed); }
    var mkrc = audit_ensure_dir();
    if (mkrc < 0) { return Err(HapiAuditMkdirFailed); }
    var path = audit_trail_path();
    var wrc = _audit_append_durable(path, buf, n);
    if (wrc < 0) { return Err(HapiAuditWriteFailed); }
    if (wrc != n) { return Err(HapiAuditWriteFailed); }
    return Ok(n);
}

fn audit_append_link_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path): Result {
    return audit_append_link_created_r(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, backup_path, 0);
}

# audit_append_link_r with `created_dir` (1.4.0; 0 when none was made).
fn audit_append_link_created_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path, created_dir): Result {
    return audit_append_link_full_r(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, backup_path, created_dir, 0);
}

# Every additive field: `created_dir` (1.4.0) and `shape` (1.6.0).
fn audit_append_link_full_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path, created_dir, shape): Result {
    var cap = audit_entry_size(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target,
      backup_path) + 64 + 6 * _audit_vlen(created_dir);
    var buf = alloc(cap);
    var n = _audit_format_link_op(buf, cap, "link", pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target,
      backup_path, created_dir, shape);
    return _audit_append_bytes(buf, n);
}

fn audit_append_unlink_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target): Result {
    return audit_append_unlink_shaped_r(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0);
}

# An unlink entry with `shape` (1.6.0): "absolute" when the link removed
# had the absolute text, so that reversing it re-creates that shape.
fn audit_append_unlink_shaped_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target, shape): Result {
    var cap = audit_entry_size(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0) + 32;
    var buf = alloc(cap);
    var n = _audit_format_link_op(buf, cap, "unlink", pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0, 0, shape);
    return _audit_append_bytes(buf, n);
}

fn audit_append_adopt_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path): Result {
    return audit_append_adopt_shaped_r(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, backup_path, 0);
}

# An adopt entry with `shape` (1.6.0): "absolute" under `adopt --absolute`.
fn audit_append_adopt_shaped_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target,
  backup_path, shape): Result {
    var cap = audit_entry_size(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target,
      backup_path) + 32;
    var buf = alloc(cap);
    var n = _audit_format_link_op(buf, cap, "adopt", pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target,
      backup_path, 0, shape);
    return _audit_append_bytes(buf, n);
}

fn audit_append_unadopt_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target): Result {
    return audit_append_unadopt_shaped_r(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0);
}

# An unadopt entry with `shape` (1.6.0), as on unlink.
fn audit_append_unadopt_shaped_r(pkg, pkg_version, manifest_hash,
  source, target, abs_source, abs_target, shape): Result {
    var cap = audit_entry_size(pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0) + 32;
    var buf = alloc(cap);
    var n = _audit_format_link_op(buf, cap, "unadopt", pkg, pkg_version, manifest_hash,
      source, target, abs_source, abs_target, 0, 0, shape);
    return _audit_append_bytes(buf, n);
}

fn audit_append_rollback_marker_r(): Result {
    return audit_append_marker_r(0, 0);
}

# A marker with a `label` or a `from` (cstrings; 0 for none). A label is
# at most 64 bytes and `from` a number, so the fixed buffer holds either.
fn audit_append_marker_r(label, from): Result {
    var buf = alloc(4096);
    var n = audit_format_marker(buf, 4096, label, from);
    return _audit_append_bytes(buf, n);
}

# Compute the manifest hash. Parses the manifest, re-serializes
# it canonically, sha1s the canonical bytes, returns a heap-
# allocated cstring of the form "sha1c:" + 40 hex chars. Returns
# 0 if the manifest doesn't parse or read fails.
#
# Per ADR 0002, the canonical hash makes cosmetic edits (whitespace,
# comments, link-row reordering) produce the same hash. The
# previous variant `audit_manifest_hash_raw(path)` (sha1 over
# raw file bytes; prefix `sha1:`) is kept for trail-format
# diagnostics; new entries use the canonical hash. Readers
# tolerate both prefixes during the M7 → M8 transition.
fn audit_manifest_hash(path): i64 {
    var mr_t, mr_v = hapi_mf_parse_file_r(path);
    if (is_err_result(mr_t) == 1) { return 0; }
    var m = mr_v;

    # Size the buffer from the parsed manifest rather than a fixed
    # 64 KB. `hapi_mf_canonical_size` over-estimates and the
    # canonicalizer's writes are bounded either way, so an oversized
    # manifest now refuses (n < 0 -> "could not hash manifest",
    # exit 1) instead of overflowing the heap.
    var cap = hapi_mf_canonical_size(m);
    var cbuf = alloc(cap);
    var n = hapi_mf_canonicalize(m, cbuf, cap);
    if (n <= 0) { return 0; }

    var digest[20];
    sha1(cbuf, n, &digest);

    var out = alloc(47);
    var prefix = "sha1c:";
    memcpy(out, prefix, 6);
    var i = 0;
    while (i < 20) {
        var b = load8(&digest + i);
        var hi = b / 16;
        var lo = b - hi * 16;
        if (hi < 10) { store8(out + 6 + i * 2, 48 + hi); }
        else { store8(out + 6 + i * 2, 87 + hi); }
        if (lo < 10) { store8(out + 6 + i * 2 + 1, 48 + lo); }
        else { store8(out + 6 + i * 2 + 1, 87 + lo); }
        i = i + 1;
    }
    store8(out + 46, 0);
    return out;
}

# Legacy raw-bytes hash. `sha1:` + 40 hex chars over the file's
# raw bytes (no parse, no canonicalization). Kept for trail-
# format diagnostics — a reader walking pre-M7 entries that
# wants to re-verify the hash against the on-disk file uses
# this. Returns 0 on read failure.
fn audit_manifest_hash_raw(path): i64 {
    var buf = alloc(262144);
    var n = file_read_all(path, buf, 262144);
    if (n <= 0) { return 0; }

    var digest[20];
    sha1(buf, n, &digest);

    var out = alloc(46);
    var prefix = "sha1:";
    memcpy(out, prefix, 5);
    var i = 0;
    while (i < 20) {
        var b = load8(&digest + i);
        var hi = b / 16;
        var lo = b - hi * 16;
        if (hi < 10) { store8(out + 5 + i * 2, 48 + hi); }
        else { store8(out + 5 + i * 2, 87 + hi); }
        if (lo < 10) { store8(out + 5 + i * 2 + 1, 48 + lo); }
        else { store8(out + 5 + i * 2 + 1, 87 + lo); }
        i = i + 1;
    }
    store8(out + 45, 0);
    return out;
}
