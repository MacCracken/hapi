# manifest_write.cyr — edits to a hapi.cyml manifest.
#
# Two operations, both atomic-via-rename:
#   manifest_append_link_row — adopt's "close the loop" edit
#   manifest_remove_link_row — rollback-of-adopt
#
# Since 1.7.0 `hapi fmt` rewrites the header through the pieces below
# (manifest_lock … manifest_commit): the same lock, read, body delimiter
# and atomic commit, so its rewrite keeps the body byte for byte too.
#
# Atomicity: write the new content to `<path>.tmp` in the same
# directory, fsync, then rename(2) over the original. Crash
# windows produce either the original or the new — never a
# corrupt file.
#
# Preservation: the rest of the file is byte-identical. We
# don't re-canonicalize, don't reorder fields, don't strip
# comments. The user's authoring stays intact.

include "lib/io.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"

enum HapiMfWriteError {
    HapiMfwReadFailed = 1;
    HapiMfwWriteFailed = 2;
    HapiMfwRenameFailed = 3;
    HapiMfwRowNotFound = 4;
    HapiMfwUnrepresentable = 5;
    HapiMfwStagingExists = 6;
    HapiMfwManifestIsSymlink = 7;
}

# Can `s` be written into a `hapi.cyml` string value and read back as
# itself? (F-021)
#
# The honest answer for three byte classes is no, and escaping does not
# help: the parser's `\`-skips-the-next-byte rule stops a quote from
# TERMINATING the string but never strips the backslash, so a written
# `ev\"il` parses back as the six characters `ev\"il`, not `ev"il`.
# There is no un-escape half to mirror. Adding one would change how
# every existing manifest parses — an ADR 0001 frozen-surface change,
# so v2.0, not a patch.
#
# Until then hapi declines to write a row it cannot faithfully
# represent, rather than writing one that quietly means something else.
# Before 1.0.7 a filename containing `"` produced `source = "ev"il"`,
# which `inspect` read back as `ev` — hapi's declared state describing a
# file that does not exist, at exit 0.
#   0x22 `"`  — terminates the value
#   0x5C `\`  — the escape lead-in; ambiguous without an un-escape
#   < 0x20, 0x7F — newline ends the line-oriented parse; the rest are
#                  invisible in a file the user is expected to read
fn _hmw_representable(s): i64 {
    if (s == 0) { return 0; }
    var n = strlen(s);
    var i = 0;
    var ok = 1;
    while (i < n) {
        var c = load8(s + i);
        if (c == 34 || c == 92 || c < 32 || c == 127) { ok = 0; }
        i = i + 1;
    }
    return ok;
}

# Human-readable reason for a manifest-write failure.
fn hapi_mfw_err_msg(code): i64 {
    if (code == HapiMfwReadFailed) { return "could not read the manifest"; }
    if (code == HapiMfwWriteFailed) { return "could not write the manifest"; }
    if (code == HapiMfwRenameFailed) { return "could not commit the manifest rewrite"; }
    if (code == HapiMfwRowNotFound) { return "no matching [[link]] row in the manifest"; }
    if (code == HapiMfwUnrepresentable) {
        return "path contains a byte hapi.cyml cannot represent (a quote, a backslash, or a control character)";
    }
    if (code == HapiMfwManifestIsSymlink) {
        return "hapi.cyml is a symlink; a rewrite would replace the link with a private copy";
    }
    if (code == HapiMfwStagingExists) {
        return "a staging file from an interrupted write is in the way (hapi.cyml.<pid>.tmp)";
    }
    return "unknown manifest-write error";
}

# Directory portion of `path` (no trailing slash), or "." when there is
# no `/`. Local rather than fs_link.cyr's, to keep this module's include
# set minimal.
fn _hmw_dirname(path): i64 {
    var n = strlen(path);
    var last = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return "."; }
    if (last == 0) { return "/"; }
    var out = alloc(last + 1);
    memcpy(out, path, last);
    store8(out + last, 0);
    return out;
}

# Serialize the manifest read-modify-write across processes.
#
# The lock is taken on the PACKAGE DIRECTORY, not the manifest. The
# manifest is replaced by rename, so two writers that flock it by path
# can end up holding two different inodes and exclude nobody; the
# directory inode is stable and every writer agrees on it. Locking the
# directory also avoids leaving a `.lock` artifact in the user's
# dotfiles repo.
#
# LOCK_EX blocks, which is what we want: an adopt that arrives mid-write
# should wait its turn, not fail. Returns the held fd, or -1.
fn _hmw_lock(manifest_path): i64 {
    var dir = _hmw_dirname(manifest_path);
    var fd = file_open(dir, O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    if (xflock(fd, LOCK_EX) < 0) { file_close(fd); return 0 - 1; }
    return fd;
}

fn _hmw_unlock(fd): i64 {
    if (fd < 0) { return 0; }
    xflock(fd, LOCK_UN);
    return file_close(fd);
}

# Render a non-negative integer as a heap cstring (for the tmp name).
fn _hmw_itoa(n): i64 {
    if (n <= 0) { return "0"; }
    var digits[24];
    var i = 0;
    var v = n;
    while (v > 0) {
        var d = v - (v / 10) * 10;
        store8(&digits + i, 48 + d);
        v = v / 10;
        i = i + 1;
    }
    var out = alloc(i + 1);
    var j = 0;
    while (j < i) {
        store8(out + j, load8(&digits + i - 1 - j));
        j = j + 1;
    }
    store8(out + i, 0);
    return out;
}

# Read the entire file into a freshly-allocated buffer. Returns
# the buffer; writes the length through *out_len. Returns 0 on
# any read failure, INCLUDING a short read.
#
# The buffer is sized from the file rather than fixed. Through 1.0.4
# this read into a fixed alloc(262144) and stopped at the cap with no
# signal — and both callers hand the result straight to
# `_hmw_write_atomic`, so `hapi adopt` on a manifest past 256 KB
# committed the truncation via tmp+rename and permanently destroyed
# everything beyond it at exit 0. ADR 0001 sanctions an arbitrarily
# long markdown body below the `---` separator, so that size is
# reachable without the user doing anything unusual.
fn _hmw_slurp(path, out_len): i64 {
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var size = xlseek(fd, 0, 2);              # SEEK_END
    if (size < 0) { file_close(fd); return 0; }
    if (xlseek(fd, 0, 0) < 0) { file_close(fd); return 0; }   # SEEK_SET
    # One byte of headroom so a file that GREW since the probe reads
    # past `size` and is caught below rather than silently truncated.
    var cap = size + 1;
    var buf = alloc(cap);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = file_read(fd, buf + total, cap - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    file_close(fd);
    if (total > size) { return 0; }           # grew mid-read: refuse
    store64(out_len, total);
    return buf;
}

# Atomic write: write `buf[0..n]` to `path` via `path.<pid>.tmp` +
# rename.
#
# The tmp name carries the pid and is created O_EXCL. Through 1.0.6 it
# was a fixed `path.tmp` opened O_TRUNC, so two concurrent `hapi adopt`
# invocations against one package used the SAME staging file and
# clobbered each other mid-write. Measured on a 3 MB manifest with 16
# concurrent adopts: **1** manifest row landed, and only 2 of the 16
# committed at all (F-012). A pid-unique name removes the collision;
# O_EXCL means a leftover from a crashed run is reported rather than
# silently reused.
fn _hmw_write_atomic(path, buf, n): i64 {
    var plen = strlen(path);
    var pid = sys_getpid();
    var pids = _hmw_itoa(pid);
    var pl = strlen(pids);
    # path + "." + pid + ".tmp" + NUL
    var tmp = alloc(plen + 1 + pl + 5);
    var pos = 0;
    memcpy(tmp + pos, path, plen); pos = pos + plen;
    store8(tmp + pos, 46); pos = pos + 1;              # .
    memcpy(tmp + pos, pids, pl); pos = pos + pl;
    memcpy(tmp + pos, ".tmp\x00", 5);

    var fd = file_open(tmp, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);
    if (fd < 0) {
        # Say so when it is a leftover in the way (F-038): the pid in the
        # name is reused, so a crashed run's staging file refuses every
        # later run that draws the same pid — rarely on Linux, often on
        # agnos's small pid space, where O_EXCL has been real since cyrius
        # 6.6.4 / kernel 1.56.56. `hapi check` lists any it finds.
        if (hapi_excl_exists(tmp, fd) == 1) { return 0 - HapiMfwStagingExists; }
        return 0 - HapiMfwWriteFailed;
    }
    var wrc = file_write(fd, buf, n);
    if (wrc != n) { file_close(fd); hapi_unlink(tmp); return 0 - HapiMfwWriteFailed; }
    hapi_fsync(fd);
    var crc = file_close(fd);
    if (crc < 0) { hapi_unlink(tmp); return 0 - HapiMfwWriteFailed; }

    var rrc = hapi_rename(tmp, path);
    if (rrc < 0) { hapi_unlink(tmp); return 0 - HapiMfwRenameFailed; }
    return 0;
}

# 1 when a `---` that ENDS ITS LINE sits at `at`: a `\n`, CR LF, a lone
# CR as the last byte, or the end of the buffer follows it. Whether `at`
# begins a line is the caller's test.
#
# This MUST be the reader's rule, byte for byte — bayan 1.11.1's
# `_cyml_delim_at` / `_cyml_eol` (cyrius 6.7.18). hapi reads only the
# header above the first such line, so a writer that disagrees on where
# the header ends writes rows nothing can read. Through 1.0.12 this
# matched only `---\n`; bayan 1.7 / 1.8 widened the reader to CR LF and
# an unterminated final `---`, and `adopt` then appended into the body
# on those manifests. tests/hapi.tcyr's `1.1.0` section pins both sides.
fn _hmw_delim_at(buf, n, at): i64 {
    if (at + 3 > n) { return 0; }
    if (load8(buf + at) != 45) { return 0; }       # -
    if (load8(buf + at + 1) != 45) { return 0; }   # -
    if (load8(buf + at + 2) != 45) { return 0; }   # -
    var e = at + 3;
    if (e == n) { return 1; }
    var c = load8(buf + e);
    if (c == 10) { return 1; }
    if (c == 13) {
        if (e + 1 == n) { return 1; }
        if (load8(buf + e + 1) == 10) { return 1; }
    }
    return 0;
}

# Byte offset of the first CYML body delimiter line (see `_hmw_delim_at`),
# or -1 when there is none and the whole file is header. Append inserts
# above it; remove searches only above it.
fn _hmw_find_separator(buf, n): i64 {
    if (_hmw_delim_at(buf, n, 0) == 1) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) {
            if (_hmw_delim_at(buf, n, i + 1) == 1) { return i + 1; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Append a [[link]] row to `manifest_path`. Inserted just before
# the body separator if one exists, else at EOF (with leading
# blank-line padding either way for readability).
# Public entry: hold the package-directory lock across the whole
# read-modify-write. Without it, two concurrent `hapi adopt` runs each
# slurped the pre-edit manifest and the last rename won — every
# filesystem mutation committed while the row recording it vanished.
# Measured on a 3 MB manifest with 16 concurrent adopts: 16 files moved,
# 16 symlinks planted, 16 trail entries — and ONE manifest row (F-012).
# 1 when the manifest at `path` is a symlink. The rewrite is a rename of a
# staging file over `path`, which replaces a symlink with a regular file
# (F-058): through 1.1.0 adopting into a package whose hapi.cyml linked to
# a shared manifest turned it into a private copy holding the new row,
# while the shared file — the one every other checkout reads — never got
# it. 4096 is the readlink buffer link_probe uses; on agnos a shorter one
# answers -1 for a longer body and would miss the link.
fn hapi_mfw_manifest_is_symlink(path): i64 {
    var buf = alloc(4096);
    if (hapi_readlink(path, buf, 4096) > 0) { return 1; }
    return 0;
}

fn manifest_append_link_row(manifest_path, source, target): i64 {
    # Refuse before taking the lock: a row we cannot represent must
    # never reach the file (F-021).
    if (_hmw_representable(source) == 0) { return 0 - HapiMfwUnrepresentable; }
    if (_hmw_representable(target) == 0) { return 0 - HapiMfwUnrepresentable; }
    if (hapi_mfw_manifest_is_symlink(manifest_path) == 1) { return 0 - HapiMfwManifestIsSymlink; }
    var lk = _hmw_lock(manifest_path);
    if (lk < 0) { return 0 - HapiMfwWriteFailed; }
    var rc = _hmw_append_unlocked(manifest_path, source, target);
    _hmw_unlock(lk);
    return rc;
}

# 1 when the manifest's line ending is CR LF, judged by its first line.
# The appended row matches it (F-041): through 1.1.0 the row template was
# LF-only, so `adopt` left a CRLF manifest with mixed endings — the reader
# and `check --strict` accept that, but an editor or a diff need not.
fn _hmw_crlf(buf, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) {
            if (i > 0) {
                if (load8(buf + i - 1) == 13) { return 1; }
            }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# Write the line ending at buf+at; returns its length.
fn _hmw_put_eol(buf, at, crlf): i64 {
    if (crlf == 1) {
        store8(buf + at, 13);
        store8(buf + at + 1, 10);
        return 2;
    }
    store8(buf + at, 10);
    return 1;
}

fn _hmw_append_unlocked(manifest_path, source, target): i64 {
    var len = 0;
    var buf = _hmw_slurp(manifest_path, &len);
    if (buf == 0) { return 0 - HapiMfwReadFailed; }

    var sep = _hmw_find_separator(buf, len);
    var crlf = _hmw_crlf(buf, len);

    var slen = strlen(source);
    var tlen = strlen(target);
    # Block: EOL "[[link]]" EOL "source = \"S\"" EOL "target = \"T\"" EOL,
    # four line endings of one or two bytes each.
    var block_len = 8 + 10 + slen + 1 + 10 + tlen + 1 + 4 * 2;
    var block = alloc(block_len + 1);
    var bp = 0;
    bp = bp + _hmw_put_eol(block, bp, crlf);
    memcpy(block + bp, "[[link]]", 8); bp = bp + 8;
    bp = bp + _hmw_put_eol(block, bp, crlf);
    memcpy(block + bp, "source = \"", 10); bp = bp + 10;
    memcpy(block + bp, source, slen); bp = bp + slen;
    store8(block + bp, 34); bp = bp + 1;
    bp = bp + _hmw_put_eol(block, bp, crlf);
    memcpy(block + bp, "target = \"", 10); bp = bp + 10;
    memcpy(block + bp, target, tlen); bp = bp + tlen;
    store8(block + bp, 34); bp = bp + 1;
    bp = bp + _hmw_put_eol(block, bp, crlf);

    var out_cap = len + bp + 16;
    var out = alloc(out_cap);
    var pos = 0;

    var split = len;
    if (sep >= 0) { split = sep; }

    memcpy(out + pos, buf, split);
    pos = pos + split;

    # Ensure there's a blank line before the new block. If the
    # last char in the prefix is already a newline, we still
    # want a separator newline — block starts with `\n` already.
    memcpy(out + pos, block, bp);
    pos = pos + bp;

    if (sep >= 0) {
        # Re-attach the body separator + body.
        memcpy(out + pos, buf + split, len - split);
        pos = pos + (len - split);
    }

    return _hmw_write_atomic(manifest_path, out, pos);
}

# Match an exact double-quoted string at buf[start..]. Returns
# the length of the literal (including quotes) if it matches
# `needle` byte-for-byte, else -1.
fn _hmw_match_quoted(buf, end, start, needle): i64 {
    if (start >= end || load8(buf + start) != 34) { return 0 - 1; }
    var nlen = strlen(needle);
    if (start + 1 + nlen >= end) { return 0 - 1; }
    var i = 0;
    while (i < nlen) {
        if (load8(buf + start + 1 + i) != load8(needle + i)) { return 0 - 1; }
        i = i + 1;
    }
    if (load8(buf + start + 1 + nlen) != 34) { return 0 - 1; }
    return nlen + 2;
}

# Check whether buf[pos..end] starts with the literal cstring `lit`.
fn _hmw_starts(buf, end, pos, lit): i64 {
    var llen = strlen(lit);
    if (pos + llen > end) { return 0; }
    var i = 0;
    while (i < llen) {
        if (load8(buf + pos + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Skip horizontal whitespace (space/tab) at *pos in buf.
fn _hmw_skip_hws(buf, end, pos_ptr): i64 {
    var p = load64(pos_ptr);
    var go = 1;
    while (p < end && go == 1) {
        var c = load8(buf + p);
        if (c == 32 || c == 9) { p = p + 1; }
        else { go = 0; }
    }
    store64(pos_ptr, p);
    return 0;
}

# Scan a [[link]] block starting at `block_start` (which points
# at the `[`). Returns the byte offset *after* the block (i.e.
# at the next `[` or `---` or EOF), and writes 1 through
# *match_ptr if the block's source AND target both match the
# requested values.
fn _hmw_scan_link_block(buf, end, block_start, want_src, want_tgt, match_ptr): i64 {
    # Walk to end-of-line after [[link]]
    var p = block_start + 8;     # skip "[[link]]"
    while (p < end && load8(buf + p) != 10) { p = p + 1; }
    if (p < end) { p = p + 1; }

    var src_match = 0;
    var tgt_match = 0;

    var go = 1;
    while (p < end && go == 1) {
        # Skip leading horizontal ws on this line
        _hmw_skip_hws(buf, end, &p);
        if (p >= end) { go = 0; }
        else {
            var c = load8(buf + p);
            if (c == 91 || c == 45) {
                # Next [[ section or --- — block ends here.
                go = 0;
            } elif (c == 10) {
                # Blank line — keep going (block continues).
                p = p + 1;
            } elif (c == 35) {
                # Comment — skip to EOL.
                while (p < end && load8(buf + p) != 10) { p = p + 1; }
                if (p < end) { p = p + 1; }
            } elif (_hmw_starts(buf, end, p, "source") == 1) {
                p = p + 6;
                _hmw_skip_hws(buf, end, &p);
                if (p < end && load8(buf + p) == 61) {
                    p = p + 1;
                    _hmw_skip_hws(buf, end, &p);
                    var ml = _hmw_match_quoted(buf, end, p, want_src);
                    if (ml > 0) { src_match = 1; p = p + ml; }
                }
                while (p < end && load8(buf + p) != 10) { p = p + 1; }
                if (p < end) { p = p + 1; }
            } elif (_hmw_starts(buf, end, p, "target") == 1) {
                p = p + 6;
                _hmw_skip_hws(buf, end, &p);
                if (p < end && load8(buf + p) == 61) {
                    p = p + 1;
                    _hmw_skip_hws(buf, end, &p);
                    var ml = _hmw_match_quoted(buf, end, p, want_tgt);
                    if (ml > 0) { tgt_match = 1; p = p + ml; }
                }
                while (p < end && load8(buf + p) != 10) { p = p + 1; }
                if (p < end) { p = p + 1; }
            } else {
                while (p < end && load8(buf + p) != 10) { p = p + 1; }
                if (p < end) { p = p + 1; }
            }
        }
    }

    if (src_match == 1 && tgt_match == 1) { store64(match_ptr, 1); }
    else { store64(match_ptr, 0); }
    return p;
}

# Find the start of a [[link]] block at or after `from`. Returns
# the offset of the `[`, or -1 if none.
fn _hmw_find_link_block(buf, end, from): i64 {
    var p = from;
    while (p + 9 <= end) {
        var at_bol = 1;
        if (p > 0) {
            if (load8(buf + p - 1) != 10) { at_bol = 0; }
        }
        if (at_bol == 1 && _hmw_starts(buf, end, p, "[[link]]") == 1) {
            return p;
        }
        p = p + 1;
    }
    return 0 - 1;
}

# Remove a [[link]] block matching `source` and `target` exactly.
# Trims the preceding blank line(s) along with the block so the
# manifest doesn't grow blank-line clutter from churn.
fn manifest_remove_link_row(manifest_path, source, target): i64 {
    if (hapi_mfw_manifest_is_symlink(manifest_path) == 1) { return 0 - HapiMfwManifestIsSymlink; }
    var lk = _hmw_lock(manifest_path);
    if (lk < 0) { return 0 - HapiMfwWriteFailed; }
    var rc = _hmw_remove_unlocked(manifest_path, source, target);
    _hmw_unlock(lk);
    return rc;
}

fn _hmw_remove_unlocked(manifest_path, source, target): i64 {
    var len = 0;
    var buf = _hmw_slurp(manifest_path, &len);
    if (buf == 0) { return 0 - HapiMfwReadFailed; }

    # Search the header only. A [[link]] below the delimiter is markdown —
    # an example in the package's docs — not a row; matching it deleted
    # the prose and reported success while the reader saw no change.
    var hdr_end = _hmw_find_separator(buf, len);
    if (hdr_end < 0) { hdr_end = len; }

    var scan = 0;
    var found_start = 0 - 1;
    var found_end = 0;
    var go = 1;
    while (go == 1) {
        var blk = _hmw_find_link_block(buf, hdr_end, scan);
        if (blk < 0) { go = 0; }
        else {
            var matched = 0;
            var block_end = _hmw_scan_link_block(buf, hdr_end, blk, source, target, &matched);
            if (matched == 1) {
                found_start = blk;
                found_end = block_end;
                go = 0;
            } else {
                scan = block_end;
            }
        }
    }

    if (found_start < 0) { return 0 - HapiMfwRowNotFound; }

    # Trim preceding blank lines (the run of line endings immediately
    # before `found_start`), keeping the one that ends the previous line,
    # so the manifest stays tidy. CR counts as part of the run (F-041):
    # matching `\n` alone stopped at the first CR, so on a CRLF manifest
    # nothing was trimmed and each adopt → rollback grew a blank line.
    var cut_start = found_start;
    var pgo = 1;
    while (cut_start > 0 && pgo == 1) {
        var pc = load8(buf + cut_start - 1);
        if (pc == 10 || pc == 13) { cut_start = cut_start - 1; }
        else { pgo = 0; }
    }
    if (cut_start < found_start) {
        if (load8(buf + cut_start) == 13 && cut_start + 1 < found_start
            && load8(buf + cut_start + 1) == 10) {
            cut_start = cut_start + 2;
        } else {
            cut_start = cut_start + 1;
        }
    }

    var out_cap = len + 1;
    var out = alloc(out_cap);
    memcpy(out, buf, cut_start);
    memcpy(out + cut_start, buf + found_end, len - found_end);
    var new_len = cut_start + (len - found_end);

    return _hmw_write_atomic(manifest_path, out, new_len);
}

# ----------------------------------------------------------------
# The pieces `hapi fmt` (1.7.0) rewrites a manifest with. A caller holds
# the lock from its read to its commit, as the two edits above do, so an
# `adopt` cannot land a row between them and be overwritten.
# ----------------------------------------------------------------

# Take the package-directory lock (see _hmw_lock). The fd, or -1.
fn manifest_lock(manifest_path): i64 { return _hmw_lock(manifest_path); }
fn manifest_unlock(fd): i64 { return _hmw_unlock(fd); }

# The whole file, sized from the file (see _hmw_slurp); 0 on a failed or
# grown read. *len_out gets the length.
fn manifest_read(manifest_path, len_out): i64 { return _hmw_slurp(manifest_path, len_out); }

# Offset of the first body delimiter line, or -1 (the reader's rule).
fn manifest_body_start(buf, n): i64 { return _hmw_find_separator(buf, n); }

# 1 when the manifest's line ending is CR LF (judged by its first line).
fn manifest_uses_crlf(buf, n): i64 { return _hmw_crlf(buf, n); }

# Replace the manifest with buf[0..n]: staging file, fsync, rename. 0, or
# a negated HapiMfWriteError. A symlinked manifest is refused (F-058).
fn manifest_commit(manifest_path, buf, n): i64 {
    if (hapi_mfw_manifest_is_symlink(manifest_path) == 1) { return 0 - HapiMfwManifestIsSymlink; }
    return _hmw_write_atomic(manifest_path, buf, n);
}
