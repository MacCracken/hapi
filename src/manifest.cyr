# manifest.cyr — hapi.cyml parser.
#
# Parses the v1.0 manifest schema documented in
# docs/adr/0001-hapi-cyml-manifest-schema.md. Single-entry CYML
# (TOML header + optional markdown body); the body is preserved
# but unparsed.
#
# We hand-roll the section dispatch instead of leaning on
# bayan's generic toml parser. That parser is shape-faithful but
# schema-blind: it happily accepts any `[section]` / `[[section]]`
# and key (single-bracket headers parse fine since v6.0.62 — the
# old "`[package]` is a no-op" limitation is gone). hapi instead
# enforces the ADR-locked `[package]` / `[[link]]` schema directly
# — strict-mode rejection of unknown sections/keys
# (`hapi check --strict`), required-key validation, duplicate-
# target and `../`-traversal detection. That domain logic is the
# reason the dispatch lives here, not the bracket counting.
#
# Filesystem checks (source paths exist, target paths writable,
# capability scope) belong to `link` / `adopt`, not here — this
# parser produces a static description that runs on any well-formed
# manifest without touching the scoped root.

include "lib/result.cyr"
# cyml folded into bayan in the v6.1.25 stdlib carve; the cyml_*
# call sites below ride bayan's _compat forwarders unchanged.
include "lib/bayan.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/syscalls.cyr"

# Error variants surfaced as Err(...) by hapi_mf_parse_*. Names
# prefixed `HapiMf` to keep them out of the lib/* enum namespace.
enum HapiMfError {
    HapiMfIoErr;
    HapiMfMissingName;
    HapiMfMissingVersion;
    HapiMfMissingSource;
    HapiMfMissingTarget;
    HapiMfDuplicateTarget;
    HapiMfPathTraversal;
    HapiMfUnknownSection;
    HapiMfUnknownKey;
}

# Strict-mode flag. When 1, the parser rejects unknown
# sections and unknown keys (used by `hapi check --strict`).
# Default 0 keeps the lenient behavior callers (inspect, link,
# unlink, adopt, status) rely on for additive schema growth.
var _hapi_mf_strict = 0;

fn hapi_mf_set_strict(v): i64 { _hapi_mf_strict = v; return 0; }
fn hapi_mf_strict(): i64 { return _hapi_mf_strict; }

# What a parse skipped that the canonical form has no place for (1.7.0,
# `hapi fmt`). 0 — every verb but fmt — records nothing; otherwise a vec
# that each skip appends a HapiMfDrop to (16 bytes: +0 the 1-based line,
# +8 a cstring saying what). Recording never changes what the parse
# returns: every call site below is beside the skip it describes, so
# the parser itself is the one list of what it drops.
var _hapi_mf_drops = 0;

fn hapi_mf_track_drops(v): i64 { _hapi_mf_drops = v; return 0; }
fn hapi_mf_drop_line(d): i64 { return load64(d); }
fn hapi_mf_drop_what(d): i64 { return load64(d + 8); }

# Record a skip at buf[pos]: `prefix`, then the key `key` (a Str, or 0),
# then `suffix`. The message is built only while tracking.
fn _hapi_mf_drop(buf, pos, prefix, key, suffix): i64 {
    if (_hapi_mf_drops == 0) { return 0; }
    var line = 1;
    var i = 0;
    while (i < pos) {
        if (load8(buf + i) == 10) { line = line + 1; }
        i = i + 1;
    }
    var pl = strlen(prefix);
    var kl = 0;
    if (key != 0) { kl = str_len(key); }
    var sl = strlen(suffix);
    var what = alloc(pl + kl + sl + 1);
    memcpy(what, prefix, pl);
    if (kl > 0) { memcpy(what + pl, str_data(key), kl); }
    memcpy(what + pl + kl, suffix, sl);
    store8(what + pl + kl + sl, 0);
    var d = alloc(16);
    store64(d, line);
    store64(d + 8, what);
    vec_push(_hapi_mf_drops, d);
    return 0;
}

# Before a skip to the end of the line: record what is there, if it is
# more than spaces, tabs and a CR — a comment, or other text, described
# as `prefix` `key` `suffix`.
fn _hapi_mf_drop_rest(buf, pos, end, prefix, key, suffix): i64 {
    if (_hapi_mf_drops == 0) { return 0; }
    var p = _hapi_mf_skip_hws(buf, pos, end);
    while (p < end && load8(buf + p) == 13) { p = p + 1; }
    if (p >= end || load8(buf + p) == 10) { return 0; }
    if (load8(buf + p) == 35) { return _hapi_mf_drop(buf, p, "a comment", 0, ""); }
    return _hapi_mf_drop(buf, p, prefix, key, suffix);
}

# Section dispatch tags used during parse.
enum HapiMfSection {
    HAPI_MF_SECT_NONE = 0;
    HAPI_MF_SECT_PACKAGE = 1;
    HAPI_MF_SECT_LINK = 2;
    HAPI_MF_SECT_UNKNOWN = 99;
}

# HapiLink — 16 bytes.
#   +0  source: Str
#   +8  target: Str
fn hapi_link_new(source, target): i64 {
    var l = alloc(16);
    store64(l, source);
    store64(l + 8, target);
    return l;
}
fn hapi_link_source(l): Str { return load64(l); }
fn hapi_link_target(l): Str { return load64(l + 8); }

# HapiManifest — 40 bytes.
#   +0  name: Str        (required, validated non-empty)
#   +8  version: Str     (required, validated non-empty)
#   +16 description: Str (optional; 0 when absent)
#   +24 links: vec of HapiLink
#   +32 ignore: vec of Str  (glob patterns)
fn hapi_mf_new(): i64 {
    var m = alloc(40);
    store64(m, 0);
    store64(m + 8, 0);
    store64(m + 16, 0);
    store64(m + 24, vec_new());
    store64(m + 32, vec_new());
    return m;
}
fn hapi_mf_name(m): Str { return load64(m); }
fn hapi_mf_version(m): Str { return load64(m + 8); }
fn hapi_mf_description(m): i64 { return load64(m + 16); }
fn hapi_mf_links(m): i64 { return load64(m + 24); }
fn hapi_mf_ignore(m): i64 { return load64(m + 32); }

# Skip horizontal whitespace (space, tab) only.
fn _hapi_mf_skip_hws(buf, pos, end): i64 {
    var go = 1;
    while (pos < end && go == 1) {
        var c = load8(buf + pos);
        if (c == 32 || c == 9) { pos = pos + 1; }
        else { go = 0; }
    }
    return pos;
}

# Skip whitespace, newlines, and full-line comments. Returns the
# position of the first significant byte (or `end`).
fn _hapi_mf_skip_ws_nl(buf, pos, end): i64 {
    var go = 1;
    while (pos < end && go == 1) {
        var c = load8(buf + pos);
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            pos = pos + 1;
        } elif (c == 35) {
            _hapi_mf_drop(buf, pos, "a comment", 0, "");
            var lgo = 1;
            while (pos < end && lgo == 1) {
                if (load8(buf + pos) == 10) { lgo = 0; }
                else { pos = pos + 1; }
            }
        } else {
            go = 0;
        }
    }
    return pos;
}

# Advance pos to the byte after the next newline (or to `end`).
fn _hapi_mf_skip_to_eol(buf, pos, end): i64 {
    var go = 1;
    while (pos < end && go == 1) {
        if (load8(buf + pos) == 10) { pos = pos + 1; go = 0; }
        else { pos = pos + 1; }
    }
    return pos;
}

# Parse a "double-quoted" string starting at pos (which points at
# the opening `"`). Returns the inner Str; writes the post-string
# position into *out_pos. Escape handling matches TOML's coarse
# rule: a `\` skips the following byte verbatim.
fn _hapi_mf_parse_str(buf, pos, end, out_pos): Str {
    pos = pos + 1;
    var start = pos;
    var go = 1;
    while (pos < end && go == 1) {
        var c = load8(buf + pos);
        if (c == 34) { go = 0; }
        elif (c == 92 && pos + 1 < end) {
            pos = pos + 2;
        } else {
            pos = pos + 1;
        }
    }
    var s = str_new(buf + start, pos - start);
    if (pos < end) { pos = pos + 1; }
    store64(out_pos, pos);
    return s;
}

# Parse a `["s1", "s2", ...]` array of double-quoted strings.
# Returns a vec of Str; writes the post-array position into
# *out_pos. Non-string elements are silently skipped (the schema
# only uses string arrays).
fn _hapi_mf_parse_str_array(buf, pos, end, out_pos): i64 {
    var v = vec_new();
    pos = pos + 1;
    var noted = 0;
    var go = 1;
    while (pos < end && go == 1) {
        pos = _hapi_mf_skip_ws_nl(buf, pos, end);
        if (pos >= end) { go = 0; }
        else {
            var c = load8(buf + pos);
            if (c == 93) { pos = pos + 1; go = 0; }
            elif (c == 34) {
                var np = 0;
                var s = _hapi_mf_parse_str(buf, pos, end, &np);
                vec_push(v, s);
                pos = np;
                pos = _hapi_mf_skip_ws_nl(buf, pos, end);
                if (pos < end && load8(buf + pos) == 44) { pos = pos + 1; }
            } else {
                # A stray comma is punctuation; anything else is a value
                # the schema's string arrays drop (noted once per array).
                if (c != 44 && noted == 0) {
                    _hapi_mf_drop(buf, pos, "a non-string element in an array", 0, "");
                    noted = 1;
                }
                pos = pos + 1;
            }
        }
    }
    store64(out_pos, pos);
    return v;
}

# Returns 1 if `s` contains a `..` path segment (i.e. `..` bounded
# by string-start/end or `/`). Used to reject path traversal in
# both `source` and `target` values.
fn _hapi_mf_has_dotdot(s: Str): i64 {
    var d = str_data(s);
    var n = str_len(s);
    if (n < 2) { return 0; }
    var i = 0;
    var hit = 0;
    while (i <= n - 2 && hit == 0) {
        if (load8(d + i) == 46 && load8(d + i + 1) == 46) {
            var prev_ok = 0;
            if (i == 0) { prev_ok = 1; }
            elif (load8(d + i - 1) == 47) { prev_ok = 1; }
            var next_ok = 0;
            if (i + 2 == n) { next_ok = 1; }
            elif (load8(d + i + 2) == 47) { next_ok = 1; }
            if (prev_ok == 1 && next_ok == 1) { hit = 1; }
        }
        i = i + 1;
    }
    return hit;
}

# Read key bytes from pos until `=`, whitespace, or newline.
# Returns the key Str; advances pos via *out_pos.
fn _hapi_mf_parse_key(buf, pos, end, out_pos): Str {
    var start = pos;
    var go = 1;
    while (pos < end && go == 1) {
        var c = load8(buf + pos);
        if (c == 61 || c == 32 || c == 9 || c == 10) { go = 0; }
        else { pos = pos + 1; }
    }
    var k = str_new(buf + start, pos - start);
    store64(out_pos, pos);
    return k;
}

# Parse the TOML header of a hapi.cyml into a HapiManifest.
# Returns Ok(manifest) on success, Err(HapiMf*) on validation
# failure. Unknown sections and unknown keys are tolerated
# silently — the schema is additive, and a stricter mode is
# reserved for a future `hapi check --strict`.
fn hapi_mf_parse_header_r(data, len): Result {
    var m = hapi_mf_new();
    var pos = 0;
    var cur = HAPI_MF_SECT_NONE;
    var cur_link = 0;

    while (pos < len) {
        pos = _hapi_mf_skip_ws_nl(data, pos, len);
        if (pos >= len) { pos = len; }
        else {
            var c = load8(data + pos);

            if (c == 91 && pos + 1 < len && load8(data + pos + 1) == 91) {
                if (cur == HAPI_MF_SECT_LINK && cur_link != 0) {
                    vec_push(hapi_mf_links(m), cur_link);
                    cur_link = 0;
                }
                pos = pos + 2;
                var nstart = pos;
                var ng = 1;
                while (pos < len && ng == 1) {
                    if (load8(data + pos) == 93) { ng = 0; }
                    else { pos = pos + 1; }
                }
                var section = str_new(data + nstart, pos - nstart);
                if (pos < len && load8(data + pos) == 93) { pos = pos + 1; }
                if (pos < len && load8(data + pos) == 93) { pos = pos + 1; }
                _hapi_mf_drop_rest(data, pos, len, "text after a section header", 0, "");
                pos = _hapi_mf_skip_to_eol(data, pos, len);

                if (str_eq_cstr(section, "link") == 1) {
                    cur = HAPI_MF_SECT_LINK;
                    cur_link = hapi_link_new(0, 0);
                } else {
                    if (_hapi_mf_strict == 1) { return Err(HapiMfUnknownSection); }
                    _hapi_mf_drop(data, nstart, "unknown section [[", section, "]] and its keys");
                    cur = HAPI_MF_SECT_UNKNOWN;
                }
            }
            elif (c == 91) {
                if (cur == HAPI_MF_SECT_LINK && cur_link != 0) {
                    vec_push(hapi_mf_links(m), cur_link);
                    cur_link = 0;
                }
                pos = pos + 1;
                var nstart = pos;
                var ng = 1;
                while (pos < len && ng == 1) {
                    if (load8(data + pos) == 93) { ng = 0; }
                    else { pos = pos + 1; }
                }
                var section = str_new(data + nstart, pos - nstart);
                if (pos < len && load8(data + pos) == 93) { pos = pos + 1; }
                _hapi_mf_drop_rest(data, pos, len, "text after a section header", 0, "");
                pos = _hapi_mf_skip_to_eol(data, pos, len);

                if (str_eq_cstr(section, "package") == 1) {
                    cur = HAPI_MF_SECT_PACKAGE;
                } else {
                    if (_hapi_mf_strict == 1) { return Err(HapiMfUnknownSection); }
                    _hapi_mf_drop(data, nstart, "unknown section [", section, "] and its keys");
                    cur = HAPI_MF_SECT_UNKNOWN;
                }
            }
            else {
                var kstart = pos;
                var kp = 0;
                var key = _hapi_mf_parse_key(data, pos, len, &kp);
                pos = kp;
                pos = _hapi_mf_skip_hws(data, pos, len);
                if (pos < len && load8(data + pos) == 61) {
                    pos = pos + 1;
                    pos = _hapi_mf_skip_hws(data, pos, len);
                    var vc = 10;
                    if (pos < len) { vc = load8(data + pos); }
                    if (vc == 34) {
                        var vp = 0;
                        var val = _hapi_mf_parse_str(data, pos, len, &vp);
                        pos = vp;
                        if (cur == HAPI_MF_SECT_PACKAGE) {
                            var slot = 0 - 1;
                            if (str_eq_cstr(key, "name") == 1) { slot = 0; }
                            elif (str_eq_cstr(key, "version") == 1) { slot = 8; }
                            elif (str_eq_cstr(key, "description") == 1) { slot = 16; }
                            if (slot >= 0) {
                                if (load64(m + slot) != 0) {
                                    _hapi_mf_drop(data, kstart, "the earlier `", key, "`, set again here");
                                }
                                store64(m + slot, val);
                            } else {
                                if (_hapi_mf_strict == 1) { return Err(HapiMfUnknownKey); }
                                _hapi_mf_drop(data, kstart, "unknown key `", key, "` in [package]");
                            }
                        } elif (cur == HAPI_MF_SECT_LINK && cur_link != 0) {
                            var lslot = 0 - 1;
                            if (str_eq_cstr(key, "source") == 1) { lslot = 0; }
                            elif (str_eq_cstr(key, "target") == 1) { lslot = 8; }
                            if (lslot >= 0) {
                                if (load64(cur_link + lslot) != 0) {
                                    _hapi_mf_drop(data, kstart, "the earlier `", key, "`, set again here");
                                }
                                store64(cur_link + lslot, val);
                            } else {
                                if (_hapi_mf_strict == 1) { return Err(HapiMfUnknownKey); }
                                _hapi_mf_drop(data, kstart, "unknown key `", key, "` in a [[link]] row");
                            }
                        } elif (cur == HAPI_MF_SECT_NONE) {
                            _hapi_mf_drop(data, kstart, "key `", key, "` before any section");
                        }
                        _hapi_mf_drop_rest(data, pos, len, "text after the value of `", key, "`");
                    }
                    elif (vc == 91) {
                        var vp = 0;
                        var arr = _hapi_mf_parse_str_array(data, pos, len, &vp);
                        pos = vp;
                        if (cur == HAPI_MF_SECT_PACKAGE && str_eq_cstr(key, "ignore") == 1) {
                            if (vec_len(hapi_mf_ignore(m)) > 0) {
                                _hapi_mf_drop(data, kstart, "the earlier `", key, "`, set again here");
                            }
                            store64(m + 32, arr);
                        } elif (cur == HAPI_MF_SECT_PACKAGE) {
                            if (_hapi_mf_strict == 1) { return Err(HapiMfUnknownKey); }
                            _hapi_mf_drop(data, kstart, "unknown key `", key, "` in [package]");
                        } elif (cur == HAPI_MF_SECT_LINK) {
                            if (_hapi_mf_strict == 1) { return Err(HapiMfUnknownKey); }
                            _hapi_mf_drop(data, kstart, "unknown key `", key, "` in a [[link]] row");
                        } elif (cur == HAPI_MF_SECT_NONE) {
                            _hapi_mf_drop(data, kstart, "key `", key, "` before any section");
                        }
                        _hapi_mf_drop_rest(data, pos, len, "text after the value of `", key, "`");
                    }
                    elif (cur != HAPI_MF_SECT_UNKNOWN) {
                        # No value, or one that is not a double-quoted string
                        # or an array: the parse skips the rest of the line.
                        _hapi_mf_drop(data, kstart, "`", key, "` with a value that is not a double-quoted string");
                    }
                } elif (cur != HAPI_MF_SECT_UNKNOWN) {
                    # An unknown section's lines are covered by its own note.
                    _hapi_mf_drop(data, kstart, "a line that is not `key = value`", 0, "");
                }
                pos = _hapi_mf_skip_to_eol(data, pos, len);
            }
        }
    }

    if (cur == HAPI_MF_SECT_LINK && cur_link != 0) {
        vec_push(hapi_mf_links(m), cur_link);
    }

    if (hapi_mf_name(m) == 0 || str_len(hapi_mf_name(m)) == 0) {
        return Err(HapiMfMissingName);
    }
    if (hapi_mf_version(m) == 0 || str_len(hapi_mf_version(m)) == 0) {
        return Err(HapiMfMissingVersion);
    }

    var links = hapi_mf_links(m);
    var nlinks = vec_len(links);
    var i = 0;
    while (i < nlinks) {
        var lnk = vec_get(links, i);
        var src = hapi_link_source(lnk);
        var tgt = hapi_link_target(lnk);
        if (src == 0 || str_len(src) == 0) { return Err(HapiMfMissingSource); }
        if (tgt == 0 || str_len(tgt) == 0) { return Err(HapiMfMissingTarget); }
        if (_hapi_mf_has_dotdot(src) == 1) { return Err(HapiMfPathTraversal); }
        if (_hapi_mf_has_dotdot(tgt) == 1) { return Err(HapiMfPathTraversal); }
        var j = 0;
        while (j < i) {
            var lnk2 = vec_get(links, j);
            if (str_eq(tgt, hapi_link_target(lnk2)) == 1) {
                return Err(HapiMfDuplicateTarget);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return Ok(m);
}

# Parse hapi.cyml from disk. `path` must point at the manifest
# file itself (not the package dir) — directory-form dispatch
# lives in src/cmd/inspect.cyr so the parser stays I/O-thin.
fn hapi_mf_parse_file_r(path): Result {
    var doc_t, doc_v = cyml_parse_file_r(path);
    if (is_err_result(doc_t) == 1) { return Err(HapiMfIoErr); }
    var doc = doc_v;
    var hdr = cyml_doc_header(doc);
    var hdr_len = cyml_doc_header_len(doc);
    return hapi_mf_parse_header_r(hdr, hdr_len);
}

# ----------------------------------------------------------------
# Canonical re-serialization (M7 — sha1: → sha1c: migration)
# ----------------------------------------------------------------
#
# Produces a fixed byte representation of a parsed manifest so
# that semantically-identical manifests collide under sha1.
# Differs from the on-disk file format in these ways:
#
#   - no comments, no blank-line variation (exactly one blank
#     between sections; final `\n` at EOF; no trailing whitespace)
#   - field order in [package] is fixed:
#         name, version, description, ignore
#     (optional fields skipped when absent)
#   - `[[link]]` rows are sorted by `target` lex byte-order so
#     row reordering in the source manifest produces the same
#     hash; `target` uniqueness is already enforced by the parser
#   - strings escape only `"` and `\` (matches the parser's
#     coarse \-skips-the-next-byte rule)
#
# This is an INTERNAL contract — the bytes are never seen by
# users. Anything consistent works; this layout is stable enough
# to freeze under the v1.0 audit-trail contract.

fn _hapi_mf_link_cmp_target(a, b): i64 {
    var ta = hapi_link_target(a);
    var tb = hapi_link_target(b);
    var da = str_data(ta);
    var db = str_data(tb);
    var la = str_len(ta);
    var lb = str_len(tb);
    var min = la;
    if (lb < min) { min = lb; }
    var i = 0;
    while (i < min) {
        var ca = load8(da + i);
        var cb = load8(db + i);
        if (ca != cb) { return ca - cb; }
        i = i + 1;
    }
    return la - lb;
}

fn _hapi_mf_clone_links(links): i64 {
    var v = vec_new();
    var n = vec_len(links);
    var i = 0;
    while (i < n) {
        vec_push(v, vec_get(links, i));
        i = i + 1;
    }
    return v;
}

fn _hapi_mf_sort_links_by_target(links): i64 {
    var n = vec_len(links);
    var i = 1;
    while (i < n) {
        var x = vec_get(links, i);
        var j = i;
        var go = 1;
        while (j > 0 && go == 1) {
            var prev = vec_get(links, j - 1);
            if (_hapi_mf_link_cmp_target(prev, x) > 0) {
                vec_set(links, j, prev);
                j = j - 1;
            } else { go = 0; }
        }
        vec_set(links, j, x);
        i = i + 1;
    }
    return 0;
}

# Canonicalization overflow flag. Set by the bounded writers below
# when a write would pass `cap`; `hapi_mf_canonicalize` clears it on
# entry and turns it into a refusal on exit.
#
# A flag rather than a per-call return because the emitters are called
# from inside the row loop: refusing at the first overflow and carrying
# the verdict out is what lets the byte sequence stay EXACTLY what it
# was for every manifest that does fit. The canonical bytes are the
# `sha1c:` hash preimage frozen by ADR 0002 — truncating instead of
# refusing would silently change the hash of an oversized manifest.
var _hapi_mf_canon_ovf = 0;

# Write one byte at *pos_ptr if it fits in `cap`; else set the flag.
fn _hapi_mf_put8(out, pos_ptr, cap, c): i64 {
    var pos = load64(pos_ptr);
    if (pos + 1 > cap) { _hapi_mf_canon_ovf = 1; return 0; }
    store8(out + pos, c);
    store64(pos_ptr, pos + 1);
    return 0;
}

# Copy `n` bytes at *pos_ptr if they fit in `cap`; else set the flag.
fn _hapi_mf_putn(out, pos_ptr, cap, src, n): i64 {
    var pos = load64(pos_ptr);
    if (pos + n > cap) { _hapi_mf_canon_ovf = 1; return 0; }
    memcpy(out + pos, src, n);
    store64(pos_ptr, pos + n);
    return 0;
}

# Emit `prefix"<escaped value>"\n` to `out` at *pos_ptr; bumps pos.
# Every write is bounded by `cap`; an overflow sets the module flag and
# the remaining writes become no-ops, so `pos` never passes `cap`.
fn _hapi_mf_emit_kv(out, pos_ptr, cap, key, val_data, val_len): i64 {
    _hapi_mf_putn(out, pos_ptr, cap, key, strlen(key));
    _hapi_mf_put8(out, pos_ptr, cap, 32);     # space
    _hapi_mf_put8(out, pos_ptr, cap, 61);     # =
    _hapi_mf_put8(out, pos_ptr, cap, 32);     # space
    _hapi_mf_put8(out, pos_ptr, cap, 34);     # "
    var i = 0;
    while (i < val_len) {
        var c = load8(val_data + i);
        if (c == 34 || c == 92) {
            _hapi_mf_put8(out, pos_ptr, cap, 92);
        }
        _hapi_mf_put8(out, pos_ptr, cap, c);
        i = i + 1;
    }
    _hapi_mf_put8(out, pos_ptr, cap, 34);     # "
    _hapi_mf_put8(out, pos_ptr, cap, 10);     # \n
    return 0;
}

# Upper bound on the canonical form of `m`, for sizing the buffer.
# Deliberately an OVER-estimate: every value is counted at 2x for
# worst-case `"` / `\` escaping, plus fixed per-row overhead. It is a
# sizing hint, NOT the safety mechanism — `hapi_mf_canonicalize`'s
# bounded writers are, so a hint that is somehow too small refuses
# cleanly instead of overflowing.
fn hapi_mf_canonical_size(m): i64 {
    var n = 64;                       # "[package]\n" + slack
    var nm = hapi_mf_name(m);
    n = n + 2 * str_len(nm) + 16;
    var ver = hapi_mf_version(m);
    n = n + 2 * str_len(ver) + 16;
    var desc = hapi_mf_description(m);
    if (desc != 0) { n = n + 2 * str_len(desc) + 20; }

    var ig = hapi_mf_ignore(m);
    var ign = vec_len(ig);
    var i = 0;
    while (i < ign) {
        n = n + 2 * str_len(vec_get(ig, i)) + 8;
        i = i + 1;
    }
    if (ign > 0) { n = n + 16; }

    var links = hapi_mf_links(m);
    var nl = vec_len(links);
    var j = 0;
    while (j < nl) {
        var lk = vec_get(links, j);
        n = n + 2 * str_len(hapi_link_source(lk));
        n = n + 2 * str_len(hapi_link_target(lk));
        n = n + 48;                   # "\n[[link]]\n" + both key lines
        j = j + 1;
    }
    return n;
}

# Re-serialize parsed manifest `m` into `out`, writing at most `cap`
# bytes. Returns bytes written, or -1 if the canonical form does not
# fit — `cap` is now honoured (it was accepted and ignored through
# 1.0.4, so a manifest whose canonical form passed the caller's buffer
# overflowed the heap and took `link` / `sync` / `adopt` down with
# SIGSEGV, exit 139, outside the documented 0/1/2 contract).
#
# Refuses rather than truncating on purpose: these bytes are the
# `sha1c:` manifest_hash preimage frozen by ADR 0002, so emitting a
# short prefix would quietly hash a different document. Callers size
# the buffer with `hapi_mf_canonical_size`.
fn hapi_mf_canonicalize(m, out, cap): i64 {
    var pos = 0;
    _hapi_mf_canon_ovf = 0;

    _hapi_mf_putn(out, &pos, cap, "[package]\n", 10);

    var nm = hapi_mf_name(m);
    _hapi_mf_emit_kv(out, &pos, cap, "name", str_data(nm), str_len(nm));

    var ver = hapi_mf_version(m);
    _hapi_mf_emit_kv(out, &pos, cap, "version", str_data(ver), str_len(ver));

    var desc = hapi_mf_description(m);
    if (desc != 0 && str_len(desc) > 0) {
        _hapi_mf_emit_kv(out, &pos, cap, "description", str_data(desc), str_len(desc));
    }

    var ig = hapi_mf_ignore(m);
    var ign = vec_len(ig);
    if (ign > 0) {
        _hapi_mf_putn(out, &pos, cap, "ignore = [", 10);
        var i = 0;
        while (i < ign) {
            if (i > 0) {
                _hapi_mf_put8(out, &pos, cap, 44);      # ,
                _hapi_mf_put8(out, &pos, cap, 32);      # space
            }
            _hapi_mf_put8(out, &pos, cap, 34);          # "
            var s = vec_get(ig, i);
            var sd = str_data(s);
            var sl = str_len(s);
            var k = 0;
            while (k < sl) {
                var c = load8(sd + k);
                if (c == 34 || c == 92) {
                    _hapi_mf_put8(out, &pos, cap, 92);
                }
                _hapi_mf_put8(out, &pos, cap, c);
                k = k + 1;
            }
            _hapi_mf_put8(out, &pos, cap, 34);          # "
            i = i + 1;
        }
        _hapi_mf_put8(out, &pos, cap, 93);              # ]
        _hapi_mf_put8(out, &pos, cap, 10);              # \n
    }

    var sorted = _hapi_mf_clone_links(hapi_mf_links(m));
    _hapi_mf_sort_links_by_target(sorted);
    var nlinks = vec_len(sorted);
    var j = 0;
    while (j < nlinks) {
        _hapi_mf_put8(out, &pos, cap, 10);              # blank line
        _hapi_mf_putn(out, &pos, cap, "[[link]]\n", 9);
        var lk = vec_get(sorted, j);
        var src = hapi_link_source(lk);
        var tgt = hapi_link_target(lk);
        _hapi_mf_emit_kv(out, &pos, cap, "source", str_data(src), str_len(src));
        _hapi_mf_emit_kv(out, &pos, cap, "target", str_data(tgt), str_len(tgt));
        j = j + 1;
    }

    if (_hapi_mf_canon_ovf == 1) { return 0 - 1; }
    return pos;
}

# ----------------------------------------------------------------
# `hapi fmt` (1.7.0): the header rewritten as hapi_mf_canonicalize's bytes
# ----------------------------------------------------------------
#
# The roadmap's condition for shipping fmt in v1.x: what it writes for the
# header IS the canonical form, so the `sha1c:` manifest hash of a
# formatted manifest is the hash of the original (ADR 0002). Three things
# can stop that, and hapi_mf_format_r reports each rather than writing:
#   - content the parse skipped (comments, unknown keys, ...), recorded by
#     the parser itself (`_hapi_mf_drops`);
#   - a value holding a backslash: the parser keeps `\` bytes and the
#     canonical form escapes them again, so the value would grow on every
#     pass and its hash change (the F-021 asymmetry, ADR 0001);
#   - output that does not parse back to these exact canonical bytes —
#     the proof, run on the bytes fmt would write.

# HapiFmt — 40 bytes.
#   +0  out: the header to write (canonical bytes, line endings as `crlf`)
#   +8  out_len
#   +16 drops: vec of HapiMfDrop (empty when nothing would be lost)
#   +24 backslash: which field holds one (cstring), or 0
#   +32 proven: 1 when `out` parses back to the same canonical bytes
fn hapi_fmt_out(f): i64 { return load64(f); }
fn hapi_fmt_out_len(f): i64 { return load64(f + 8); }
fn hapi_fmt_drops(f): i64 { return load64(f + 16); }
fn hapi_fmt_backslash(f): i64 { return load64(f + 24); }
fn hapi_fmt_proven(f): i64 { return load64(f + 32); }

fn _hapi_mf_has_backslash(s): i64 {
    if (s == 0) { return 0; }
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        if (load8(d + i) == 92) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The first field of `m` holding a backslash, named for a message; 0 if none.
fn _hapi_mf_backslash_field(m): i64 {
    if (_hapi_mf_has_backslash(hapi_mf_name(m)) == 1) { return "`name`"; }
    if (_hapi_mf_has_backslash(hapi_mf_version(m)) == 1) { return "`version`"; }
    if (_hapi_mf_has_backslash(hapi_mf_description(m)) == 1) { return "`description`"; }
    var ig = hapi_mf_ignore(m);
    var i = 0;
    while (i < vec_len(ig)) {
        if (_hapi_mf_has_backslash(vec_get(ig, i)) == 1) { return "an `ignore` pattern"; }
        i = i + 1;
    }
    var links = hapi_mf_links(m);
    var j = 0;
    while (j < vec_len(links)) {
        var lk = vec_get(links, j);
        if (_hapi_mf_has_backslash(hapi_link_source(lk)) == 1) { return "a [[link]] row's `source`"; }
        if (_hapi_mf_has_backslash(hapi_link_target(lk)) == 1) { return "a [[link]] row's `target`"; }
        j = j + 1;
    }
    return 0;
}

# m's canonical bytes in a fresh buffer; *len_out gets the length. 0 when
# they do not fit the sizing hint (the canonicalizer refuses, never cuts).
fn _hapi_mf_canonical_buf(m, len_out): i64 {
    var cap = hapi_mf_canonical_size(m);
    var buf = alloc(cap + 1);
    var n = hapi_mf_canonicalize(m, buf, cap);
    if (n < 0) { return 0; }
    store64(len_out, n);
    return buf;
}

# Parse the header `hdr` (len bytes) and build what fmt would write for it,
# each line ended CR LF when `crlf` is 1. Err(code) when it does not parse.
fn hapi_mf_format_r(hdr, len, crlf): Result {
    var drops = vec_new();
    hapi_mf_track_drops(drops);
    var r_t, r_v = hapi_mf_parse_header_r(hdr, len);
    hapi_mf_track_drops(0);
    if (is_err_result(r_t) == 1) { return Err(r_v); }
    var m = r_v;

    var f = alloc(40);
    store64(f, 0);
    store64(f + 8, 0);
    store64(f + 16, drops);
    store64(f + 24, _hapi_mf_backslash_field(m));
    store64(f + 32, 0);

    var cn = 0;
    var canon = _hapi_mf_canonical_buf(m, &cn);
    if (canon == 0) { return Ok(f); }

    var out = canon;
    var on = cn;
    if (crlf == 1) {
        var lines = 0;
        var i = 0;
        while (i < cn) {
            if (load8(canon + i) == 10) { lines = lines + 1; }
            i = i + 1;
        }
        out = alloc(cn + lines + 1);
        on = 0;
        i = 0;
        while (i < cn) {
            var c = load8(canon + i);
            if (c == 10) { store8(out + on, 13); on = on + 1; }
            store8(out + on, c);
            on = on + 1;
            i = i + 1;
        }
    }
    store64(f, out);
    store64(f + 8, on);

    # The proof: the bytes fmt would write parse back to the same
    # canonical bytes, so the manifest's hash cannot change.
    var p_t, p_v = hapi_mf_parse_header_r(out, on);
    if (is_err_result(p_t) == 0) {
        var bn = 0;
        var back = _hapi_mf_canonical_buf(p_v, &bn);
        if (back != 0 && bn == cn) {
            if (memeq(back, canon, cn) == 1) { store64(f + 32, 1); }
        }
    }
    return Ok(f);
}

# Map a HapiMfError code to a human cstring. Used by inspect and
# by future commands when they surface a parse failure.
fn hapi_mf_err_msg(code): i64 {
    if (code == HapiMfIoErr) { return "could not read manifest"; }
    if (code == HapiMfMissingName) { return "[package].name is missing or empty"; }
    if (code == HapiMfMissingVersion) { return "[package].version is missing or empty"; }
    if (code == HapiMfMissingSource) { return "[[link]].source is missing or empty"; }
    if (code == HapiMfMissingTarget) { return "[[link]].target is missing or empty"; }
    if (code == HapiMfDuplicateTarget) { return "two [[link]] rows share the same target"; }
    if (code == HapiMfPathTraversal) { return "a path contains a `..` segment"; }
    if (code == HapiMfUnknownSection) { return "manifest has an unknown [section] (strict mode)"; }
    if (code == HapiMfUnknownKey) { return "manifest has an unknown key in a known section (strict mode)"; }
    return "unknown manifest error";
}
