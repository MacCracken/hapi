# audit_reader.cyr — reads the JSONL audit trail back into
# structured entries. Pairs with src/audit.cyr (the writer).
#
# We hand-roll the JSON object scan instead of pulling in
# lib/json.cyr's full parser because the per-line shape is
# pinned by ADR 0002 (always a flat object of "key":"value"
# pairs, all string-typed) and the scanner is ~80 lines —
# smaller than the json.cyr include surface.
#
# Crash-safety, and the line between "torn" and "corrupt":
#   - A TRAILING line without a `\n` is dropped silently. That is the
#     writer's atomic-append contract — a torn final write leaves either
#     zero or one complete line, never a valid-looking partial.
#   - An INTERIOR line that fails to parse is CORRUPTION, and is
#     refused (F-016). Skipping it silently is what let `rollback`
#     report complete success while the link that line recorded stayed
#     on disk. hapi's rule is that conflicts surface explicitly; a
#     damaged trail is a conflict with the user's own history.
#   - An absent trail is Ok(empty) — first run on this host. Any OTHER
#     open or read failure is an error, not "empty" (F-017): a
#     permissions change or a failing disk used to read as "nothing to
#     do", and `list` / `rollback` / `unlink` exited 0 having done
#     nothing.

include "lib/io.cyr"
include "src/agnos_compat.cyr"   # hapi_open_regular, hapi_open_absent
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/syscalls.cyr"
include "lib/result.cyr"
include "src/out.cyr"

enum HapiAuditReadError {
    HapiArOpenFailed = 1;
    HapiArReadFailed = 2;
    HapiArCorrupt = 3;
    HapiArNoLocation = 4;
    HapiArShrunk = 5;
}

# 1-based line number of the corrupt entry, for the caller's message.
# Set by audit_read_r alongside Err(HapiArCorrupt).
var _har_corrupt_line = 0;

fn audit_corrupt_line(): i64 { return _har_corrupt_line; }

fn hapi_ar_err_msg(code): i64 {
    if (code == HapiArOpenFailed) { return "audit trail exists but could not be opened"; }
    if (code == HapiArReadFailed) { return "audit trail could not be read"; }
    if (code == HapiArCorrupt)    { return "audit trail has a malformed entry"; }
    if (code == HapiArNoLocation) {
        return "no audit-trail location: $XDG_STATE_HOME and $HOME are unset or not absolute";
    }
    return "unknown audit-trail read error";
}

# HapiAuditEntry — 120 bytes.
#   +0   op (cstring)
#   +8   ts (cstring)
#   +16  pkg (cstring or 0)
#   +24  pkg_version (cstring or 0)
#   +32  manifest_hash (cstring or 0)
#   +40  source (cstring or 0)
#   +48  target (cstring or 0)
#   +56  abs_source (cstring or 0)
#   +64  abs_target (cstring or 0)
#   +72  backup_path (cstring or 0; only set on link/adopt
#        entries written under --backup-to)
#   +80  created_dir (cstring or 0; 1.4.0, only on link entries whose
#        creation made a directory)
#   +88  label (cstring or 0; 1.5.0, a rollback-marker that
#        `checkpoint --label` wrote)
#   +96  from (cstring or 0; 1.5.0, a rollback-marker that rollback
#        wrote: the line its range began on)
#   +104 lineno (the entry's 1-based line in the trail; set by the
#        reader, not a field of the line)
#   +112 shape (cstring or 0; 1.6.0, "absolute" on an entry whose link
#        text is absolute)
#   +120 absent (cstring or 0; 1.7.1, "1" on an op:unlink that retired a
#        link already gone)
fn _hae_new(): i64 {
    var e = alloc(128);
    var i = 0;
    while (i < 128) { store64(e + i, 0); i = i + 8; }
    return e;
}
fn hae_op(e): i64 { return load64(e); }
fn hae_ts(e): i64 { return load64(e + 8); }
fn hae_pkg(e): i64 { return load64(e + 16); }
fn hae_pkg_version(e): i64 { return load64(e + 24); }
fn hae_manifest_hash(e): i64 { return load64(e + 32); }
fn hae_source(e): i64 { return load64(e + 40); }
fn hae_target(e): i64 { return load64(e + 48); }
fn hae_abs_source(e): i64 { return load64(e + 56); }
fn hae_abs_target(e): i64 { return load64(e + 64); }
fn hae_backup_path(e): i64 { return load64(e + 72); }
fn hae_created_dir(e): i64 { return load64(e + 80); }
fn hae_label(e): i64 { return load64(e + 88); }
fn hae_from(e): i64 { return load64(e + 96); }
fn hae_lineno(e): i64 { return load64(e + 104); }
fn hae_shape(e): i64 { return load64(e + 112); }
# 1 when the entry's link text is absolute (1.6.0). Any other `shape`,
# and none, is the relative default.
fn hae_absolute(e): i64 { return hapi_cstr_eq(hae_shape(e), "absolute"); }
# 1 on an op:unlink that retired a link already gone (1.7.1, F-078).
fn hae_absent(e): i64 { return hapi_cstr_eq(load64(e + 120), "1"); }

# A trail field as hapi prints it (F-104): a control byte is shown as `?`.
# The trail is hapi's own, written from manifests that hold none since
# F-092, but one an older hapi or a hand wrote may, and its text would
# reach the terminal raw. 1.5.0 kept only `label` and `ts` back.
fn hae_shown(s): i64 {
    if (s == 0) { return ""; }
    var n = strlen(s);
    var i = 0;
    var clean = 1;
    while (i < n) {
        var c = load8(s + i);
        if (c < 32 || c == 127) { clean = 0; }
        i = i + 1;
    }
    if (clean == 1) { return s; }
    var out = alloc(n + 1);
    i = 0;
    while (i < n) {
        var c2 = load8(s + i);
        if (c2 < 32 || c2 == 127) { store8(out + i, 63); } else { store8(out + i, c2); }
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

# Parse a hex digit. Returns 0-15, or -1 on non-hex.
fn _har_hex(c): i64 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70)  { return c - 55; }
    return 0 - 1;
}

# Read a JSON-quoted string starting at buf[*pos] (which must
# point at the opening `"`). On success, writes the unescaped
# heap-allocated cstring through *out_cstr and advances *pos
# past the closing `"`. Returns 0 on success, -1 on malformed.
fn _har_read_str(buf, len, pos_ptr, out_cstr): i64 {
    var pos = load64(pos_ptr);
    if (pos >= len || load8(buf + pos) != 34) { return 0 - 1; }
    pos = pos + 1;
    # Two passes: measure and validate, then fill. `\uXXXX` decodes to
    # UTF-8, a surrogate pair to its one code point (F-100). Through 1.7.0
    # only the low byte of the code point was kept and a malformed escape
    # was accepted, so a non-ASCII path re-serialized by any standard JSON
    # tool read back as a different path. hapi's writer emits `\u00XX`
    # only for control bytes, which still decode to that one byte.
    var scan = pos;
    var out_len = 0;
    var go = 1;
    while (scan < len && go == 1) {
        var c = load8(buf + scan);
        if (c == 34) { go = 0; }
        elif (c == 92) {
            scan = scan + 1;
            if (scan >= len) { return 0 - 1; }
            var esc = load8(buf + scan);
            if (esc == 117) {
                var cp = _har_u4(buf, len, scan + 1);
                if (cp < 0) { return 0 - 1; }
                scan = scan + 5;
                if (cp >= 0xD800 && cp <= 0xDBFF) {
                    if (scan + 1 >= len || load8(buf + scan) != 92 || load8(buf + scan + 1) != 117) { return 0 - 1; }
                    var lo = _har_u4(buf, len, scan + 2);
                    if (lo < 0xDC00 || lo > 0xDFFF) { return 0 - 1; }
                    scan = scan + 6;
                    out_len = out_len + 4;
                } elif (cp >= 0xDC00 && cp <= 0xDFFF) {
                    return 0 - 1;                             # a lone low surrogate
                } else {
                    out_len = out_len + _har_utf8_len(cp);
                }
            } elif (esc == 34 || esc == 92 || esc == 47 || esc == 98 || esc == 102
                    || esc == 110 || esc == 114 || esc == 116) {
                out_len = out_len + 1;
                scan = scan + 1;
            } else {
                return 0 - 1;                                 # not a JSON escape
            }
        } else {
            out_len = out_len + 1;
            scan = scan + 1;
        }
    }
    if (go == 1) { return 0 - 1; }   # unterminated

    var out = alloc(out_len + 1);
    if (out == 0) { return 0 - 1; }
    var rp = pos;
    var wp = 0;
    var go2 = 1;
    while (rp < len && go2 == 1) {
        var c = load8(buf + rp);
        if (c == 34) { go2 = 0; rp = rp + 1; }
        elif (c == 92) {
            rp = rp + 1;
            var esc = load8(buf + rp);
            if (esc == 110) { store8(out + wp, 10); wp = wp + 1; rp = rp + 1; }
            elif (esc == 114) { store8(out + wp, 13); wp = wp + 1; rp = rp + 1; }
            elif (esc == 116) { store8(out + wp, 9);  wp = wp + 1; rp = rp + 1; }
            elif (esc == 98)  { store8(out + wp, 8);  wp = wp + 1; rp = rp + 1; }
            elif (esc == 102) { store8(out + wp, 12); wp = wp + 1; rp = rp + 1; }
            elif (esc == 117) {
                var cp = _har_u4(buf, len, rp + 1);
                rp = rp + 5;
                if (cp >= 0xD800 && cp <= 0xDBFF) {
                    var lo = _har_u4(buf, len, rp + 2);
                    cp = 0x10000 + (cp - 0xD800) * 1024 + (lo - 0xDC00);
                    rp = rp + 6;
                }
                wp = wp + _har_utf8_put(out + wp, cp);
            } else {
                store8(out + wp, esc); wp = wp + 1; rp = rp + 1;
            }
        } else {
            store8(out + wp, c); wp = wp + 1; rp = rp + 1;
        }
    }
    store8(out + wp, 0);
    store64(out_cstr, out);
    store64(pos_ptr, rp);
    return 0;
}

# The code point of the four hex digits at buf[at..at+4), or -1.
fn _har_u4(buf, len, at): i64 {
    if (at + 4 > len) { return 0 - 1; }
    var cp = 0;
    var i = 0;
    while (i < 4) {
        var h = _har_hex(load8(buf + at + i));
        if (h < 0) { return 0 - 1; }
        cp = cp * 16 + h;
        i = i + 1;
    }
    return cp;
}

fn _har_utf8_len(cp): i64 {
    if (cp < 0x80) { return 1; }
    if (cp < 0x800) { return 2; }
    if (cp < 0x10000) { return 3; }
    return 4;
}

# Write `cp` as UTF-8 at `out`; returns the bytes written.
fn _har_utf8_put(out, cp): i64 {
    if (cp < 0x80) { store8(out, cp); return 1; }
    if (cp < 0x800) {
        store8(out, 0xC0 + cp / 64);
        store8(out + 1, 0x80 + (cp & 63));
        return 2;
    }
    if (cp < 0x10000) {
        store8(out, 0xE0 + cp / 4096);
        store8(out + 1, 0x80 + ((cp / 64) & 63));
        store8(out + 2, 0x80 + (cp & 63));
        return 3;
    }
    store8(out, 0xF0 + cp / 262144);
    store8(out + 1, 0x80 + ((cp / 4096) & 63));
    store8(out + 2, 0x80 + ((cp / 64) & 63));
    store8(out + 3, 0x80 + (cp & 63));
    return 4;
}

# Skip whitespace in a buffer at *pos. JSON allows space/tab/LF/CR.
fn _har_skip_ws(buf, len, pos_ptr): i64 {
    var pos = load64(pos_ptr);
    var go = 1;
    while (pos < len && go == 1) {
        var c = load8(buf + pos);
        if (c == 32 || c == 9 || c == 10 || c == 13) { pos = pos + 1; }
        else { go = 0; }
    }
    store64(pos_ptr, pos);
    return 0;
}

# Match the lookup key against a known field name and store
# the value into the appropriate slot of `entry`.
fn _har_assign_field(entry, key, value): i64 {
    if (hapi_cstr_eq(key, "op") == 1)            { store64(entry,      value); }
    elif (hapi_cstr_eq(key, "ts") == 1)           { store64(entry + 8,  value); }
    elif (hapi_cstr_eq(key, "pkg") == 1)          { store64(entry + 16, value); }
    elif (hapi_cstr_eq(key, "pkg_version") == 1)  { store64(entry + 24, value); }
    elif (hapi_cstr_eq(key, "manifest_hash") == 1){ store64(entry + 32, value); }
    elif (hapi_cstr_eq(key, "source") == 1)       { store64(entry + 40, value); }
    elif (hapi_cstr_eq(key, "target") == 1)       { store64(entry + 48, value); }
    elif (hapi_cstr_eq(key, "abs_source") == 1)   { store64(entry + 56, value); }
    elif (hapi_cstr_eq(key, "abs_target") == 1)   { store64(entry + 64, value); }
    elif (hapi_cstr_eq(key, "backup_path") == 1)  { store64(entry + 72, value); }
    elif (hapi_cstr_eq(key, "created_dir") == 1)  { store64(entry + 80, value); }
    elif (hapi_cstr_eq(key, "label") == 1)        { store64(entry + 88, value); }
    elif (hapi_cstr_eq(key, "from") == 1)         { store64(entry + 96, value); }
    elif (hapi_cstr_eq(key, "shape") == 1)        { store64(entry + 112, value); }
    elif (hapi_cstr_eq(key, "absent") == 1)       { store64(entry + 120, value); }
    # Unknown fields silently dropped — additive growth per ADR 0002.
    return 0;
}

# Parse one JSONL line (no trailing newline) into a HapiAuditEntry.
# Returns the entry on success, 0 on malformed. Per ADR 0002 the
# value half of every field is a JSON string.
fn _har_parse_line(buf, len): i64 {
    var entry = _hae_new();
    var pos = 0;
    _har_skip_ws(buf, len, &pos);
    if (pos >= len || load8(buf + pos) != 123) { return 0; }
    pos = pos + 1;
    _har_skip_ws(buf, len, &pos);
    if (pos < len && load8(buf + pos) == 125) {
        pos = pos + 1;
        _har_skip_ws(buf, len, &pos);
        if (pos != len) { return 0; }                  # F-099
        return entry;
    }

    var go = 1;
    while (go == 1) {
        var key = 0;
        if (_har_read_str(buf, len, &pos, &key) < 0) { return 0; }
        _har_skip_ws(buf, len, &pos);
        if (pos >= len || load8(buf + pos) != 58) { return 0; }
        pos = pos + 1;
        _har_skip_ws(buf, len, &pos);
        var value = 0;
        if (_har_read_str(buf, len, &pos, &value) < 0) { return 0; }
        _har_assign_field(entry, key, value);
        _har_skip_ws(buf, len, &pos);
        if (pos >= len) { return 0; }
        var c = load8(buf + pos);
        if (c == 125) { pos = pos + 1; go = 0; }
        elif (c == 44) { pos = pos + 1; _har_skip_ws(buf, len, &pos); }
        else { return 0; }
    }
    # Nothing but whitespace after the closing `}` (F-099): two entries
    # joined on one line read as the first, so unlink reported success
    # and left the second's link, still live in the trail.
    _har_skip_ws(buf, len, &pos);
    if (pos != len) { return 0; }
    return entry;
}

# Read the audit trail at `path` into a vec of HapiAuditEntry
# pointers. Ok(vec) on success — including an absent trail, which
# yields an empty vec (first hapi run on this host, not an error).
# Err on: an existing trail that will not open or read, and on an
# interior malformed line.
#
# The read is sized from the file. Through 1.0.5 it read the first
# 256 KB and stopped, so once the trail outgrew that, `rollback` could
# not see the most recent checkpoint marker, fell back to start=0, and
# reversed the OLDEST still-live links while leaving the recent work in
# place — measured at 637 settled links destroyed on an 800-entry trail,
# exit 0 (F-007).
fn audit_read_r(path): Result {
    _har_corrupt_line = 0;
    var entries = vec_new();

    var fd = hapi_open_regular(path, O_RDONLY, 0);       # F-091
    if (fd < 0) {
        # ENOENT is the legitimate "no trail yet" case. Anything else —
        # EACCES, EIO, EMFILE — is a real failure and must not read as
        # an empty trail. Through the shim: agnos has no errno (F-044).
        if (hapi_open_absent(path, fd) == 1) { return Ok(entries); }
        return Err(HapiArOpenFailed);
    }

    # A shared lock, so a read during another hapi's append sees whole
    # lines (F-102): through 1.7.0 none was taken, and a trail that grew
    # mid-read was refused as unreadable. agnos's flock is exclusive-only.
    #ifndef CYRIUS_TARGET_AGNOS
    xflock(fd, LOCK_SH);
    #endif
    var size = xlseek(fd, 0, 2);                  # SEEK_END
    if (size < 0) { file_close(fd); return Err(HapiArReadFailed); }
    if (xlseek(fd, 0, 0) < 0) { file_close(fd); return Err(HapiArReadFailed); }
    if (size == 0) { file_close(fd); return Ok(entries); }

    # One byte of headroom so a trail that GREW between the size probe
    # and the read is detected rather than silently truncated.
    var cap = size + 1;
    var buf = alloc(cap);
    if (buf == 0) { file_close(fd); return Err(HapiArReadFailed); }   # F-102: too large to hold
    var total = 0;
    var rgo = 1;
    var rerr = 0;
    while (rgo == 1) {
        var n = file_read(fd, buf + total, cap - total);
        if (n < 0) { rerr = 1; rgo = 0; }
        elif (n == 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    file_close(fd);
    if (rerr == 1) { return Err(HapiArReadFailed); }
    if (total > size) { return Err(HapiArReadFailed); }   # grew mid-read
    if (total == 0) { return Ok(entries); }
    if (_har_parse_lines(buf, total, 0, entries) < 0) { return Err(HapiArCorrupt); }
    return Ok(entries);
}

# The end of the last complete line _har_parse_lines consumed, and how
# many lines it had then counted.
var _har_end = 0;
var _har_lines = 0;
fn audit_read_end(): i64 { return _har_end; }
fn audit_read_lines(): i64 { return _har_lines; }

# Parse buf[0..total) line by line into `entries`, numbering lines from
# `lineno0` + 1. A line terminated with `\n` must parse; a trailing line
# without one is the torn-write case and is dropped. Sets _har_end and
# _har_lines. Returns 0, or -1 on a corrupt line (_har_corrupt_line set).
fn _har_parse_lines(buf, total, lineno0, entries): i64 {
    var pos = 0;
    var lineno = lineno0;
    _har_end = 0;
    while (pos < total) {
        var line_start = pos;
        var found = 0;
        while (pos < total && found == 0) {
            if (load8(buf + pos) == 10) { found = 1; }
            else { pos = pos + 1; }
        }
        if (found == 1) {
            lineno = lineno + 1;
            var line_len = pos - line_start;
            if (line_len > 0) {
                var entry = _har_parse_line(buf + line_start, line_len);
                if (entry == 0) {
                    _har_corrupt_line = lineno;
                    return 0 - 1;
                }
                store64(entry + 104, lineno);
                vec_push(entries, entry);
            }
            pos = pos + 1;
            _har_end = pos;
        }
        # If no \n found, the trailing partial line falls off here.
    }
    _har_lines = lineno;
    return 0;
}

# The entries on the complete lines from byte `from` on, numbered from
# `lineno0` + 1 (1.7.1). For a caller that keeps what it read, and reads
# again as the trail grows: `link` during a no-arg sync. On Ok, _har_end
# is the absolute offset past the last complete line, and _har_lines the
# line count there. A trail now shorter than `from` is Err(HapiArShrunk):
# it was replaced, and the caller starts again from 0.
fn audit_read_from_r(path, from, lineno0): Result {
    _har_corrupt_line = 0;
    var entries = vec_new();
    _har_end = from;
    _har_lines = lineno0;
    var fd = hapi_open_regular(path, O_RDONLY, 0);       # F-091
    if (fd < 0) {
        if (hapi_open_absent(path, fd) == 1) {
            if (from > 0) { return Err(HapiArShrunk); }
            return Ok(entries);
        }
        return Err(HapiArOpenFailed);
    }
    #ifndef CYRIUS_TARGET_AGNOS
    xflock(fd, LOCK_SH);                          # F-102
    #endif
    var size = xlseek(fd, 0, 2);
    if (size < 0) { file_close(fd); return Err(HapiArReadFailed); }
    if (size < from) { file_close(fd); return Err(HapiArShrunk); }
    if (size == from) { file_close(fd); return Ok(entries); }
    if (xlseek(fd, from, 0) < 0) { file_close(fd); return Err(HapiArReadFailed); }
    var want = size - from;
    var cap = want + 1;
    var buf = alloc(cap);
    if (buf == 0) { file_close(fd); return Err(HapiArReadFailed); }
    var total = 0;
    var rgo = 1;
    var rerr = 0;
    while (rgo == 1) {
        var n = file_read(fd, buf + total, cap - total);
        if (n < 0) { rerr = 1; rgo = 0; }
        elif (n == 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    file_close(fd);
    if (rerr == 1) { return Err(HapiArReadFailed); }
    if (total > want) { return Err(HapiArReadFailed); }
    if (_har_parse_lines(buf, total, lineno0, entries) < 0) { return Err(HapiArCorrupt); }
    _har_end = from + _har_end;
    return Ok(entries);
}

# Back-compat shape: the vec, with every failure flattened to empty.
# Retained for call sites that genuinely cannot act on an error; the
# three trail-consuming verbs use `audit_read_default_r` instead.
fn audit_read(path): i64 {
    var r_t, r_v = audit_read_r(path);
    if (is_err_result(r_t) == 1) { return vec_new(); }
    return r_v;
}

# Convenience: read the default trail (audit_trail_path()).
fn audit_read_default(): i64 {
    if (audit_trail_path() == 0) { return vec_new(); }
    return audit_read(audit_trail_path());
}

fn audit_read_default_r(): Result {
    if (audit_trail_path() == 0) { return Err(HapiArNoLocation); }
    return audit_read_r(audit_trail_path());
}

# The trail, or Err(1) after saying why it cannot be read: `hapi: <why>
# (line N)`, then that hapi refuses to `what` on a partial view. A trail
# that will not read, or has a malformed interior line, conflicts with
# the user's own history. An ABSENT trail is Ok(empty), the first run.
# unlink, rollback, list and sync each had a copy (finding 160).
fn audit_read_or_refuse(what): Result {
    var tr_t, tr_v = audit_read_default_r();
    if (is_err_result(tr_t) == 1) {
        var trc = tr_v;
        hapi_eputs("hapi: ");
        hapi_eputs(hapi_ar_err_msg(trc));
        if (trc == HapiArCorrupt) {
            hapi_eputs(" (line ");
            hapi_eputs(hapi_itoa(audit_corrupt_line()));
            hapi_eputs(")");
        }
        hapi_eputs("\n  refusing to ");
        hapi_eputs(what);
        hapi_eputs(" on a partial view of the trail\n");
        return Err(1);
    }
    return Ok(tr_v);
}
