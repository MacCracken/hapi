# hapi — main entry point.
#
# Argv dispatcher. Ten verbs frozen at v1.0.0; --version /
# --help round out the surface. Global flags landed in M6:
#   --root <path>  — open a non-$HOME scope, gated by ADR 0005
#                    (HAPI_ALLOWED_ROOTS stopgap, kavach later).
#                    Accepted on: link, adopt, status, list, sync.
#   --dry-run      — show what would happen; no syscalls or
#                    audit writes. Accepted on: link, unlink,
#                    adopt, sync, rollback, checkpoint.
# M7 added:
#   --backup-to <dir> — snapshot the existing on-disk file
#                    before a destructive overwrite. Audit entry
#                    gains an additive `backup_path` field per ADR
#                    0002's growth contract. PARSED on link, sync
#                    and adopt; EFFECTIVE on `link --force` and
#                    `adopt` only — `sync` has no `--force`, so it
#                    has no destructive step and the flag is inert
#                    there (F-026). Kept accepted on sync rather
#                    than rejected: the command surface is frozen.
#
# The exit-code contract:
#   0  success
#   1  command-specific failure (parse error, conflict, IO,
#      capability denial)
#   2  bad usage (unknown verb, unknown / misplaced flag,
#      missing argument)

include "src/agnos_compat.cyr"
include "src/cmd/inspect.cyr"
include "src/cmd/link.cyr"
include "src/cmd/unlink.cyr"
include "src/cmd/adopt.cyr"
include "src/cmd/rollback.cyr"
include "src/cmd/checkpoint.cyr"
include "src/cmd/status.cyr"
include "src/cmd/list.cyr"
include "src/cmd/check.cyr"
include "src/cmd/sync.cyr"
include "src/cli.cyr"
include "src/cap.cyr"
include "src/backup.cyr"
include "lib/args.cyr"

# `hapi --version` prints `hapi <version>`. The number is
# CYRIUS_PKG_VERSION — the compile-time constant cyrius resolves
# from `[package].version`, which is `${file:VERSION}` — so the
# VERSION file at the project root is the only place it lives.
# Replaces the hand-synced literal this fn used to carry (the
# constant landed in cyrius 6.5.21; 6.5.34 made it visible in
# included files too, so a future move off main.cyr still works).
fn hapi_print_version(): i64 {
    print("hapi ", 5);
    println(CYRIUS_PKG_VERSION);
    return 0;
}

fn hapi_print_usage(): i64 {
    println("usage: hapi <command> [args...]");
    println("");
    println("commands:");
    println("  inspect <path>            parse and display a package manifest");
    println("  link <path> [--force]     create symlinks for the package");
    println("  unlink <pkg>              remove this package's symlinks from the trail");
    println("  adopt <file> <pkg>        move a file into a package, link back");
    println("  rollback                  reverse the audit trail to the last marker");
    println("  checkpoint                append a rollback-marker to the audit trail");
    println("  status <path>             show drift between manifest and on-disk symlinks");
    println("  list                      list packages tracked in the audit trail");
    println("  check <path> [--strict]   parse + display a manifest, optionally strict");
    println("  sync <path>               re-apply a manifest (idempotent)");
    println("");
    println("global flags:");
    println("  --root <path>             open a non-$HOME scope (link/adopt/status/list/sync)");
    println("                            requires the path to be inside $HOME or listed");
    println("                            in HAPI_ALLOWED_ROOTS (colon-separated)");
    println("  --dry-run                 print actions; no syscalls or audit writes");
    println("                            (link/unlink/adopt/sync/rollback/checkpoint)");
    println("  --backup-to <dir>         snapshot existing file content to <dir> before");
    println("                            a destructive overwrite (link --force / adopt).");
    println("                            Audit entry gains `backup_path`.");
    println("");
    println("options:");
    println("  --version, -v             print version and exit");
    println("  --help, -h                print this message and exit");
    return 0;
}

# Compare an argv cstring to a literal cstring (both null-terminated).
fn _hapi_argeq(arg, lit): i64 {
    if (arg == 0) { return 0; }
    var la = strlen(arg);
    var ll = strlen(lit);
    if (la != ll) { return 0; }
    return memeq(arg, lit, la);
}

# True if `arg` looks like a flag (starts with '-'). Used to
# guard against an unrecognized flag being swallowed as a
# positional argument.
fn _hapi_is_flag(arg): i64 {
    if (arg == 0) { return 0; }
    if (strlen(arg) < 1) { return 0; }
    if (load8(arg) == 45) { return 1; }
    return 0;
}

# Fetch the value token for a value-taking flag. Returns the argv
# pointer, or 0 when the next token is absent OR is itself a flag.
# Through 1.0.8 `--root --dry-run pkg` consumed `--dry-run` as the root
# value: the cap check passes whenever cwd is under $HOME, so a run the
# user asked to be a no-op created `$HOME/--dry-run/`, planted a symlink
# and appended to the trail — at exit 0 (F-019).
fn _hapi_flag_value(ai, n, flag): i64 {
    if (ai + 1 >= n) { return 0; }
    var v = argv(ai + 1);
    if (_hapi_is_flag(v) == 1) { return 0; }
    return v;
}

# strlen-based so the length cannot drift from the literal — the
# hand-counted eprints this replaces were one byte short and wrote a
# stray NUL to stderr.
fn _hapi_missing_value(flag, kind): i64 {
    eprint("hapi: ", 6);
    eprint(flag, strlen(flag));
    eprint(" requires a ", 12);
    eprint(kind, strlen(kind));
    var tail = " argument (a value starting with `-` must be spelled `./-name`)\n";
    eprint(tail, strlen(tail));
    return 0;
}

# Apply a `--root <value>` pair: cap-check the value, set the
# scope override on success. Returns 0 success / 1 cap denial
# / 2 missing value.
fn _hapi_apply_root(value): i64 {
    if (value == 0 || strlen(value) == 0) {
        eprint("hapi: --root requires a path argument\n", 39);
        return 2;
    }
    var cr_t, cr_v = cap_check_root_r(value);
    if (is_err_result(cr_t) == 1) {
        var code = cr_v;
        var msg = hapi_cap_err_msg(code);
        eprint("hapi: ", 6);
        eprint(msg, strlen(msg));
        eprint("\n", 1);
        return 1;
    }
    var abs_root = cr_v;
    link_set_scope_root(abs_root);
    return 0;
}

# Print a stock "unexpected argument" error. Every verb rejects a
# positional it has no slot for, rather than silently dropping it —
# through 1.0.4 `hapi rollback <pkg>` ignored the package name and
# reversed the ENTIRE visible trail at exit 0, and `hapi link A B`
# reported complete success having linked only A.
fn _hapi_extra_arg(verb, arg): i64 {
    eprint("hapi: unexpected argument for `", 31);
    eprint(verb, strlen(verb));
    eprint("`: ", 3);
    eprint(arg, strlen(arg));
    eprint("\n", 1);
    return 0;
}

# Print a stock "unexpected flag for this verb" error.
fn _hapi_unexpected_flag(verb, flag): i64 {
    eprint("hapi: unexpected flag for `", 27);
    eprint(verb, strlen(verb));
    eprint("`: ", 3);
    eprint(flag, strlen(flag));
    eprint("\n", 1);
    return 0;
}

fn main(): i64 {
    alloc_init();
    args_init();

    var n = argc();
    if (n < 2) {
        hapi_print_usage();
        return 2;
    }

    var verb = argv(1);

    if (_hapi_argeq(verb, "--version") == 1) { return hapi_print_version(); }
    if (_hapi_argeq(verb, "-v") == 1)        { return hapi_print_version(); }
    if (_hapi_argeq(verb, "--help") == 1)    { return hapi_print_usage(); }
    if (_hapi_argeq(verb, "-h") == 1)        { return hapi_print_usage(); }

    if (_hapi_argeq(verb, "inspect") == 1) {
        var path = 0;
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            # ADR 0005: a verb that takes no flags still owes exit 2 for
            # one, not the exit 1 that means "bad manifest" (F-033).
            if (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            elif (path == 0) { path = a; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_inspect(path);
    }

    if (_hapi_argeq(verb, "link") == 1) {
        var path = 0;
        var force = 0;
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--force") == 1) { force = 1; }
            elif (_hapi_argeq(a, "--dry-run") == 1) { hapi_set_dry_run(1); }
            elif (_hapi_argeq(a, "--root") == 1) {
                var v = _hapi_flag_value(ai, n, "--root");
                if (v == 0) { _hapi_missing_value("--root", "path"); return 2; }
                var rc = _hapi_apply_root(v);
                if (rc != 0) { return rc; }
                ai = ai + 1;
            }
            elif (_hapi_argeq(a, "--backup-to") == 1) {
                var bv = _hapi_flag_value(ai, n, "--backup-to");
                if (bv == 0) { _hapi_missing_value("--backup-to", "directory"); return 2; }
                hapi_set_backup_dir(bv);
                ai = ai + 1;
            }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            elif (path == 0) { path = a; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_link(path, force);
    }

    if (_hapi_argeq(verb, "unlink") == 1) {
        var pkg = 0;
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--dry-run") == 1) { hapi_set_dry_run(1); }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            elif (pkg == 0) { pkg = a; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_unlink(pkg);
    }

    if (_hapi_argeq(verb, "adopt") == 1) {
        var file = 0;
        var pkg = 0;
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--dry-run") == 1) { hapi_set_dry_run(1); }
            elif (_hapi_argeq(a, "--root") == 1) {
                var v = _hapi_flag_value(ai, n, "--root");
                if (v == 0) { _hapi_missing_value("--root", "path"); return 2; }
                var rc = _hapi_apply_root(v);
                if (rc != 0) { return rc; }
                ai = ai + 1;
            }
            elif (_hapi_argeq(a, "--backup-to") == 1) {
                var bv = _hapi_flag_value(ai, n, "--backup-to");
                if (bv == 0) { _hapi_missing_value("--backup-to", "directory"); return 2; }
                hapi_set_backup_dir(bv);
                ai = ai + 1;
            }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            elif (file == 0) { file = a; }
            elif (pkg == 0) { pkg = a; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_adopt(file, pkg);
    }

    if (_hapi_argeq(verb, "rollback") == 1) {
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--dry-run") == 1) { hapi_set_dry_run(1); }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_rollback();
    }

    if (_hapi_argeq(verb, "checkpoint") == 1) {
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--dry-run") == 1) { hapi_set_dry_run(1); }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_checkpoint();
    }

    if (_hapi_argeq(verb, "status") == 1) {
        var path = 0;
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--root") == 1) {
                var v = _hapi_flag_value(ai, n, "--root");
                if (v == 0) { _hapi_missing_value("--root", "path"); return 2; }
                var rc = _hapi_apply_root(v);
                if (rc != 0) { return rc; }
                ai = ai + 1;
            }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            elif (path == 0) { path = a; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_status(path);
    }

    if (_hapi_argeq(verb, "list") == 1) {
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--root") == 1) {
                var v = _hapi_flag_value(ai, n, "--root");
                if (v == 0) { _hapi_missing_value("--root", "path"); return 2; }
                var rc = _hapi_apply_root(v);
                if (rc != 0) { return rc; }
                ai = ai + 1;
            }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_list();
    }

    if (_hapi_argeq(verb, "sync") == 1) {
        var path = 0;
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--dry-run") == 1) { hapi_set_dry_run(1); }
            elif (_hapi_argeq(a, "--root") == 1) {
                var v = _hapi_flag_value(ai, n, "--root");
                if (v == 0) { _hapi_missing_value("--root", "path"); return 2; }
                var rc = _hapi_apply_root(v);
                if (rc != 0) { return rc; }
                ai = ai + 1;
            }
            elif (_hapi_argeq(a, "--backup-to") == 1) {
                var bv = _hapi_flag_value(ai, n, "--backup-to");
                if (bv == 0) { _hapi_missing_value("--backup-to", "directory"); return 2; }
                hapi_set_backup_dir(bv);
                ai = ai + 1;
            }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            elif (path == 0) { path = a; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_sync(path);
    }

    if (_hapi_argeq(verb, "check") == 1) {
        var path = 0;
        var strict = 0;
        var ai = 2;
        while (ai < n) {
            var a = argv(ai);
            if (_hapi_argeq(a, "--strict") == 1) { strict = 1; }
            elif (_hapi_is_flag(a) == 1) { _hapi_unexpected_flag(verb, a); return 2; }
            elif (path == 0) { path = a; }
            else { _hapi_extra_arg(verb, a); return 2; }
            ai = ai + 1;
        }
        return cmd_check(path, strict);
    }

    eprint("hapi: unknown command: ", 23);
    eprint(verb, strlen(verb));
    eprint("\n", 1);
    hapi_print_usage();
    return 2;
}

var r = main();
syscall(SYS_EXIT, r);
