# agnos_compat.cyr — target-portability shims for the agnos userland.
#
# hapi's syscall surface was written against Linux (with macOS/Windows
# peers). A handful of filesystem operations diverge on agnos
# (CYRIUS_TARGET_AGNOS): the same operation takes different syscall
# arities/argument-semantics, or names a syscall agnos lacks entirely.
# These thin wrappers centralize the divergence so the call sites in cmd/*,
# manifest_write, fs_link and audit stay target-clean. On every non-agnos
# target each wrapper forwards verbatim to the original Linux/mac call, so
# behavior there is unchanged (the compiler folds the indirection away).
#
# The agnos syscall ABI referenced below is documented in the agnos repo's
# docs/development/agnos-userland-abi.md.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/io.cyr"

# unlink(path). Linux: unlink(path). agnos: unlink(path, pathlen) — the
# path length is an explicit argument (no NUL-scan in the kernel).
fn hapi_unlink(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_unlink(path, strlen(path));
    #else
    return sys_unlink(path);
    #endif
}

# rename(old -> new). Linux: rename(old, new). agnos: rename(old, oldlen,
# new, newlen) — 4-arg, a4 in r10.
fn hapi_rename(old, new): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rename(old, strlen(old), new, strlen(new));
    #else
    return sys_rename(old, new);
    #endif
}

# fsync(fd). agnos has no per-fd fsync; SYS_SYNC (#12) flushes globally,
# which still guarantees the just-written manifest/audit bytes reach disk
# before the subsequent rename durability point. Linux keeps precise
# per-fd fsync.
fn hapi_fsync(fd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_sync();
    #else
    return sys_fsync(fd);
    #endif
}

# symlink(target, linkpath). Linux: symlink(target, linkpath). agnos:
# symlink(target, targetlen, linkpath, linkpathlen) — the native peer
# wrapper (agnos syscall #63, landed agnos 1.51.0 / cyrius 6.4.x stdlib).
fn hapi_symlink(target, linkpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_symlink(target, strlen(target), linkpath, strlen(linkpath));
    #else
    return sys_symlink(target, linkpath);
    #endif
}

# readlink(path, buf, buflen) → the symlink's TEXT target byte count (NOT
# NUL-terminated, ≤ buflen), or a negative error. agnos #70 is the introspection
# peer of symlink#63: it NO-FOLLOWs the final path component and returns -1 when
# `path` is not a symlink (incl. a missing path). Linux forwards to the 3-arg
# sys_readlink (returns -errno: EINVAL=22 not-a-symlink, ENOENT=2 absent). agnos
# takes the path length explicitly (path, pathlen, buf, buflen) — the native peer
# wrapper (cyrius 6.5.x stdlib), so the arity difference is the whole divergence.
fn hapi_readlink(path, buf, buflen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_readlink(path, strlen(path), buf, buflen);
    #else
    return sys_readlink(path, buf, buflen);
    #endif
}

# Open `path` WITHOUT following a final-component symlink.
#
# Linux/macOS get the real thing: `O_NOFOLLOW` is atomic — the kernel
# refuses with ELOOP inside the open itself, so no race exists. Spell the
# SYMBOL, never the number: the value is per-arch (x86_64 0x20000, arm64
# 0x8000, Darwin 0x100) and each `lib/syscalls_*` peer owns it. From 0.9.0
# through 1.0.11 this open carried the x86_64 literal, which on arm64 is
# O_LARGEFILE — so the aarch64 build followed symlinks here and F-003's
# defence was absent there (cyrius 6.6.4 named hapi as carrying it).
#
# agnos had no equivalent when this was first written: its AO_* set ended
# at AO_DIRECTORY, and `lib/io.cyr`'s bridge silently DROPPED the
# O_NOFOLLOW bit. So F-003's backup-copy TOCTOU defence did not exist on
# agnos — a swapped-in symlink's target content went into the "snapshot"
# and `hapi_backup_copy` returned 0 (F-031). 1.0.10 added a pre-check with
# the `readlink`#70 peer: if the path IS a symlink, refuse. That closed the
# realistic case but left the race between the readlink and the open.
#
# 1.1.1 closes the race (F-039). The kernel gained AO_NOFOLLOW at agnos
# 1.56.53, and since cyrius 6.6.4 `file_open` bridges O_NOFOLLOW to it, so
# the agnos arm now passes the flag too and the kernel refuses inside the
# open itself. The pre-check stays, for kernels older than 1.56.53: their
# open#7 looks at no bit it does not know (there is no flag validation), so
# the flag is a no-op there and the pre-check is still the whole defence —
# the residual race survives only on those kernels. No minimum kernel is
# needed. On agnos either refusal is a bare negative (-1 from the kernel,
# -40 from the pre-check); callers test `< 0`.
#
# The pre-check's buffer is the agnos link-body maximum (symlink#63:
# 4096). It was 64 through 1.1.0, and agnos readlink#70 answers -1 — not
# a truncated count — for a body longer than the buffer, so any link
# with a body of 65 bytes or more read as "not a symlink" and was
# followed. mirshi truncates like Linux and hid it; a real 1.57.14 kernel
# showed it.
fn hapi_open_nofollow(path, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var probe = alloc(4096);
    var n = hapi_readlink(path, probe, 4096);
    if (n > 0) { return 0 - 40; }          # ELOOP — it is a symlink
    #endif
    return file_open(path, flags | O_NOFOLLOW, 0);
}

# mkdir(path, mode). Linux: mkdir(path, mode). agnos: mkdir(path, pathlen)
# — SAME ARITY as Linux but the 2nd arg is the path length, not the mode,
# so this needs a real branch (a bare call miscompiles silently, no warning).
# agnos has no mode arg; permissions are fixed by the kernel.
#
# EEXIST handling: fsl_mkdir_parents / audit treat Linux EEXIST (errno 17)
# as success, but agnos signals every error as -1 with no errno, so that
# `err != 17` guard cannot fire on agnos. Real agnos ext2 mkdir is
# idempotent (existing dir → success), but under mirshi mkdir maps to the
# host FS where an existing dir returns -1. So on a failure, confirm via
# stat that the path is already a directory and report success — matching
# the Linux idempotent-parents behavior on both real agnos and mirshi.
fn hapi_mkdir(path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var rc = sys_mkdir(path, strlen(path));
    if (rc >= 0) { return 0; }
    var st = alloc(STAT_BUFSZ);
    if (sys_stat(path, strlen(path), st) < 0) { return rc; }
    if ((load64(st + STAT_MODE) & 0xF000) == 0x4000) { return 0; }
    return rc;
    #else
    return sys_mkdir(path, mode);
    #endif
}

# mkdir that says whether it made the directory: 1 created, 0 a directory
# (or, on Linux, anything — EEXIST, as fsl_mkdir_parents always took it) was
# already there, <0 failure. 1.4.0 records the directories `link` makes
# (`created_dir`), so "made it" must be exact. Linux says so in the EEXIST.
# agnos cannot: its ext2 mkdir is idempotent (an existing directory is
# success), so the agnos arm asks stat first. A directory another process
# makes between that stat and the mkdir would read as ours there; Linux
# sees it as EEXIST.
fn hapi_mkdir_made(path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var st = alloc(STAT_BUFSZ);
    if (sys_stat(path, strlen(path), st) >= 0) {
        if ((load64(st + STAT_MODE) & 0xF000) == 0x4000) { return 0; }
        return 0 - 1;
    }
    var rc = sys_mkdir(path, strlen(path));
    if (rc >= 0) { return 1; }
    return rc;
    #else
    var rc = sys_mkdir(path, mode);
    if (rc == 0) { return 1; }
    if (rc == 0 - 17) { return 0; }
    return rc;
    #endif
}

# rmdir(path). Linux: rmdir(path) — refuses a non-empty directory and does
# not follow a symlink. agnos: rmdir(path, pathlen), -1 for every failure.
fn hapi_rmdir(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path, strlen(path));
    #else
    return sys_rmdir(path);
    #endif
}

# 1 when an O_CREAT|O_EXCL open that failed with `err` failed because the
# name already exists. Linux reports -EEXIST (17 on x86_64 and arm64 alike —
# both use the asm-generic errno table). agnos reports a bare -1 for every
# failure (no errno; userland ABI §1), so ask stat whether the name resolves.
fn hapi_excl_exists(path, err): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var st = alloc(STAT_BUFSZ);
    if (sys_stat(path, strlen(path), st) >= 0) { return 1; }
    return 0;
    #else
    if (err == 0 - 17) { return 1; }
    return 0;
    #endif
}

# 1 when an open of `path` that failed with `err` failed because nothing is
# there (ENOENT), as opposed to a path that exists and will not open. Linux
# says so in the errno. agnos returns a bare -1 for both, so ask stat: the
# audit-trail reader's "no trail yet is an empty trail" rule (F-017) keyed
# on -ENOENT alone, and on agnos refused every absent trail as unreadable
# (F-044) — `hapi list` and `hapi rollback` failed before the first link.
fn hapi_open_absent(path, err): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var st = alloc(STAT_BUFSZ);
    if (sys_stat(path, strlen(path), st) < 0) { return 1; }
    return 0;
    #else
    if (err == 0 - 2) { return 1; }
    return 0;
    #endif
}

# NOTE: `file_append_locked` is NOT shimmed here. As of the cyrius 6.4.x
# stdlib, lib/io.cyr provides an agnos-aware implementation (LOCK_EX hold +
# explicit SEEK_END, since the agnos kernel does not honor AO_APPEND yet) —
# more correct than an append-flag open. Defining one here would shadow it.
