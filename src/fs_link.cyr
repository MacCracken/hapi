# fs_link.cyr — symlink primitives and path resolution.
#
# All path strings here are heap-allocated null-terminated
# cstrings (so they can hand straight to syscalls without a
# str_data() detour). Str values from manifest fields get
# converted to cstrings at the boundary via _fsl_str_to_cstr.
#
# Implements the symlink-shape decision from ADR 0003 — links
# carry a *relative* target computed at link time as the path
# from the link's parent directory to the absolute source.

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"

enum HapiLinkProbe {
    HAPI_LP_ABSENT = 0;
    HAPI_LP_SYMLINK = 1;
    HAPI_LP_FILE = 2;
    HAPI_LP_DIRECTORY = 3;
    HAPI_LP_ERROR = 4;
}

# Probe result: 16 bytes.
#   +0  kind (HAPI_LP_*)
#   +8  symlink target cstring (heap-allocated, null-terminated)
#       — only meaningful when kind == HAPI_LP_SYMLINK; 0 otherwise.
fn _fsl_probe_new(kind, target_cstr): i64 {
    var p = alloc(16);
    store64(p, kind);
    store64(p + 8, target_cstr);
    return p;
}
fn link_probe_kind(p): i64 { return load64(p); }
fn link_probe_target(p): i64 { return load64(p + 8); }

#ifdef CYRIUS_TARGET_AGNOS
# agnos only: 1 when the nearest ancestor of `path` that exists is a
# directory — i.e. a failed stat of `path` means "absent", not "a parent
# component is a file". 0 otherwise.
fn _fsl_agnos_parent_is_dir(path): i64 {
    var cur = _fsl_path_dirname(path);
    var st = alloc(STAT_BUFSZ);
    var go = 1;
    while (go == 1) {
        if (sys_stat(cur, strlen(cur), st) >= 0) {
            if ((load64(st + STAT_MODE) & 0xF000) == 0x4000) { return 1; }
            return 0;
        }
        if (strlen(cur) <= 1) { go = 0; }
        else { cur = _fsl_path_dirname(cur); }
    }
    return 0;
}
#endif

# Probe `path` (cstring) and classify what's there. readlink(2)
# is the cheap discriminator — its EINVAL is exactly the "exists
# but not a symlink" signal. We follow up with a directory probe
# (open + getdents) to split FILE vs DIRECTORY, because --force
# treats those differently.
fn link_probe(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos readlink#70 (the introspection peer of symlink#63) reads a symlink's
    # TEXT target and returns its byte length, or -1 when `path` is not a symlink
    # (a missing path included) — the same no-follow discriminator role the Linux
    # readlink EINVAL plays. So probe readlink FIRST: n > 0 ⇒ it's a symlink AND we
    # already hold the target to byte-compare against the manifest — including a
    # DANGLING link (target missing), which #70 sees but stat#33 would report
    # absent. Otherwise fall back to stat#33 to split file/dir/absent (stat follows
    # symlinks, but the path is not one here, so the final-component follow is moot).
    # Before readlink#70, agnos exposed neither lstat nor readlink to ring-3, so this
    # branch stat-classified and could neither SEE an existing link nor read its
    # target for the status/reconcile compare — #70 (agnos kernel) closed that.
    var buf = alloc(4096);
    var n = hapi_readlink(path, buf, 4096);
    if (n > 0) {
        var t = alloc(n + 1);
        memcpy(t, buf, n);
        store8(t + n, 0);
        return _fsl_probe_new(HAPI_LP_SYMLINK, t);
    }
    var st = alloc(STAT_BUFSZ);
    var rc = sys_stat(path, strlen(path), st);
    if (rc < 0) {
        # agnos says -1 for every failure, so "absent" has to be earned:
        # the path is absent only if its nearest existing ancestor is a
        # directory (F-050). Through 1.1.0 every failure was ABSENT, so a
        # path through a regular file (`file/sub`) read as absent where
        # Linux says ENOTDIR — `unlink` then reported it removed and wrote
        # no trail entry, and `list` kept counting it live.
        if (_fsl_agnos_parent_is_dir(path) == 1) { return _fsl_probe_new(HAPI_LP_ABSENT, 0); }
        return _fsl_probe_new(HAPI_LP_ERROR, 0);
    }
    if ((load64(st + STAT_MODE) & 0xF000) == 0x4000) { return _fsl_probe_new(HAPI_LP_DIRECTORY, 0); }
    return _fsl_probe_new(HAPI_LP_FILE, 0);
    #else
    var buf = alloc(4096);
    var n = sys_readlink(path, buf, 4096);
    if (n > 0) {
        var t = alloc(n + 1);
        memcpy(t, buf, n);
        store8(t + n, 0);
        return _fsl_probe_new(HAPI_LP_SYMLINK, t);
    }
    var err = 0 - n;
    if (err == 2) { return _fsl_probe_new(HAPI_LP_ABSENT, 0); }
    if (err == 22) {
        # Path exists, not a symlink. Split file vs directory with stat
        # (F-049). Through 1.1.0 this opened the path O_RDONLY and tried
        # getdents, which had two failure modes: a FIFO at a target made
        # the open block until a writer came, so `link` and `status` hung;
        # and any open failure read as FILE, so a mode-000 directory was
        # reported as a regular file. stat needs neither read permission
        # nor an open. The final component is already known not to be a
        # symlink, so stat's following it is moot. Anything that is not a
        # directory — a FIFO, a socket, a device — stays FILE, as before.
        # sys_stat is the per-arch peer (x86_64 stat, arm64 fstatat), and
        # STAT_MODE its per-arch offset.
        var st = alloc(STAT_BUFSZ);
        if (sys_stat(path, st) < 0) { return _fsl_probe_new(HAPI_LP_ERROR, 0); }
        if ((load64(st + STAT_MODE) & 0xF000) == 0x4000) { return _fsl_probe_new(HAPI_LP_DIRECTORY, 0); }
        return _fsl_probe_new(HAPI_LP_FILE, 0);
    }
    return _fsl_probe_new(HAPI_LP_ERROR, 0);
    #endif
}

# Is a manifest row's `source` actually there? GNU stow probes the source
# before it links; hapi did not, so a row naming a file that is not in the
# package produced a symlink pointing at nothing (F-022).
#
# Present means FILE, DIRECTORY or SYMLINK. Everything else is refused,
# ABSENT and ERROR alike: ERROR covers ENOTDIR (the row source traverses a
# regular file — `zshrc/sub` where `zshrc` is a file) as well as an
# unsearchable parent, and hapi's standing posture for a state it cannot
# prove is to refuse, never to assume (see fsl_resolve_path's hop cap).
# `link` and `status` share this predicate so they cannot disagree.
fn fsl_source_present(path): i64 {
    var k = link_probe_kind(link_probe(path));
    if (k == HAPI_LP_FILE) { return 1; }
    if (k == HAPI_LP_DIRECTORY) { return 1; }
    if (k == HAPI_LP_SYMLINK) { return 1; }
    return 0;
}

# Heap-copy a Str's bytes into a null-terminated cstring.
fn _fsl_str_to_cstr(s: Str): i64 {
    var len = str_len(s);
    var out = alloc(len + 1);
    memcpy(out, str_data(s), len);
    store8(out + len, 0);
    return out;
}

# Heap-copy a cstring (clone).
fn _fsl_cstr_dup(c): i64 {
    var n = strlen(c);
    var out = alloc(n + 1);
    memcpy(out, c, n);
    store8(out + n, 0);
    return out;
}

# Join `dir` and `name` with a '/' separator (skipping the
# separator when dir already ends in one). Both inputs are
# cstrings; output is a fresh heap cstring.
fn _fsl_path_join(dir, name): i64 {
    var dl = strlen(dir);
    var nl = strlen(name);
    var sep = 1;
    if (dl > 0 && load8(dir + dl - 1) == 47) { sep = 0; }
    var out = alloc(dl + sep + nl + 1);
    memcpy(out, dir, dl);
    if (sep == 1) { store8(out + dl, 47); }
    memcpy(out + dl + sep, name, nl);
    store8(out + dl + sep + nl, 0);
    return out;
}

# Get the dirname (everything before the last '/') as a cstring.
# Returns "." when there's no '/' in the input.
fn _fsl_path_dirname(path): i64 {
    var n = strlen(path);
    var last = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return _fsl_cstr_dup("."); }
    if (last == 0) { return _fsl_cstr_dup("/"); }
    var out = alloc(last + 1);
    memcpy(out, path, last);
    store8(out + last, 0);
    return out;
}

# Get the process's current working directory as a cstring.
# Used as the base for resolving the package-dir argument
# when the user passes a relative path.
fn _fsl_getcwd(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no getcwd syscall (no per-process cwd concept in the
    # userland ABI). Its kernel does stage `PWD` into the init envp at
    # exec, so prefer that when it is absolute — it is the only source
    # of truth available (F-027).
    var pwd = getenv("PWD");
    if (pwd != 0 && strlen(pwd) > 0 && load8(pwd) == 47) {
        var pl = strlen(pwd);
        var pc = alloc(pl + 1);
        memcpy(pc, pwd, pl);
        store8(pc + pl, 0);
        return pc;
    }
    # No usable PWD (a supervisor that passes no envp, for one). Return
    # 0 rather than "." — "." made `fsl_to_absolute` hand back a
    # RELATIVE path that flowed into the trail's `abs_source`, which
    # ADR 0002 requires to be absolute. The caller must refuse instead.
    return 0;
    #else
    var buf = alloc(4096);
    var n = syscall(SYS_GETCWD, buf, 4096);
    if (n < 0) {
        var fb = alloc(2);
        store8(fb, 46); store8(fb + 1, 0);
        return fb;
    }
    # On Linux, getcwd writes a null-terminated path; the return
    # value is the length including the trailing null. The buf is
    # already what we want — just clone it tight.
    var len = strlen(buf);
    var out = alloc(len + 1);
    memcpy(out, buf, len);
    store8(out + len, 0);
    return out;
    #endif
}

# Resolve `path` (cstring) to an absolute cstring. If already
# absolute (starts with '/'), returns a clone. Otherwise prefixes
# the cwd with '/' as separator. Note: does NOT resolve `..` or
# `.` segments. Call `fsl_lexical_normalize` afterward when the
# result will be byte-compared against a permitted prefix (e.g.
# the capability cap-check).
fn fsl_to_absolute(path): i64 {
    var n = strlen(path);
    if (n > 0 && load8(path) == 47) { return _fsl_cstr_dup(path); }
    var cwd = _fsl_getcwd();
    if (cwd == 0) { return 0; }        # cwd unknowable — see F-027
    return _fsl_path_join(cwd, path);
}

# Canonicalize a user-supplied path ARGUMENT: absolutize, then
# collapse `.` / `..` / `//` lexically (F-024). Same treatment
# `--root` already gets in cap_check_root_r.
# Returns 0 when the argument is relative AND the cwd cannot be
# determined — on agnos with no usable `PWD`. Every caller must treat 0
# as a refusal: continuing would put a non-absolute path into the
# trail's `abs_source`, which ADR 0002 requires to be absolute, and the
# resulting symlink body resolves against the wrong directory (F-027).
fn fsl_canonical_arg(path): i64 {
    var abs = fsl_to_absolute(path);
    if (abs == 0) { return 0; }
    if (load8(abs) != 47) { return 0; }
    return fsl_lexical_normalize(abs);
}

# Lexical path canonicalization: collapse `.` and `..` segments
# in `path` (an absolute cstring). Returns a fresh heap cstring.
#
# `/a/b/../c` → `/a/c`
# `/a/./b`    → `/a/b`
# `/a/b/..`   → `/a`
# `/..`       → `/` (cannot escape root)
# `/`         → `/`
#
# Lexical means: no filesystem calls; no symlink resolution. A
# leading symlink in the path is preserved (`/home/user/trap`
# stays `/home/user/trap` even if `trap` is a symlink). This is
# exactly the property the capability cap-check needs to reject
# `--root /home/user/../etc` while leaving the symlink-resolution
# question for the kavach migration.
# Split a path into its components, absolute or relative. Returns a vec
# of Str; an empty segment (a leading or doubled `/`) is dropped, so
# `/a/b` and `a/b` split alike. `.` and `..` are kept for the caller.
#
# Through 1.7.0 the scan began at byte 1, as if every path began with
# `/`. fsl_resolve_path also splits a symlink's own text, which is
# usually relative, so its first byte was lost: `../outside` read as
# `./outside`, `dotfiles/config` as `otfiles/config`. A relative link
# out of $HOME then resolved inside it, and every check made on the
# resolved path was made on the wrong one (F-065). `from` is 1 only for
# the legacy resolver below.
fn _fsl_split_from(path, from): i64 {
    var parts = vec_new();
    var n = strlen(path);
    var start = from;
    var i = from;
    while (i <= n) {
        var at_sep = 0;
        if (i == n) { at_sep = 1; }
        elif (load8(path + i) == 47) { at_sep = 1; }
        if (at_sep == 1) {
            var seg_len = i - start;
            if (seg_len > 0) { vec_push(parts, str_new(path + start, seg_len)); }
            start = i + 1;
        }
        i = i + 1;
    }
    return parts;
}

fn _fsl_split(path): i64 { return _fsl_split_from(path, 0); }

# Resolve `path` by following a symlink at EVERY component, left to
# right — the physical path, as the kernel would reach it.
#
# This is the missing half of the capability boundary (F-015).
# `fsl_lexical_normalize` collapses `..` but treats every component as a
# plain name, so an ordinary convenience symlink — `~/.config ->
# /mnt/other/etc` — put a manifest target outside the scope root on a
# PLAIN `hapi link`, no flag involved, and `--force` then deleted
# whatever was there. Lexical containment cannot see that; only
# following the links can.
#
# Components that do not exist yet are kept literally: hapi creates
# parent directories, so the parent of a new target is routinely absent,
# and an absent component cannot be a symlink out of the scope.
#
# `.` and `..` are walked, not pre-collapsed (F-052). Through 1.1.0 the
# path was lexically normalized first, which popped `..` against the
# literal name before it — so `a/..` with `a -> /outside` came out as the
# directory holding `a`, while the kernel goes to /outside's parent.
# `adopt 'a/../c.conf'` moved a file from outside $HOME into the package
# on that. A `..` now pops the RESOLVED prefix, which is exactly the
# kernel's physical parent, and a symlink's own text is spliced in raw
# for the same reason.
#
# A component hapi cannot probe ends the walk with 0 (F-066). Through
# 1.7.0 an ERROR probe was kept as a plain name, like an absent one. But
# the probe spells the RESOLVED prefix, and the kernel walks the short
# path it is given: past 4096 resolved bytes readlink says ENAMETOOLONG,
# and a symlink there was never followed by hapi while the write
# followed it out of the scope. Only an absent component is kept
# literally; nothing below it can be a symlink.
#
# Hop-capped at 40 (the kernel's own ELOOP budget). Returns 0 if the cap
# is hit, or a component cannot be probed — the caller must treat that as
# "cannot prove containment" and refuse, never as "contained".
fn fsl_resolve_path(path): i64 { return _fsl_resolve(path, 0); }

# The resolver 1.1.1–1.7.0 shipped, kept for one use only: recognizing
# the link texts those versions wrote (fsl_link_text_matches), so the
# links stay removable after the fix. It splits a link's text from byte 1
# and keeps an unprobeable component as a name. Never use it to decide
# containment, the package guard, or a text to create.
fn _fsl_resolve_path_legacy(path): i64 { return _fsl_resolve(path, 1); }

# fsl_source_reaches' watch: while set, the walk notes any path it visits
# that lies within `_fsl_watch`.
var _fsl_watch = 0;
var _fsl_watch_hit = 0;

fn _fsl_resolve(path, legacy): i64 {
    var abs = fsl_to_absolute(path);
    if (abs == 0) { return 0; }
    var hops = 0;
    var parts = _fsl_split(abs);
    var idx = 0;
    var acc = alloc(2);
    store8(acc, 47); store8(acc + 1, 0);          # "/"

    var go = 1;
    while (go == 1) {
        if (idx >= vec_len(parts)) { go = 0; continue; }
        var seg = _fsl_str_to_cstr(vec_get(parts, idx));
        idx = idx + 1;
        if (_fsl_seg_is(seg, ".") == 1) { continue; }
        if (_fsl_seg_is(seg, "..") == 1) {
            acc = _fsl_path_dirname(acc);           # dirname("/") is "/"
            continue;
        }
        var cand = _fsl_path_join(acc, seg);
        if (_fsl_watch != 0) {
            if (_fsl_within(cand, _fsl_watch) == 1) { _fsl_watch_hit = 1; }
        }
        var probe = link_probe(cand);
        var kind = link_probe_kind(probe);
        if (kind == HAPI_LP_ERROR && legacy == 0) { return 0; }
        if (kind == HAPI_LP_SYMLINK) {
            hops = hops + 1;
            if (hops > 40) { return 0; }
            var tgt = link_probe_target(probe);
            if (tgt == 0) { return 0; }
            # Continue from the link's text, then the components we have
            # not consumed. An absolute text restarts at "/"; a relative
            # one resolves from the link's own (already resolved) parent,
            # which `acc` still is.
            if (load8(tgt) == 47) {
                acc = alloc(2);
                store8(acc, 47); store8(acc + 1, 0);
            }
            var merged = _fsl_split_from(tgt, legacy);
            var r = idx;
            while (r < vec_len(parts)) { vec_push(merged, vec_get(parts, r)); r = r + 1; }
            parts = merged;
            idx = 0;
        } else {
            acc = cand;
        }
    }
    return acc;
}

# 1 when the source, followed to where it physically leads, reaches the
# target `phys_tgt`: it passes through it, ends inside it, or holds it —
# or when the walk cannot be finished, since the caller refuses on 1
# (F-069). Through 1.7.0 the source was only probed for presence, and a
# symlink counted as present without being followed. So the layout people
# migrate from, `pkg/bashrc -> ~/.bashrc` with the row `bashrc ->
# .bashrc`, was an ordinary conflict, and `--force` deleted the only copy
# and planted `.bashrc -> pkg/bashrc -> .bashrc`, a loop status called
# OK. A source that holds its target (`pkg/cfg -> ~/.config`, row
# `.config/app`) made a directory cycle the same way.
fn fsl_source_reaches(abs_src, phys_tgt): i64 {
    if (abs_src == 0 || phys_tgt == 0) { return 1; }
    _fsl_watch = phys_tgt;
    _fsl_watch_hit = 0;
    var end = fsl_resolve_path(abs_src);
    _fsl_watch = 0;
    if (end == 0) { return 1; }
    if (_fsl_watch_hit == 1) { return 1; }          # through it, or ends inside it
    if (_fsl_within(phys_tgt, end) == 1) { return 1; }
    return 0;
}

fn _fsl_seg_is(seg, lit): i64 {
    var n = strlen(lit);
    if (strlen(seg) != n) { return 0; }
    return memeq(seg, lit, n);
}

# Is the PHYSICAL location of `path` inside the PHYSICAL scope root?
# Both sides are resolved, so a scope root that is itself reached
# through a symlink (`/home/u -> /mnt/home/u`) does not cause a false
# refusal. Returns 0 when containment cannot be proven.
# Component-boundary prefix match. Local to this module: cap.cyr's
# equivalent lives downstream of this file (it includes fs_link.cyr), so
# reaching for it here would be a cycle.
fn _fsl_within(path, prefix): i64 {
    var pn = strlen(path);
    var fn_ = strlen(prefix);
    if (fn_ == 0) { return 0; }
    # "/" contains every absolute path — see _cap_path_within (F-047).
    if (fn_ == 1 && load8(prefix) == 47) {
        if (pn > 0 && load8(path) == 47) { return 1; }
        return 0;
    }
    if (fn_ > 1 && load8(prefix + fn_ - 1) == 47) { fn_ = fn_ - 1; }
    if (pn < fn_) { return 0; }
    if (memeq(path, prefix, fn_) == 0) { return 0; }
    if (pn == fn_) { return 1; }
    if (load8(path + fn_) == 47) { return 1; }
    return 0;
}

fn fsl_resolved_within(path, scope_root): i64 {
    var rp = fsl_resolve_path(path);
    if (rp == 0) { return 0; }
    var rs = fsl_resolve_path(scope_root);
    if (rs == 0) { return 0; }
    return _fsl_within(rp, rs);
}

# The final component of `path` (no slash), or `path` itself when it has
# no slash.
fn _fsl_path_basename(path): i64 {
    var n = strlen(path);
    var i = n;
    while (i > 0 && load8(path + i - 1) != 47) { i = i - 1; }
    return _fsl_cstr_dup(path + i);
}

# Where a link at `abs_target` PHYSICALLY sits: its parent resolved
# through every symlink, plus its own final name left unresolved. The
# final component is not followed on purpose — for an up-to-date row it
# IS hapi's symlink, and following that lands in the package by design.
# Returns 0 when the parent cannot be resolved (hop cap).
fn fsl_physical_target(abs_target): i64 {
    var rp = fsl_resolve_path(_fsl_path_dirname(abs_target));
    if (rp == 0) { return 0; }
    return _fsl_path_join(rp, _fsl_path_basename(abs_target));
}

# 1 when a link at `abs_target` would physically sit inside `dir` — or
# when that cannot be proven either way, since the caller refuses on 1.
#
# Containment in the SCOPE was already decided on the resolved path
# (F-015), but nothing asked the same question of the PACKAGE (F-045):
# with `~/.ssh -> dotfiles/pkg/ssh` and a row `ssh/config -> .ssh/config`,
# the target is the row's own source reached through a symlinked parent.
# `link` called it an "existing regular file", and `--force` deleted the
# user's only copy and planted a symlink to itself. Both paths are inside
# $HOME, so the scope check was satisfied.
fn fsl_lands_in(abs_target, dir): i64 {
    var pt = fsl_physical_target(abs_target);
    if (pt == 0) { return 1; }
    var rd = fsl_resolve_path(dir);
    if (rd == 0) { return 1; }
    return _fsl_within(pt, rd);
}

# The text hapi writes into the symlink at `abs_target` (ADR 0003): the
# relative path from the link's parent directory to the source — the
# directory the link PHYSICALLY sits in.
#
# Through 1.1.0 this was computed from the LEXICAL parent (F-046). The
# two agree unless a parent component is a symlink, and then they need
# not: with `~/.config -> data/deep/config`, a row `.config/rc` got the
# text `../dotfiles/pkg/rc`, which the kernel resolves from
# `~/data/deep/config` to a path that does not exist. `link` reported
# success, `status` said OK (it compares the text, which matched), and a
# re-run said up to date. The source half stays lexical on purpose — a
# package reached through a symlink resolves on its own, and resolving it
# here would bake that mount into every link, against ADR 0003's
# portability rationale.
#
# An unresolvable parent (hop cap) falls back to the lexical one; every
# caller refuses such a row on the scope check before writing anything.
fn fsl_link_text(abs_target, abs_source): i64 {
    var parent = _fsl_path_dirname(abs_target);
    var rp = fsl_resolve_path(parent);
    if (rp == 0) { rp = parent; }
    return fsl_compute_relative(rp, abs_source);
}

# The absolute text (1.6.0, `--absolute`; ADR 0003 addendum): the source's
# path as spelled, lexically normalized and never resolved — the same
# choice the relative text makes for its source half, so a package
# reached through a symlink keeps that indirection.
fn fsl_absolute_text(abs_source): i64 {
    return fsl_lexical_normalize(abs_source);
}

# The text a link hapi creates gets: the absolute text when `absolute` is
# 1, else the relative one. 0 for an absolute text of a source that is not
# an absolute path — `link` and `adopt` cannot produce one, but rollback
# reads `abs_source` from a trail that can be edited, and would write
# that relative path as the "absolute" text. Its callers skip on 0.
fn fsl_link_text_shaped(abs_target, abs_source, absolute): i64 {
    if (absolute == 1) {
        if (abs_source == 0 || load8(abs_source) != 47) { return 0; }
        return fsl_absolute_text(abs_source);
    }
    return fsl_link_text(abs_target, abs_source);
}

# 1 when `text` is the absolute text for `abs_source`. A relative text is
# ruled out on its first byte, before anything is normalized.
fn fsl_is_absolute_text(text, abs_source): i64 {
    if (text == 0 || abs_source == 0) { return 0; }
    if (load8(text) != 47) { return 0; }
    var want = fsl_absolute_text(abs_source);
    var n = strlen(text);
    if (strlen(want) != n) { return 0; }
    return memeq(text, want, n);
}

# The trail's `shape` for a link whose text hapi accepted as its own:
# "absolute" for an absolute text, 0 (no field) for a relative one.
fn fsl_shape_of(text): i64 {
    if (text != 0 && load8(text) == 47) { return "absolute"; }
    return 0;
}

# 1 when the symlink text `text` at `abs_target` is one hapi wrote for
# `abs_source`: today's text, the absolute text (1.6.0), the
# lexical-parent text hapi 1.1.0 and earlier wrote, or the text 1.1.1–
# 1.7.0 wrote from a parent their resolver mis-resolved (F-065). Removal
# (unlink, rollback, prune) accepts all four, so a link an older hapi
# planted under a symlinked parent stays removable — "we only remove what
# we created". Creation and `status` accept today's relative text and the
# absolute one.
fn fsl_link_text_matches(text, abs_target, abs_source): i64 {
    if (text == 0) { return 0; }
    if (fsl_is_absolute_text(text, abs_source) == 1) { return 1; }
    var parent = _fsl_path_dirname(abs_target);
    if (_fsl_text_is(text, fsl_link_text(abs_target, abs_source)) == 1) { return 1; }
    if (_fsl_text_is(text, fsl_compute_relative(parent, abs_source)) == 1) { return 1; }
    var lp = _fsl_resolve_path_legacy(parent);
    if (lp == 0) { lp = parent; }
    if (_fsl_text_is(text, fsl_compute_relative(lp, abs_source)) == 1) { return 1; }
    return 0;
}

fn _fsl_text_is(text, want): i64 {
    if (want == 0) { return 0; }
    var n = strlen(text);
    if (strlen(want) != n) { return 0; }
    return memeq(text, want, n);
}

fn fsl_lexical_normalize(path): i64 {
    var n = strlen(path);
    if (n == 0 || load8(path) != 47) { return _fsl_cstr_dup(path); }

    var parts = vec_new();
    var start = 1;
    var i = 1;
    while (i <= n) {
        var at_sep = 0;
        if (i == n) { at_sep = 1; }
        elif (load8(path + i) == 47) { at_sep = 1; }
        if (at_sep == 1) {
            var seg_len = i - start;
            if (seg_len > 0) {
                if (seg_len == 1 && load8(path + start) == 46) {
                    # "." segment — drop
                } elif (seg_len == 2 && load8(path + start) == 46
                  && load8(path + start + 1) == 46) {
                    if (vec_len(parts) > 0) { vec_pop(parts); }
                } else {
                    vec_push(parts, str_new(path + start, seg_len));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }

    var sn = vec_len(parts);
    if (sn == 0) {
        var root = alloc(2);
        store8(root, 47);
        store8(root + 1, 0);
        return root;
    }
    var total = 0;
    var k = 0;
    while (k < sn) {
        total = total + 1 + str_len(vec_get(parts, k));
        k = k + 1;
    }
    var out = alloc(total + 1);
    var pos = 0;
    k = 0;
    while (k < sn) {
        store8(out + pos, 47); pos = pos + 1;
        var s = vec_get(parts, k);
        memcpy(out + pos, str_data(s), str_len(s));
        pos = pos + str_len(s);
        k = k + 1;
    }
    store8(out + pos, 0);
    return out;
}

# Split a cstring path on '/' into a vec of Str slices that
# borrow into the input. Empty components (from leading '/' or
# '//') are dropped. Used by fsl_compute_relative.
fn _fsl_split_path(path): i64 {
    var v = vec_new();
    var n = strlen(path);
    var start = 0;
    var i = 0;
    while (i <= n) {
        var c = 47;
        if (i < n) { c = load8(path + i); }
        if (c == 47 || i == n) {
            if (i > start) {
                vec_push(v, str_new(path + start, i - start));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return v;
}

# Compare two Str values for byte-equality.
fn _fsl_str_byteeq(a: Str, b: Str): i64 {
    var an = str_len(a);
    var bn = str_len(b);
    if (an != bn) { return 0; }
    var ap = str_data(a);
    var bp = str_data(b);
    var i = 0;
    while (i < an) {
        if (load8(ap + i) != load8(bp + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Compute the relative path from `from_dir` (the link's parent
# directory, absolute) to `to_file` (the source file, absolute).
# Result is a fresh cstring with `..` segments for the
# from_dir components not shared by to_file.
#
# Both inputs MUST be absolute paths (start with '/'). Caller
# resolves via fsl_to_absolute.
fn fsl_compute_relative(from_dir, to_file): i64 {
    var from_parts = _fsl_split_path(from_dir);
    var to_parts   = _fsl_split_path(to_file);

    var fn_ = vec_len(from_parts);
    var tn = vec_len(to_parts);
    var lim = fn_;
    if (tn < lim) { lim = tn; }
    var common = 0;
    var go = 1;
    while (common < lim && go == 1) {
        var fp = vec_get(from_parts, common);
        var tp = vec_get(to_parts, common);
        if (_fsl_str_byteeq(fp, tp) == 0) { go = 0; }
        else { common = common + 1; }
    }

    # Output: `..` for each from_dir component past `common`,
    # then each to_file component past `common`.
    var ups = fn_ - common;
    # Worst-case length: ups * 3 (`../`) + sum of remaining-to-parts lengths + slashes
    var cap = ups * 3 + 1;
    var k = common;
    while (k < tn) {
        cap = cap + str_len(vec_get(to_parts, k)) + 1;
        k = k + 1;
    }
    if (cap < 4) { cap = 4; }
    var out = alloc(cap);
    var pos = 0;
    var u = 0;
    while (u < ups) {
        store8(out + pos, 46); store8(out + pos + 1, 46); store8(out + pos + 2, 47);
        pos = pos + 3;
        u = u + 1;
    }
    k = common;
    var first_tail = 1;
    while (k < tn) {
        if (first_tail == 0) { store8(out + pos, 47); pos = pos + 1; }
        var t = vec_get(to_parts, k);
        var tlen = str_len(t);
        memcpy(out + pos, str_data(t), tlen);
        pos = pos + tlen;
        first_tail = 0;
        k = k + 1;
    }
    # Strip a trailing slash if we wrote only `..` segments.
    if (pos > 0 && load8(out + pos - 1) == 47) { pos = pos - 1; }
    if (pos == 0) {
        # Same dir, same file. Shouldn't happen for our usage
        # but emit "." rather than the empty string.
        store8(out, 46);
        pos = 1;
    }
    store8(out + pos, 0);
    return out;
}

# mkdir -p `path`'s parent. Treats EEXIST as success. Mode 0700.
# Returns 0 on success, negative on first non-EEXIST failure.
# Mode-carrying form. `mode` is the mkdir(2) mode, which the kernel then
# filters through the process umask.
#
# Two callers want opposite things (F-029). A directory hapi creates in
# the user's $HOME on their behalf should look like one they made
# themselves — 0777 through their umask. A directory holding hapi's own
# state must stay private regardless of umask: the audit trail records
# every path the user links, and `--backup-to` snapshots are written
# 0644, so the directory is the only thing holding the line. Through
# 1.0.8 both got a hardcoded 0700, which made the second correct and the
# first wrong — a `--root` deployment produced config directories the
# consuming service could not traverse.
# Create every missing directory on the way to `file_path` (its parent
# included). With `created_out` non-zero, also store there the outermost
# directory THIS call made, provided it made every directory from there
# down to the parent; 0 when it made none. A directory found already there
# restarts that run below it, so a racing creator's directory is never
# claimed. That one path is what a 1.4.0 `op:link` records as
# `created_dir`: `mkdir -p` makes a contiguous chain, so the outermost
# directory implies the rest.
fn fsl_mkdir_parents_mode_r(file_path, mode, created_out): i64 {
    if (created_out != 0) { store64(created_out, 0); }
    var n = strlen(file_path);
    var last_slash = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(file_path + i) == 47) { last_slash = i; }
        i = i + 1;
    }
    if (last_slash <= 0) { return 0; }

    var tmp = alloc(n + 1);
    memcpy(tmp, file_path, n);
    store8(tmp + n, 0);

    var top = 0 - 1;            # offset in `tmp` where the made run begins
    var j = 1;
    while (j <= last_slash) {
        if (j == last_slash || load8(tmp + j) == 47) {
            store8(tmp + j, 0);
            var rc = hapi_mkdir_made(tmp, mode);
            store8(tmp + j, 47);
            if (rc < 0) { return rc; }
            if (rc == 0) { top = 0 - 1; }
            elif (top < 0) { top = j; }
        }
        j = j + 1;
    }
    if (created_out != 0 && top > 0) {
        var out = alloc(top + 1);
        memcpy(out, file_path, top);
        store8(out + top, 0);
        store64(created_out, out);
    }
    return 0;
}

fn fsl_mkdir_parents_mode(file_path, mode): i64 {
    return fsl_mkdir_parents_mode_r(file_path, mode, 0);
}

# Create a symlink at `linkpath` pointing at `target`. Creates
# the parent directory of `linkpath` on demand. Returns the
# raw kernel return code (0 on success, -errno on failure).
# Back-compat name: private (0700) parents. Kept so the state-dir and
# backup-destination callers, which WANT 0700, need no change.
fn fsl_mkdir_parents(file_path): i64 {
    return fsl_mkdir_parents_mode(file_path, 0x1C0);
}

# link_create, also storing in `created_out` (when non-zero) the outermost
# directory it made for the link, or 0 (see fsl_mkdir_parents_mode_r). If
# the symlink then fails, the directories it made are removed again.
fn link_create_r(target, linkpath, created_out): i64 {
    if (created_out != 0) { store64(created_out, 0); }
    # symlink(2) can never create a path spelled with a trailing '/'
    # (EEXIST/ENOENT either way), so refuse BEFORE mkdir_parents
    # materializes the directory we would then fail to link over (F-032).
    var lpn = strlen(linkpath);
    if (lpn == 0 || load8(linkpath + lpn - 1) == 47) { return 0 - 22; }
    # 0777-through-umask: these land in the user's scope and should look
    # like directories they created themselves (F-029). hapi's own state
    # directories keep the private 0700 default of `fsl_mkdir_parents`.
    var made = 0;
    var mkrc = fsl_mkdir_parents_mode_r(linkpath, 0x1FF, &made);
    if (mkrc < 0) { return mkrc; }
    var src = hapi_symlink(target, linkpath);
    if (src < 0) {
        if (made != 0) { fsl_rmdir_created(linkpath, made, 0); }
        return src;
    }
    if (created_out != 0) { store64(created_out, made); }
    return 0;
}

fn link_create(target, linkpath): i64 {
    return link_create_r(target, linkpath, 0);
}

# Remove the directories a link's creation made, once the link is gone:
# from the link's parent up to and including `top` (its `created_dir`),
# deepest first, stopping at the first that is not an empty directory.
# Call it only after removing the link itself. The link sitting in the
# directory is the proof that the directory is still the one hapi made,
# not one the user deleted and made again. Each directory removed is
# appended to `removed` (a vec, or 0). Returns the count removed.
#
# `top` must be a proper prefix of `abs_target` ending at a '/'. That is
# the relation link_create_r recorded it in, and anything else (an edited
# trail) removes nothing. "/" never qualifies: no absolute path has a
# second '/' right after the first.
fn _fsl_made_ok(abs_target, top): i64 {
    if (abs_target == 0 || top == 0) { return 0; }
    var tn = strlen(top);
    if (tn == 0 || tn >= strlen(abs_target)) { return 0; }
    if (load8(top) != 47 || load8(abs_target + tn) != 47) { return 0; }
    return memeq(abs_target, top, tn);
}

# 1 when every directory from `abs_target`'s parent up to `top` is still a
# real directory, not a symlink. All of them are checked before any is
# removed (F-062): the walk goes deepest first, so a made directory swapped
# for a symlink higher up would otherwise be resolved through by the
# rmdir below it. That removed an empty directory of the same name
# wherever the symlink led — a path judged on its spelling where the
# kernel acts on where it goes, the F-015 / F-051 shape. Directories above
# `top` were the user's before hapi came, and may be symlinks.
fn _fsl_chain_is_real(abs_target, top): i64 {
    var tn = strlen(top);
    var dir = _fsl_path_dirname(abs_target);
    var go = 1;
    while (go == 1) {
        if (link_probe_kind(link_probe(dir)) != HAPI_LP_DIRECTORY) { return 0; }
        if (strlen(dir) <= tn) { go = 0; }
        else { dir = _fsl_path_dirname(dir); }
    }
    return 1;
}

fn fsl_rmdir_created(abs_target, top, removed): i64 {
    if (_fsl_made_ok(abs_target, top) == 0) { return 0; }
    if (_fsl_chain_is_real(abs_target, top) == 0) { return 0; }
    var tn = strlen(top);
    var count = 0;
    var dir = _fsl_path_dirname(abs_target);
    var go = 1;
    while (go == 1) {
        if (link_probe_kind(link_probe(dir)) != HAPI_LP_DIRECTORY || hapi_rmdir(dir) < 0) { go = 0; }
        else {
            if (removed != 0) { vec_push(removed, dir); }
            count = count + 1;
            if (strlen(dir) <= tn) { go = 0; }       # `top` was the last
            else { dir = _fsl_path_dirname(dir); }
        }
    }
    return count;
}

# fsl_rmdir_created over several removed links at once: `targets[i]` /
# `tops[i]` are each link's abs_target and created_dir. Every directory in
# any chain is tried once, longest path first, so a child always goes before
# its parent. A directory one link made and another reused is removed when
# the run removed both, in whatever order it removed them. A directory still
# holding something is simply not removed. Returns the vec of removed
# directories.
fn fsl_rmdir_created_all(targets, tops): i64 {
    var cands = vec_new();
    var i = 0;
    while (i < vec_len(targets)) {
        var t = vec_get(targets, i);
        var top = vec_get(tops, i);
        if (_fsl_made_ok(t, top) == 1 && _fsl_chain_is_real(t, top) == 1) {
            var tn = strlen(top);
            var dir = _fsl_path_dirname(t);
            var go = 1;
            while (go == 1) {
                var seen = 0;
                var k = 0;
                while (k < vec_len(cands)) {
                    var c = vec_get(cands, k);
                    if (strlen(c) == strlen(dir) && memeq(c, dir, strlen(dir)) == 1) { seen = 1; }
                    k = k + 1;
                }
                if (seen == 0) { vec_push(cands, dir); }
                if (strlen(dir) <= tn) { go = 0; }   # `top` was the last
                else { dir = _fsl_path_dirname(dir); }
            }
        }
        i = i + 1;
    }
    vec_sort_by(cands, &_fsl_longer_first);
    var removed = vec_new();
    var j = 0;
    while (j < vec_len(cands)) {
        var d = vec_get(cands, j);
        if (link_probe_kind(link_probe(d)) == HAPI_LP_DIRECTORY && hapi_rmdir(d) == 0) {
            vec_push(removed, d);
        }
        j = j + 1;
    }
    return removed;
}

fn _fsl_longer_first(a, b): i64 { return strlen(b) - strlen(a); }

# The line a removed directory is reported with, under its link's line.
fn fsl_print_removed_dir(dir): i64 {
    var head = "  - ";
    print(head, strlen(head));
    print(dir, strlen(dir));
    var tail = "/  (a directory hapi made)\n";
    print(tail, strlen(tail));
    return 0;
}
