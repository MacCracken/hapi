# fs_link.cyr — symlink primitives and path resolution.
#
# All path strings here are heap-allocated null-terminated
# cstrings (so they can hand straight to syscalls without a
# str_data() detour). Str values from manifest fields get
# converted to cstrings at the boundary via _fsl_str_to_cstr.
#
# Implements the symlink-shape decision from ADR 0003 — links
# carry a *relative* target computed at link time as the path
# from the link's parent directory to the absolute source.

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"

enum HapiLinkProbe {
    HAPI_LP_ABSENT = 0;
    HAPI_LP_SYMLINK = 1;
    HAPI_LP_FILE = 2;
    HAPI_LP_DIRECTORY = 3;
    HAPI_LP_ERROR = 4;
}

# Probe result: 16 bytes.
#   +0  kind (HAPI_LP_*)
#   +8  symlink target cstring (heap-allocated, null-terminated)
#       — only meaningful when kind == HAPI_LP_SYMLINK; 0 otherwise.
fn _fsl_probe_new(kind, target_cstr): i64 {
    var p = alloc(16);
    store64(p, kind);
    store64(p + 8, target_cstr);
    return p;
}
fn link_probe_kind(p): i64 { return load64(p); }
fn link_probe_target(p): i64 { return load64(p + 8); }

# Probe `path` (cstring) and classify what's there. readlink(2)
# is the cheap discriminator — its EINVAL is exactly the "exists
# but not a symlink" signal. We follow up with a directory probe
# (open + getdents) to split FILE vs DIRECTORY, because --force
# treats those differently.
fn link_probe(path): i64 {
#ifdef CYRIUS_TARGET_AGNOS
    # agnos readlink#70 (the introspection peer of symlink#63) reads a symlink's
    # TEXT target and returns its byte length, or -1 when `path` is not a symlink
    # (a missing path included) — the same no-follow discriminator role the Linux
    # readlink EINVAL plays. So probe readlink FIRST: n > 0 ⇒ it's a symlink AND we
    # already hold the target to byte-compare against the manifest — including a
    # DANGLING link (target missing), which #70 sees but stat#33 would report
    # absent. Otherwise fall back to stat#33 to split file/dir/absent (stat follows
    # symlinks, but the path is not one here, so the final-component follow is moot).
    # Before readlink#70, agnos exposed neither lstat nor readlink to ring-3, so this
    # branch stat-classified and could neither SEE an existing link nor read its
    # target for the status/reconcile compare — #70 (agnos kernel) closed that.
    var buf = alloc(4096);
    var n = hapi_readlink(path, buf, 4096);
    if (n > 0) {
        var t = alloc(n + 1);
        memcpy(t, buf, n);
        store8(t + n, 0);
        return _fsl_probe_new(HAPI_LP_SYMLINK, t);
    }
    var st = alloc(STAT_BUFSZ);
    var rc = sys_stat(path, strlen(path), st);
    if (rc < 0) { return _fsl_probe_new(HAPI_LP_ABSENT, 0); }
    if ((load64(st + STAT_MODE) & 0xF000) == 0x4000) { return _fsl_probe_new(HAPI_LP_DIRECTORY, 0); }
    return _fsl_probe_new(HAPI_LP_FILE, 0);
#else
    var buf = alloc(4096);
    var n = sys_readlink(path, buf, 4096);
    if (n > 0) {
        var t = alloc(n + 1);
        memcpy(t, buf, n);
        store8(t + n, 0);
        return _fsl_probe_new(HAPI_LP_SYMLINK, t);
    }
    var err = 0 - n;
    if (err == 2) { return _fsl_probe_new(HAPI_LP_ABSENT, 0); }
    if (err == 22) {
        # Path exists, not a symlink. Distinguish file vs directory
        # via the same trick is_dir uses: open + getdents. ENOTDIR
        # (errno 20) on getdents = regular file.
        # io.cyr's portable wrappers, not raw syscalls. Every target
        # spells these differently — aarch64 Linux has no open(2) at all
        # (56 there is `openat`, while 56 on x86_64 is `io_setup`, so a
        # bare number is worse than an undefined one), and agnos's
        # sys_open is (name, namelen, flags) with a 3-arg getdents. A
        # bare `syscall(SYS_OPEN, ...)` here is exactly what kept
        # `--aarch64` from building between 1.0.2 and 1.0.4, so this
        # block stays on the wrappers even though it sits in the
        # non-agnos `#else` arm.
        var fd = file_open(path, O_RDONLY, 0);
        if (fd < 0) { return _fsl_probe_new(HAPI_LP_FILE, 0); }
        var dbuf = alloc(32);
        var gd = xgetdents(fd, dbuf, 32);
        file_close(fd);
        if (gd >= 0) { return _fsl_probe_new(HAPI_LP_DIRECTORY, 0); }
        return _fsl_probe_new(HAPI_LP_FILE, 0);
    }
    return _fsl_probe_new(HAPI_LP_ERROR, 0);
#endif
}

# Heap-copy a Str's bytes into a null-terminated cstring.
fn _fsl_str_to_cstr(s: Str): i64 {
    var len = str_len(s);
    var out = alloc(len + 1);
    memcpy(out, str_data(s), len);
    store8(out + len, 0);
    return out;
}

# Heap-copy a cstring (clone).
fn _fsl_cstr_dup(c): i64 {
    var n = strlen(c);
    var out = alloc(n + 1);
    memcpy(out, c, n);
    store8(out + n, 0);
    return out;
}

# Join `dir` and `name` with a '/' separator (skipping the
# separator when dir already ends in one). Both inputs are
# cstrings; output is a fresh heap cstring.
fn _fsl_path_join(dir, name): i64 {
    var dl = strlen(dir);
    var nl = strlen(name);
    var sep = 1;
    if (dl > 0 && load8(dir + dl - 1) == 47) { sep = 0; }
    var out = alloc(dl + sep + nl + 1);
    memcpy(out, dir, dl);
    if (sep == 1) { store8(out + dl, 47); }
    memcpy(out + dl + sep, name, nl);
    store8(out + dl + sep + nl, 0);
    return out;
}

# Get the dirname (everything before the last '/') as a cstring.
# Returns "." when there's no '/' in the input.
fn _fsl_path_dirname(path): i64 {
    var n = strlen(path);
    var last = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return _fsl_cstr_dup("."); }
    if (last == 0) { return _fsl_cstr_dup("/"); }
    var out = alloc(last + 1);
    memcpy(out, path, last);
    store8(out + last, 0);
    return out;
}

# Get the process's current working directory as a cstring.
# Used as the base for resolving the package-dir argument
# when the user passes a relative path.
fn _fsl_getcwd(): i64 {
#ifdef CYRIUS_TARGET_AGNOS
    # agnos has no getcwd syscall (no per-process cwd concept in the
    # userland ABI). Return "." so relative package-dir args resolve
    # against the invocation directory the caller already knows.
    var dot = alloc(2);
    store8(dot, 46); store8(dot + 1, 0);
    return dot;
#else
    var buf = alloc(4096);
    var n = syscall(SYS_GETCWD, buf, 4096);
    if (n < 0) {
        var fb = alloc(2);
        store8(fb, 46); store8(fb + 1, 0);
        return fb;
    }
    # On Linux, getcwd writes a null-terminated path; the return
    # value is the length including the trailing null. The buf is
    # already what we want — just clone it tight.
    var len = strlen(buf);
    var out = alloc(len + 1);
    memcpy(out, buf, len);
    store8(out + len, 0);
    return out;
#endif
}

# Resolve `path` (cstring) to an absolute cstring. If already
# absolute (starts with '/'), returns a clone. Otherwise prefixes
# the cwd with '/' as separator. Note: does NOT resolve `..` or
# `.` segments. Call `fsl_lexical_normalize` afterward when the
# result will be byte-compared against a permitted prefix (e.g.
# the capability cap-check).
fn fsl_to_absolute(path): i64 {
    var n = strlen(path);
    if (n > 0 && load8(path) == 47) { return _fsl_cstr_dup(path); }
    var cwd = _fsl_getcwd();
    return _fsl_path_join(cwd, path);
}

# Lexical path canonicalization: collapse `.` and `..` segments
# in `path` (an absolute cstring). Returns a fresh heap cstring.
#
# `/a/b/../c` → `/a/c`
# `/a/./b`    → `/a/b`
# `/a/b/..`   → `/a`
# `/..`       → `/` (cannot escape root)
# `/`         → `/`
#
# Lexical means: no filesystem calls; no symlink resolution. A
# leading symlink in the path is preserved (`/home/user/trap`
# stays `/home/user/trap` even if `trap` is a symlink). This is
# exactly the property the capability cap-check needs to reject
# `--root /home/user/../etc` while leaving the symlink-resolution
# question for the kavach migration.
# Split an absolute path into its components (no ".", no "..", already
# collapsed by fsl_lexical_normalize). Returns a vec of Str.
fn _fsl_split(path): i64 {
    var parts = vec_new();
    var n = strlen(path);
    var start = 1;
    var i = 1;
    while (i <= n) {
        var at_sep = 0;
        if (i == n) { at_sep = 1; }
        elif (load8(path + i) == 47) { at_sep = 1; }
        if (at_sep == 1) {
            var seg_len = i - start;
            if (seg_len > 0) { vec_push(parts, str_new(path + start, seg_len)); }
            start = i + 1;
        }
        i = i + 1;
    }
    return parts;
}

# Resolve `path` by following a symlink at EVERY component, left to
# right — the physical path, as the kernel would reach it.
#
# This is the missing half of the capability boundary (F-015).
# `fsl_lexical_normalize` collapses `..` but treats every component as a
# plain name, so an ordinary convenience symlink — `~/.config ->
# /mnt/other/etc` — put a manifest target outside the scope root on a
# PLAIN `hapi link`, no flag involved, and `--force` then deleted
# whatever was there. Lexical containment cannot see that; only
# following the links can.
#
# Components that do not exist yet are kept literally: hapi creates
# parent directories, so the parent of a new target is routinely absent,
# and an absent component cannot be a symlink out of the scope.
#
# Hop-capped at 40 (the kernel's own ELOOP budget). Returns 0 if the cap
# is hit — the caller must treat that as "cannot prove containment" and
# refuse, never as "contained".
fn fsl_resolve_path(path): i64 {
    var cur = fsl_lexical_normalize(fsl_to_absolute(path));
    var hops = 0;
    var parts = _fsl_split(cur);
    var idx = 0;
    var acc = alloc(2);
    store8(acc, 47); store8(acc + 1, 0);          # "/"

    var go = 1;
    while (go == 1) {
        if (idx >= vec_len(parts)) { go = 0; continue; }
        var seg = vec_get(parts, idx);
        acc = _fsl_path_join(acc, _fsl_str_to_cstr(seg));
        idx = idx + 1;

        var probe = link_probe(acc);
        if (link_probe_kind(probe) == HAPI_LP_SYMLINK) {
            hops = hops + 1;
            if (hops > 40) { return 0; }
            var tgt = link_probe_target(probe);
            if (tgt == 0) { return 0; }
            var next = 0;
            if (load8(tgt) == 47) {
                next = fsl_lexical_normalize(tgt);
            } else {
                next = fsl_lexical_normalize(_fsl_path_join(_fsl_path_dirname(acc), tgt));
            }
            # Re-seat the walk at the link target, then continue with the
            # components we have not consumed yet.
            var rest = vec_new();
            var r = idx;
            while (r < vec_len(parts)) { vec_push(rest, vec_get(parts, r)); r = r + 1; }
            var head = _fsl_split(next);
            var h = 0;
            var merged = vec_new();
            while (h < vec_len(head)) { vec_push(merged, vec_get(head, h)); h = h + 1; }
            h = 0;
            while (h < vec_len(rest)) { vec_push(merged, vec_get(rest, h)); h = h + 1; }
            parts = merged;
            idx = 0;
            acc = alloc(2);
            store8(acc, 47); store8(acc + 1, 0);
        }
    }
    return acc;
}

# Is the PHYSICAL location of `path` inside the PHYSICAL scope root?
# Both sides are resolved, so a scope root that is itself reached
# through a symlink (`/home/u -> /mnt/home/u`) does not cause a false
# refusal. Returns 0 when containment cannot be proven.
# Component-boundary prefix match. Local to this module: cap.cyr's
# equivalent lives downstream of this file (it includes fs_link.cyr), so
# reaching for it here would be a cycle.
fn _fsl_within(path, prefix): i64 {
    var pn = strlen(path);
    var fn_ = strlen(prefix);
    if (fn_ == 0) { return 0; }
    if (fn_ > 1 && load8(prefix + fn_ - 1) == 47) { fn_ = fn_ - 1; }
    if (pn < fn_) { return 0; }
    if (memeq(path, prefix, fn_) == 0) { return 0; }
    if (pn == fn_) { return 1; }
    if (load8(path + fn_) == 47) { return 1; }
    return 0;
}

fn fsl_resolved_within(path, scope_root): i64 {
    var rp = fsl_resolve_path(path);
    if (rp == 0) { return 0; }
    var rs = fsl_resolve_path(scope_root);
    if (rs == 0) { return 0; }
    return _fsl_within(rp, rs);
}

fn fsl_lexical_normalize(path): i64 {
    var n = strlen(path);
    if (n == 0 || load8(path) != 47) { return _fsl_cstr_dup(path); }

    var parts = vec_new();
    var start = 1;
    var i = 1;
    while (i <= n) {
        var at_sep = 0;
        if (i == n) { at_sep = 1; }
        elif (load8(path + i) == 47) { at_sep = 1; }
        if (at_sep == 1) {
            var seg_len = i - start;
            if (seg_len > 0) {
                if (seg_len == 1 && load8(path + start) == 46) {
                    # "." segment — drop
                } elif (seg_len == 2 && load8(path + start) == 46
                                     && load8(path + start + 1) == 46) {
                    if (vec_len(parts) > 0) { vec_pop(parts); }
                } else {
                    vec_push(parts, str_new(path + start, seg_len));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }

    var sn = vec_len(parts);
    if (sn == 0) {
        var root = alloc(2);
        store8(root, 47);
        store8(root + 1, 0);
        return root;
    }
    var total = 0;
    var k = 0;
    while (k < sn) {
        total = total + 1 + str_len(vec_get(parts, k));
        k = k + 1;
    }
    var out = alloc(total + 1);
    var pos = 0;
    k = 0;
    while (k < sn) {
        store8(out + pos, 47); pos = pos + 1;
        var s = vec_get(parts, k);
        memcpy(out + pos, str_data(s), str_len(s));
        pos = pos + str_len(s);
        k = k + 1;
    }
    store8(out + pos, 0);
    return out;
}

# Split a cstring path on '/' into a vec of Str slices that
# borrow into the input. Empty components (from leading '/' or
# '//') are dropped. Used by fsl_compute_relative.
fn _fsl_split_path(path): i64 {
    var v = vec_new();
    var n = strlen(path);
    var start = 0;
    var i = 0;
    while (i <= n) {
        var c = 47;
        if (i < n) { c = load8(path + i); }
        if (c == 47 || i == n) {
            if (i > start) {
                vec_push(v, str_new(path + start, i - start));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return v;
}

# Compare two Str values for byte-equality.
fn _fsl_str_byteeq(a: Str, b: Str): i64 {
    var an = str_len(a);
    var bn = str_len(b);
    if (an != bn) { return 0; }
    var ap = str_data(a);
    var bp = str_data(b);
    var i = 0;
    while (i < an) {
        if (load8(ap + i) != load8(bp + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Compute the relative path from `from_dir` (the link's parent
# directory, absolute) to `to_file` (the source file, absolute).
# Result is a fresh cstring with `..` segments for the
# from_dir components not shared by to_file.
#
# Both inputs MUST be absolute paths (start with '/'). Caller
# resolves via fsl_to_absolute.
fn fsl_compute_relative(from_dir, to_file): i64 {
    var from_parts = _fsl_split_path(from_dir);
    var to_parts   = _fsl_split_path(to_file);

    var fn_ = vec_len(from_parts);
    var tn = vec_len(to_parts);
    var lim = fn_;
    if (tn < lim) { lim = tn; }
    var common = 0;
    var go = 1;
    while (common < lim && go == 1) {
        var fp = vec_get(from_parts, common);
        var tp = vec_get(to_parts, common);
        if (_fsl_str_byteeq(fp, tp) == 0) { go = 0; }
        else { common = common + 1; }
    }

    # Output: `..` for each from_dir component past `common`,
    # then each to_file component past `common`.
    var ups = fn_ - common;
    # Worst-case length: ups * 3 (`../`) + sum of remaining-to-parts lengths + slashes
    var cap = ups * 3 + 1;
    var k = common;
    while (k < tn) {
        cap = cap + str_len(vec_get(to_parts, k)) + 1;
        k = k + 1;
    }
    if (cap < 4) { cap = 4; }
    var out = alloc(cap);
    var pos = 0;
    var u = 0;
    while (u < ups) {
        store8(out + pos, 46); store8(out + pos + 1, 46); store8(out + pos + 2, 47);
        pos = pos + 3;
        u = u + 1;
    }
    k = common;
    var first_tail = 1;
    while (k < tn) {
        if (first_tail == 0) { store8(out + pos, 47); pos = pos + 1; }
        var t = vec_get(to_parts, k);
        var tlen = str_len(t);
        memcpy(out + pos, str_data(t), tlen);
        pos = pos + tlen;
        first_tail = 0;
        k = k + 1;
    }
    # Strip a trailing slash if we wrote only `..` segments.
    if (pos > 0 && load8(out + pos - 1) == 47) { pos = pos - 1; }
    if (pos == 0) {
        # Same dir, same file. Shouldn't happen for our usage
        # but emit "." rather than the empty string.
        store8(out, 46);
        pos = 1;
    }
    store8(out + pos, 0);
    return out;
}

# mkdir -p `path`'s parent. Treats EEXIST as success. Mode 0700.
# Returns 0 on success, negative on first non-EEXIST failure.
fn fsl_mkdir_parents(file_path): i64 {
    var n = strlen(file_path);
    var last_slash = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(file_path + i) == 47) { last_slash = i; }
        i = i + 1;
    }
    if (last_slash <= 0) { return 0; }

    var tmp = alloc(n + 1);
    memcpy(tmp, file_path, n);
    store8(tmp + n, 0);

    var j = 1;
    while (j <= last_slash) {
        if (load8(tmp + j) == 47) {
            store8(tmp + j, 0);
            var rc = hapi_mkdir(tmp, 0x1C0);
            if (rc < 0) {
                var err = 0 - rc;
                if (err != 17) { return rc; }
            }
            store8(tmp + j, 47);
        }
        j = j + 1;
    }
    store8(tmp + last_slash, 0);
    var rc = hapi_mkdir(tmp, 0x1C0);
    if (rc < 0) {
        var err = 0 - rc;
        if (err != 17) { return rc; }
    }
    return 0;
}

# Create a symlink at `linkpath` pointing at `target`. Creates
# the parent directory of `linkpath` on demand. Returns the
# raw kernel return code (0 on success, -errno on failure).
fn link_create(target, linkpath): i64 {
    var mkrc = fsl_mkdir_parents(linkpath);
    if (mkrc < 0) { return mkrc; }
    return hapi_symlink(target, linkpath);
}
